; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_RadioSetItemEnabled
; 說明 ...: Enables or disable specified radio options.
; 語法 ........: _UI_RadioSetItemEnabled( $hWnd, $iRadio, $iIndex, $bEnabled )
; 參數 ....: $hWnd - Window handle returned by _UI_WindowCreate
;                  $iRadio - Radio control ID
;                  $iIndex - Zero-based option index
;                  $bEnabled - True = enabled, False = disabled
; 傳回值 .: Success - 1
;                  Failure - 0
; 作者 ........: Fanxing
; 備註 .......: Silently selects the next available item when the current item is disabled; the current index is -1 when all
;                  are disabled.
; 相關函式 .......: _UI_RadioGetItemEnabled, _UI_RadioSetSelected
; 範例 .......: Yes
; ===============================================================================================================================
Func _UI_RadioSetItemEnabled($hWnd, $iRadio, $iIndex, $bEnabled)
    Local $vAuiForwardResult = __AUI_Call("int", "_UI_RadioSetItemEnabled", "hwnd", $hWnd, "int", $iRadio, "int", $iIndex, "int", $bEnabled ? 1 : 0)
    Return SetError(@error, @extended, $vAuiForwardResult)
EndFunc

