EndFunc

; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_JsonSetRaw
; 說明 ...: Adds or replaces a value at an RFC 6901 JSON Pointer using a complete JSON value.
; 語法 ........: _UI_JsonSetRaw( $iJson, $sPointer, $sValueJson )
; 參數 ....: $iJson - Document handle; borrowed child handles are not accepted
;                  $sPointer - RFC 6901 JSON Pointer; an empty string replaces the document root
;                  $sValueJson - A complete, valid JSON value
; 傳回值 .: Success - 1
;                  Failure - 0 and set @error
; 作者 ........: Fanxing
; 備註 .......: Parent containers must already exist; intermediate nodes are not created automatically. Append to an array
;                  with "-" or an index equal to its current length. Use the Raw form for exact large integers or pre-serialized
;                  JSON. Failure does not change the document or invalidate existing child handles.
; 相關函式 .......: _UI_JsonSet, _UI_JsonRemove, _UI_JsonGetNumberText
; 範例 .......: No
; ===============================================================================================================================
Func _UI_JsonSetRaw($iJson, $sPointer, $sValueJson)
    Local $vAuiForwardResult = __AUI_Call("int", "_UI_JsonSetRaw", "int", $iJson, "wstr", $sPointer, "wstr", $sValueJson)
    Return SetError(@error, @extended, $vAuiForwardResult)
EndFunc

; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_JsonSet
; 說明 ...: Converts a native AutoIt value to JSON and adds or replaces it at an RFC 6901 JSON Pointer.
; 語法 ........: _UI_JsonSet( $iJson, $sPointer, $vValue )
; 參數 ....: $iJson - Document handle; borrowed child handles are not accepted
;                  $sPointer - RFC 6901 JSON Pointer; an empty string replaces the document root
;                  $vValue - Map, one-dimensional array, string, integer, finite Double, Boolean, or Null
; 傳回值 .: Success - 1
;                  Failure - 0 and set @error
; 作者 ........: Fanxing
; 備註 .......: The value is fully converted under the _UI_JsonFromAutoIt rules first. The document remains unchanged if
;                  conversion or mutation fails.
; 相關函式 .......: _UI_JsonSetRaw, _UI_JsonFromAutoIt
; 範例 .......: No
; ===============================================================================================================================
Func _UI_JsonSet($iJson, $sPointer, $vValue)
    Local $sJson = _UI_JsonFromAutoIt($vValue)
    Local $iError = @error, $iExtended = @extended
    If $iError Then Return SetError($iError, $iExtended, 0)
    Local $iResult = _UI_JsonSetRaw($iJson, $sPointer, $sJson)
    Return SetError(@error, @extended, $iResult)
EndFunc

; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_JsonRemove
; 說明 ...: Removes the object member or array element selected by an RFC 6901 JSON Pointer.
; 語法 ........: _UI_JsonRemove( $iJson, $sPointer )
; 參數 ....: $iJson - Document handle; borrowed child handles are not accepted
;                  $sPointer - RFC 6901 JSON Pointer; an empty string is not allowed
; 傳回值 .: Success - 1
;                  Failure - 0 and set @error
; 作者 ........: Fanxing
; 備註 .......: The document root cannot be removed. Use _UI_JsonSetRaw to replace it or _UI_JsonClear to empty a root
;                  container.
; 相關函式 .......: _UI_JsonSet, _UI_JsonClear
; 範例 .......: No
; ===============================================================================================================================
Func _UI_JsonRemove($iJson, $sPointer)
    Local $vAuiForwardResult = __AUI_Call("int", "_UI_JsonRemove", "int", $iJson, "wstr", $sPointer)
    Return SetError(@error, @extended, $vAuiForwardResult)
EndFunc

