; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_ToggleButton
; 說明 ...: Creates a toggle (pressed/up) button.
; 語法 ........: _UI_ToggleButton( $hWnd, $iParent, $sText [, $bChecked = False [, $iX = 0 [, $iY = 0 [, $iW = 0 [, $iH =
;                  0]]]]] )
; 參數 ....: $hWnd - Window handle returned by _UI_WindowCreate
;                  $iParent - Parent element ID; use 0 for the window root
;                  $sText - Text content
;                  $bChecked - [Optional] Whether to initially select, default False
;                  $iX - [Optional] Logical X coordinate (relative to parent container; ignored in flexible containers such as
;                  Row/Column), default 0
;                  $iY - [Optional] Logical Y coordinate (relative to parent container; ignored in flexible containers), default
;                  0
;                  $iW - [Optional] Logical width; 0 = automatically determined/filled by layout, default 0
;                  $iH - [Optional] Logical height; 0 = automatically determined/filled by layout, default 0
; 傳回值 .: Success - New element ID (integer, >= 1)
;                  Failure - 0
; 作者 ........: Fanxing
; 相關函式 .......: _UI_Button, _UI_OnValue
; 範例 .......: Yes
; ===============================================================================================================================
Func _UI_ToggleButton($hWnd, $iParent, $sText, $bChecked = False, $iX = 0, $iY = 0, $iW = 0, $iH = 0)
    Local $vAuiForwardResult = __AUI_Call("int", "_UI_ToggleButton", _
                       "hwnd", $hWnd, "int", $iParent, "wstr", $sText, _
                       "int", ($bChecked ? 1 : 0), _
                       "int", $iX, "int", $iY, "int", $iW, "int", $iH)
    Return SetError(@error, @extended, $vAuiForwardResult)
EndFunc

; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_ToggleButtonSetChecked
; 說明 ...: Sets the ToggleButton state without raising a change event.
; 語法 ........: _UI_ToggleButtonSetChecked( $hWnd, $iButton, $bChecked )
; 參數 ....: $hWnd - Window handle returned by _UI_WindowCreate
;                  $iButton - ToggleButton control ID
;                  $bChecked - True means selected, False means unchecked
; 傳回值 .: Success - 1
;                  Failure - 0
; 作者 ........: Fanxing
; 相關函式 .......: _UI_ToggleButtonGetChecked, _UI_OnValue
; 範例 .......: Yes
; ===============================================================================================================================
Func _UI_ToggleButtonSetChecked($hWnd, $iButton, $bChecked)
    Local $vAuiForwardResult = __AUI_Call("int", "_UI_ToggleButtonSetChecked", "hwnd", $hWnd, "int", $iButton, "int", $bChecked ? 1 : 0)
    Return SetError(@error, @extended, $vAuiForwardResult)
EndFunc

; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_ToggleButtonGetChecked
; 說明 ...: Retrieves the selected state of a toggle button.
; 語法 ........: _UI_ToggleButtonGetChecked( $hWnd, $iButton )
; 參數 ....: $hWnd - Window handle returned by _UI_WindowCreate
