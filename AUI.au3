; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_EnableEditMenu
; 說明 ...: Attaches a standard "cut/copy/paste/select all" context menu to the text input box, and the actions are wired
;                  within the library (copy/select all are always available; cut/paste is automatically disabled when
;                  read-only).
; 語法 ........: _UI_EnableEditMenu( $hWnd, $iId )
; 參數 ....: $hWnd - Window handle
;                  $iId - Input box / multi-line box ID
; 傳回值 .: Success - Menu ID
; 作者 ........: Fanxing
; 範例 .......: No
; ===============================================================================================================================
Func _UI_EnableEditMenu($hWnd, $iId)
    _AUI_SetEditMenuTraditionalChinese($hWnd)
    Local $vAuiForwardResult = __AUI_Call("int", "_UI_EnableEditMenu", "hwnd", $hWnd, "int", $iId)
    Return SetError(@error, @extended, $vAuiForwardResult)
EndFunc

Func _AUI_SetEditMenuTraditionalChinese($hWnd)
    _UI_WindowSetString($hWnd, $AUI_STR_EDIT_CUT,        "剪下")
    _UI_WindowSetString($hWnd, $AUI_STR_EDIT_COPY,       "複製")
    _UI_WindowSetString($hWnd, $AUI_STR_EDIT_PASTE,      "貼上")
    _UI_WindowSetString($hWnd, $AUI_STR_EDIT_SELECT_ALL, "全選")
EndFunc

; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_ContextMenuSetItemEnabled
; 說明 ...: Enables or disable specified context menu items.
; 語法 ........: _UI_ContextMenuSetItemEnabled( $hWnd, $iMenu, $iIndex, $bEnabled )
; 參數 ....: $hWnd - Window handle returned by _UI_WindowCreate
;                  $iMenu - ContextMenu control ID
;                  $iIndex - Zero-based menu-item index
;                  $bEnabled - True = enabled, False = disabled
; 傳回值 .: Success - 1
;                  Failure - 0
; 作者 ........: Fanxing
; 備註 .......: Disabled items still appear, but clicking does not close the menu or trigger OnValue.
; 相關函式 .......: _UI_ContextMenuGetItemEnabled
; 範例 .......: Yes
; ===============================================================================================================================
Func _UI_ContextMenuSetItemEnabled($hWnd, $iMenu, $iIndex, $bEnabled)
    Local $vAuiForwardResult = __AUI_Call("int", "_UI_ContextMenuSetItemEnabled", "hwnd", $hWnd, "int", $iMenu, "int", $iIndex, "int", $bEnabled ? 1 : 0)
    Return SetError(@error, @extended, $vAuiForwardResult)
EndFunc

