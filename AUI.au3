; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_RadioInsertItem
; 說明 ...: Inserts a single option at the specified position.
; 語法 ........: _UI_RadioInsertItem( $hWnd, $iRadio, $iIndex, $sText )
; 參數 ....: $hWnd - Window handle returned by _UI_WindowCreate
;                  $iRadio - Radio control ID
;                  $iIndex - Insert index; can be equal to the current number of options
;                  $sText - New option text
; 傳回值 .: Success - 1
;                  Failure - 0
; 作者 ........: Fanxing
; 備註 .......: When inserting before the current option, the original currently selected item remains unchanged.
; 範例 .......: Yes
; ===============================================================================================================================
Func _UI_RadioInsertItem($hWnd, $iRadio, $iIndex, $sText)
    Local $vAuiForwardResult = __AUI_Call("int", "_UI_RadioInsertItem", "hwnd", $hWnd, "int", $iRadio, "int", $iIndex, "wstr", $sText)
    Return SetError(@error, @extended, $vAuiForwardResult)
EndFunc

; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_RadioRemoveItem
; 說明 ...: Deletes specified single option.
; 語法 ........: _UI_RadioRemoveItem( $hWnd, $iRadio, $iIndex )
; 參數 ....: $hWnd - Window handle returned by _UI_WindowCreate
;                  $iRadio - Radio control ID
;                  $iIndex - Option index to delete
; 傳回值 .: Success - 1
;                  Failure - 0
; 作者 ........: Fanxing
; 備註 .......: After deleting the current item, the next item at the original position will be selected first; if there is
;                  no next item, the previous item will be selected.
; 範例 .......: Yes
; ===============================================================================================================================
Func _UI_RadioRemoveItem($hWnd, $iRadio, $iIndex)
    Local $vAuiForwardResult = __AUI_Call("int", "_UI_RadioRemoveItem", "hwnd", $hWnd, "int", $iRadio, "int", $iIndex)
    Return SetError(@error, @extended, $vAuiForwardResult)
EndFunc

; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_RadioClear
; 說明 ...: Clears all options in the radio group.
; 語法 ........: _UI_RadioClear( $hWnd, $iRadio )
; 參數 ....: $hWnd - Window handle returned by _UI_WindowCreate
;                  $iRadio - Radio control ID
; 傳回值 .: Success - 1
;                  Failure - 0
; 作者 ........: Fanxing
; 備註 .......: After clearing, the current option index is -1; when appending the first item again, index 0 will be
;                  automatically selected.
