; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_EditSetError
; 說明 ...: Sets a manual application-level error state and message; an empty string clears the error.
; 語法 ........: _UI_EditSetError( $hWnd, $iId [, $sMessage = ""] )
; 參數 ....: $hWnd - Window handle
;                  $iId - Edit control element ID
;                  $sMessage - [Optional] Error message text
; 傳回值 .: Success - 1
;                  Failure - 0
; 作者 ........: Fanxing
; 備註 .......: Manual errors take precedence over built-in rules and are not overwritten by _UI_EditValidate or
;                  _UI_FormValidate. They are cleared when the user edits the text or when an empty string is passed explicitly.
; 範例 .......: Yes
; ===============================================================================================================================
Func _UI_EditSetError($hWnd, $iId, $sMessage = "")
    Local $vAuiForwardResult = __AUI_Call("int", "_UI_EditSetError", "hwnd", $hWnd, "int", $iId, "wstr", $sMessage)
    Return SetError(@error, @extended, $vAuiForwardResult)
EndFunc

