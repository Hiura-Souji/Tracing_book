; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_ColorPickerGetPalette
; 說明 ...: Retrieves the color picker's current swatch as a one-dimensional ARGB color array.
; 語法 ........: _UI_ColorPickerGetPalette( $hWnd, $iId )
; 參數 ....: $hWnd - Window handle returned by _UI_WindowCreate
;                  $iId - ColorPicker element ID returned by _UI_ColorPicker
; 傳回值 .: Success - One-dimensional color array
;                  Failure - 0, and set @error
; 作者 ........: Fanxing
; 相關函式 .......: _UI_ColorPickerSetPalette, _UI_ColorPickerGetPaletteColor
; 範例 .......: Yes
; ===============================================================================================================================
Func _UI_ColorPickerGetPalette($hWnd, $iId)
    Local $iCount = _UI_ColorPickerGetPaletteCount($hWnd, $iId)
    If $iCount < 0 Then Return SetError(_UI_GetLastError(), 0, 0)
    Local $aColors[$iCount]
    For $i = 0 To $iCount - 1
        $aColors[$i] = _UI_ColorPickerGetPaletteColor($hWnd, $iId, $i)
        If _UI_GetLastError() <> $AUI_OK Then Return SetError(_UI_GetLastError(), $i, 0)
    Next
    Return SetError(0, 0, $aColors)
EndFunc

; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_ColorPicker
; 說明 ...: Creates a color picker.
; 語法 ........: _UI_ColorPicker( $hWnd, $iParent [, $iColor = 0xFF0067C0 [, $iX = 0 [, $iY = 0 [, $iW = 0 [, $iH = 0]]]]] )
; 參數 ....: $hWnd - Window handle returned by _UI_WindowCreate
;                  $iParent - Parent element ID; use 0 for the window root
;                  $iColor - [Optional] Initial color 0xAARRGGBB, default 0xFF0067C0
;                  $iX - [Optional] Logical X coordinate (relative to parent container; ignored in flexible containers such as
;                  Row/Column), default 0
;                  $iY - [Optional] Logical Y coordinate (relative to parent container; ignored in flexible containers), default
;                  0
;                  $iW - [Optional] Logical width; 0 = automatically determined/filled by layout, default 0
;                  $iH - [Optional] Logical height; 0 = automatically determined/filled by layout, default 0
; 傳回值 .: Success - New element ID (integer, >= 1)
;                  Failure - 0
; 作者 ........: Fanxing
; 相關函式 .......: _UI_RGB, _UI_OnValue
; 範例 .......: Yes
; ===============================================================================================================================
Func _UI_ColorPicker($hWnd, $iParent, $iColor = 0xFF0067C0, $iX = 0, $iY = 0, $iW = 0, $iH = 0)
    Local $vAuiForwardResult = __AUI_Call("int", "_UI_ColorPicker", _
                       "hwnd", $hWnd, "int", $iParent, "uint", $iColor, _
                       "int", $iX, "int", $iY, "int", $iW, "int", $iH)
    Return SetError(@error, @extended, $vAuiForwardResult)
EndFunc

