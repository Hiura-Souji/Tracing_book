EndFunc

; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_SetDragHandle
; 說明 ...: Enables or disables using the element as a drag region for a borderless window.
; 語法 ........: _UI_SetDragHandle( $hWnd, $iId [, $bEnable = True] )
; 參數 ....: $hWnd - Window handle
;                  $iId - Target element ID
;                  $bEnable - [Optional] True to turn on, False to turn off, default True
; 傳回值 .: Success - 1
;                  Failure - 0
; 作者 ........: Fanxing
; 備註 .......: The window can be moved by dragging the blank space of the element, and interactive sub-elements such as
;                  buttons inside the element can still be clicked normally.
; 相關函式 .......: _UI_WindowCreateEx, $AUI_WIN_NO_TITLEBAR
; 範例 .......: Yes
; ===============================================================================================================================
Func _UI_SetDragHandle($hWnd, $iId, $bEnable = True)
    Local $vAuiForwardResult = __AUI_Call("int", "_UI_SetDragHandle", "hwnd", $hWnd, "int", $iId, "int", $bEnable ? 1 : 0)
    Return SetError(@error, @extended, $vAuiForwardResult)
EndFunc

