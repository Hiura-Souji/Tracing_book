; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_PaginationSetPage
; 說明 ...: Silently sets the current page of the pagination control; out-of-range pages are clamped to [1, total page
;                  count].
; 語法 ........: _UI_PaginationSetPage( $hWnd, $iId, $iPage )
; 參數 ....: $hWnd - Window handle returned by _UI_WindowCreate
;                  $iId - Pagination element ID
;                  $iPage - 1-based page number; values below 1 are treated as 1, values above the total page count are treated
;                  as the total page count
; 傳回值 .: Success - 1 (always succeeds; the page is clamped)
;                  Failure - 0; the error code is set when the element is invalid
; 作者 ........: Fanxing
; 範例 .......: Yes
; ===============================================================================================================================
Func _UI_PaginationSetPage($hWnd, $iId, $iPage)
    Local $vAuiForwardResult = __AUI_Call("int", "_UI_PaginationSetPage", "hwnd", $hWnd, "int", $iId, "int", $iPage)
    Return SetError(@error, @extended, $vAuiForwardResult)
EndFunc

