    If $bEnable Then $iEnable = 1
    Local $vAuiForwardResult = __AUI_Call("int", "_UI_SetWrap", "hwnd", $hWnd, "int", $iId, "int", $iEnable)
    Return SetError(@error, @extended, $vAuiForwardResult)
EndFunc

