; ────────────────────────────────────────────────────────────────────────────
;  Spinner
; ────────────────────────────────────────────────────────────────────────────
; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_Spinner
; 說明 ...: Creates a spinning loading indicator that displays descriptive text underneath.
; 語法 ........: _UI_Spinner( $hWnd, $iParent [, $sText = "" [, $iX = 0 [, $iY = 0 [, $iW = 0 [, $iH = 0]]]]] )
; 參數 ....: $hWnd - Window handle returned by _UI_WindowCreate
;                  $iParent - Parent element ID; use 0 for the window root
;                  $sText - [Optional] Description text below the indicator; an empty string means only the circles will be
;                  displayed, the default is ""
;                  $iX - [Optional] Logical X coordinate (relative to parent container; ignored in flexible containers such as
;                  Row/Column), default 0
;                  $iY - [Optional] Logical Y coordinate (relative to parent container; ignored in flexible containers), default
;                  0
;                  $iW - [Optional] Logical width, default 0
;                  $iH - [Optional] Logical height, default 0; recommended to be at least 64 when displaying text
; 傳回值 .: Success - New element ID (integer, >= 1)
;                  Failure - 0
; 作者 ........: Fanxing
; 相關函式 .......: _UI_Progress, _UI_SetBusy
; 範例 .......: Yes
; ===============================================================================================================================
Func _UI_Spinner($hWnd, $iParent, $sText = "", $iX = 0, $iY = 0, $iW = 0, $iH = 0)
    Local $vAuiForwardResult = __AUI_Call("int", "_UI_Spinner", _
                       "hwnd", $hWnd, "int", $iParent, "wstr", $sText, _
                       "int", $iX, "int", $iY, "int", $iW, "int", $iH)
    Return SetError(@error, @extended, $vAuiForwardResult)
EndFunc
; ────────────────────────────────────────────────────────────────────────────
;  WebView
; ────────────────────────────────────────────────────────────────────────────
Func __AUI_DispWebTab($hWnd, $iWebId, $iEvent, $iTabId)
    Local $f = __AUI_CbGet($__AUI_CB_WEB_TAB_ADDED + $iEvent, $iWebId, $hWnd)
    If $f <> "" Then __AUI_SafeCall($f, $iTabId, 0, 0, 1)
EndFunc

Func __AUI_DispWebResult($hWnd, $iWebId, $iRequestId, $iStatus)
    Local $sKey = $iWebId & ":" & $iRequestId
    Local $f = __AUI_CbGet($__AUI_CB_WEB_RESULT, $sKey, $hWnd)
    __AUI_CbDel($__AUI_CB_WEB_RESULT, $sKey, $hWnd)
    If $f <> "" Then __AUI_SafeCall($f, $iWebId, $iRequestId, $iStatus, 3)
EndFunc

Func __AUI_WebResultAttachCallback($hWnd, $iWebId, $iRequestId, $sOnDone)
    If $iRequestId <= 0 Or $sOnDone = "" Then Return SetError(0, 0, 1)
    If __AUI_CbSet($__AUI_CB_WEB_RESULT, $iWebId & ":" & $iRequestId, $sOnDone, $hWnd) Then Return SetError(0, 0, 1)
    Local $iMapError = @error
    If $iMapError = 0 Then $iMapError = $AUI_UDF_ERR_INVALID_CALLBACK
    __AUI_Call("int", "_UI_WebViewResultRelease", "hwnd", $hWnd, "int", $iWebId, "int", $iRequestId)
    Return SetError($iMapError, 0, 0)
EndFunc

; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_WebView
; 說明 ...: Creates WebView2 browser control.
; 語法 ........: _UI_WebView( $hWnd, $iParent, $sUrl [, $iX = 0 [, $iY = 0 [, $iW = 0 [, $iH = 0]]]] )
; 參數 ....: $hWnd - Window handle returned by _UI_WindowCreate
;                  $iParent - Parent element ID; use 0 for the window root
;                  $sUrl - URL
;                  $iX - [Optional] Logical X coordinate (relative to parent container; ignored in flexible containers such as
;                  Row/Column), default 0
;                  $iY - [Optional] Logical Y coordinate (relative to parent container; ignored in flexible containers), default
;                  0
;                  $iW - [Optional] Logical width; 0 = automatically determined/filled by layout, default 0
;                  $iH - [Optional] Logical height; 0 = automatically determined/filled by layout, default 0
; 傳回值 .: Success - New element ID (integer, >= 1)
;                  Failure - 0
; 作者 ........: Fanxing
; 備註 .......: The Microsoft Edge WebView2 Runtime must be installed; call _UI_WebViewIsRuntimeInstalled to check before
;                  creating the control.
; 相關函式 .......: _UI_WebViewNavigate, _UI_WebViewExecuteScriptAsync
; 範例 .......: Yes
; ===============================================================================================================================
Func _UI_WebView($hWnd, $iParent, $sUrl, $iX = 0, $iY = 0, $iW = 0, $iH = 0)
    Local $vAuiForwardResult = __AUI_Call("int", "_UI_WebView", _
                      "hwnd", $hWnd, "int", $iParent, "wstr", $sUrl, _
                      "int", $iX, "int", $iY, "int", $iW, "int", $iH)
    Return SetError(@error, @extended, $vAuiForwardResult)
EndFunc

