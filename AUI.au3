; 參數 ....: $hWnd - Window handle returned by _UI_WindowCreate
;                  $iParent - Parent element ID; use 0 for the window root
;                  $iX - [Optional] Logical X coordinate relative to the parent container, default 0
;                  $iY - [Optional] Logical Y coordinate relative to the parent container, default 0
;                  $iW - [Optional] Logical width, default 0
;                  $iH - [Optional] Logical height, default 0
; 傳回值 .: Success - New Canvas element ID (integer, >=1)
;                  Failure - 0, and set the error code
; 作者 ........: Fanxing
; 範例 .......: Yes
; ===============================================================================================================================
Func _UI_Canvas($hWnd, $iParent, $iX = 0, $iY = 0, $iW = 0, $iH = 0)
    Local $vAuiForwardResult = __AUI_Call("int", "_UI_Canvas", "hwnd", $hWnd, "int", $iParent, "int", $iX, "int", $iY, "int", $iW, "int", $iH)
    Return SetError(@error, @extended, $vAuiForwardResult)
EndFunc

; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_CanvasClear
; 說明 ...: Clears all drawing commands and transform states, and sets the Canvas background color.
; 語法 ........: _UI_CanvasClear( $hWnd, $iId, $iColor )
; 參數 ....: $hWnd - Window handle
;                  $iId - Canvas element ID
;                  $iColor - Background color, the format is 0xAARRGGBB
; 傳回值 .: Success - 1
;                  Failure - 0, and set the error code
; 作者 ........: Fanxing
; 備註 .......: Successful network images are cached for 10 minutes. The existing image remains visible during refresh, and
;                  failures use a 1–30 second backoff before retrying automatically.
; 範例 .......: Yes
; ===============================================================================================================================
Func _UI_CanvasClear($hWnd, $iId, $iColor)
    Local $vAuiForwardResult = __AUI_Call("int", "_UI_CanvasClear", "hwnd", $hWnd, "int", $iId, "uint", $iColor)
