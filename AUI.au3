;                  $iTree - Tree control ID
;                  $iNode - Stable 64-bit node ID to move
;                  $iParent - The stable ID of the new parent node; -1 indicates the root level
;                  $iPosition - Position under new parent node, starting at 0; moves to end if out of range
; 傳回值 .: Success - 1
;                  Failure - 0 (node is invalid, parent node is invalid or movement will form a cycle)
; 作者 ........: Fanxing
; 相關函式 .......: _UI_TreeOnReorder, _UI_TreeGetParent
; 範例 .......: No
; ===============================================================================================================================
Func _UI_TreeMove($hWnd, $iTree, $iNode, $iParent, $iPosition)
	Local $vAuiForwardResult = __AUI_Call("int", "_UI_TreeMove", "hwnd", $hWnd, "int", $iTree, _
