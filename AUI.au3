; 參數 ....: $hWnd - Window handle returned by _UI_WindowCreate
;                  $iId - Target element ID
;                  $iWhich - Collapse state or handle target: 0 for expanded or hidden, 1 for first panel, 2 for second panel
; 傳回值 .: Success - 1
;                  Failure - 0
; 作者 ........: Fanxing
; 範例 .......: No
; ===============================================================================================================================
Func _UI_SplitSetCollapsed($hWnd, $iId, $iWhich)
	Local $vAuiForwardResult = __AUI_Call("int", "_UI_SplitSetCollapsed", "hwnd", $hWnd, "int", $iId, "int", $iWhich)
	Return SetError(@error, @extended, $vAuiForwardResult)
EndFunc

