Func __AUI_EnsureDll()
    If $g_pAuiModule Then Return SetError(0, 0, $g_pAuiModule)

    __AUI_SetProcessDpiAware()

    Local $pModule = __AUI_MemoryLoadEmbedded()
    If @error Or Not $pModule Then
        $g_iAuiLoadError = $AUI_UDF_ERR_EMBEDDED_DLL
        ConsoleWrite("[AUI] Failed to load the embedded runtime: " & __AUI_MemoryGetErrorText() & @CRLF)
        Return SetError($g_iAuiLoadError, __AUI_MemoryGetError(), 0)
    EndIf
    $g_pAuiModule = $pModule
    $g_iAuiLoadError = 0
    Return SetError(0, 0, $g_pAuiModule)
EndFunc

Func __AUI_SetProcessDpiAware()
    Local $a
    $a = DllCall("user32.dll", "bool", "SetProcessDpiAwarenessContext", "handle", -4)
    If Not @error And IsArray($a) And $a[0] Then Return True
    $a = DllCall("user32.dll", "bool", "SetProcessDpiAwarenessContext", "handle", -3)
    If Not @error And IsArray($a) And $a[0] Then Return True
    $a = DllCall("shcore.dll", "long", "SetProcessDpiAwareness", "int", 2)
    If Not @error And IsArray($a) And $a[0] = 0 Then Return True
    $a = DllCall("user32.dll", "bool", "SetProcessDPIAware")
    Return Not @error And IsArray($a) And $a[0]
EndFunc

Func __AUI_InvokeDll($iArgCount, $sRetType, $sFuncName, $vP1Type = Default, $vP1 = Default, _
                                       $vP2Type = Default, $vP2 = Default, _
                                       $vP3Type = Default, $vP3 = Default, _
                                       $vP4Type = Default, $vP4 = Default, _
                                       $vP5Type = Default, $vP5 = Default, _
                                       $vP6Type = Default, $vP6 = Default, _
                                       $vP7Type = Default, $vP7 = Default, _
                                       $vP8Type = Default, $vP8 = Default, _
                                       $vP9Type = Default, $vP9 = Default, _
                                       $vP10Type = Default, $vP10 = Default, _
                                       $vP11Type = Default, $vP11 = Default, _
                                       $vP12Type = Default, $vP12 = Default)
    If __AUI_EnsureDll() = 0 Then Return SetError($g_iAuiLoadError, 0, 0)
    Local $pAddress = __AUI_MemoryGetProcAddress($sFuncName)
    If Not $pAddress Then Return SetError($AUI_UDF_ERR_EMBEDDED_DLL, 0, 0)
    Local $aResult
    Switch $iArgCount
        Case 0
            $aResult = DllCallAddress($sRetType, $pAddress)
        Case 1
            $aResult = DllCallAddress($sRetType, $pAddress, $vP1Type, $vP1)
        Case 2
            $aResult = DllCallAddress($sRetType, $pAddress, $vP1Type, $vP1, $vP2Type, $vP2)
        Case 3
            $aResult = DllCallAddress($sRetType, $pAddress, $vP1Type, $vP1, $vP2Type, $vP2, $vP3Type, $vP3)
        Case 4
            $aResult = DllCallAddress($sRetType, $pAddress, $vP1Type, $vP1, $vP2Type, $vP2, $vP3Type, $vP3, $vP4Type, $vP4)
        Case 5
            $aResult = DllCallAddress($sRetType, $pAddress, $vP1Type, $vP1, $vP2Type, $vP2, $vP3Type, $vP3, $vP4Type, $vP4, $vP5Type, $vP5)
        Case 6
            $aResult = DllCallAddress($sRetType, $pAddress, $vP1Type, $vP1, $vP2Type, $vP2, $vP3Type, $vP3, $vP4Type, $vP4, $vP5Type, $vP5, $vP6Type, $vP6)
        Case 7
            $aResult = DllCallAddress($sRetType, $pAddress, $vP1Type, $vP1, $vP2Type, $vP2, $vP3Type, $vP3, $vP4Type, $vP4, $vP5Type, $vP5, $vP6Type, $vP6, $vP7Type, $vP7)
        Case 8
            $aResult = DllCallAddress($sRetType, $pAddress, $vP1Type, $vP1, $vP2Type, $vP2, $vP3Type, $vP3, $vP4Type, $vP4, $vP5Type, $vP5, $vP6Type, $vP6, $vP7Type, $vP7, $vP8Type, $vP8)
        Case 9
            $aResult = DllCallAddress($sRetType, $pAddress, $vP1Type, $vP1, $vP2Type, $vP2, $vP3Type, $vP3, $vP4Type, $vP4, $vP5Type, $vP5, $vP6Type, $vP6, $vP7Type, $vP7, $vP8Type, $vP8, $vP9Type, $vP9)
        Case 10
            $aResult = DllCallAddress($sRetType, $pAddress, $vP1Type, $vP1, $vP2Type, $vP2, $vP3Type, $vP3, $vP4Type, $vP4, $vP5Type, $vP5, $vP6Type, $vP6, $vP7Type, $vP7, $vP8Type, $vP8, $vP9Type, $vP9, $vP10Type, $vP10)
        Case 11
            $aResult = DllCallAddress($sRetType, $pAddress, $vP1Type, $vP1, $vP2Type, $vP2, $vP3Type, $vP3, $vP4Type, $vP4, $vP5Type, $vP5, $vP6Type, $vP6, $vP7Type, $vP7, $vP8Type, $vP8, $vP9Type, $vP9, $vP10Type, $vP10, $vP11Type, $vP11)
        Case 12
            $aResult = DllCallAddress($sRetType, $pAddress, $vP1Type, $vP1, $vP2Type, $vP2, $vP3Type, $vP3, $vP4Type, $vP4, $vP5Type, $vP5, $vP6Type, $vP6, $vP7Type, $vP7, $vP8Type, $vP8, $vP9Type, $vP9, $vP10Type, $vP10, $vP11Type, $vP11, $vP12Type, $vP12)
        Case Else
            $g_iAuiUdfErrorCode = $AUI_ERR_INVALID_ARGUMENT
            Return SetError($g_iAuiUdfErrorCode, 0, 0)
    EndSwitch
    Local $iDllError = @error
    If $iDllError Then
        ConsoleWrite("[AUI] Call to " & $sFuncName & " failed; error code: " & $iDllError & @CRLF)
        Return SetError($iDllError, 0, 0)
    EndIf
    Return SetError(0, 0, $aResult)
EndFunc

Func __AUI_DllCall($sRetType, $sFuncName, $vP1Type = Default, $vP1 = Default, _
                                       $vP2Type = Default, $vP2 = Default, _
                                       $vP3Type = Default, $vP3 = Default, _
                                       $vP4Type = Default, $vP4 = Default, _
                                       $vP5Type = Default, $vP5 = Default, _
                                       $vP6Type = Default, $vP6 = Default, _
                                       $vP7Type = Default, $vP7 = Default, _
                                       $vP8Type = Default, $vP8 = Default, _
                                       $vP9Type = Default, $vP9 = Default, _
                                       $vP10Type = Default, $vP10 = Default, _
                                       $vP11Type = Default, $vP11 = Default, _
                                       $vP12Type = Default, $vP12 = Default)
    Local $iArgCount = Int((@NumParams - 2) / 2)
    Local $vAuiDllResult = __AUI_InvokeDll($iArgCount, $sRetType, $sFuncName, _
            $vP1Type, $vP1, $vP2Type, $vP2, $vP3Type, $vP3, $vP4Type, $vP4, _
            $vP5Type, $vP5, $vP6Type, $vP6, $vP7Type, $vP7, $vP8Type, $vP8, _
            $vP9Type, $vP9, $vP10Type, $vP10, $vP11Type, $vP11, $vP12Type, $vP12)
    If $sFuncName <> "_UI_GetLastError" And $sFuncName <> "_UI_IsAlive" Then
        $g_iAuiUdfErrorCode = $AUI_OK
        $g_bAuiUdfErrorOverride = False
    EndIf
    Return SetError(@error, @extended, $vAuiDllResult)
EndFunc

Func __AUI_Fail($iCode, $iExtended = 0, $vReturn = 0)
    $g_iAuiUdfErrorCode = $iCode
    Return SetError($iCode, $iExtended, $vReturn)
EndFunc

Func __AUI_Call($sRetType, $sFuncName, $vP1Type = Default, $vP1 = Default, _
                                       $vP2Type = Default, $vP2 = Default, _
                                       $vP3Type = Default, $vP3 = Default, _
                                       $vP4Type = Default, $vP4 = Default, _
                                       $vP5Type = Default, $vP5 = Default, _
                                       $vP6Type = Default, $vP6 = Default, _
                                       $vP7Type = Default, $vP7 = Default, _
                                       $vP8Type = Default, $vP8 = Default, _
                                       $vP9Type = Default, $vP9 = Default, _
                                       $vP10Type = Default, $vP10 = Default, _
                                       $vP11Type = Default, $vP11 = Default, _
                                       $vP12Type = Default, $vP12 = Default)
    Local $iArgCount = Int((@NumParams - 2) / 2)
    Local $aResult = __AUI_InvokeDll($iArgCount, $sRetType, $sFuncName, _
            $vP1Type, $vP1, $vP2Type, $vP2, $vP3Type, $vP3, $vP4Type, $vP4, _
            $vP5Type, $vP5, $vP6Type, $vP6, $vP7Type, $vP7, $vP8Type, $vP8, _
            $vP9Type, $vP9, $vP10Type, $vP10, $vP11Type, $vP11, $vP12Type, $vP12)
    Local $iDllError = @error
    If $iDllError Or Not IsArray($aResult) Then
        If $sFuncName <> "_UI_GetLastError" And $sFuncName <> "_UI_IsAlive" Then
            $g_iAuiUdfErrorCode = $AUI_OK
            $g_bAuiUdfErrorOverride = False
        EndIf
        Return SetError($iDllError, 0, 0)
    EndIf
    Local $vResult = $aResult[0]
    If $sFuncName <> "_UI_GetLastError" And $sFuncName <> "_UI_IsAlive" Then
        Local $bFail = (IsNumber($vResult) And $vResult <= 0) Or ($vResult = 0)
        If $bFail Then
            Local $aNativeError = __AUI_DllCall("int", "_UI_GetLastError")
            Local $iNativeCallError = @error
            If $iNativeCallError Or Not IsArray($aNativeError) Then
                $g_iAuiUdfErrorCode = $AUI_OK
                $g_bAuiUdfErrorOverride = False
                Return SetError($iNativeCallError, 0, $vResult)
            EndIf
            If $aNativeError[0] <> $AUI_OK Then
                $g_iAuiUdfErrorCode = $AUI_OK
                $g_bAuiUdfErrorOverride = False
                Return SetError($aNativeError[0], 0, $vResult)
            EndIf
        EndIf
        $g_iAuiUdfErrorCode = $AUI_OK
        $g_bAuiUdfErrorOverride = False
    EndIf
    Return SetError(0, 0, $vResult)
EndFunc

Func __AUI_ReadNativeLastError()
    Local $aError = __AUI_DllCall("int", "_UI_GetLastError")
    Local $iDllError = @error
    If $iDllError Or Not IsArray($aError) Then Return SetError($iDllError, 0, $AUI_ERR_IO)
    Return SetError(0, 0, $aError[0])
EndFunc

Func __AUI_IsIntegerVariant($vValue)
    Local $sType = VarGetType($vValue)
    Return $sType = "Int32" Or $sType = "Int64"
EndFunc

Func __AUI_ReadIndexedText($sFuncName, $hWnd, $iId, $iIndex, $iMinCapacity = 0)
    If __AUI_EnsureDll() = 0 Then Return SetError($g_iAuiLoadError, 0, "")
    Local $aNeed = __AUI_DllCall("int", $sFuncName, _
            "hwnd", $hWnd, "int", $iId, "int", $iIndex, "ptr", 0, "int", 0)
    Local $iDllError = @error
    If $iDllError Or Not IsArray($aNeed) Then Return SetError($iDllError, 0, "")
    If $aNeed[0] < 0 Then Return SetError(__AUI_ReadNativeLastError(), 0, "")
    If $aNeed[0] = 0 Then
        Local $iNativeError = __AUI_ReadNativeLastError()
        Local $iNativeDllError = @error
        If $iNativeDllError Then Return SetError($iNativeDllError, 0, "")
        If $iNativeError <> $AUI_OK Then Return SetError($iNativeError, 0, "")
    EndIf
    Local $iCap = $aNeed[0] + 1
    If $iMinCapacity > $iCap Then $iCap = $iMinCapacity
    If $iCap < 1 Then $iCap = 1
    If $iCap > $__AUI_READ_TEXT_MAX_CHARS Then
        $g_iAuiUdfErrorCode = $AUI_ERR_LIMIT_EXCEEDED
        Return SetError($g_iAuiUdfErrorCode, 0, "")
    EndIf
    Local $tBuf = DllStructCreate("wchar[" & $iCap & "]")
    If @error Or Not IsDllStruct($tBuf) Then
        $g_iAuiUdfErrorCode = $AUI_ERR_LIMIT_EXCEEDED
        Return SetError($g_iAuiUdfErrorCode, 0, "")
    EndIf
    Local $aRead = __AUI_DllCall("int", $sFuncName, _
            "hwnd", $hWnd, "int", $iId, "int", $iIndex, _
            "ptr", DllStructGetPtr($tBuf), "int", $iCap)
    $iDllError = @error
    If $iDllError Or Not IsArray($aRead) Then Return SetError($iDllError, 0, "")
    If $aRead[0] < 0 Then Return SetError(__AUI_ReadNativeLastError(), 0, "")
    If $aRead[0] >= $iCap Then
        $g_iAuiUdfErrorCode = $AUI_ERR_BUFFER_TOO_SMALL
        Return SetError($g_iAuiUdfErrorCode, $aRead[0] + 1, "")
    EndIf
    If $aRead[0] = 0 Then
        Local $iReadError = __AUI_ReadNativeLastError()
        Local $iReadDllError = @error
        If $iReadDllError Then Return SetError($iReadDllError, 0, "")
        If $iReadError <> $AUI_OK Then Return SetError($iReadError, 0, "")
    EndIf
    Return SetError(0, 0, DllStructGetData($tBuf, 1))
EndFunc

Func __AUI_ReadElementText($sFuncName, $hWnd, $iId, $iMinCapacity = 0)
    If __AUI_EnsureDll() = 0 Then Return SetError($g_iAuiLoadError, 0, "")
