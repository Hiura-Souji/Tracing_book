; ────────────────────────────────────────────────────────────────────────────
;  Archive Creation and Extraction
; ────────────────────────────────────────────────────────────────────────────
Func __AUI_ArchiveSourcesJson($vSources)
    If IsString($vSources) Then
        If $vSources = "" Then
            $g_iAuiUdfErrorCode = $AUI_ERR_INVALID_ARGUMENT
            Return SetError($AUI_ERR_INVALID_ARGUMENT, 0, "")
        EndIf
        Local $aSingleSource[1] = [$vSources]
        Local $sSingleJson = _UI_JsonFromAutoIt($aSingleSource)
        Return SetError(@error, @extended, $sSingleJson)
    EndIf
    If Not IsArray($vSources) Then
        $g_iAuiUdfErrorCode = $AUI_ERR_INVALID_ARGUMENT
        Return SetError($AUI_ERR_INVALID_ARGUMENT, 0, "")
    EndIf

    Local $iDimensions = UBound($vSources, 0)
    If @error Then
        $g_iAuiUdfErrorCode = $AUI_ERR_INVALID_ARGUMENT
        Return SetError($AUI_ERR_INVALID_ARGUMENT, 0, "")
    EndIf
    Local $iRows = UBound($vSources, 1)
    If @error Or $iRows < 1 Or $iRows > $AUI_ARCHIVE_MAX_SOURCE_ROOTS Then
        $g_iAuiUdfErrorCode = $AUI_ERR_OUT_OF_RANGE
        Return SetError($AUI_ERR_OUT_OF_RANGE, 0, "")
    EndIf

    If $iDimensions = 1 Then
        For $i = 0 To $iRows - 1
            If Not IsString($vSources[$i]) Or $vSources[$i] = "" Then
                $g_iAuiUdfErrorCode = $AUI_ERR_INVALID_ARGUMENT
                Return SetError($AUI_ERR_INVALID_ARGUMENT, $i, "")
            EndIf
        Next
        Local $sListJson = _UI_JsonFromAutoIt($vSources)
        Return SetError(@error, @extended, $sListJson)
    EndIf

    If $iDimensions <> 2 Or UBound($vSources, 2) <> 2 Then
        $g_iAuiUdfErrorCode = $AUI_ERR_INVALID_ARGUMENT
        Return SetError($AUI_ERR_INVALID_ARGUMENT, 0, "")
    EndIf
    Local $aMappedSources[$iRows]
    For $i = 0 To $iRows - 1
        If Not IsString($vSources[$i][0]) Or $vSources[$i][0] = "" Or _
                Not IsString($vSources[$i][1]) Then
            $g_iAuiUdfErrorCode = $AUI_ERR_INVALID_ARGUMENT
            Return SetError($AUI_ERR_INVALID_ARGUMENT, $i, "")
        EndIf
        Local $mSource[]
        $mSource["source"] = $vSources[$i][0]
        If $vSources[$i][1] <> "" Then $mSource["name"] = $vSources[$i][1]
        $aMappedSources[$i] = $mSource
    Next
    Local $sMappedJson = _UI_JsonFromAutoIt($aMappedSources)
    Return SetError(@error, @extended, $sMappedJson)
EndFunc

Func __AUI_ArchiveRegisterTask($iTaskId, $hWnd, $sOnDone, $sOnProgress)
    Local $iError
    If $iTaskId <= 0 Then Return SetError(@error, @extended, 0)
    If __AUI_CbSet($__AUI_CB_ASYNC_DONE, $iTaskId, $sOnDone) = 0 Then
        $iError = @error
        __AUI_AsyncAbortRegistration($iTaskId)
        Return SetError($iError, 0, 0)
    EndIf
    If $sOnProgress <> "" And __AUI_CbSet($__AUI_CB_ASYNC_PROGRESS, $iTaskId, $sOnProgress) = 0 Then
        $iError = @error
        __AUI_AsyncAbortRegistration($iTaskId)
        Return SetError($iError, 0, 0)
    EndIf
    If __AUI_CbSet($__AUI_CB_ASYNC_OWNER, $iTaskId, $hWnd, 0, False) = 0 Then
        $iError = @error
        __AUI_AsyncAbortRegistration($iTaskId)
        Return SetError($iError, 0, 0)
    EndIf
    Return SetError(0, 0, $iTaskId)
EndFunc

Func __AUI_ArchiveMemoryBuffer($bArchive, ByRef $tArchive, ByRef $iBytes)
    If Not IsBinary($bArchive) Then
        $g_iAuiUdfErrorCode = $AUI_ERR_INVALID_ARGUMENT
        Return SetError($AUI_ERR_INVALID_ARGUMENT, 0, 0)
    EndIf
    $iBytes = BinaryLen($bArchive)
    If $iBytes < 1 Then
        $g_iAuiUdfErrorCode = $AUI_ERR_INVALID_ARGUMENT
        Return SetError($AUI_ERR_INVALID_ARGUMENT, 0, 0)
    EndIf
    If $iBytes > $AUI_ARCHIVE_MAX_MEMORY_INPUT_BYTES Then
        $g_iAuiUdfErrorCode = $AUI_ERR_LIMIT_EXCEEDED
        Return SetError($AUI_ERR_LIMIT_EXCEEDED, $iBytes, 0)
    EndIf
    $tArchive = DllStructCreate("byte[" & $iBytes & "]")
    If @error Or Not IsDllStruct($tArchive) Then
        $g_iAuiUdfErrorCode = $AUI_ERR_LIMIT_EXCEEDED
        Return SetError($AUI_ERR_LIMIT_EXCEEDED, $iBytes, 0)
    EndIf
    DllStructSetData($tArchive, 1, $bArchive)
    If @error Then
        $g_iAuiUdfErrorCode = $AUI_ERR_IO
        Return SetError($AUI_ERR_IO, 0, 0)
    EndIf
    Local $pArchive = DllStructGetPtr($tArchive)
    If @error Or $pArchive = 0 Then
        $g_iAuiUdfErrorCode = $AUI_ERR_IO
        Return SetError($AUI_ERR_IO, 0, 0)
    EndIf
    Return SetError(0, 0, $pArchive)
EndFunc

; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_ArchiveExtractAsync
; 說明 ...: Extracts an archive asynchronously on an AUI worker thread without blocking the AutoIt UI thread.
; 語法 ........: _UI_ArchiveExtractAsync( $hWnd, $sArchivePath, $sDestinationPath, $sOnDone [, $sOnProgress = "" [, $sPassword
;                  = "" [, $iOverwrite = $AUI_ARCHIVE_OVERWRITE_FAIL [, $iMaxEntries = 0 [, $iMaxFileBytes = 0 [,
;                  $iMaxTotalBytes = 0]]]]]] )
; 參數 ....: $hWnd - Owner AUI window handle
;                  $sArchivePath - Existing ZIP, 7z, RAR4, RAR5, TAR-family, or CAB archive
;                  $sDestinationPath - Destination directory
;                  $sOnDone - Completion callback name: Func($iTaskId, $iStatus)
;                  $sOnProgress - [Optional] Progress callback name: Func($iTaskId, $iDone, $iTotal)
;                  $sPassword - [Optional] ZIP password; encrypted 7z and RAR archives are unsupported
;                  $iOverwrite - [Optional] FAIL, SKIP, or REPLACE overwrite policy
;                  $iMaxEntries - [Optional] Entry limit; 0 uses the 200,000-entry safety ceiling
;                  $iMaxFileBytes - [Optional] Per-file expanded-size limit; 0 uses 64 GiB
;                  $iMaxTotalBytes - [Optional] Total expanded-size limit; 0 uses 1 TiB
; 傳回值 .: Success - Asynchronous task ID
;                  Failure - 0, and set @error
; 作者 ........: Fanxing
; 備註 .......: Scanning and extraction are cancellable. Once COMMITTING begins, AUI completes the transactional commit
;                  instead of stopping halfway. Read the current path, structured progress, and archive error details while the
;                  task is still alive; they are guaranteed to remain available during the completion callback.
; 相關函式 .......: _UI_ArchiveGetProgress, _UI_AsyncCancel, _UI_AsyncResult
; 範例 .......: Yes
; ===============================================================================================================================
Func _UI_ArchiveExtractAsync($hWnd, $sArchivePath, $sDestinationPath, $sOnDone, $sOnProgress = "", $sPassword = "", _
        $iOverwrite = $AUI_ARCHIVE_OVERWRITE_FAIL, $iMaxEntries = 0, $iMaxFileBytes = 0, $iMaxTotalBytes = 0)
    If $sOnDone = "" Or __AUI_ValidateOptionalCallback($sOnDone) = 0 Or _
            __AUI_ValidateOptionalCallback($sOnProgress) = 0 Then Return SetError($AUI_UDF_ERR_INVALID_CALLBACK, 0, 0)
    If $g_pAuiDispAsyncDone = 0 Then $g_pAuiDispAsyncDone = __AUI_RegisterCallback("__AUI_DispAsyncDone", "int;int")
    If $g_pAuiDispAsyncDone = 0 Then Return SetError(@error, 0, 0)
    Local $pProgress = 0
    If $sOnProgress <> "" Then
        If $g_pAuiDispAsyncProgress = 0 Then $g_pAuiDispAsyncProgress = __AUI_RegisterCallback("__AUI_DispAsyncProgress", "int;int64;int64")
        If $g_pAuiDispAsyncProgress = 0 Then Return SetError(@error, 0, 0)
        $pProgress = $g_pAuiDispAsyncProgress
    EndIf
    Local $iTaskId = __AUI_Call("int", "_UI_ArchiveExtractAsync", _
            "hwnd", $hWnd, "wstr", $sArchivePath, "wstr", $sDestinationPath, "wstr", $sPassword, _
            "int", $iOverwrite, "uint64", $iMaxEntries, "uint64", $iMaxFileBytes, "uint64", $iMaxTotalBytes, _
            "ptr", $g_pAuiDispAsyncDone, "ptr", $pProgress)
    If @error Or $iTaskId <= 0 Then Return SetError(@error, @extended, 0)
    Local $iRegistered = __AUI_ArchiveRegisterTask($iTaskId, $hWnd, $sOnDone, $sOnProgress)
    Return SetError(@error, @extended, $iRegistered)
EndFunc

; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_ArchiveExtractMemoryAsync
; 說明 ...: Extract an archive asynchronously from AutoIt Binary data without writing the compressed input to disk.
; 語法 ........: _UI_ArchiveExtractMemoryAsync( $hWnd, $bArchive, $sDestinationPath, $sOnDone [, $sOnProgress = "" [,
;                  $sPassword = "" [, $iOverwrite = $AUI_ARCHIVE_OVERWRITE_FAIL [, $iMaxEntries = 0 [, $iMaxFileBytes = 0 [,
;                  $iMaxTotalBytes = 0]]]]]] )
; 參數 ....: $hWnd - Owner AUI window handle
;                  $bArchive - A non-empty AutoIt Binary value containing the complete archive, up to 128 MiB
;                  $sDestinationPath - Destination directory
;                  $sOnDone - Completion callback name: Func($iTaskId, $iStatus)
;                  $sOnProgress - [Optional] Progress callback name: Func($iTaskId, $iDone, $iTotal)
;                  $sPassword - [Optional] ZIP password; encrypted 7z and RAR archives are unsupported
;                  $iOverwrite - [Optional] FAIL, SKIP, or REPLACE overwrite policy
;                  $iMaxEntries - [Optional] Entry limit; 0 uses the 200,000-entry safety ceiling
;                  $iMaxFileBytes - [Optional] Per-file expanded-size limit; 0 uses 64 GiB
;                  $iMaxTotalBytes - [Optional] Total expanded-size limit; 0 uses 1 TiB
; 傳回值 .: Success - Asynchronous task ID
;                  Failure - 0, and set @error
; 作者 ........: Fanxing
; 備註 .......: AUI copies the Binary value into task-owned memory before returning. Native copies for active memory-archive
;                  tasks share a 256 MiB process budget. The compressed input is never written to disk; output files use the
;                  same-volume staging, security checks, and transactional commit as _UI_ArchiveExtractAsync. The caller may
;                  modify or release the original Binary immediately after the call returns.
; 相關函式 .......: _UI_ArchiveListMemoryAsync, _UI_ArchiveGetProgress, _UI_AsyncCancel
; 範例 .......: Yes
; ===============================================================================================================================
Func _UI_ArchiveExtractMemoryAsync($hWnd, $bArchive, $sDestinationPath, $sOnDone, $sOnProgress = "", $sPassword = "", _
        $iOverwrite = $AUI_ARCHIVE_OVERWRITE_FAIL, $iMaxEntries = 0, $iMaxFileBytes = 0, $iMaxTotalBytes = 0)
    If $sOnDone = "" Or __AUI_ValidateOptionalCallback($sOnDone) = 0 Or _
            __AUI_ValidateOptionalCallback($sOnProgress) = 0 Then Return SetError($AUI_UDF_ERR_INVALID_CALLBACK, 0, 0)
    Local $tArchive, $iArchiveBytes = 0
    Local $pArchive = __AUI_ArchiveMemoryBuffer($bArchive, $tArchive, $iArchiveBytes)
    If @error Or $pArchive = 0 Then Return SetError(@error, @extended, 0)
    If $g_pAuiDispAsyncDone = 0 Then $g_pAuiDispAsyncDone = __AUI_RegisterCallback("__AUI_DispAsyncDone", "int;int")
    If $g_pAuiDispAsyncDone = 0 Then Return SetError(@error, 0, 0)
    Local $pProgress = 0
    If $sOnProgress <> "" Then
        If $g_pAuiDispAsyncProgress = 0 Then $g_pAuiDispAsyncProgress = __AUI_RegisterCallback("__AUI_DispAsyncProgress", "int;int64;int64")
        If $g_pAuiDispAsyncProgress = 0 Then Return SetError(@error, 0, 0)
        $pProgress = $g_pAuiDispAsyncProgress
    EndIf
    Local $iTaskId = __AUI_Call("int", "_UI_ArchiveExtractMemoryAsync", _
            "hwnd", $hWnd, "ptr", $pArchive, "uint64", $iArchiveBytes, "wstr", $sDestinationPath, "wstr", $sPassword, _
            "int", $iOverwrite, "uint64", $iMaxEntries, "uint64", $iMaxFileBytes, "uint64", $iMaxTotalBytes, _
            "ptr", $g_pAuiDispAsyncDone, "ptr", $pProgress)
    If @error Or $iTaskId <= 0 Then Return SetError(@error, @extended, 0)
    Local $iRegistered = __AUI_ArchiveRegisterTask($iTaskId, $hWnd, $sOnDone, $sOnProgress)
    Return SetError(@error, @extended, $iRegistered)
EndFunc

; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_ArchiveCreateAsync
; 說明 ...: Creates a ZIP, 7z, TAR, TAR.GZ, or TAR.XZ archive asynchronously on an AUI worker thread.
; 語法 ........: _UI_ArchiveCreateAsync( $hWnd, $sOutputPath, $iFormat, $vSources, $sOnDone [, $sOnProgress = "" [, $sPassword
;                  = "" [, $iOverwrite = $AUI_ARCHIVE_OVERWRITE_FAIL [, $iCompressionLevel = 6 [, $iMaxEntries = 0 [,
;                  $iMaxTotalBytes = 0]]]]]] )
; 參數 ....: $hWnd - Owner AUI window handle
;                  $sOutputPath - Output archive path
;                  $iFormat - An $AUI_ARCHIVE_FORMAT_* creation format
;                  $vSources - One path, a one-dimensional path array, or a two-column [source path, archive name] array
;                  $sOnDone - Completion callback name: Func($iTaskId, $iStatus)
;                  $sOnProgress - [Optional] Progress callback name: Func($iTaskId, $iDone, $iTotal)
;                  $sPassword - [optional] ZIP password; a non-empty value creates a WinZip AES-256 archive
;                  $iOverwrite - [Optional] FAIL or REPLACE overwrite policy
;                  $iCompressionLevel - [Optional] Compression level from 0 through 9
;                  $iMaxEntries - [Optional] Entry limit; 0 uses the 200,000-entry safety ceiling
;                  $iMaxTotalBytes - [Optional] Source-data limit; 0 uses 1 TiB
; 傳回值 .: Success - Asynchronous task ID
;                  Failure - 0, and set @error
; 作者 ........: Fanxing
; 備註 .......: AUI exclusively creates a temporary file in the output directory, writes and flushes it completely, and
;                  commits it with one final rename. Cancellation is accepted before COMMITTING; once commit begins,
;                  cancellation is no longer accepted. Source directories are scanned recursively, and reparse points and unsafe
;                  names are rejected. Creation passwords apply only to ZIP; passing a non-empty password for another creation
;                  format fails and sets @error.
; 相關函式 .......: _UI_ArchiveGetProgress, _UI_AsyncCancel, _UI_AsyncResult
; 範例 .......: Yes
; ===============================================================================================================================
Func _UI_ArchiveCreateAsync($hWnd, $sOutputPath, $iFormat, $vSources, $sOnDone, $sOnProgress = "", _
        $sPassword = "", $iOverwrite = $AUI_ARCHIVE_OVERWRITE_FAIL, $iCompressionLevel = 6, _
        $iMaxEntries = 0, $iMaxTotalBytes = 0)
    If $sOnDone = "" Or __AUI_ValidateOptionalCallback($sOnDone) = 0 Or _
            __AUI_ValidateOptionalCallback($sOnProgress) = 0 Then Return SetError($AUI_UDF_ERR_INVALID_CALLBACK, 0, 0)
    Local $sSourcesJson = __AUI_ArchiveSourcesJson($vSources)
    If @error Then Return SetError(@error, @extended, 0)
    If $g_pAuiDispAsyncDone = 0 Then $g_pAuiDispAsyncDone = __AUI_RegisterCallback("__AUI_DispAsyncDone", "int;int")
    If $g_pAuiDispAsyncDone = 0 Then Return SetError(@error, 0, 0)
    Local $pProgress = 0
    If $sOnProgress <> "" Then
        If $g_pAuiDispAsyncProgress = 0 Then $g_pAuiDispAsyncProgress = __AUI_RegisterCallback("__AUI_DispAsyncProgress", "int;int64;int64")
        If $g_pAuiDispAsyncProgress = 0 Then Return SetError(@error, 0, 0)
        $pProgress = $g_pAuiDispAsyncProgress
    EndIf
    Local $iTaskId = __AUI_Call("int", "_UI_ArchiveCreateAsync", _
            "hwnd", $hWnd, "wstr", $sOutputPath, "int", $iFormat, "wstr", $sSourcesJson, _
            "wstr", $sPassword, "int", $iOverwrite, "int", $iCompressionLevel, _
            "uint64", $iMaxEntries, "uint64", $iMaxTotalBytes, _
            "ptr", $g_pAuiDispAsyncDone, "ptr", $pProgress)
    If @error Or $iTaskId <= 0 Then Return SetError(@error, @extended, 0)
    Local $iRegistered = __AUI_ArchiveRegisterTask($iTaskId, $hWnd, $sOnDone, $sOnProgress)
    Return SetError(@error, @extended, $iRegistered)
EndFunc

; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_ArchiveListAsync
; 說明 ...: Reads an archive directory asynchronously on an AUI worker thread without extracting files.
; 語法 ........: _UI_ArchiveListAsync( $hWnd, $sArchivePath, $sOnDone [, $sOnProgress = "" [, $sPassword = "" [, $iMaxEntries
;                  = 0 [, $iMaxTotalBytes = 0]]]] )
; 參數 ....: $hWnd - Owner AUI window handle
;                  $sArchivePath - Existing ZIP, 7z, RAR4, RAR5, TAR-family, or CAB archive
;                  $sOnDone - Completion callback name: Func($iTaskId, $iStatus)
;                  $sOnProgress - [Optional] Progress callback name: Func($iTaskId, $iDone, $iTotal)
;                  $sPassword - [optional] password used when the archive directory headers themselves require one
;                  $iMaxEntries - [optional] entry limit; 0 uses the 200,000-entry safety ceiling
;                  $iMaxTotalBytes - [optional] declared uncompressed total limit; 0 uses 1 TiB
; 傳回值 .: Success - Asynchronous task ID
;                  Failure - 0, and set @error
; 作者 ........: Fanxing
; 備註 .......: Results are stored in the native task object and must be read entry by entry through _UI_ArchiveListGetCount
;                  and _UI_ArchiveListGetEntry before the completion callback returns. Listing does not read file contents and
;                  therefore does not verify a ZIP content password; paths, links, entry types, and safety ceilings are still
;                  validated under the extraction rules. Read large archives on demand or present them through a paged model
;                  instead of writing every entry to the UI at once.
; 相關函式 .......: _UI_ArchiveListGetCount, _UI_ArchiveListGetEntry, _UI_ArchiveGetProgress
; 範例 .......: Yes
; ===============================================================================================================================
Func _UI_ArchiveListAsync($hWnd, $sArchivePath, $sOnDone, $sOnProgress = "", $sPassword = "", _
        $iMaxEntries = 0, $iMaxTotalBytes = 0)
    If $sOnDone = "" Or __AUI_ValidateOptionalCallback($sOnDone) = 0 Or _
            __AUI_ValidateOptionalCallback($sOnProgress) = 0 Then Return SetError($AUI_UDF_ERR_INVALID_CALLBACK, 0, 0)
    If $g_pAuiDispAsyncDone = 0 Then $g_pAuiDispAsyncDone = __AUI_RegisterCallback("__AUI_DispAsyncDone", "int;int")
    If $g_pAuiDispAsyncDone = 0 Then Return SetError(@error, 0, 0)
    Local $pProgress = 0
    If $sOnProgress <> "" Then
        If $g_pAuiDispAsyncProgress = 0 Then $g_pAuiDispAsyncProgress = __AUI_RegisterCallback("__AUI_DispAsyncProgress", "int;int64;int64")
        If $g_pAuiDispAsyncProgress = 0 Then Return SetError(@error, 0, 0)
        $pProgress = $g_pAuiDispAsyncProgress
    EndIf
    Local $iTaskId = __AUI_Call("int", "_UI_ArchiveListAsync", _
            "hwnd", $hWnd, "wstr", $sArchivePath, "wstr", $sPassword, _
            "uint64", $iMaxEntries, "uint64", $iMaxTotalBytes, _
            "ptr", $g_pAuiDispAsyncDone, "ptr", $pProgress)
    If @error Or $iTaskId <= 0 Then Return SetError(@error, @extended, 0)
    Local $iRegistered = __AUI_ArchiveRegisterTask($iTaskId, $hWnd, $sOnDone, $sOnProgress)
    Return SetError(@error, @extended, $iRegistered)
EndFunc

; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_ArchiveListMemoryAsync
; 說明 ...: Retrieves an archive directory asynchronously from AutoIt Binary data without creating a temporary archive
;                  file.
; 語法 ........: _UI_ArchiveListMemoryAsync( $hWnd, $bArchive, $sOnDone [, $sOnProgress = "" [, $sPassword = "" [,
;                  $iMaxEntries = 0 [, $iMaxTotalBytes = 0]]]] )
; 參數 ....: $hWnd - Owner AUI window handle
;                  $bArchive - A non-empty AutoIt Binary value containing the complete archive, up to 128 MiB
;                  $sOnDone - Completion callback name: Func($iTaskId, $iStatus)
;                  $sOnProgress - [Optional] Progress callback name: Func($iTaskId, $iDone, $iTotal)
;                  $sPassword - [optional] password used when the archive directory headers themselves require one
;                  $iMaxEntries - [optional] entry limit; 0 uses the 200,000-entry safety ceiling
;                  $iMaxTotalBytes - [optional] declared uncompressed total limit; 0 uses 1 TiB
; 傳回值 .: Success - Asynchronous task ID
;                  Failure - 0, and set @error
; 作者 ........: Fanxing
; 備註 .......: AUI copies the Binary value before returning and releases the native copy after scanning. Listing produces no
;                  filesystem output. Result availability and lifetime match _UI_ArchiveListAsync: read entries through
;                  _UI_ArchiveListGetCount and _UI_ArchiveListGetEntry before the completion callback returns.
; 相關函式 .......: _UI_ArchiveExtractMemoryAsync, _UI_ArchiveListGetCount, _UI_ArchiveListGetEntry
; 範例 .......: Yes
; ===============================================================================================================================
Func _UI_ArchiveListMemoryAsync($hWnd, $bArchive, $sOnDone, $sOnProgress = "", $sPassword = "", _
        $iMaxEntries = 0, $iMaxTotalBytes = 0)
    If $sOnDone = "" Or __AUI_ValidateOptionalCallback($sOnDone) = 0 Or _
            __AUI_ValidateOptionalCallback($sOnProgress) = 0 Then Return SetError($AUI_UDF_ERR_INVALID_CALLBACK, 0, 0)
    Local $tArchive, $iArchiveBytes = 0
    Local $pArchive = __AUI_ArchiveMemoryBuffer($bArchive, $tArchive, $iArchiveBytes)
    If @error Or $pArchive = 0 Then Return SetError(@error, @extended, 0)
    If $g_pAuiDispAsyncDone = 0 Then $g_pAuiDispAsyncDone = __AUI_RegisterCallback("__AUI_DispAsyncDone", "int;int")
    If $g_pAuiDispAsyncDone = 0 Then Return SetError(@error, 0, 0)
    Local $pProgress = 0
    If $sOnProgress <> "" Then
        If $g_pAuiDispAsyncProgress = 0 Then $g_pAuiDispAsyncProgress = __AUI_RegisterCallback("__AUI_DispAsyncProgress", "int;int64;int64")
        If $g_pAuiDispAsyncProgress = 0 Then Return SetError(@error, 0, 0)
        $pProgress = $g_pAuiDispAsyncProgress
    EndIf
    Local $iTaskId = __AUI_Call("int", "_UI_ArchiveListMemoryAsync", _
            "hwnd", $hWnd, "ptr", $pArchive, "uint64", $iArchiveBytes, "wstr", $sPassword, _
            "uint64", $iMaxEntries, "uint64", $iMaxTotalBytes, _
            "ptr", $g_pAuiDispAsyncDone, "ptr", $pProgress)
    If @error Or $iTaskId <= 0 Then Return SetError(@error, @extended, 0)
    Local $iRegistered = __AUI_ArchiveRegisterTask($iTaskId, $hWnd, $sOnDone, $sOnProgress)
    Return SetError(@error, @extended, $iRegistered)
EndFunc

; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_ArchiveGetProgress
; 說明 ...: Returns structured progress for a live archive task.
; 語法 ........: _UI_ArchiveGetProgress( $iTaskId )
; 參數 ....: $iTaskId - Archive task ID
; 傳回值 .: Success - A five-item array: [phase, completed entries, total entries, completed bytes, total bytes]
;                  Failure - 0, and set @error
; 作者 ........: Fanxing
; 備註 .......: Totals may remain zero until scanning completes. _UI_AsyncProgress reports normalized progress from 0 through
;                  100. The phase transitions to FINISHED after success, failure, or cancellation.
; 相關函式 .......: _UI_ArchiveGetCurrentPath, _UI_AsyncProgress
; 範例 .......: Yes
; ===============================================================================================================================
Func _UI_ArchiveGetProgress($iTaskId)
    Local $tProgress = DllStructCreate("int phase;int64 entriesDone;int64 entriesTotal;int64 bytesDone;int64 bytesTotal")
    If @error Or Not IsDllStruct($tProgress) Then
        $g_iAuiUdfErrorCode = $AUI_ERR_LIMIT_EXCEEDED
        Return SetError($AUI_ERR_LIMIT_EXCEEDED, 0, 0)
    EndIf
    Local $iResult = __AUI_Call("int", "_UI_ArchiveGetProgress", "int", $iTaskId, _
            "ptr", DllStructGetPtr($tProgress, "phase"), "ptr", DllStructGetPtr($tProgress, "entriesDone"), _
            "ptr", DllStructGetPtr($tProgress, "entriesTotal"), "ptr", DllStructGetPtr($tProgress, "bytesDone"), _
            "ptr", DllStructGetPtr($tProgress, "bytesTotal"))
    If @error Or $iResult = 0 Then Return SetError(@error, @extended, 0)
    Local $aProgress[5] = [DllStructGetData($tProgress, "phase"), DllStructGetData($tProgress, "entriesDone"), _
            DllStructGetData($tProgress, "entriesTotal"), DllStructGetData($tProgress, "bytesDone"), _
            DllStructGetData($tProgress, "bytesTotal")]
    Return SetError(0, 0, $aProgress)
EndFunc

; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_ArchiveGetCurrentPath
; 說明 ...: Returns the archive-relative path currently being scanned, processed, or committed.
; 語法 ........: _UI_ArchiveGetCurrentPath( $iTaskId )
