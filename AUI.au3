; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_SwitchPanel
; 說明 ...: Shows the panel at the specified array index and hides the remaining panels.
; 語法 ........: _UI_SwitchPanel( $hWnd, Const ByRef $aPanelIds, $iSelected )
; 參數 ....: $hWnd - Window handle returned by _UI_WindowCreate
;                  $aPanelIds - 1D array of panel element IDs (each panel is typically an _UI_Column / _UI_Panel container)
;                  $iSelected - Index in the array (0-based) of the panel to be shown; remaining panels are automatically hidden
; 傳回值 .: Success - 1
;                  Failure - 0
; 作者 ........: Fanxing
; 備註 .......: Use this helper for Sidebar-based or custom multi-page navigation. It validates every panel first and leaves
;                  all panels unchanged when any panel is invalid. Tabs manages its own pages; use _UI_TabsGetPage to retrieve
;                  them.
; 相關函式 .......: _UI_SetVisible, _UI_OnValue, _UI_Sidebar, _UI_TabsGetPage
; 範例 .......: Yes
; ===============================================================================================================================
Func _UI_SwitchPanel($hWnd, Const ByRef $aPanelIds, $iSelected)
    If Not IsArray($aPanelIds) Or UBound($aPanelIds, 0) <> 1 Then
        $g_iAuiUdfErrorCode = $AUI_ERR_INVALID_ARGUMENT
        Return SetError($g_iAuiUdfErrorCode, 0, 0)
    EndIf
    Local $iCount = UBound($aPanelIds)
    If Not __AUI_IsIntegerVariant($iSelected) Or $iSelected < 0 Or $iSelected >= $iCount Then
        $g_iAuiUdfErrorCode = $AUI_ERR_OUT_OF_RANGE
        Return SetError($g_iAuiUdfErrorCode, 0, 0)
    EndIf
    Local $aVisible[$iCount]
    For $i = 0 To $iCount - 1
        $aVisible[$i] = _UI_IsVisible($hWnd, $aPanelIds[$i])
        Local $iValidateError = @error
        If $iValidateError Then Return SetError($iValidateError, $i, 0)
    Next
    For $i = 0 To $iCount - 1
        If _UI_SetVisible($hWnd, $aPanelIds[$i], ($i = $iSelected)) = 0 Then
            Local $iSetError = @error
            For $iRollback = $i - 1 To 0 Step -1
                _UI_SetVisible($hWnd, $aPanelIds[$iRollback], $aVisible[$iRollback])
            Next
            Return SetError($iSetError ? $iSetError : $AUI_ERR_IO, $i, 0)
        EndIf
    Next
    Return SetError(0, 0, 1)
EndFunc

