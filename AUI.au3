    If $f <> "" Then __AUI_SafeCall($f, $iFrom, $iTo, 0, 2)
EndFunc

Func __AUI_CheckProxy($hWnd, $iId, $iRow, $iChecked)
    Local $f = __AUI_CbGet($__AUI_CB_DATAVIEW_CHECK, $iId, $hWnd)
    If $f <> "" Then __AUI_SafeCall($f, $iRow, ($iChecked <> 0), 0, 2)
