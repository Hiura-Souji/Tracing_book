EndFunc

; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_ColorPickerSetPalette
; 說明 ...: Replaces the current color picker's instance swatch with a one-dimensional ARGB color array.
; 語法 ........: _UI_ColorPickerSetPalette( $hWnd, $iId, $aColors )
; 參數 ....: $hWnd - Window handle returned by _UI_WindowCreate
;                  $iId - ColorPicker element ID returned by _UI_ColorPicker
;                  $aColors - One-dimensional array containing 1..$AUI_COLOR_PICKER_MAX_PALETTE 0xAARRGGBB colors
; 傳回值 .: Success - 1
;                  Failure - 0; @error is set to 7 ($AUI_ERR_OUT_OF_RANGE) when the array is invalid or the color count exceeds
;                  $AUI_COLOR_PICKER_MAX_PALETTE; use _UI_GetLastErrorText for diagnostic text
; 作者 ........: Fanxing
; 相關函式 .......: _UI_ColorPickerGetPalette, _UI_ColorPickerResetPalette
; 範例 .......: Yes
; ===============================================================================================================================
Func _UI_ColorPickerSetPalette($hWnd, $iId, Const ByRef $aColors)
    If Not IsArray($aColors) Or UBound($aColors, 0) <> 1 Then
        $g_iAuiUdfErrorCode = $AUI_ERR_INVALID_ARGUMENT
        Return SetError($g_iAuiUdfErrorCode, 0, 0)
    EndIf
    Local $iCount = UBound($aColors)
    If $iCount < 1 Then
        $g_iAuiUdfErrorCode = $AUI_ERR_INVALID_ARGUMENT
        Return SetError($g_iAuiUdfErrorCode, 0, 0)
    EndIf
    Local $tColors = DllStructCreate("dword[" & $iCount & "]")
    If @error Then
        $g_iAuiUdfErrorCode = $AUI_ERR_LIMIT_EXCEEDED
        Return SetError($g_iAuiUdfErrorCode, $iCount, 0)
    EndIf
    For $i = 0 To $iCount - 1
        DllStructSetData($tColors, 1, $aColors[$i], $i + 1)
    Next
    Local $vAuiForwardResult = __AUI_Call("int", "_UI_ColorPickerSetPalette", _
                      "hwnd", $hWnd, "int", $iId, "ptr", DllStructGetPtr($tColors), "int", $iCount)
    Return SetError(@error, @extended, $vAuiForwardResult)
EndFunc

