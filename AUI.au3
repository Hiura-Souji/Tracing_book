; 名稱 ..........: _UI_TextAreaSetLineColor
; 說明 ...: Sets the text color of the specified logical line.
; 語法 ........: _UI_TextAreaSetLineColor( $hWnd, $iId, $iLine, $iColor )
; 參數 ....: $hWnd - Window handle
;                  $iId - TextArea element ID
;                  $iLine - Zero-based logical line number
;                  $iColor - 0xAARRGGBB; 0 means clear the row color
; 傳回值 .: Success - 1
;                  Failure - 0
; 作者 ........: Fanxing
; 範例 .......: Yes
; ===============================================================================================================================
Func _UI_TextAreaSetLineColor($hWnd, $iId, $iLine, $iColor)
    Local $vAuiForwardResult = __AUI_Call("int", "_UI_TextAreaSetLineColor", "hwnd", $hWnd, "int", $iId, "int", $iLine, "uint", $iColor)
    Return SetError(@error, @extended, $vAuiForwardResult)
EndFunc

; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_TextAreaGetLineColor
; 說明 ...: Retrieves the custom text color of the specified logical line.
; 語法 ........: _UI_TextAreaGetLineColor( $hWnd, $iId, $iLine )
; 參數 ....: $hWnd - Window handle
;                  $iId - TextArea element ID
;                  $iLine - Zero-based logical line number
; 傳回值 .: Success - 0xAARRGGBB; 0 means the line uses the default text color
;                  Failure - 0, and set @error
; 作者 ........: Fanxing
; 相關函式 .......: _UI_TextAreaSetLineColor, _UI_TextAreaClearLineColor
; 範例 .......: Yes
; ===============================================================================================================================
Func _UI_TextAreaGetLineColor($hWnd, $iId, $iLine)
    Local $tColor = DllStructCreate("uint")
    Local $iResult = __AUI_Call("int", "_UI_TextAreaGetLineColor", "hwnd", $hWnd, "int", $iId, _
            "int", $iLine, "ptr", DllStructGetPtr($tColor))
    Local $iDllError = @error
    If $iDllError Then Return SetError($iDllError, 0, 0)
    If $iResult = 0 Then
        Local $iNativeError = _UI_GetLastError()
        If @error Or $iNativeError = $AUI_OK Then $iNativeError = $AUI_ERR_INVALID_ARGUMENT
        Return SetError($iNativeError, 0, 0)
    EndIf
    Return SetError(0, 0, DllStructGetData($tColor, 1))
EndFunc

