; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_MediaViewGetSeekableRange
; 說明 ...: Retrieves the current jumpable time window; the start and end seconds of the live stream DVR will move with
;                  the list update.
; 語法 ........: _UI_MediaViewGetSeekableRange($hWnd, $iMedia, ByRef $fStart, ByRef $fEnd)
; 參數 ....: $hWnd - Window handle
;                  $iMedia - MediaView element ID
;                  $fStart - [ByRef] Receive the starting seconds of the jumpable range
;                  $fEnd - [ByRef] Receives the end seconds of the jumpable range
; 傳回值 .: Returns 1 if there is a jumpable range; returns 0 when it is not ready or the live stream does not provide
;                  DVR, and the output is all 0
; 作者 ........: Fanxing
; 範例 .......: Yes
; ===============================================================================================================================
Func _UI_MediaViewGetSeekableRange($hWnd, $iMedia, ByRef $fStart, ByRef $fEnd)
    $fStart = 0.0
    $fEnd = 0.0
    If __AUI_EnsureDll() = 0 Then Return SetError($g_iAuiLoadError, 0, 0)
    Local $tRange = DllStructCreate("double start;double end")
    Local $aResult = __AUI_DllCall("int", "_UI_MediaViewGetSeekableRange", _
            "hwnd", $hWnd, "int", $iMedia, _
            "ptr", DllStructGetPtr($tRange, "start"), _
            "ptr", DllStructGetPtr($tRange, "end"))
    Local $iError = @error
    If $iError Or Not IsArray($aResult) Then Return SetError($iError, 0, 0)
    If $aResult[0] = 0 Then Return SetError(__AUI_ReadNativeLastError(), 0, 0)
    $fStart = DllStructGetData($tRange, "start")
    $fEnd = DllStructGetData($tRange, "end")
    Return SetError(0, 0, $aResult[0])
EndFunc

