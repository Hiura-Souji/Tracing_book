    Return SetError(@error, @extended, $vAuiForwardResult <> 0)
EndFunc

; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_DataViewOnCheck
; 說明 ...: Registers a callback for row checkbox state changes.
; 語法 ........: _UI_DataViewOnCheck( $hWnd, $iDataView, $sFuncName )
; 參數 ....: $hWnd - Window handle returned by _UI_WindowCreate
;                  $iDataView - DataView element ID returned by _UI_DataView
;                  $sFuncName - Callback function name, signature Func($iRow, $bChecked); an empty string indicates cancellation
; 傳回值 .: Success - 1
;                  Failure - 0; the callback name is invalid, callback registration failed, or the native call failed
; 作者 ........: Fanxing
; 備註 .......: When clicking the all-select box in the table header, $iRow is -1, and $bChecked represents the new
;                  all-select state.
; 相關函式 .......: _UI_DataViewSetCheckable, _UI_DataViewSetChecked
; 範例 .......: Yes
; ===============================================================================================================================
Func _UI_DataViewOnCheck($hWnd, $iDataView, $sFuncName)
    If __AUI_ValidateOptionalCallback($sFuncName) = 0 Then Return SetError(@error, 0, 0)
    If $sFuncName <> "" And $g_pAuiDispCheck = 0 Then $g_pAuiDispCheck = __AUI_RegisterCallback("__AUI_CheckProxy", "hwnd;int;int;int")
    If $sFuncName <> "" And $g_pAuiDispCheck = 0 Then Return SetError(@error, 0, 0)
    Local $sOldFunc = __AUI_CbGet($__AUI_CB_DATAVIEW_CHECK, $iDataView, $hWnd)
    If __AUI_CbSet($__AUI_CB_DATAVIEW_CHECK, $iDataView, $sFuncName, $hWnd) = 0 Then Return SetError(@error, 0, 0)
    Local $pCallback = $sFuncName = "" ? 0 : $g_pAuiDispCheck
    Local $iResult = __AUI_Call("int", "_UI_DataViewOnCheck", "hwnd", $hWnd, "int", $iDataView, "ptr", $pCallback)
    Local $iCallError = @error
    If $iCallError Or $iResult = 0 Then
        __AUI_CbSet($__AUI_CB_DATAVIEW_CHECK, $iDataView, $sOldFunc, $hWnd)
        Return SetError($iCallError, 0, 0)
    EndIf
    Return SetError(0, 0, 1)
EndFunc
; ────────────────────────────────────────────────────────────────────────────
;  Chart
; ────────────────────────────────────────────────────────────────────────────
; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_Chart
; 說明 ...: Creates charts (line/column/pie/area).
; 語法 ........: _UI_Chart( $hWnd, $iParent, $iType, $sData [, $sLabels = "" [, $iX = 0 [, $iY = 0 [, $iW = 0 [, $iH = 0]]]]]
;                  )
; 參數 ....: $hWnd - Window handle returned by _UI_WindowCreate
;                  $iParent - Parent element ID; use 0 for the window root
;                  $iType - Chart type $AUI_CHART_LINE/BAR/PIE/AREA
;                  $sData - Non-empty finite non-negative numbers, separated by |; polyline/column/area at most
;                  $AUI_CHART_MAX_POINTS points, pie chart at most $AUI_CHART_MAX_PIE_SLICES items
;                  $sLabels - [Optional] Label of each data point, | separated, can be less than but not more than data points,
;                  default is ""
;                  $iX - [Optional] Logical X coordinate (relative to parent container; ignored in flexible containers such as
;                  Row/Column), default 0
;                  $iY - [Optional] Logical Y coordinate (relative to parent container; ignored in flexible containers), default
;                  0
;                  $iW - [Optional] Logical width; 0 = automatically determined/filled by layout, default 0
;                  $iH - [Optional] Logical height; 0 = automatically determined/filled by layout, default 0
; 傳回值 .: Success - New element ID (integer, >= 1)
;                  Failure - 0
; 作者 ........: Fanxing
; 相關函式 .......: _UI_Statistic
; 範例 .......: Yes
; ===============================================================================================================================
Func _UI_Chart($hWnd, $iParent, $iType, $sData, $sLabels = "", _
               $iX = 0, $iY = 0, $iW = 0, $iH = 0)
    Local $vAuiForwardResult = __AUI_Call("int", "_UI_Chart", _
                       "hwnd", $hWnd, "int", $iParent, "int", $iType, _
                       "wstr", $sData, "wstr", $sLabels, _
                       "int", $iX, "int", $iY, "int", $iW, "int", $iH)
    Return SetError(@error, @extended, $vAuiForwardResult)
EndFunc

