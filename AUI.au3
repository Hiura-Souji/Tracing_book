; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_CanvasGetStrokeStyle
; 說明 ...: Retrieves the current line type, endpoints and connection methods used by subsequent stroke commands.
; 語法 ........: _UI_CanvasGetStrokeStyle( $hWnd, $iId )
; 參數 ....: $hWnd - Window handle
;                  $iId - Canvas element ID
; 傳回值 .: Success - Three-item array [line type, endpoint, connection method]
;                  Failure - 0, and set @error
; 作者 ........: Fanxing
; 相關函式 .......: _UI_CanvasSetStrokeStyle, _UI_CanvasSave, _UI_CanvasRestore
; 範例 .......: Yes
; ===============================================================================================================================
Func _UI_CanvasGetStrokeStyle($hWnd, $iId)
    Local $tDash = DllStructCreate("int"), $tCap = DllStructCreate("int"), $tJoin = DllStructCreate("int")
    Local $iResult = __AUI_Call("int", "_UI_CanvasGetStrokeStyle", "hwnd", $hWnd, "int", $iId, _
            "ptr", DllStructGetPtr($tDash), "ptr", DllStructGetPtr($tCap), "ptr", DllStructGetPtr($tJoin))
    Local $iDllError = @error
    If $iDllError Then Return SetError($iDllError, 0, 0)
    If $iResult = 0 Then
        Local $iNativeError = _UI_GetLastError()
        If @error Or $iNativeError = $AUI_OK Then $iNativeError = $AUI_ERR_INVALID_ARGUMENT
        Return SetError($iNativeError, 0, 0)
    EndIf
    Local $aStyle[3] = [DllStructGetData($tDash, 1), DllStructGetData($tCap, 1), DllStructGetData($tJoin, 1)]
    Return SetError(0, 0, $aStyle)
EndFunc

