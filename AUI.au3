; 傳回值 .: Success - Current relative path, or an empty string when no entry is active
;                  Failure - An empty string with @error set
; 作者 ........: Fanxing
; 相關函式 .......: _UI_ArchiveGetProgress
; 範例 .......: Yes
; ===============================================================================================================================
Func _UI_ArchiveGetCurrentPath($iTaskId)
    Local $sPath = __AUI_ReadTaskText("_UI_ArchiveGetCurrentPath", $iTaskId)
    Return SetError(@error, @extended, $sPath)
EndFunc

