; 傳回值 .: Success - 1
;                  Failure - 0, and set @error
; 作者 ........: Fanxing
; 相關函式 .......: _UI_Wrap, _UI_WrapGetDirection
; 範例 .......: Yes
; ===============================================================================================================================
Func _UI_WrapSetDirection($hWnd, $iWrap, $iDirection)
    Local $vAuiForwardResult = __AUI_Call("int", "_UI_WrapSetDirection", _
            "hwnd", $hWnd, "int", $iWrap, "int", $iDirection)
    Return SetError(@error, @extended, $vAuiForwardResult)
EndFunc

