; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_HttpRequestGetRedirectHistory
; 說明 ...: Retrieves the redirects followed by a terminal request as JSON.
; 語法 ........: _UI_HttpRequestGetRedirectHistory( $iRequestId )
; 參數 ....: $iRequestId - Request ID
; 傳回值 .: Success - JSON array; [] when no redirects were followed
;                  Failure - Empty string and set @error
; 作者 ........: Fanxing
; 備註 .......: Available after the request succeeds, fails, is cancelled, or times out. Each record contains fromUrl, toUrl,
;                  status, method, nextMethod, location, methodChanged, and elapsedMs. Redirects completed before a limit or
;                  loop failure remain available.
; 相關函式 .......: _UI_HttpSessionSetRedirectPolicy, _UI_JsonParse
; 範例 .......: Yes
; ===============================================================================================================================
Func _UI_HttpRequestGetRedirectHistory($iRequestId)
    Local $vAuiHelperResult = __AUI_HttpReadText("_UI_HttpRequestGetRedirectHistory", $iRequestId)
    Return SetError(@error, @extended, $vAuiHelperResult)
EndFunc

; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_HttpRequestGetCertificate
; 說明 ...: Retrieves the final server TLS and certificate summary as JSON.
; 語法 ........: _UI_HttpRequestGetCertificate( $iRequestId )
; 參數 ....: $iRequestId - Successfully completed request ID
; 傳回值 .: Success - JSON object; a plain HTTP response returns {"available":false}
;                  Failure - Empty string and set @error
; 作者 ........: Fanxing
; 備註 .......: The HTTPS object contains validationRelaxed, valid, policyError, policyErrorText, protocol, cipherSuite,
;                  cipher, cipherBits, the leaf certificate, and a certificate-chain summary of up to 16 entries. Each
;                  certificate includes its Subject, Issuer, serial number, UTC validity period, and SHA-256 fingerprint. Strict
;                  system certificate validation remains the default. The connection is relaxed only when the request explicitly
;                  sets $AUI_NET_ALLOW_INVALID_CERT, and the summary still reports the independent certificate-policy result.
; 相關函式 .......: _UI_HttpRequestGetRedirectHistory, _UI_JsonParse
; 範例 .......: Yes
; ===============================================================================================================================
Func _UI_HttpRequestGetCertificate($iRequestId)
    Local $vAuiHelperResult = __AUI_HttpReadText("_UI_HttpRequestGetCertificate", $iRequestId)
    Return SetError(@error, @extended, $vAuiHelperResult)
EndFunc
