; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_CanvasDrawPolyline
; 說明 ...: Adds an unclosed polyline command; the point array format is [x1,y1,x2,y2,...].
; 語法 ........: _UI_CanvasDrawPolyline( $hWnd, $iId, Const ByRef $aPoints, $iColor [, $nWidth = 1] )
; 參數 ....: $hWnd - Window handle
;                  $iId - Canvas element ID
;                  $aPoints - 1D logical coordinate array; minimum 2 points, maximum 65535 points
;                  $iColor - Stroke color, the format is 0xAARRGGBB
;                  $nWidth - [Optional] Logical stroke width greater than 0, default 1
; 傳回值 .: Success - 1
;                  Failure - 0, and set the error code
; 作者 ........: Fanxing
; 範例 .......: Yes
; ===============================================================================================================================
Func _UI_CanvasDrawPolyline($hWnd, $iId, Const ByRef $aPoints, $iColor, $nWidth = 1)
    Local $tPoints, $iCount
    If Not __AUI_CanvasBuildPoints($aPoints, $tPoints, $iCount, 2) Then Return SetError(@error, 0, 0)
    Local $vAuiForwardResult = __AUI_Call("int", "_UI_CanvasDrawPolyline", "hwnd", $hWnd, "int", $iId, "ptr", DllStructGetPtr($tPoints), "int", $iCount, "uint", $iColor, "float", $nWidth)
    Return SetError(@error, @extended, $vAuiForwardResult)
EndFunc

