Func _UI_DatePickerGetDate($hWnd, $iId)
    Local $vAuiHelperResult = __AUI_ReadElementText("_UI_DatePickerGetDate", $hWnd, $iId)
    Return SetError(@error, @extended, $vAuiHelperResult)
EndFunc

