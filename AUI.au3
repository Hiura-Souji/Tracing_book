; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_TextAreaGetScrollPosition
; 說明 ...: Retrieves the logical pixel scroll position.
; 語法 ........: _UI_TextAreaGetScrollPosition( $hWnd, $iId )
; 參數 ....: $hWnd - Window handle
;                  $iId - TextArea element ID
; 傳回值 .: Success - Two-element array [horizontal position, vertical position]
;                  Failure - 0; when the layout resource is not ready, _UI_GetLastError() returns $AUI_ERR_NOT_READY
; 作者 ........: Fanxing
; 範例 .......: Yes
; ===============================================================================================================================
Func _UI_TextAreaGetScrollPosition($hWnd, $iId)
    If __AUI_EnsureDll() = 0 Then Return SetError($g_iAuiLoadError, 0, 0)
    Local $aCall = __AUI_DllCall("int", "_UI_TextAreaGetScrollPosition", "hwnd", $hWnd, "int", $iId, _
            "int*", 0, "int*", 0)
    Local $iDllError = @error
    If $iDllError Or Not IsArray($aCall) Then Return SetError($iDllError, 0, 0)
    If Not $aCall[0] Then Return SetError(__AUI_ReadNativeLastError(), 0, 0)
    Local $aPosition[2] = [$aCall[3], $aCall[4]]
    Return $aPosition
EndFunc

