; 說明 ...: Cancels currently active cell editing and discards modifications.
; 語法 ........: _UI_DataViewCancelEdit( $hWnd, $iDataView )
; 參數 ....: $hWnd - Window handle returned by _UI_WindowCreate
;                  $iDataView - DataView control ID
; 傳回值 .: Success - 1
;                  Failure - 0; the error code is $AUI_ERR_NOT_READY when there is no active editing
; 作者 ........: Fanxing
; 範例 .......: Yes
; ===============================================================================================================================
Func _UI_DataViewCancelEdit($hWnd, $iDataView)
    Local $vAuiForwardResult = __AUI_Call("int", "_UI_DataViewCancelEdit", "hwnd", $hWnd, "int", $iDataView)
    Return SetError(@error, @extended, $vAuiForwardResult)
EndFunc

; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_DataViewGetEditCell
; 說明 ...: Retrieves the row currently being edited.
; 語法 ........: _UI_DataViewGetEditCell( $hWnd, $iDataView )
; 參數 ....: $hWnd - Window handle returned by _UI_WindowCreate
;                  $iDataView - DataView control ID
; 傳回值 .: Success - Two-element array [row, column]
;                  Failure - 0; the error code is $AUI_ERR_NOT_READY when there is no active editing
; 作者 ........: Fanxing
; 範例 .......: Yes
; ===============================================================================================================================
Func _UI_DataViewGetEditCell($hWnd, $iDataView)
    If __AUI_EnsureDll() = 0 Then Return SetError($g_iAuiLoadError, 0, 0)
    Local $aCall = __AUI_DllCall("int", "_UI_DataViewGetEditCell", "hwnd", $hWnd, "int", $iDataView, "int*", -1, "int*", -1)
    Local $iDllError = @error
    If $iDllError Or Not IsArray($aCall) Then Return SetError($iDllError, 0, 0)
    If $aCall[0] = 0 Then Return SetError(__AUI_ReadNativeLastError(), 0, 0)
    Local $aResult[2] = [$aCall[3], $aCall[4]]
    Return SetError(0, 0, $aResult)
EndFunc

