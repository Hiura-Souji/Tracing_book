Func _UI_NumberInputSetValue($hWnd, $iId, $nValue)
    Local $vAuiForwardResult = __AUI_Call("int", "_UI_NumberInputSetValue", "hwnd", $hWnd, "int", $iId, "double", $nValue)
    Return SetError(@error, @extended, $vAuiForwardResult)
EndFunc

; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_NumberInputSetRange
; 說明 ...: Atomically sets the minimum and maximum values of a NumberInput and clamps the current value.
; 語法 ........: _UI_NumberInputSetRange( $hWnd, $iId, $nMin, $nMax )
; 參數 ....: $hWnd - Window handle
;                  $iId - NumberInput element ID
;                  $nMin - Finite minimum
;                  $nMax - Finite maximum value, must not be less than the minimum value
; 傳回值 .: Success - 1
;                  Failure - 0, and set the error code
; 作者 ........: Fanxing
; 範例 .......: Yes
; ===============================================================================================================================
Func _UI_NumberInputSetRange($hWnd, $iId, $nMin, $nMax)
    Local $vAuiForwardResult = __AUI_Call("int", "_UI_NumberInputSetRange", "hwnd", $hWnd, "int", $iId, _
            "double", $nMin, "double", $nMax)
    Return SetError(@error, @extended, $vAuiForwardResult)
EndFunc

; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_NumberInputGetRange
; 說明 ...: Retrieves the minimum and maximum values of NumberInput.
; 語法 ........: _UI_NumberInputGetRange( $hWnd, $iId )
; 參數 ....: $hWnd - Window handle
;                  $iId - NumberInput element ID
; 傳回值 .: Success - Two-element array [minimum value, maximum value]
;                  Failure - Empty array and set @error
; 作者 ........: Fanxing
; 範例 .......: Yes
; ===============================================================================================================================
Func _UI_NumberInputGetRange($hWnd, $iId)
    If __AUI_EnsureDll() = 0 Then Return SetError($g_iAuiLoadError, 0, Null)
    Local $aCall = __AUI_DllCall("int", "_UI_NumberInputGetRange", _
            "hwnd", $hWnd, "int", $iId, "double*", 0, "double*", 0)
    Local $iError = @error
    If $iError Or Not IsArray($aCall) Then Return SetError($iError, 0, Null)
    If $aCall[0] = 0 Then Return SetError(__AUI_ReadNativeLastError(), 0, Null)
    Local $aRange[2] = [$aCall[3], $aCall[4]]
    Return $aRange
EndFunc

