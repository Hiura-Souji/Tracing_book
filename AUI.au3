; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_TreeFromArray
; 說明 ...: Builds trees in batches using a two-dimensional array, specifying the parent row number and node text for
;                  each row.
; 語法 ........: _UI_TreeFromArray( $hWnd, $iTree, Const ByRef $aNodes )
; 參數 ....: $hWnd - Window handle returned by _UI_WindowCreate
;                  $iTree - Tree control ID (_UI_Tree returned)
;                  $aNodes - Two-dimensional array [n][0]=parent row number (-1 is the root level), [n][1]=node text; the parent
;                  row must be before the current row
; 傳回值 .: Success - Array of stable node IDs corresponding to each row
;                  Failure - 0, and set @error: 1=array format error, 2=invalid parent row number, 3=add failed, 4=batch update
;                  failed
; 作者 ........: Fanxing
; 備註 .......: Input is validated before the batch begins. If adding a node or ending the batch fails, every node created by
;                  this call is removed before failure is returned.
; 相關函式 .......: _UI_Tree, _UI_TreeFromMap
; 範例 .......: Yes
; ===============================================================================================================================
Func _UI_TreeFromArray($hWnd, $iTree, Const ByRef $aNodes)
    If Not IsArray($aNodes) Or UBound($aNodes, 0) <> 2 Or UBound($aNodes, 2) < 2 Then
        $g_iAuiUdfErrorCode = $AUI_ERR_INVALID_ARGUMENT
        Return SetError($g_iAuiUdfErrorCode, 0, 0)
    EndIf
    Local $n = UBound($aNodes)
    Local $nSize = ($n > 0) ? $n : 1
    Local $aIds[$nSize]
    For $i = 0 To $n - 1
        Local $iParentRow = $aNodes[$i][0]
        If Not __AUI_IsIntegerVariant($iParentRow) Or $iParentRow < -1 Or $iParentRow >= $i Then
            $g_iAuiUdfErrorCode = $AUI_ERR_OUT_OF_RANGE
            Return SetError($g_iAuiUdfErrorCode, $i, 0)
        EndIf
    Next
    If Not _UI_TreeBeginUpdate($hWnd, $iTree) Then
        Local $iBeginError = @error, $iBeginExtended = @extended
        $g_iAuiUdfErrorCode = $iBeginError
        Return SetError($iBeginError, $iBeginExtended, 0)
    EndIf
    For $i = 0 To $n - 1
        Local $iParentRow2 = $aNodes[$i][0]
        Local $iParentId = ($iParentRow2 < 0) ? -1 : $aIds[$iParentRow2]
        $aIds[$i] = _UI_TreeAdd($hWnd, $iTree, $iParentId, $aNodes[$i][1])
        If $aIds[$i] < 1 Then
            Local $iAddError = @error, $iAddExtended = @extended
            __AUI_TreeRollback($hWnd, $iTree, $aIds, $i)
            _UI_TreeEndUpdate($hWnd, $iTree)
            $g_iAuiUdfErrorCode = $iAddError
            Return SetError($iAddError, $iAddExtended, 0)
        EndIf
    Next
    If Not _UI_TreeEndUpdate($hWnd, $iTree) Then
        Local $iEndError = @error, $iEndExtended = @extended
        __AUI_TreeRollback($hWnd, $iTree, $aIds, $n)
        $g_iAuiUdfErrorCode = $iEndError
        Return SetError($iEndError, $iEndExtended, 0)
    EndIf
    Return SetError(0, 0, $aIds)
EndFunc

; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_TreeFromMap
; 說明 ...: Recursively builds a tree using an array of Map nodes.
; 語法 ........: _UI_TreeFromMap( $hWnd, $iTree, Const ByRef $aNodes [, $iParent = -1] )
; 參數 ....: $hWnd - Window handle returned by _UI_WindowCreate
;                  $iTree - Tree control ID (_UI_Tree returned)
;                  $aNodes - One-dimensional array; elements can be strings, or a Map with text and optional children arrays
;                  $iParent - [Optional] The stable ID of the new node's parent node; default -1 indicates the root level
; 傳回值 .: Success - 1
;                  Failure - 0 and set @error; @extended to the index of the failed node in the current array
; 作者 ........: Fanxing
; 備註 .......: If validation, node creation, or batch completion fails, every node created by this call is removed before
;                  failure is returned.
; 相關函式 .......: _UI_Tree, _UI_TreeFromArray
; 範例 .......: Yes
; ===============================================================================================================================
Func _UI_TreeFromMap($hWnd, $iTree, Const ByRef $aNodes, $iParent = -1)
    If Not IsArray($aNodes) Or UBound($aNodes, 0) <> 1 Then
        $g_iAuiUdfErrorCode = $AUI_ERR_INVALID_ARGUMENT
        Return SetError($g_iAuiUdfErrorCode, 0, 0)
    EndIf
    If Not __AUI_IsIntegerVariant($iParent) Or $iParent < -1 Or $iParent = 0 Then
        $g_iAuiUdfErrorCode = $AUI_ERR_INVALID_ARGUMENT
        Return SetError($g_iAuiUdfErrorCode, 0, 0)
    EndIf
    If Not _UI_TreeBeginUpdate($hWnd, $iTree) Then Return SetError(_UI_GetLastError(), 0, 0)
    Local $iAddedCapacity = UBound($aNodes)
    If $iAddedCapacity < 1 Then $iAddedCapacity = 1
    Local $aAdded[$iAddedCapacity]
    Local $iAdded = 0
    Local $iBuilt = __AUI_TreeFromMapCore($hWnd, $iTree, $aNodes, $iParent, $aAdded, $iAdded)
    Local $iBuildError = @error, $iBuildIndex = @extended
    If $iBuilt = 0 Then __AUI_TreeRollback($hWnd, $iTree, $aAdded, $iAdded)
    Local $iEnded = _UI_TreeEndUpdate($hWnd, $iTree)
    If $iBuilt = 0 Then Return SetError($iBuildError, $iBuildIndex, 0)
    If $iEnded = 0 Then
        Local $iEndError = @error
        If Not $iEndError Then $iEndError = _UI_GetLastError()
        __AUI_TreeRollback($hWnd, $iTree, $aAdded, $iAdded)
        Return SetError($iEndError ? $iEndError : $AUI_ERR_IO, 0, 0)
    EndIf
    Return SetError(0, 0, 1)
EndFunc

Func __AUI_TreeFromMapCore($hWnd, $iTree, Const ByRef $aNodes, $iParent, ByRef $aAdded, ByRef $iAdded)
    Local $iIndex = 0
    For $vNode In $aNodes
        Local $sText = ""
        Local $bHasChildren = False
        If IsMap($vNode) Then
            If Not MapExists($vNode, "text") Then
                $g_iAuiUdfErrorCode = $AUI_ERR_INVALID_ARGUMENT
                Return SetError($g_iAuiUdfErrorCode, $iIndex, 0)
            EndIf
            $sText = String($vNode["text"])
            $bHasChildren = MapExists($vNode, "children")
        Else
            $sText = String($vNode)
        EndIf
        Local $iId = _UI_TreeAdd($hWnd, $iTree, $iParent, $sText)
        If $iId < 1 Then
            Local $iAddError = @error
            If Not $iAddError Then $iAddError = _UI_GetLastError()
            Return SetError($iAddError ? $iAddError : $AUI_ERR_IO, $iIndex, 0)
        EndIf
        If $iAdded >= UBound($aAdded) Then ReDim $aAdded[UBound($aAdded) * 2]
        $aAdded[$iAdded] = $iId
        $iAdded += 1
        If $bHasChildren Then
            If Not IsArray($vNode["children"]) Or UBound($vNode["children"], 0) <> 1 Then
                $g_iAuiUdfErrorCode = $AUI_ERR_INVALID_ARGUMENT
                Return SetError($g_iAuiUdfErrorCode, $iIndex, 0)
            EndIf
            Local $aChildren = $vNode["children"]
            If __AUI_TreeFromMapCore($hWnd, $iTree, $aChildren, $iId, $aAdded, $iAdded) = 0 Then _
                Return SetError(@error, $iIndex, 0)
        EndIf
        $iIndex += 1
    Next
    Return SetError(0, 0, 1)
EndFunc

Func __AUI_TreeRollback($hWnd, $iTree, ByRef $aAdded, $iAdded)
    For $i = $iAdded - 1 To 0 Step -1
        _UI_TreeRemove($hWnd, $iTree, $aAdded[$i])
    Next
EndFunc

