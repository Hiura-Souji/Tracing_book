EndFunc

; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_DbColumnType
; 說明 ...: Returns the SQLite storage class of the current result column.
; 語法 ........: _UI_DbColumnType( $iStatement, $iColumn )
; 參數 ....: $iStatement - Statement ID
;                  $iColumn - Zero-based column index
; 傳回值 .: $AUI_DB_INTEGER through $AUI_DB_NULL; returns -1 on failure
; 作者 ........: Fanxing
; 備註 .......: Column values can be read only when the most recent _UI_DbStep call returned $AUI_DB_ROW.
; 範例 .......: Yes
; ===============================================================================================================================
Func _UI_DbColumnType($iStatement, $iColumn)
    Local $vAuiForwardResult = __AUI_Call("int", "_UI_DbColumnType", "uint64", $iStatement, "int", $iColumn)
    Return SetError(@error, @extended, $vAuiForwardResult)
EndFunc

