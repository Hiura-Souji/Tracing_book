Func _UI_OnChange($hWnd, $iId, $sFuncName)
    If __AUI_ValidateOptionalCallback($sFuncName) = 0 Then Return SetError(@error, 0, 0)
    If $sFuncName <> "" And $g_pAuiDispChange = 0 Then $g_pAuiDispChange = __AUI_RegisterCallback("__AUI_DispChange", "hwnd;int;wstr")
    If $sFuncName <> "" And $g_pAuiDispChange = 0 Then Return SetError($AUI_UDF_ERR_CALLBACK_REGISTER, 0, 0)
    Local $sOldFunc = __AUI_CbGet($__AUI_CB_CHANGE, $iId, $hWnd)
    If __AUI_CbSet($__AUI_CB_CHANGE, $iId, $sFuncName, $hWnd) = 0 Then Return SetError($AUI_UDF_ERR_INVALID_CALLBACK, 0, 0)
    Local $pCallback = ($sFuncName = "" And Not __AUI_EventHasSubscribers($hWnd, $AUI_EVENT_CHANGE, $iId)) ? 0 : $g_pAuiDispChange
    Local $iResult = __AUI_Call("int", "_UI_OnChange", "hwnd", $hWnd, "int", $iId, "ptr", $pCallback)
    Local $iCallError = @error
    If $iCallError Or $iResult = 0 Then
        __AUI_CbSet($__AUI_CB_CHANGE, $iId, $sOldFunc, $hWnd)
        Return SetError($iCallError, 0, 0)
    EndIf
    Return SetError(0, 0, 1)
EndFunc

; #FUNCTION# ===================================================================================================================
