; ===============================================================================================================================
Func _UI_DbBindNull($iStatement, $iIndex)
    Local $vAuiForwardResult = __AUI_Call("int", "_UI_DbBindNull", "uint64", $iStatement, "int", $iIndex)
    Return SetError(@error, @extended, $vAuiForwardResult)
EndFunc

; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_DbBindInt64
; 說明 ...: Binds signed 64-bit integer.
; 語法 ........: _UI_DbBindInt64( $iStatement, $iIndex, $iValue )
; 參數 ....: $iStatement - Statement ID
;                  $iIndex - 1-based parameter index
;                  $iValue - Signed 64-bit integer
; 傳回值 .: Success 1, Failure 0
; 作者 ........: Fanxing
; 範例 .......: Yes
; ===============================================================================================================================
Func _UI_DbBindInt64($iStatement, $iIndex, $iValue)
    Local $vAuiForwardResult = __AUI_Call("int", "_UI_DbBindInt64", "uint64", $iStatement, "int", $iIndex, "int64", $iValue)
    Return SetError(@error, @extended, $vAuiForwardResult)
EndFunc

; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_DbBindDouble
; 說明 ...: Binds double precision floating point number.
; 語法 ........: _UI_DbBindDouble( $iStatement, $iIndex, $fValue )
; 參數 ....: $iStatement - Statement ID
;                  $iIndex - 1-based parameter index
;                  $fValue - Double precision floating point number
; 傳回值 .: Success 1, Failure 0
; 作者 ........: Fanxing
; 範例 .......: Yes
; ===============================================================================================================================
Func _UI_DbBindDouble($iStatement, $iIndex, $fValue)
    Local $vAuiForwardResult = __AUI_Call("int", "_UI_DbBindDouble", "uint64", $iStatement, "int", $iIndex, "double", $fValue)
    Return SetError(@error, @extended, $vAuiForwardResult)
EndFunc

; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_DbBindText
; 說明 ...: Copy and bind the AutoIt Unicode string.
; 語法 ........: _UI_DbBindText( $iStatement, $iIndex, $sValue )
; 參數 ....: $iStatement - Statement ID
;                  $iIndex - 1-based parameter index
;                  $sValue - Unicode text
; 傳回值 .: Success 1, Failure 0
; 作者 ........: Fanxing
; 備註 .......: Embedded U+0000 code units are preserved; bind SQL NULL only with _UI_DbBindNull.
; 範例 .......: Yes
; ===============================================================================================================================
Func _UI_DbBindText($iStatement, $iIndex, $sValue)
    Local $bText = StringToBinary(String($sValue), 2)
    Local $iBytes = BinaryLen($bText)
    If $iBytes > 64 * 1024 * 1024 Then
        $g_iAuiUdfErrorCode = $AUI_ERR_LIMIT_EXCEEDED
        Return SetError($g_iAuiUdfErrorCode, $iBytes, 0)
    EndIf
    Local $tText = DllStructCreate("byte[" & ($iBytes + 2) & "]")
    If @error Or Not IsDllStruct($tText) Then
        $g_iAuiUdfErrorCode = $AUI_ERR_LIMIT_EXCEEDED
        Return SetError($g_iAuiUdfErrorCode, 0, 0)
    EndIf
    If $iBytes > 0 Then
        DllStructSetData($tText, 1, $bText)
        If @error Then
            $g_iAuiUdfErrorCode = $AUI_ERR_IO
            Return SetError($g_iAuiUdfErrorCode, 0, 0)
        EndIf
    EndIf
    Local $pText = DllStructGetPtr($tText)
    If @error Or $pText = 0 Then
        $g_iAuiUdfErrorCode = $AUI_ERR_IO
        Return SetError($g_iAuiUdfErrorCode, 0, 0)
    EndIf
    Local $vAuiForwardResult = __AUI_Call("int", "_UI_DbBindTextN", "uint64", $iStatement, "int", $iIndex, _
            "ptr", $pText, "int", $iBytes / 2)
    Return SetError(@error, @extended, $vAuiForwardResult)
EndFunc

; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_DbBindBlob
; 說明 ...: Copy and bind binary data.
; 語法 ........: _UI_DbBindBlob( $iStatement, $iIndex, $vData )
; 參數 ....: $iStatement - Statement ID
;                  $iIndex - 1-based parameter index
;                  $vData - Binary value or value convertible by Binary()
; 傳回值 .: Success 1, Failure 0
; 作者 ........: Fanxing
; 範例 .......: Yes
; ===============================================================================================================================
Func _UI_DbBindBlob($iStatement, $iIndex, $vData)
    Local $bData = IsBinary($vData) ? $vData : Binary($vData)
    Local $iSize = BinaryLen($bData)
    If $iSize > 64 * 1024 * 1024 Then
        $g_iAuiUdfErrorCode = $AUI_ERR_LIMIT_EXCEEDED
        Return SetError($g_iAuiUdfErrorCode, $iSize, 0)
    EndIf
    If $iSize = 0 Then
        Local $vAuiEmptyBlobResult = __AUI_Call("int", "_UI_DbBindBlob", "uint64", $iStatement, "int", $iIndex, "ptr", 0, "int", 0)
        Return SetError(@error, @extended, $vAuiEmptyBlobResult)
    EndIf
    Local $tData = DllStructCreate("byte[" & $iSize & "]")
    If @error Or Not IsDllStruct($tData) Then
        $g_iAuiUdfErrorCode = $AUI_ERR_LIMIT_EXCEEDED
        Return SetError($g_iAuiUdfErrorCode, 0, 0)
    EndIf
    DllStructSetData($tData, 1, $bData)
    If @error Then
        $g_iAuiUdfErrorCode = $AUI_ERR_IO
        Return SetError($g_iAuiUdfErrorCode, 0, 0)
    EndIf
    Local $pData = DllStructGetPtr($tData)
    If @error Or $pData = 0 Then
        $g_iAuiUdfErrorCode = $AUI_ERR_IO
        Return SetError($g_iAuiUdfErrorCode, 0, 0)
    EndIf
    Local $vAuiForwardResult = __AUI_Call("int", "_UI_DbBindBlob", "uint64", $iStatement, "int", $iIndex, _
            "ptr", $pData, "int", $iSize)
    Return SetError(@error, @extended, $vAuiForwardResult)
EndFunc

; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_DbBindParameterCount
; 說明 ...: Returns the number of bind parameters in a prepared statement.
; 語法 ........: _UI_DbBindParameterCount( $iStatement )
; 參數 ....: $iStatement - Statement ID
; 傳回值 .: Success - A nonnegative parameter count; Failure - -1
; 作者 ........: Fanxing
; 相關函式 .......: _UI_DbBindParameterIndex, _UI_DbBindValues
; 範例 .......: Yes
; ===============================================================================================================================
Func _UI_DbBindParameterCount($iStatement)
    Local $vAuiForwardResult = __AUI_Call("int", "_UI_DbBindParameterCount", "uint64", $iStatement)
    Return SetError(@error, @extended, $vAuiForwardResult)
EndFunc

; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_DbBindParameterIndex
; 說明 ...: Returns a one-based bind index for a complete parameter name.
; 語法 ........: _UI_DbBindParameterIndex( $iStatement, $sName )
; 參數 ....: $iStatement - Statement ID
;                  $sName - Parameter name including its :, @, $, or ? prefix
; 傳回值 .: Success - The parameter index; returns 0 when the name is absent, or -1 when the call fails
; 作者 ........: Fanxing
; 相關函式 .......: _UI_DbBindParameterName, _UI_DbBindValue
; 範例 .......: Yes
; ===============================================================================================================================
Func _UI_DbBindParameterIndex($iStatement, $sName)
    Local $vAuiForwardResult = __AUI_Call("int", "_UI_DbBindParameterIndex", "uint64", $iStatement, "wstr", $sName)
    Return SetError(@error, @extended, $vAuiForwardResult)
EndFunc

; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_DbBindParameterName
; 說明 ...: Returns the parameter name at a specified bind index.
; 語法 ........: _UI_DbBindParameterName( $iStatement, $iIndex )
; 參數 ....: $iStatement - Statement ID
;                  $iIndex - One-based parameter index
; 傳回值 .: Returns a named parameter including its prefix. An anonymous ? parameter returns an empty string; failure
;                  sets @error.
; 作者 ........: Fanxing
; 相關函式 .......: _UI_DbBindParameterIndex, _UI_DbBindParameterCount
; 範例 .......: Yes
; ===============================================================================================================================
Func _UI_DbBindParameterName($iStatement, $iIndex)
    Local $vAuiHelperResult = __AUI_DbReadStatementText("_UI_DbBindParameterName", $iStatement, $iIndex)
    Return SetError(@error, @extended, $vAuiHelperResult)
EndFunc

; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_DbBindValue
; 說明 ...: Binds one SQL parameter according to its AutoIt value type.
; 語法 ........: _UI_DbBindValue( $iStatement, $iIndex, $vValue )
; 參數 ....: $iStatement - Statement ID
;                  $iIndex - One-based parameter index
;                  $vValue - Null/Default, Binary, Boolean, integer, floating-point value, or string
; 傳回值 .: Success - 1; Failure - 0 and sets @error
; 作者 ........: Fanxing
; 備註 .......: Null and Default bind SQL NULL; unsupported AutoIt types are rejected.
; 相關函式 .......: _UI_DbBindValues, _UI_DbBindNull
; 範例 .......: Yes
; ===============================================================================================================================
Func _UI_DbBindValue($iStatement, $iIndex, $vValue)
    Local $iResult = 0
    Local $sValueType = VarGetType($vValue)
    If IsKeyword($vValue) Then
        $iResult = _UI_DbBindNull($iStatement, $iIndex)
    ElseIf IsBinary($vValue) Then
        $iResult = _UI_DbBindBlob($iStatement, $iIndex, $vValue)
    ElseIf IsBool($vValue) Then
        $iResult = _UI_DbBindInt64($iStatement, $iIndex, Int($vValue))
    ElseIf $sValueType = "Int32" Or $sValueType = "Int64" Then
        $iResult = _UI_DbBindInt64($iStatement, $iIndex, $vValue)
    ElseIf $sValueType = "Double" Then
        $iResult = _UI_DbBindDouble($iStatement, $iIndex, $vValue)
    ElseIf IsString($vValue) Then
        $iResult = _UI_DbBindText($iStatement, $iIndex, $vValue)
    Else
        $g_iAuiUdfErrorCode = $AUI_ERR_INVALID_ARGUMENT
        Return SetError($g_iAuiUdfErrorCode, 0, 0)
    EndIf
    Local $iBindError = @error, $iBindExtended = @extended
    If Not $iResult Then
        Local $iResolvedError = __AUI_DbResolveFailure($iBindError, $iBindExtended)
        Local $iResolvedExtended = @extended
        Return SetError($iResolvedError, $iResolvedExtended, 0)
    EndIf
    Return SetError(0, 0, 1)
EndFunc

; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_DbBindValues
; 說明 ...: Binds every value in a one-dimensional AutoIt array in positional order.
; 語法 ........: _UI_DbBindValues( $iStatement, Const ByRef $aValues )
; 參數 ....: $iStatement - Statement ID
;                  $aValues - One-dimensional array whose element count exactly matches the statement parameter count
; 傳回值 .: Success - 1; Failure - 0 and sets @error. For a count mismatch, @extended contains the statement parameter
;                  count; for a bind failure, it contains the parameter index.
; 作者 ........: Fanxing
; 相關函式 .......: _UI_DbBindValue, _UI_DbBindParameterCount
; 範例 .......: Yes
; ===============================================================================================================================
Func _UI_DbBindValues($iStatement, Const ByRef $aValues)
    If Not IsArray($aValues) Or UBound($aValues, 0) <> 1 Then
        $g_iAuiUdfErrorCode = $AUI_ERR_INVALID_ARGUMENT
        Return SetError($g_iAuiUdfErrorCode, 0, 0)
    EndIf
    Local $iCount = _UI_DbBindParameterCount($iStatement)
    Local $iCountError = @error, $iCountExtended = @extended
    If $iCount < 0 Then
        Local $iResolvedError = __AUI_DbResolveFailure($iCountError, $iCountExtended)
        Local $iResolvedExtended = @extended
        Return SetError($iResolvedError, $iResolvedExtended, 0)
    EndIf
    If UBound($aValues) <> $iCount Then
        $g_iAuiUdfErrorCode = $AUI_ERR_INVALID_ARGUMENT
        Return SetError($g_iAuiUdfErrorCode, $iCount, 0)
    EndIf
    For $i = 0 To $iCount - 1
        If Not _UI_DbBindValue($iStatement, $i + 1, $aValues[$i]) Then
            Local $iValueError = @error
            Return SetError($iValueError, $i + 1, 0)
        EndIf
    Next
    Return SetError(0, 0, 1)
EndFunc

; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_DbStep
; 說明 ...: Make prepared statements execute one step forward.
; 語法 ........: _UI_DbStep( $iStatement )
; 參數 ....: $iStatement - Statement ID
; 傳回值 .: Generate a row and return $AUI_DB_ROW, complete the execution and return $AUI_DB_DONE, and failure return -1
; 作者 ........: Fanxing
; 備註 .......: Call _UI_DbReset after reaching $AUI_DB_DONE or encountering an error; the statement cannot be executed again
;                  directly.
; 相關函式 .......: _UI_DbColumnText, _UI_DbReset
; 範例 .......: Yes
; ===============================================================================================================================
Func _UI_DbStep($iStatement)
    Local $vAuiForwardResult = __AUI_Call("int", "_UI_DbStep", "uint64", $iStatement)
    Return SetError(@error, @extended, $vAuiForwardResult)
EndFunc

; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_DbStatementReadOnly
; 說明 ...: Returns whether a prepared statement does not directly modify the database.
; 語法 ........: _UI_DbStatementReadOnly( $iStatement )
; 參數 ....: $iStatement - Statement ID
; 傳回值 .: Returns 1 for a read-only statement, 0 for a writable statement, or -1 on failure
; 作者 ........: Fanxing
; 備註 .......: A statement that invokes a user-defined SQL function may still produce external side effects from that
;                  function.
; 範例 .......: Yes
; ===============================================================================================================================
Func _UI_DbStatementReadOnly($iStatement)
    Local $vAuiForwardResult = __AUI_Call("int", "_UI_DbStatementReadOnly", "uint64", $iStatement)
    Return SetError(@error, @extended, $vAuiForwardResult)
EndFunc

; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_DbColumnCount
; 說明 ...: Queries the number of result columns of a precompiled statement.
; 語法 ........: _UI_DbColumnCount( $iStatement )
; 參數 ....: $iStatement - Statement ID
; 傳回值 .: Returns a non-negative column number on success, -1 on failure
; 作者 ........: Fanxing
; 範例 .......: Yes
; ===============================================================================================================================
Func _UI_DbColumnCount($iStatement)
    Local $vAuiForwardResult = __AUI_Call("int", "_UI_DbColumnCount", "uint64", $iStatement)
