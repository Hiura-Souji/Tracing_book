; 相關函式 .......: _UI_StepsSetItemStatus, _UI_StepsGetEffectiveItemStatus
; 範例 .......: Yes
; ===============================================================================================================================
Func _UI_StepsGetItemStatus($hWnd, $iSteps, $iIndex)
    Local $vAuiForwardResult = __AUI_Call("int", "_UI_StepsGetItemStatus", _
                      "hwnd", $hWnd, "int", $iSteps, "int", $iIndex)
    Return SetError(@error, @extended, $vAuiForwardResult)
EndFunc

; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_StepsGetEffectiveItemStatus
; 說明 ...: Retrieves the current actual drawing status of the specified step.
; 語法 ........: _UI_StepsGetEffectiveItemStatus( $hWnd, $iSteps, $iIndex )
; 參數 ....: $hWnd - Window handle returned by _UI_WindowCreate
