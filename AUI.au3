; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_DataViewGetRowStyle
; 說明 ...: Retrieves the current explicit background color of the specified data row.
; 語法 ........: _UI_DataViewGetRowStyle( $hWnd, $iDataView, $iRow )
; 參數 ....: $hWnd - Window handle returned by _UI_WindowCreate
;                  $iDataView - DataView control ID
;                  $iRow - Current row index (starts at 0; the virtual view must have committed the row's stable ID)
; 傳回值 .: Success - Explicit background color; 0 means use the default row background
;                  Failure - 0, and set @error
; 作者 ........: Fanxing
; 相關函式 .......: _UI_DataViewSetRowStyle, _UI_DataViewClearRowStyle
; 範例 .......: Yes
; ===============================================================================================================================
Func _UI_DataViewGetRowStyle($hWnd, $iDataView, $iRow)
    Local $tBackground = DllStructCreate("uint")
    Local $iResult = __AUI_Call("int", "_UI_DataViewGetRowStyle", _
            "hwnd", $hWnd, "int", $iDataView, "int", $iRow, "ptr", DllStructGetPtr($tBackground))
    Local $iDllError = @error
    If $iDllError Then Return SetError($iDllError, 0, 0)
    If $iResult = 0 Then
        Local $iNativeError = _UI_GetLastError()
        If @error Or $iNativeError = $AUI_OK Then $iNativeError = $AUI_ERR_INVALID_ARGUMENT
        Return SetError($iNativeError, 0, 0)
    EndIf
    Return SetError(0, 0, DllStructGetData($tBackground, 1))
EndFunc

