; 名稱 ..........: _UI_DbColumnName
; 說明 ...: Retrieves result column name.
; 語法 ........: _UI_DbColumnName( $iStatement, $iColumn )
; 參數 ....: $iStatement - Statement ID
;                  $iColumn - Zero-based column index
; 傳回值 .: Successfully returns the column name; failure returns an empty string and sets @error
; 作者 ........: Fanxing
; 範例 .......: Yes
; ===============================================================================================================================
Func _UI_DbColumnName($iStatement, $iColumn)
    Local $vAuiHelperResult = __AUI_DbReadStatementText("_UI_DbColumnName", $iStatement, $iColumn)
    Return SetError(@error, @extended, $vAuiHelperResult)
EndFunc

; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_DbColumnInt64
; 說明 ...: Retrieves the current result column as a signed 64-bit integer.
; 語法 ........: _UI_DbColumnInt64( $iStatement, $iColumn )
; 參數 ....: $iStatement - Statement ID
;                  $iColumn - Zero-based column index
; 傳回值 .: The converted signed 64-bit integer; failure returns 0 and sets @error
; 作者 ........: Fanxing
; 範例 .......: Yes
; ===============================================================================================================================
Func _UI_DbColumnInt64($iStatement, $iColumn)
    Local $vAuiHelperResult = __AUI_DbReadStatementNumber("int64", "_UI_DbColumnInt64", $iStatement, $iColumn, 0)
    Return SetError(@error, @extended, $vAuiHelperResult)
EndFunc

; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_DbColumnDouble
; 說明 ...: Retrieves the current result column as a double-precision floating point number.
; 語法 ........: _UI_DbColumnDouble( $iStatement, $iColumn )
; 參數 ....: $iStatement - Statement ID
;                  $iColumn - Zero-based column index
; 傳回值 .: The converted double-precision floating-point value; failure returns 0 and sets @error
; 作者 ........: Fanxing
; 範例 .......: Yes
; ===============================================================================================================================
Func _UI_DbColumnDouble($iStatement, $iColumn)
    Local $vAuiHelperResult = __AUI_DbReadStatementNumber("double", "_UI_DbColumnDouble", $iStatement, $iColumn, 0.0)
    Return SetError(@error, @extended, $vAuiHelperResult)
EndFunc

; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_DbColumnText
; 說明 ...: Retrieves the current result column as UTF-16 text.
; 語法 ........: _UI_DbColumnText( $iStatement, $iColumn )
; 參數 ....: $iStatement - Statement ID
;                  $iColumn - Zero-based column index
; 傳回值 .: Unicode text. SQL NULL and a valid empty string both return an empty string; failure sets @error
; 作者 ........: Fanxing
; 備註 .......: The return value is converted with an explicit length and preserves embedded U+0000 characters in database
;                  text. Internally, the operation uses a two-phase length-query and data-read protocol. Do not call Step,
;                  Reset, or Finalize on the same statement from another thread between those phases.
; 範例 .......: Yes
; ===============================================================================================================================
Func _UI_DbColumnText($iStatement, $iColumn)
    Local $vAuiHelperResult = __AUI_DbReadStatementText("_UI_DbColumnText", $iStatement, $iColumn)
    Return SetError(@error, @extended, $vAuiHelperResult)
EndFunc

; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_DbColumnBlob
; 說明 ...: Copy the current result column as an AutoIt Binary value.
; 語法 ........: _UI_DbColumnBlob( $iStatement, $iColumn )
; 參數 ....: $iStatement - Statement ID
;                  $iColumn - Zero-based column index
; 傳回值 .: Binary data. SQL NULL and a zero-length BLOB both return Binary(""); failure sets @error
; 作者 ........: Fanxing
; 備註 .......: Internally uses a two-phase length-query and data-read protocol. Do not call Step, Reset, or Finalize on the
;                  same statement from another thread between those phases.
; 範例 .......: Yes
; ===============================================================================================================================
Func _UI_DbColumnBlob($iStatement, $iColumn)
    Local $aNeed = __AUI_DllCall("int", "_UI_DbColumnBlob", "uint64", $iStatement, "int", $iColumn, "ptr", 0, "int", 0)
    If @error Or Not IsArray($aNeed) Or $aNeed[0] < 0 Then Return SetError(@error ? @error : $AUI_ERR_DATABASE, 0, Binary(""))
    If $aNeed[0] = 0 Then
        Local $iNeedError = __AUI_ReadNativeLastError()
        If @error Then Return SetError(@error, 0, Binary(""))
        If $iNeedError <> $AUI_OK Then Return SetError($iNeedError, 0, Binary(""))
        Return SetError(0, 0, Binary(""))
    EndIf
    Local $tData = DllStructCreate("byte[" & $aNeed[0] & "]")
    If @error Or Not IsDllStruct($tData) Then
        $g_iAuiUdfErrorCode = $AUI_ERR_LIMIT_EXCEEDED
        Return SetError($g_iAuiUdfErrorCode, 0, Binary(""))
    EndIf
    Local $pData = DllStructGetPtr($tData)
    If @error Or $pData = 0 Then
        $g_iAuiUdfErrorCode = $AUI_ERR_IO
        Return SetError($g_iAuiUdfErrorCode, 0, Binary(""))
    EndIf
    Local $aRead = __AUI_DllCall("int", "_UI_DbColumnBlob", "uint64", $iStatement, "int", $iColumn, _
            "ptr", $pData, "int", $aNeed[0])
    If @error Or Not IsArray($aRead) Then Return SetError(@error ? @error : $AUI_ERR_IO, 0, Binary(""))
    If $aRead[0] < 0 Or $aRead[0] > $aNeed[0] Then
        $g_iAuiUdfErrorCode = $AUI_ERR_BUFFER_TOO_SMALL
        Return SetError($g_iAuiUdfErrorCode, $aRead[0], Binary(""))
    EndIf
    If $aRead[0] <> $aNeed[0] Then
        $g_iAuiUdfErrorCode = $AUI_ERR_NOT_READY
        Return SetError($g_iAuiUdfErrorCode, $aRead[0], Binary(""))
    EndIf
    Return SetError(0, 0, DllStructGetData($tData, 1))
EndFunc

; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_DbColumnValue
; 說明 ...: Reads one result column according to its current SQLite storage class.
; 語法 ........: _UI_DbColumnValue( $iStatement, $iColumn )
; 參數 ....: $iStatement - Statement ID
;                  $iColumn - Zero-based column index
; 傳回值 .: Returns Int64, Double, String, Binary, or Null; failure returns Null and sets @error
; 作者 ........: Fanxing
; 相關函式 .......: _UI_DbColumnType, _UI_DbFetchRow
; 範例 .......: Yes
; ===============================================================================================================================
Func _UI_DbColumnValue($iStatement, $iColumn)
    Local $iValueError, $iValueExtended   ; 修正：原本只在某個分支內宣告，其他分支執行時會出現「變數未宣告」
    Local $iType = _UI_DbColumnType($iStatement, $iColumn)
    Local $iTypeError = @error, $iTypeExtended = @extended
    If $iType < $AUI_DB_INTEGER Or $iType > $AUI_DB_NULL Then
        Local $iResolvedError = __AUI_DbResolveFailure($iTypeError, $iTypeExtended)
        Local $iResolvedExtended = @extended
        Return SetError($iResolvedError, $iResolvedExtended, Null)
    EndIf
    Switch $iType
        Case $AUI_DB_INTEGER
            Local $iValue = _UI_DbColumnInt64($iStatement, $iColumn)
            $iValueError = @error
            $iValueExtended = @extended
            If $iValueError Then Return SetError($iValueError, $iValueExtended, Null)
            Return SetError(0, 0, $iValue)
        Case $AUI_DB_FLOAT
            Local $fValue = _UI_DbColumnDouble($iStatement, $iColumn)
            $iValueError = @error
			$iValueExtended = @extended
            If $iValueError Then Return SetError($iValueError, $iValueExtended, Null)
            Return SetError(0, 0, $fValue)
        Case $AUI_DB_TEXT
            Local $sValue = _UI_DbColumnText($iStatement, $iColumn)
            $iValueError = @error
			$iValueExtended = @extended
            If $iValueError Then Return SetError($iValueError, $iValueExtended, Null)
            Return SetError(0, 0, $sValue)
        Case $AUI_DB_BLOB
            Local $bValue = _UI_DbColumnBlob($iStatement, $iColumn)
            $iValueError = @error
			$iValueExtended = @extended
            If $iValueError Then Return SetError($iValueError, $iValueExtended, Null)
            Return SetError(0, 0, $bValue)
        Case $AUI_DB_NULL
            Return SetError(0, 0, Null)
    EndSwitch
    $g_iAuiUdfErrorCode = $AUI_ERR_DATABASE
    Return SetError($g_iAuiUdfErrorCode, 0, Null)
EndFunc

; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_DbFetchColumnNames
; 說明 ...: Reads all result column names from a prepared statement into a one-dimensional array.
; 語法 ........: _UI_DbFetchColumnNames( $iStatement, ByRef $aNames )
; 參數 ....: $iStatement - Statement ID
;                  $aNames - [Output] Receives the column-name array on success
; 傳回值 .: Success - The column count; Failure - -1 and sets @error
; 作者 ........: Fanxing
; 相關函式 .......: _UI_DbColumnName, _UI_DbFetchRow
; 範例 .......: Yes
; ===============================================================================================================================
Func _UI_DbFetchColumnNames($iStatement, ByRef $aNames)
    Local $iCount = _UI_DbColumnCount($iStatement)
    Local $iCountError = @error, $iCountExtended = @extended
    If $iCount < 0 Then
        Local $iResolvedError = __AUI_DbResolveFailure($iCountError, $iCountExtended)
        Local $iResolvedExtended = @extended
        Return SetError($iResolvedError, $iResolvedExtended, -1)
    EndIf
    Local $aResult[$iCount]
    For $i = 0 To $iCount - 1
        $aResult[$i] = _UI_DbColumnName($iStatement, $i)
        Local $iNameError = @error
        If $iNameError Then Return SetError($iNameError, $i, -1)
    Next
    $aNames = $aResult
    Return SetError(0, 0, $iCount)
EndFunc

; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_DbFetchRow
; 說明 ...: Steps a statement and reads the current row into a typed one-dimensional array.
; 語法 ........: _UI_DbFetchRow( $iStatement, ByRef $aRow )
; 參數 ....: $iStatement - Statement ID
;                  $aRow - [Output] Receives the current row for ROW or an empty array for DONE
; 傳回值 .: Returns $AUI_DB_ROW for a row, $AUI_DB_DONE when complete, or -1 on failure and sets @error
; 作者 ........: Fanxing
; 相關函式 .......: _UI_DbFetchColumnNames, _UI_DbColumnValue
; 範例 .......: Yes
; ===============================================================================================================================
Func _UI_DbFetchRow($iStatement, ByRef $aRow)
    Local $iResolvedError, $iResolvedExtended   ; 修正：原本只在某個分支內宣告，其他分支執行時會出現「變數未宣告」
    Local $iStep = _UI_DbStep($iStatement)
    Local $iStepError = @error, $iStepExtended = @extended
    If $iStep = $AUI_DB_DONE Then
        Local $aEmpty[0]
        $aRow = $aEmpty
        Return SetError(0, 0, $AUI_DB_DONE)
    EndIf
    If $iStep <> $AUI_DB_ROW Then
        $iResolvedError = __AUI_DbResolveFailure($iStepError, $iStepExtended)
        $iResolvedExtended = @extended
        Return SetError($iResolvedError, $iResolvedExtended, -1)
    EndIf
    Local $iCount = _UI_DbColumnCount($iStatement)
    Local $iCountError = @error, $iCountExtended = @extended
    If $iCount < 0 Then
        $iResolvedError = __AUI_DbResolveFailure($iCountError, $iCountExtended)
        $iResolvedExtended = @extended
        Return SetError($iResolvedError, $iResolvedExtended, -1)
    EndIf
    Local $aResult[$iCount]
    For $i = 0 To $iCount - 1
        $aResult[$i] = _UI_DbColumnValue($iStatement, $i)
        Local $iColumnError = @error
        If $iColumnError Then Return SetError($iColumnError, $i, -1)
    Next
    $aRow = $aResult
    Return SetError(0, 0, $AUI_DB_ROW)
EndFunc

