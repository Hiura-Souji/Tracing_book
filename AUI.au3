; ────────────────────────────────────────────────────────────────────────────
;  DataView
; ────────────────────────────────────────────────────────────────────────────
Func __AUI_DataViewArrayToText(Const ByRef $aData)
    If Not IsArray($aData) Then
        $g_iAuiUdfErrorCode = $AUI_ERR_INVALID_ARGUMENT
        Return SetError($g_iAuiUdfErrorCode, 0, "")
    EndIf
    Local $iDimensions = UBound($aData, 0)
    If $iDimensions < 1 Or $iDimensions > 2 Then
        $g_iAuiUdfErrorCode = $AUI_ERR_INVALID_ARGUMENT
        Return SetError($g_iAuiUdfErrorCode, 0, "")
    EndIf
    Local $iRows = UBound($aData, 1)
    Local $iColumns = 1
    If $iDimensions = 2 Then $iColumns = UBound($aData, 2)
    Local $sResult = ""
    For $iRow = 0 To $iRows - 1
        If $iRow > 0 Then $sResult &= @CRLF
        For $iColumn = 0 To $iColumns - 1
            If $iColumn > 0 Then $sResult &= @TAB
            Local $sCell = $iDimensions = 1 ? String($aData[$iRow]) : String($aData[$iRow][$iColumn])
            If StringInStr($sCell, @TAB) Or StringInStr($sCell, @CR) Or StringInStr($sCell, @LF) Then
                $g_iAuiUdfErrorCode = $AUI_ERR_INVALID_ARGUMENT
                Return SetError($g_iAuiUdfErrorCode, $iRow, "")
            EndIf
            $sResult &= $sCell
        Next
    Next
    Return SetError(0, 0, $sResult)
EndFunc

Func __AUI_DataViewCollect($hWnd, $iDataView, $sCountExport, $sItemExport, $sReturnType, $iMaxItems)
    Local $iCount = __AUI_Call("int", $sCountExport, "hwnd", $hWnd, "int", $iDataView)
    If @error Then Return SetError(@error, 0, 0)
    If $iCount = 0 Then
        Local $iCountError = _UI_GetLastError()
        If $iCountError <> $AUI_OK Then Return SetError($iCountError, 0, 0)
    EndIf
    If $iMaxItems < 0 Or $iCount > $iMaxItems Then
        $g_iAuiUdfErrorCode = $AUI_ERR_LIMIT_EXCEEDED
        Return SetError($g_iAuiUdfErrorCode, $iCount, 0)
    EndIf
    Local $aResult[$iCount]
    For $iIndex = 0 To $iCount - 1
        $aResult[$iIndex] = __AUI_Call($sReturnType, $sItemExport, "hwnd", $hWnd, "int", $iDataView, "int", $iIndex)
        If @error Then Return SetError(@error, $iIndex, 0)
        If $sReturnType = "int64" And $aResult[$iIndex] = 0 Then
            Local $iNativeError = _UI_GetLastError()
            If $iNativeError <> $AUI_OK Then Return SetError($iNativeError, $iIndex, 0)
        EndIf
    Next
    Return SetError(0, 0, $aResult)
EndFunc

Func __AUI_DataRangeProxy($hWnd, $iDataView, $iToken, $iFirst, $iCount, $iRevision)
    Local $f = __AUI_CbGet($__AUI_CB_DATAVIEW_RANGE, $iDataView, $hWnd)
    If $f <> "" Then Call($f, $iDataView, $iToken, $iFirst, $iCount, $iRevision)
EndFunc

Func __AUI_DataRowIdProxy($hWnd, $iDataView, $iRow)
    Local $f = __AUI_CbGet($__AUI_CB_DATAVIEW_ROW_ID, $iDataView, $hWnd)
    If $f = "" Then Return 0
    Local $iRowId = Call($f, $iRow)
    If @error Or Not __AUI_IsIntegerVariant($iRowId) Or $iRowId <= 0 Then Return 0
    Return $iRowId
EndFunc

