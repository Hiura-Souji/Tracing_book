; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_MediaViewOnEvent
; 說明 ...: Registers media event callback Func($iEvent); only forward AUI_MEDIA_EVENT_* stable event subset.
; 語法 ........: _UI_MediaViewOnEvent($hWnd, $iMedia, $sFuncName)
; 參數 ....: $hWnd - Window handle
;                  $iMedia - MediaView element ID
;                  $sFuncName - Callback function name, signature is Func($iEvent); empty string clear callback
; 傳回值 .: Success 1, Failure 0
; 作者 ........: Fanxing
; 範例 .......: Yes
; ===============================================================================================================================
Func _UI_MediaViewOnEvent($hWnd, $iMedia, $sFuncName)
    If __AUI_ValidateOptionalCallback($sFuncName) = 0 Then Return SetError(@error, 0, 0)
    If $sFuncName <> "" And $g_pAuiDispMedia = 0 Then $g_pAuiDispMedia = __AUI_RegisterCallback("__AUI_DispMedia", "hwnd;int;int")
    If $sFuncName <> "" And $g_pAuiDispMedia = 0 Then Return SetError($AUI_UDF_ERR_CALLBACK_REGISTER, 0, 0)
    Local $sOld = __AUI_CbGet($__AUI_CB_MEDIA, $iMedia, $hWnd)
    If __AUI_CbSet($__AUI_CB_MEDIA, $iMedia, $sFuncName, $hWnd) = 0 Then Return SetError($AUI_UDF_ERR_INVALID_CALLBACK, 0, 0)
    Local $p = $sFuncName = "" ? 0 : $g_pAuiDispMedia
    Local $r = __AUI_Call("int", "_UI_MediaViewOnEvent", "hwnd", $hWnd, "int", $iMedia, "ptr", $p)
    Local $e = @error
    If $e Or $r = 0 Then
        __AUI_CbSet($__AUI_CB_MEDIA, $iMedia, $sOld, $hWnd)
        Return SetError($e, 0, 0)
    EndIf
    Return SetError(0, 0, 1)
EndFunc

; ────────────────────────────────────────────────────────────────────────────
;  SQLite Database
; ────────────────────────────────────────────────────────────────────────────
Func __AUI_DbFailureCode($iFallback = $AUI_ERR_DATABASE)
    Local $iError = __AUI_ReadNativeLastError()
    If @error Or $iError = $AUI_OK Then Return $iFallback
    Return $iError
EndFunc

Func __AUI_DbResolveFailure($iError, $iExtended, $iFallback = $AUI_ERR_DATABASE)
    If $iError Then Return SetError(0, $iExtended, $iError)
    Local $iResolved = __AUI_DbFailureCode($iFallback)
    Return SetError(0, 0, $iResolved)
EndFunc

Func __AUI_DbParametersOmitted($vParameters)
    Return IsKeyword($vParameters) = 1
EndFunc

Func __AUI_DbReadStatementText($sFunction, $iStatement, $iColumn)
    Local $aNeed = __AUI_DllCall("int", $sFunction, "uint64", $iStatement, "int", $iColumn, "ptr", 0, "int", 0)
    If @error Or Not IsArray($aNeed) Or $aNeed[0] < 0 Then Return SetError(@error ? @error : $AUI_ERR_DATABASE, 0, "")
    If $aNeed[0] = 0 Then
        Local $iNeedError = __AUI_ReadNativeLastError()
        If @error Then Return SetError(@error, 0, "")
        If $iNeedError <> $AUI_OK Then Return SetError($iNeedError, 0, "")
    EndIf
    Local $iCapacity = $aNeed[0] + 1
    Local $tBuffer = DllStructCreate("byte[" & ($iCapacity * 2) & "]")
    If @error Or Not IsDllStruct($tBuffer) Then
        $g_iAuiUdfErrorCode = $AUI_ERR_LIMIT_EXCEEDED
        Return SetError($g_iAuiUdfErrorCode, 0, "")
    EndIf
    Local $pBuffer = DllStructGetPtr($tBuffer)
    If @error Or $pBuffer = 0 Then
        $g_iAuiUdfErrorCode = $AUI_ERR_IO
        Return SetError($g_iAuiUdfErrorCode, 0, "")
    EndIf
    Local $aRead = __AUI_DllCall("int", $sFunction, "uint64", $iStatement, "int", $iColumn, _
            "ptr", $pBuffer, "int", $iCapacity)
    If @error Or Not IsArray($aRead) Then Return SetError(@error ? @error : $AUI_ERR_IO, 0, "")
    If $aRead[0] < 0 Then Return SetError(__AUI_ReadNativeLastError(), 0, "")
    If $aRead[0] >= $iCapacity Then
        $g_iAuiUdfErrorCode = $AUI_ERR_BUFFER_TOO_SMALL
        Return SetError($g_iAuiUdfErrorCode, $aRead[0] + 1, "")
    EndIf
    If $aRead[0] <> $aNeed[0] Then
        $g_iAuiUdfErrorCode = $AUI_ERR_NOT_READY
        Return SetError($g_iAuiUdfErrorCode, $aRead[0], "")
    EndIf
    If $aRead[0] = 0 Then
        Local $iReadError = __AUI_ReadNativeLastError()
        If @error Then Return SetError(@error, 0, "")
        If $iReadError <> $AUI_OK Then Return SetError($iReadError, 0, "")
        Return SetError(0, 0, "")
    EndIf
    Local $bText = BinaryMid(DllStructGetData($tBuffer, 1), 1, $aRead[0] * 2)
    Return SetError(0, 0, BinaryToString($bText, 2))
EndFunc

Func __AUI_DbReadStatementNumber($sReturnType, $sFunction, $iStatement, $iColumn, $vFailure)
    Local $aResult = __AUI_DllCall($sReturnType, $sFunction, "uint64", $iStatement, "int", $iColumn)
    Local $iDllError = @error
    If $iDllError Or Not IsArray($aResult) Then Return SetError($iDllError ? $iDllError : $AUI_ERR_IO, 0, $vFailure)
    Local $iNativeError = __AUI_ReadNativeLastError()
    $iDllError = @error
    If $iDllError Then Return SetError($iDllError, 0, $vFailure)
    If $iNativeError <> $AUI_OK Then Return SetError($iNativeError, 0, $vFailure)
    Return SetError(0, 0, $aResult[0])
EndFunc

Func __AUI_DbReadConnectionText($sFunction, $iDatabase)
    Local $aNeed = __AUI_DllCall("int", $sFunction, "uint64", $iDatabase, "ptr", 0, "int", 0)
    If @error Or Not IsArray($aNeed) Or $aNeed[0] < 0 Then Return SetError(@error ? @error : $AUI_ERR_DATABASE, 0, "")
    If $aNeed[0] = 0 Then
        Local $iNeedError = __AUI_ReadNativeLastError()
        If @error Then Return SetError(@error, 0, "")
        If $iNeedError <> $AUI_OK Then Return SetError($iNeedError, 0, "")
    EndIf
    Local $iCapacity = $aNeed[0] + 1
    Local $tBuffer = DllStructCreate("wchar[" & $iCapacity & "]")
    If @error Or Not IsDllStruct($tBuffer) Then
        $g_iAuiUdfErrorCode = $AUI_ERR_LIMIT_EXCEEDED
        Return SetError($g_iAuiUdfErrorCode, 0, "")
    EndIf
    Local $pBuffer = DllStructGetPtr($tBuffer)
    If @error Or $pBuffer = 0 Then
        $g_iAuiUdfErrorCode = $AUI_ERR_IO
        Return SetError($g_iAuiUdfErrorCode, 0, "")
    EndIf
    Local $aRead = __AUI_DllCall("int", $sFunction, "uint64", $iDatabase, _
            "ptr", $pBuffer, "int", $iCapacity)
    If @error Or Not IsArray($aRead) Then Return SetError(@error ? @error : $AUI_ERR_IO, 0, "")
    If $aRead[0] < 0 Then Return SetError(__AUI_ReadNativeLastError(), 0, "")
    If $aRead[0] >= $iCapacity Then
        $g_iAuiUdfErrorCode = $AUI_ERR_BUFFER_TOO_SMALL
        Return SetError($g_iAuiUdfErrorCode, $aRead[0] + 1, "")
    EndIf
    If $aRead[0] <> $aNeed[0] Then
        $g_iAuiUdfErrorCode = $AUI_ERR_NOT_READY
        Return SetError($g_iAuiUdfErrorCode, $aRead[0], "")
    EndIf
    If $aRead[0] = 0 Then
        Local $iReadError = __AUI_ReadNativeLastError()
        If @error Then Return SetError(@error, 0, "")
        If $iReadError <> $AUI_OK Then Return SetError($iReadError, 0, "")
    EndIf
    Return SetError(0, 0, DllStructGetData($tBuffer, 1))
EndFunc

Func __AUI_DbReadGlobalText($sFunction)
    Local $aNeed = __AUI_DllCall("int", $sFunction, "ptr", 0, "int", 0)
    If @error Or Not IsArray($aNeed) Or $aNeed[0] < 0 Then Return SetError(@error ? @error : $AUI_ERR_DATABASE, 0, "")
    If $aNeed[0] = 0 Then
        Local $iNeedError = __AUI_ReadNativeLastError()
        If @error Then Return SetError(@error, 0, "")
        If $iNeedError <> $AUI_OK Then Return SetError($iNeedError, 0, "")
    EndIf
    Local $iCapacity = $aNeed[0] + 1
    Local $tBuffer = DllStructCreate("wchar[" & $iCapacity & "]")
    If @error Or Not IsDllStruct($tBuffer) Then
        $g_iAuiUdfErrorCode = $AUI_ERR_LIMIT_EXCEEDED
        Return SetError($g_iAuiUdfErrorCode, 0, "")
    EndIf
    Local $pBuffer = DllStructGetPtr($tBuffer)
    If @error Or $pBuffer = 0 Then
        $g_iAuiUdfErrorCode = $AUI_ERR_IO
        Return SetError($g_iAuiUdfErrorCode, 0, "")
    EndIf
    Local $aRead = __AUI_DllCall("int", $sFunction, "ptr", $pBuffer, "int", $iCapacity)
    If @error Or Not IsArray($aRead) Then Return SetError(@error ? @error : $AUI_ERR_IO, 0, "")
    If $aRead[0] < 0 Then Return SetError(__AUI_ReadNativeLastError(), 0, "")
    If $aRead[0] >= $iCapacity Then
        $g_iAuiUdfErrorCode = $AUI_ERR_BUFFER_TOO_SMALL
        Return SetError($g_iAuiUdfErrorCode, $aRead[0] + 1, "")
    EndIf
    If $aRead[0] <> $aNeed[0] Then
        $g_iAuiUdfErrorCode = $AUI_ERR_NOT_READY
        Return SetError($g_iAuiUdfErrorCode, $aRead[0], "")
    EndIf
    If $aRead[0] = 0 Then
        Local $iReadError = __AUI_ReadNativeLastError()
        If @error Then Return SetError(@error, 0, "")
        If $iReadError <> $AUI_OK Then Return SetError($iReadError, 0, "")
    EndIf
    Return SetError(0, 0, DllStructGetData($tBuffer, 1))
EndFunc

Func __AUI_DbValueBytes($vValue)
    If IsString($vValue) Then Return StringLen($vValue) * 2
    If IsBinary($vValue) Then Return BinaryLen($vValue)
    If IsKeyword($vValue) Then Return 0
    Return 8
EndFunc

; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_DbOpen
; 說明 ...: Opens a SQLite database and returns an opaque AUI-managed connection ID.
; 語法 ........: _UI_DbOpen( $sPath [, $iFlags = $AUI_DB_OPEN_DEFAULT] )
; 參數 ....: $sPath - Database path, :memory:, or a file: URI when URI support is enabled
;                  $iFlags - [Optional] $AUI_DB_OPEN_* Bitwise combination of flags
; 傳回值 .: Success - A positive connection ID; Failure - 0. Call _UI_DbGetErrorText(0) to retrieve the open error
; 作者 ........: Fanxing
; 備註 .......: AUI and AutoIt exchange strings as UTF-16 at the call boundary; newly created database files default to
;                  UTF-8. Existing UTF-8, UTF-16LE, and UTF-16BE databases can be opened directly, and writes preserve their
;                  file encoding. Ordinary local paths are normalized and use the locking win32-longpath VFS. A file: URI must
;                  be enabled explicitly; nolock, non-locking VFS options, and writable immutable connections are prohibited.
;                  Different connections can run concurrently; do not interleave ordinary operations on the same connection.
; 相關函式 .......: _UI_DbClose, _UI_DbGetErrorText
; 範例 .......: Yes
; ===============================================================================================================================
Func _UI_DbOpen($sPath, $iFlags = $AUI_DB_OPEN_DEFAULT)
    Local $vAuiForwardResult = __AUI_Call("uint64", "_UI_DbOpen", "wstr", $sPath, "int", $iFlags)
    Return SetError(@error, @extended, $vAuiForwardResult)
EndFunc

; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_DbClose
; 說明 ...: Rolls back an unfinished transaction, finalizes all owned statements, and closes the database connection.
; 語法 ........: _UI_DbClose( $iDatabase )
; 參數 ....: $iDatabase - Connection ID returned by _UI_DbOpen
; 傳回值 .: Success 1, Failure 0
; 作者 ........: Fanxing
; 相關函式 .......: _UI_DbOpen, _UI_DbFinalize
; 範例 .......: Yes
; ===============================================================================================================================
Func _UI_DbClose($iDatabase)
    Local $vAuiForwardResult = __AUI_Call("int", "_UI_DbClose", "uint64", $iDatabase)
    Return SetError(@error, @extended, $vAuiForwardResult)
EndFunc

; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_DbExec
; 說明 ...: Executes a single SQL statement or a multi-statement SQL script that does not require row-by-row result
;                  processing.
; 語法 ........: _UI_DbExec( $iDatabase, $sSql )
; 參數 ....: $iDatabase - Database connection ID
;                  $sSql - A single SQL statement or a multi-statement SQL script
; 傳回值 .: Success 1, Failure 0
; 作者 ........: Fanxing
; 相關函式 .......: _UI_DbPrepare, _UI_DbGetErrorText
; 範例 .......: Yes
; ===============================================================================================================================
Func _UI_DbExec($iDatabase, $sSql)
    Local $vAuiForwardResult = __AUI_Call("int", "_UI_DbExec", "uint64", $iDatabase, "wstr", $sSql)
    Return SetError(@error, @extended, $vAuiForwardResult)
EndFunc

; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_DbPrepare
; 說明 ...: Compiles one SQL statement and returns an opaque AUI-managed statement ID.
; 語法 ........: _UI_DbPrepare( $iDatabase, $sSql [, $iFlags = $AUI_DB_PREPARE_DEFAULT] )
; 參數 ....: $iDatabase - Database connection ID
;                  $sSql - One SQL statement
;                  $iFlags - [Optional] $AUI_DB_PREPARE_* flag
; 傳回值 .: Success - A positive statement ID; Failure - 0
; 作者 ........: Fanxing
; 備註 .......: The input must contain exactly one effective statement; trailing whitespace, semicolons, and comments do not
;                  count as a second statement.
; 相關函式 .......: _UI_DbStep, _UI_DbFinalize
; 範例 .......: Yes
; ===============================================================================================================================
Func _UI_DbPrepare($iDatabase, $sSql, $iFlags = $AUI_DB_PREPARE_DEFAULT)
    Local $vAuiForwardResult = __AUI_Call("uint64", "_UI_DbPrepare", "uint64", $iDatabase, "wstr", $sSql, "int", $iFlags)
    Return SetError(@error, @extended, $vAuiForwardResult)
EndFunc

; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_DbFinalize
; 說明 ...: Releases prepared statements.
; 語法 ........: _UI_DbFinalize( $iStatement )
; 參數 ....: $iStatement - Statement ID returned by _UI_DbPrepare
; 傳回值 .: Success 1, Failure 0
; 作者 ........: Fanxing
; 相關函式 .......: _UI_DbPrepare, _UI_DbReset
; 範例 .......: Yes
; ===============================================================================================================================
Func _UI_DbFinalize($iStatement)
    Local $vAuiForwardResult = __AUI_Call("int", "_UI_DbFinalize", "uint64", $iStatement)
    Return SetError(@error, @extended, $vAuiForwardResult)
EndFunc

; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_DbReset
; 說明 ...: Resets prepared statements for execution again; existing parameter bindings remain unchanged.
; 語法 ........: _UI_DbReset( $iStatement )
; 參數 ....: $iStatement - Statement ID
; 傳回值 .: Success 1, Failure 0
; 作者 ........: Fanxing
; 備註 .......: After a statement reaches $AUI_DB_DONE or fails, reset it before binding or executing it again. Resetting a
;                  valid statement returns 1. An error already reported by the previous _UI_DbStep is not reported again as a
;                  Reset failure.
; 相關函式 .......: _UI_DbClearBindings, _UI_DbStep
; 範例 .......: Yes
; ===============================================================================================================================
Func _UI_DbReset($iStatement)
    Local $vAuiForwardResult = __AUI_Call("int", "_UI_DbReset", "uint64", $iStatement)
    Return SetError(@error, @extended, $vAuiForwardResult)
EndFunc

; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_DbClearBindings
; 說明 ...: Resets all parameter bindings for a statement to NULL.
; 語法 ........: _UI_DbClearBindings( $iStatement )
; 參數 ....: $iStatement - Statement ID
; 傳回值 .: Success 1, Failure 0
; 作者 ........: Fanxing
; 相關函式 .......: _UI_DbReset, _UI_DbBindText
; 範例 .......: Yes
; ===============================================================================================================================
Func _UI_DbClearBindings($iStatement)
    Local $vAuiForwardResult = __AUI_Call("int", "_UI_DbClearBindings", "uint64", $iStatement)
    Return SetError(@error, @extended, $vAuiForwardResult)
EndFunc

