; ────────────────────────────────────────────────────────────────────────────
;  Pagination
; ────────────────────────────────────────────────────────────────────────────
; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_Pagination
; 說明 ...: Creates paginator.
; 語法 ........: _UI_Pagination( $hWnd, $iParent, $iTotal [, $iPageSize = 10 [, $iCurrent = 1 [, $iX = 0 [, $iY = 0 [, $iW = 0
;                  [, $iH = 0]]]]]] )
; 參數 ....: $hWnd - Window handle returned by _UI_WindowCreate
;                  $iParent - Parent element ID; use 0 for the window root
;                  $iTotal - Total number of entries
;                  $iPageSize - [Optional] Number of items per page, default 10
;                  $iCurrent - [Optional] Current page number (starting from 1), default 1
;                  $iX - [Optional] Logical X coordinate (relative to parent container; ignored in flexible containers such as
;                  Row/Column), default 0
;                  $iY - [Optional] Logical Y coordinate (relative to parent container; ignored in flexible containers), default
;                  0
;                  $iW - [Optional] Logical width; 0 = automatically determined/filled by layout, default 0
;                  $iH - [Optional] Logical height; 0 = automatically determined/filled by layout, default 0
; 傳回值 .: Success - New element ID (integer, >= 1)
;                  Failure - 0
; 作者 ........: Fanxing
; 相關函式 .......: _UI_OnValue
; 範例 .......: Yes
; ===============================================================================================================================
Func _UI_Pagination($hWnd, $iParent, $iTotal, $iPageSize = 10, $iCurrent = 1, _
                    $iX = 0, $iY = 0, $iW = 0, $iH = 0)
    Local $vAuiForwardResult = __AUI_Call("int", "_UI_Pagination", _
                       "hwnd", $hWnd, "int", $iParent, _
                       "int", $iTotal, "int", $iPageSize, "int", $iCurrent, _
                       "int", $iX, "int", $iY, "int", $iW, "int", $iH)
    Return SetError(@error, @extended, $vAuiForwardResult)
EndFunc

; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_PaginationSetModel
; 說明 ...: Atomically updates the Pagination item count and page size.
; 語法 ........: _UI_PaginationSetModel( $hWnd, $iPagination, $iTotal, $iPageSize )
; 參數 ....: $hWnd - Window handle returned by _UI_WindowCreate
;                  $iPagination - Pagination control ID
;                  $iTotal - Total number of entries, must >= 0
;                  $iPageSize - Number of entries per page, must > 0
; 傳回值 .: Success - 1
;                  Failure - 0
; 作者 ........: Fanxing
; 備註 .......: After the update, the total number of pages is recalculated, and when the current page exceeds the range, it
;                  is automatically clamped to the last page.
; 範例 .......: Yes
; ===============================================================================================================================
Func _UI_PaginationSetModel($hWnd, $iPagination, $iTotal, $iPageSize)
    Local $vAuiForwardResult = __AUI_Call("int", "_UI_PaginationSetModel", "hwnd", $hWnd, "int", $iPagination, "int", $iTotal, "int", $iPageSize)
    Return SetError(@error, @extended, $vAuiForwardResult)
EndFunc

