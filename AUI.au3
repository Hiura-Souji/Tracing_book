; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_DataViewOnAction
; 說明 ...: Registers in-row action button callback Func(row, stable RowID, column, button index).
; 語法 ........: _UI_DataViewOnAction( $hWnd, $iDataView, $sFuncName )
; 參數 ....: $hWnd - Window handle
;                  $iDataView - DataView control ID
;                  $sFuncName - Callback function name; empty string cancels callback
; 傳回值 .: Success - 1
;                  Failure - 0
; 作者 ........: Fanxing
; 備註 .......: Clicking the button will consume the interaction and will not trigger row selection, ordinary cell click,
;                  double-click editing or dragging.
; 相關函式 .......: _UI_DataViewSetColumnActions, _UI_DataViewGetRowId
; 範例 .......: Yes
; ===============================================================================================================================
Func _UI_DataViewOnAction($hWnd, $iDataView, $sFuncName)
    If __AUI_ValidateOptionalCallback($sFuncName) = 0 Then Return SetError(@error, 0, 0)
    If $sFuncName <> "" And $g_pAuiDispDataAction = 0 Then $g_pAuiDispDataAction = __AUI_RegisterCallback("__AUI_DataActionProxy", "hwnd;int;int;int64;int;int")
    If $sFuncName <> "" And $g_pAuiDispDataAction = 0 Then Return SetError(@error, 0, 0)
    Local $sOldFunc = __AUI_CbGet($__AUI_CB_DATAVIEW_ACTION, $iDataView, $hWnd)
    If __AUI_CbSet($__AUI_CB_DATAVIEW_ACTION, $iDataView, $sFuncName, $hWnd) = 0 Then Return SetError(@error, 0, 0)
    Local $pCallback = $sFuncName = "" ? 0 : $g_pAuiDispDataAction
    Local $iResult = __AUI_Call("int", "_UI_DataViewOnAction", "hwnd", $hWnd, "int", $iDataView, "ptr", $pCallback)
    Local $iCallError = @error
    If $iCallError Or $iResult = 0 Then
        __AUI_CbSet($__AUI_CB_DATAVIEW_ACTION, $iDataView, $sOldFunc, $hWnd)
        Return SetError($iCallError, 0, 0)
    EndIf
    Return SetError(0, 0, 1)
EndFunc

; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_DataViewOnLink
; 說明 ...: Registers link column callback Func(row, stableRowID, column, link text).
; 語法 ........: _UI_DataViewOnLink( $hWnd, $iDataView, $sFuncName )
; 參數 ....: $hWnd - Window handle
;                  $iDataView - DataView control ID
;                  $sFuncName - Callback function name; empty string cancels callback
; 傳回值 .: Success - 1
;                  Failure - 0
; 作者 ........: Fanxing
; 備註 .......: Triggered only by clicking the actual link text area; the library does not automatically open the address,
;                  and the callback determines how to handle it.
; 相關函式 .......: _UI_DataViewSetColumnType, _UI_DataViewGetRowId
; 範例 .......: Yes
; ===============================================================================================================================
Func _UI_DataViewOnLink($hWnd, $iDataView, $sFuncName)
    If __AUI_ValidateOptionalCallback($sFuncName) = 0 Then Return SetError(@error, 0, 0)
    If $sFuncName <> "" And $g_pAuiDispDataLink = 0 Then $g_pAuiDispDataLink = __AUI_RegisterCallback("__AUI_DataLinkProxy", "hwnd;int;int;int64;int;wstr")
    If $sFuncName <> "" And $g_pAuiDispDataLink = 0 Then Return SetError(@error, 0, 0)
    Local $sOldFunc = __AUI_CbGet($__AUI_CB_DATAVIEW_LINK, $iDataView, $hWnd)
    If __AUI_CbSet($__AUI_CB_DATAVIEW_LINK, $iDataView, $sFuncName, $hWnd) = 0 Then Return SetError(@error, 0, 0)
    Local $pCallback = $sFuncName = "" ? 0 : $g_pAuiDispDataLink
    Local $iResult = __AUI_Call("int", "_UI_DataViewOnLink", "hwnd", $hWnd, "int", $iDataView, "ptr", $pCallback)
    Local $iCallError = @error
    If $iCallError Or $iResult = 0 Then
        __AUI_CbSet($__AUI_CB_DATAVIEW_LINK, $iDataView, $sOldFunc, $hWnd)
        Return SetError($iCallError, 0, 0)
    EndIf
    Return SetError(0, 0, 1)
EndFunc

; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_DataViewSetColumnTag
; 說明 ...: Sets a column as a capsule label and specify the default semantic appearance.
; 語法 ........: _UI_DataViewSetColumnTag( $hWnd, $iDataView, $iCol [, $iVariant = $AUI_VAR_DEFAULT] )
; 參數 ....: $hWnd - Window handle
;                  $iDataView - DataView control ID
;                  $iCol - Zero-based column index
;                  $iVariant - [Optional] $AUI_VAR_DEFAULT/PRIMARY/SUCCESS/WARNING/DANGER, default neutral
; 傳回值 .: Success - 1
;                  Failure - 0
; 作者 ........: Fanxing
; 相關函式 .......: _UI_DataViewGetColumnTag, _UI_DataViewSetColumnTagVariant
; 範例 .......: Yes
; ===============================================================================================================================
Func _UI_DataViewSetColumnTag($hWnd, $iDataView, $iCol, $iVariant = $AUI_VAR_DEFAULT)
    Local $vAuiForwardResult = __AUI_Call("int", "_UI_DataViewSetColumnTag", "hwnd", $hWnd, "int", $iDataView, "int", $iCol, "int", $iVariant)
    Return SetError(@error, @extended, $vAuiForwardResult)
EndFunc

