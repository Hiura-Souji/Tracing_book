Func __AUI_IsCallable($vFunc)
    If IsFunc($vFunc) Then Return True
    If Not IsString($vFunc) Or $vFunc = "" Then Return False
    If Not StringRegExp($vFunc, "^[A-Za-z_][A-Za-z0-9_]*$") Then Return False
    Local $fResolved = Execute($vFunc)
    Return IsFunc($fResolved)
EndFunc

Func __AUI_RegisterCallback($sFuncName, $sSignature, $sRetType = "none")
    If Not __AUI_IsCallable($sFuncName) Then Return SetError($AUI_UDF_ERR_INVALID_CALLBACK, 0, 0)
    Local $hCb = DllCallbackRegister($sFuncName, $sRetType, $sSignature)
    If $hCb = 0 Then
        ConsoleWrite("[AUI] DllCallbackRegister failed: " & $sFuncName & @CRLF)
        Return SetError($AUI_UDF_ERR_CALLBACK_REGISTER, 0, 0)
    EndIf
    Local $n = UBound($g_aAuiCallbacks)
    ReDim $g_aAuiCallbacks[$n + 1][3]
    $g_aAuiCallbacks[$n][0] = $sFuncName
    $g_aAuiCallbacks[$n][1] = $hCb
    $g_aAuiCallbacks[$n][2] = $sSignature
    Local $pCallback = DllCallbackGetPtr($hCb)
    If $pCallback = 0 Then
        DllCallbackFree($hCb)
        ReDim $g_aAuiCallbacks[$n][3]
        Return SetError($AUI_UDF_ERR_CALLBACK_REGISTER, 0, 0)
    EndIf
    Return SetError(0, 0, $pCallback)
EndFunc

Func __AUI_FreeAllCallbacks()
    For $i = 0 To UBound($g_aAuiCallbacks) - 1
        If $g_aAuiCallbacks[$i][1] <> 0 Then
            DllCallbackFree($g_aAuiCallbacks[$i][1])
        EndIf
    Next
    ReDim $g_aAuiCallbacks[1][3]
EndFunc

Func __AUI_CbSet($iType, $iId, $vValue, $hWnd = 0, $bRequireCallable = True)
    If $bRequireCallable And $vValue = "" Then
        __AUI_CbDel($iType, $iId, $hWnd)
        Return SetError(0, 0, 1)
    EndIf
    If $bRequireCallable And Not __AUI_IsCallable($vValue) Then Return SetError($AUI_UDF_ERR_INVALID_CALLBACK, 0, 0)
    Local $sKey = $hWnd & ":" & $iType & ":" & $iId
    If IsObj($g_oAuiCbMap) Then
        $g_oAuiCbMap.Item($sKey) = $vValue
        Return SetError(0, 0, 1)
    EndIf
    For $i = 0 To UBound($g_aAuiCbMap) - 1
        If $g_aAuiCbMap[$i][0] = $sKey Then
            $g_aAuiCbMap[$i][1] = $vValue
            Return SetError(0, 0, 1)
        EndIf
    Next
    Local $n = UBound($g_aAuiCbMap)
    ReDim $g_aAuiCbMap[$n + 1][2]
    $g_aAuiCbMap[$n][0] = $sKey
    $g_aAuiCbMap[$n][1] = $vValue
    Return SetError(0, 0, 1)
EndFunc

Func __AUI_CbGet($iType, $iId, $hWnd = 0)
    Local $sKey = $hWnd & ":" & $iType & ":" & $iId
    If IsObj($g_oAuiCbMap) Then
        If $g_oAuiCbMap.Exists($sKey) Then Return $g_oAuiCbMap.Item($sKey)
        Return ""
    EndIf
    For $i = 0 To UBound($g_aAuiCbMap) - 1
        If $g_aAuiCbMap[$i][0] = $sKey Then Return $g_aAuiCbMap[$i][1]
    Next
    Return ""
EndFunc

Func __AUI_CbDel($iType, $iId, $hWnd = 0)
    Local $sKey = $hWnd & ":" & $iType & ":" & $iId
    If IsObj($g_oAuiCbMap) Then
        If $g_oAuiCbMap.Exists($sKey) Then $g_oAuiCbMap.Remove($sKey)
        Return
    EndIf
    Local $n = UBound($g_aAuiCbMap)
    For $i = 1 To $n - 1
        If $g_aAuiCbMap[$i][0] = $sKey Then
            If $i < $n - 1 Then
                $g_aAuiCbMap[$i][0] = $g_aAuiCbMap[$n - 1][0]
                $g_aAuiCbMap[$i][1] = $g_aAuiCbMap[$n - 1][1]
            EndIf
            ReDim $g_aAuiCbMap[$n - 1][2]
            Return
        EndIf
    Next
EndFunc

Func __AUI_IsElementCallbackType($iType)
    Switch $iType
        Case $__AUI_CB_CLICK, $__AUI_CB_CHANGE, $__AUI_CB_VALUE, $__AUI_CB_KEY, $__AUI_CB_NUMBER, $__AUI_CB_SLIDER_COMMIT, $__AUI_CB_FILE_DROP
            Return True
        Case $__AUI_CB_DATAVIEW_SORT, $__AUI_CB_DATAVIEW_CELL_EDITED, $__AUI_CB_DATAVIEW_CELL_CLICK, $__AUI_CB_DATAVIEW_ROW_DBLCLICK
            Return True
        Case $__AUI_CB_DATAVIEW_REORDER, $__AUI_CB_DATAVIEW_CHECK, $__AUI_CB_DATAVIEW_RANGE, $__AUI_CB_DATAVIEW_ROW_ID
            Return True
        Case $__AUI_CB_DATAVIEW_ACTION, $__AUI_CB_DATAVIEW_LINK
            Return True
        Case $__AUI_CB_TREE_SELECT, $__AUI_CB_TREE_DBLCLICK, $__AUI_CB_TREE_REORDER
            Return True
        Case $__AUI_CB_WEB_TAB_ADDED, $__AUI_CB_WEB_TAB_TITLE, $__AUI_CB_WEB_TAB_CLOSED, $__AUI_CB_WEB_TAB_LOADING
            Return True
        Case $__AUI_CB_WEB_PICK, $__AUI_CB_WEB_RESULT, $__AUI_CB_WEB_PICK_CACHE, $__AUI_CB_MEDIA
            Return True
    EndSwitch
    Return False
EndFunc

Func __AUI_CbDelElement($hWnd, $iId)
    Local $sOwnerPrefix = String($hWnd) & ":"
    Local $sElementId = String($iId)
    Local $sKey = "", $iSep1 = 0, $iSep2 = 0, $iType = 0, $sStoredId = ""
    If IsObj($g_oAuiCbMap) Then
        Local $aKeys = $g_oAuiCbMap.Keys
        For $i = 0 To UBound($aKeys) - 1
            $sKey = String($aKeys[$i])
            If StringLeft($sKey, StringLen($sOwnerPrefix)) <> $sOwnerPrefix Then ContinueLoop
            $iSep1 = StringInStr($sKey, ":")
            $iSep2 = StringInStr($sKey, ":", 0, 1, $iSep1 + 1)
            If $iSep2 <= $iSep1 Then ContinueLoop
            $iType = Number(StringMid($sKey, $iSep1 + 1, $iSep2 - $iSep1 - 1))
            If Not __AUI_IsElementCallbackType($iType) Then ContinueLoop
            $sStoredId = StringMid($sKey, $iSep2 + 1)
            If $sStoredId = $sElementId Or StringLeft($sStoredId, StringLen($sElementId) + 1) = $sElementId & ":" Then _
                $g_oAuiCbMap.Remove($sKey)
        Next
        __AUI_EventDelElement($hWnd, $iId)
        Return
    EndIf
    For $i = UBound($g_aAuiCbMap) - 1 To 1 Step -1
        $sKey = String($g_aAuiCbMap[$i][0])
        If StringLeft($sKey, StringLen($sOwnerPrefix)) <> $sOwnerPrefix Then ContinueLoop
        $iSep1 = StringInStr($sKey, ":")
        $iSep2 = StringInStr($sKey, ":", 0, 1, $iSep1 + 1)
        If $iSep2 <= $iSep1 Then ContinueLoop
        $iType = Number(StringMid($sKey, $iSep1 + 1, $iSep2 - $iSep1 - 1))
        If Not __AUI_IsElementCallbackType($iType) Then ContinueLoop
        $sStoredId = StringMid($sKey, $iSep2 + 1)
        If $sStoredId = $sElementId Or StringLeft($sStoredId, StringLen($sElementId) + 1) = $sElementId & ":" Then
            __AUI_CbDel($iType, $sStoredId, $hWnd)
        EndIf
    Next
    __AUI_EventDelElement($hWnd, $iId)
EndFunc

Func __AUI_DispDestroyed($hWnd, $iId)
    __AUI_CbDelElement($hWnd, $iId)
EndFunc

Func __AUI_ValidateOptionalCallback($sFuncName)
    If $sFuncName = "" Or __AUI_IsCallable($sFuncName) Then Return SetError(0, 0, 1)
    Return SetError($AUI_UDF_ERR_INVALID_CALLBACK, 0, 0)
EndFunc

Func __AUI_CbClear()
    If IsObj($g_oAuiCbMap) Then
        $g_oAuiCbMap.RemoveAll()
    Else
        ReDim $g_aAuiCbMap[1][2]
    EndIf
    __AUI_EventClear()
EndFunc

Func __AUI_CbDelWindow($hWnd)
    Local $sKey = "", $iType = 0, $sId = "", $sOwner = ""
    Local $iSep1 = 0, $iSep2 = 0
    Local $sWnd = String($hWnd)
    If IsObj($g_oAuiCbMap) Then
        Local $aKeys = $g_oAuiCbMap.Keys
        For $i = 0 To UBound($aKeys) - 1
            $sKey = String($aKeys[$i])
            $iSep1 = StringInStr($sKey, ":")
            $iSep2 = StringInStr($sKey, ":", 0, 1, $iSep1 + 1)
            If $iSep1 <= 1 Or $iSep2 <= $iSep1 Then ContinueLoop
            $sOwner = StringLeft($sKey, $iSep1 - 1)
            $iType = Number(StringMid($sKey, $iSep1 + 1, $iSep2 - $iSep1 - 1))
            $sId = StringMid($sKey, $iSep2 + 1)
            If $iType = $__AUI_CB_ASYNC_OWNER Then
                If Number($g_oAuiCbMap.Item($sKey)) = Number($hWnd) Then
                    __AUI_CbDel($__AUI_CB_ASYNC_DONE, Number($sId))
                    __AUI_CbDel($__AUI_CB_ASYNC_PROGRESS, Number($sId))
                    __AUI_CbDel($__AUI_CB_ASYNC_OWNER, Number($sId), Number($sOwner))
                EndIf
            ElseIf $iType = $__AUI_CB_HTTP_OWNER Then
                If Number($g_oAuiCbMap.Item($sKey)) = Number($hWnd) Then
                    __AUI_CbDel($__AUI_CB_HTTP_DONE, Number($sId))
                    __AUI_CbDel($__AUI_CB_HTTP_PROGRESS, Number($sId))
                    __AUI_CbDel($__AUI_CB_HTTP_EASY_DONE, Number($sId))
                    __AUI_CbDel($__AUI_CB_HTTP_EASY_MODE, Number($sId))
                    __AUI_CbDel($__AUI_CB_HTTP_EASY_TIMER, Number($sId))
                    __AUI_CbDel($__AUI_CB_HTTP_OWNER, Number($sId), Number($sOwner))
                EndIf
            ElseIf $iType = $__AUI_CB_WEBSOCKET_OWNER Then
                If Number($g_oAuiCbMap.Item($sKey)) = Number($hWnd) Then
                    __AUI_CbDel($__AUI_CB_WEBSOCKET, Number($sId))
                    __AUI_CbDel($__AUI_CB_WEBSOCKET_OWNER, Number($sId), Number($sOwner))
                EndIf
            ElseIf $sOwner = $sWnd Then
                __AUI_CbDel($iType, $sId, $hWnd)
            EndIf
        Next
        __AUI_EventDelWindow($hWnd)
        Return
    EndIf

    If UBound($g_aAuiCbMap) <= 1 Then
        __AUI_EventDelWindow($hWnd)
        Return
    EndIf
    For $i = UBound($g_aAuiCbMap) - 1 To 1 Step -1
        $sKey = String($g_aAuiCbMap[$i][0])
        $iSep1 = StringInStr($sKey, ":")
        $iSep2 = StringInStr($sKey, ":", 0, 1, $iSep1 + 1)
        If $iSep1 <= 1 Or $iSep2 <= $iSep1 Then ContinueLoop
        $sOwner = StringLeft($sKey, $iSep1 - 1)
        $iType = Number(StringMid($sKey, $iSep1 + 1, $iSep2 - $iSep1 - 1))
        $sId = StringMid($sKey, $iSep2 + 1)
            If $iType = $__AUI_CB_ASYNC_OWNER Then
            If Number($g_aAuiCbMap[$i][1]) = Number($hWnd) Then
                __AUI_CbDel($__AUI_CB_ASYNC_DONE, Number($sId))
                __AUI_CbDel($__AUI_CB_ASYNC_PROGRESS, Number($sId))
                    __AUI_CbDel($__AUI_CB_ASYNC_OWNER, Number($sId), Number($sOwner))
                EndIf
            ElseIf $iType = $__AUI_CB_HTTP_OWNER Then
                If Number($g_aAuiCbMap[$i][1]) = Number($hWnd) Then
                    __AUI_CbDel($__AUI_CB_HTTP_DONE, Number($sId))
                    __AUI_CbDel($__AUI_CB_HTTP_PROGRESS, Number($sId))
                    __AUI_CbDel($__AUI_CB_HTTP_EASY_DONE, Number($sId))
                    __AUI_CbDel($__AUI_CB_HTTP_EASY_MODE, Number($sId))
                    __AUI_CbDel($__AUI_CB_HTTP_EASY_TIMER, Number($sId))
                    __AUI_CbDel($__AUI_CB_HTTP_OWNER, Number($sId), Number($sOwner))
                EndIf
            ElseIf $iType = $__AUI_CB_WEBSOCKET_OWNER Then
                If Number($g_aAuiCbMap[$i][1]) = Number($hWnd) Then
                    __AUI_CbDel($__AUI_CB_WEBSOCKET, Number($sId))
                    __AUI_CbDel($__AUI_CB_WEBSOCKET_OWNER, Number($sId), Number($sOwner))
                EndIf
        ElseIf $sOwner = $sWnd Then
            __AUI_CbDel($iType, $sId, $hWnd)
        EndIf
    Next
    __AUI_EventDelWindow($hWnd)
EndFunc

Func __AUI_SafeCall($sFunc, $a, $b, $c, $iArgc)
    Switch $iArgc
        Case 3
            Call($sFunc, $a, $b, $c)
        Case 2
            Call($sFunc, $a, $b)
        Case 1
            Call($sFunc, $a)
        Case Else
            Call($sFunc)
    EndSwitch
EndFunc

Func __AUI_SafeCallResult($sFunc, $a, $b, $c, $iArgc)
    Switch $iArgc
        Case 3
            Return Call($sFunc, $a, $b, $c)
        Case 2
            Return Call($sFunc, $a, $b)
        Case 1
            Return Call($sFunc, $a)
        Case Else
            Return Call($sFunc)
    EndSwitch
EndFunc

Func __AUI_CbDelAsyncForWindow($hWnd)
    __AUI_CbDelWindow($hWnd)
EndFunc

; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_Init
; 說明 ...: Initializes the runtime from the embedded data in the current single-file UDF. The first call to any _UI_*
;                  function also initializes it automatically.
; 語法 ........: _UI_Init()
; 參數 ....: None
; 傳回值 .: Success - 1
;                  Failure - 0
;                  @error - $AUI_UDF_ERR_EMBEDDED_DLL
; 作者 ........: Fanxing
; 備註 .......: AUI never loads an external runtime DLL from the script directory. Decompression, validation, or mapping
;                  failure never falls back to a disk file.
; 相關函式 .......: _UI_Shutdown, _UI_Version
; 範例 .......: No
; ===============================================================================================================================
Func _UI_Init()
    If __AUI_EnsureDll() = 0 Then Return SetError($g_iAuiLoadError, 0, 0)
    Return SetError(0, 0, 1)
EndFunc

; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_Shutdown
; 說明 ...: Shuts down the runtime safely and releases all AutoIt callback resources; the function is called
;                  automatically when the script exits.
; 語法 ........: _UI_Shutdown()
; 參數 ....: None
; 傳回值 .: Success - 1
;                  Failure - 0, and set @error; calling during callback execution will return $AUI_ERR_NOT_READY
; 作者 ........: Fanxing
; 備註 .......: Stops asynchronous tasks, waits for worker threads to exit, and releases all windows, window-scoped graphics
;                  resources, application objects, and callbacks. The embedded runtime image and process-wide shared graphics
;                  infrastructure remain loaded for reuse by a subsequent initialization.
; 相關函式 .......: _UI_Init
; 範例 .......: No
; ===============================================================================================================================
Func _UI_Shutdown()
    If $g_pAuiModule Then
        Local $aStop = __AUI_DllCall("int", "_UI_Shutdown")
        Local $iDllError = @error
        If $iDllError Or Not IsArray($aStop) Then Return SetError($iDllError, 0, 0)
        If $aStop[0] = 0 Then
            Local $aNativeError = __AUI_DllCall("int", "_UI_GetLastError")
            Local $iNativeError = $AUI_ERR_NOT_READY
            If Not @error And IsArray($aNativeError) Then $iNativeError = $aNativeError[0]
            Return SetError($iNativeError, 0, 0)
        EndIf
    EndIf
    __AUI_FreeAllCallbacks()
    __AUI_CbClear()
    $g_pAuiDispClick = 0
    $g_pAuiDispChange = 0
    $g_pAuiDispValue = 0
    $g_pAuiDispSliderCommit = 0
    $g_pAuiDispNumber = 0
    $g_pAuiDispKey = 0
    $g_pAuiDispFileDrop = 0
    $g_pAuiDispClose = 0
    $g_pAuiDispWindowDestroyed = 0
    $g_pAuiDispResize = 0
    $g_pAuiDispThemeChange = 0
    $g_pAuiDispBeforeClose = 0
    $g_pAuiDispIdle = 0
    $g_pAuiDispTimer = 0
    $g_pAuiDispSort = 0
    $g_pAuiDispCellEdited = 0
    $g_pAuiDispAsyncDone = 0
    $g_pAuiDispAsyncProgress = 0
    $g_pAuiDispHttpDone = 0
    $g_pAuiDispHttpProgress = 0
    $g_pAuiDispWebSocket = 0
    $g_pAuiDispDataRange = 0
    $g_pAuiDispDataRowId = 0
    $g_pAuiDispDataAction = 0
    $g_pAuiDispDataLink = 0
    $g_pAuiDispCellClick = 0
    $g_pAuiDispRowDbl = 0
    $g_pAuiDispReorder = 0
    $g_pAuiDispTreeSelect = 0
    $g_pAuiDispTreeDbl = 0
    $g_pAuiDispTreeReorder = 0
    $g_pAuiDispCheck = 0
    $g_pAuiDispWebTab = 0
    $g_pAuiDispWebResult = 0
    $g_pAuiDispHotkey = 0
    $g_pAuiDispPostTask = 0
    $g_pAuiDispMedia = 0
    $g_pAuiDispDestroyed = 0
    Return SetError(0, 0, 1)
EndFunc

; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_Version
; 說明 ...: Retrieves AUI runtime version string.
; 語法 ........: _UI_Version()
; 參數 ....: None
; 傳回值 .: Success - The complete version string of the current AUI runtime
;                  Failure - ""
; 作者 ........: Fanxing
; 範例 .......: Yes
; ===============================================================================================================================
Func _UI_Version()
    Local $tBuf = DllStructCreate("wchar[64]")
    Local $iCopied = __AUI_Call("int", "_UI_GetVersion", "ptr", DllStructGetPtr($tBuf), "int", 64)
    Local $iErr = @error
    If $iErr Or $iCopied <= 0 Then Return SetError($iErr, 0, "")
    Return SetError(0, 0, DllStructGetData($tBuf, 1))
EndFunc

; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_GetEdition
; 說明 ...: Returns whether the embedded runtime is the official complete runtime or a Builder-generated custom runtime.
; 語法 ........: _UI_GetEdition()
; 參數 ....: None
; 傳回值 .: Returns $AUI_EDITION_COMPLETE for the official complete runtime, or $AUI_EDITION_CUSTOM for an
;                  AUIBuilder-generated runtime
; 作者 ........: Fanxing
; 相關函式 .......: _UI_GetBuildFeatures, _UI_Version
; 範例 .......: No
; ===============================================================================================================================
Func _UI_GetEdition()
    Local $vAuiForwardResult = __AUI_Call("int", "_UI_GetEdition")
    Return SetError(@error, @extended, $vAuiForwardResult)
EndFunc

; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_GetBuildFeatures
; 說明 ...: Returns the optional features compiled into the embedded AUI runtime.
; 語法 ........: _UI_GetBuildFeatures()
; 參數 ....: None
; 傳回值 .: A bitwise combination of $AUI_FEATURE_* constants
; 作者 ........: Fanxing
; 相關函式 .......: _UI_GetEdition, _UI_Version
; 範例 .......: No
; ===============================================================================================================================
Func _UI_GetBuildFeatures()
    Local $vAuiForwardResult = __AUI_Call("uint", "_UI_GetBuildFeatures")
    Return SetError(@error, @extended, $vAuiForwardResult)
EndFunc

; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_GetLastError
; 說明 ...: Retrieves the error code recorded by the current thread's latest AUI core API call.
; 語法 ........: _UI_GetLastError()
; 參數 ....: None
; 傳回值 .: Success - $AUI_OK or a $AUI_ERR_* error code
; 作者 ........: Fanxing
; 備註 .......: Success with API clears the old error, failure with API writes the current error; status is overwritten by
;                  subsequent calls and should be read immediately after the target call. _UI_IsAlive is an exception: it is a
;                  side-effect-free lifecycle probe that does not change the current error state.
; 相關函式 .......: _UI_GetLastErrorText
; 範例 .......: Yes
; ===============================================================================================================================
Func _UI_GetLastError()
    If $g_bAuiUdfErrorOverride Or $g_iAuiUdfErrorCode <> $AUI_OK Then
        Return SetError(0, 0, $g_iAuiUdfErrorCode)
    EndIf
    Local $vAuiForwardResult = __AUI_Call("int", "_UI_GetLastError")
    Return SetError(@error, @extended, $vAuiForwardResult)
EndFunc

; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_GetLastErrorText
; 說明 ...: Retrieves the latest AUI core error and converts it into English diagnostic text.
; 語法 ........: _UI_GetLastErrorText()
; 參數 ....: None
; 傳回值 .: Success - Error descriptions can be written directly to logs or displayed
; 作者 ........: Fanxing
; 備註 .......: This function internally calls _UI_GetLastError and does not clear the error status.
; 相關函式 .......: _UI_GetLastError
; 範例 .......: Yes
; ===============================================================================================================================
Func _UI_GetLastErrorText()
    Local $iErr = _UI_GetLastError()
    Switch $iErr
        Case $AUI_OK
            Return "OK"
        Case $AUI_ERR_INVALID_WINDOW
            Return "Invalid window handle; the handle does not identify a live AUI window"
        Case $AUI_ERR_INVALID_ELEMENT
            Return "Invalid element ID; the element does not exist in this window"
        Case $AUI_ERR_NO_UI_THREAD
            Return "The UI thread is not ready, or the current thread is not the AUI UI thread"
        Case $AUI_ERR_INVALID_ARGUMENT
            Return "An argument value is invalid"
        Case $AUI_ERR_WRONG_ELEMENT_TYPE
            Return "The element type does not support this control-specific operation"
        Case $AUI_ERR_BUFFER_TOO_SMALL
            Return "The output buffer is too small"
        Case $AUI_ERR_OUT_OF_RANGE
            Return "An index, range, or value is outside the permitted bounds"
        Case $AUI_ERR_NOT_READY
            Return "The object is not ready, or the asynchronous result has expired"
        Case $AUI_ERR_LIMIT_EXCEEDED
            Return "The requested data exceeds an AUI safety limit"
        Case $AUI_ERR_IO
            Return "A file, network, or system I/O operation failed"
        Case $AUI_ERR_DATABASE
            Return "A database operation failed; SQLite diagnostics are available through the database error APIs"
        Case $AUI_ERR_JSON
            Return "The JSON text contains a syntax error"
        Case Else
            Return "Unknown error (" & $iErr & ")"
    EndSwitch
EndFunc

; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_RGB
; 說明 ...: Constructs a 0xAARRGGBB color value from R, G, B, and optional A components.
; 語法 ........: _UI_RGB( $iR, $iG, $iB [, $iA = 0xFF] )
; 參數 ....: $iR - Red component in the 0–255 range
;                  $iG - Green component in the 0–255 range
;                  $iB - Blue component in the 0–255 range
;                  $iA - [Optional] Alpha in the 0–255 range; default is 0xFF.
; 傳回值 .: Success - ARGB Color value 0xAARRGGBB; 0 is legal fully transparent black
; 作者 ........: Fanxing
; 相關函式 .......: _UI_SetColor, _UI_ColorPicker
; 範例 .......: Yes
; ===============================================================================================================================
Func _UI_RGB($iR, $iG, $iB, $iA = 0xFF)
    Return BitOR(BitShift($iA, -24), BitShift($iR, -16), BitShift($iG, -8), $iB)
EndFunc

OnAutoItExitRegister("_UI_Shutdown")
; ────────────────────────────────────────────────────────────────────────────
;  視窗與訊息迴圈
; ────────────────────────────────────────────────────────────────────────────
Func __AUI_DispHotkey($hWnd, $iVk, $iMods)
    Local $f = __AUI_CbGet($__AUI_CB_HOTKEY, $iVk & ":" & $iMods, $hWnd)
    If $f <> "" Then __AUI_SafeCall($f, $iVk, $iMods, 0, 2)
EndFunc

Func __AUI_DispPostTask($pToken)
    Local $iToken = Number($pToken)
    Local $f = __AUI_CbGet($__AUI_CB_POST_TASK, $iToken)
    Local $vData = __AUI_CbGet($__AUI_CB_POST_TASK_DATA, $iToken)
    __AUI_CbDel($__AUI_CB_POST_TASK, $iToken)
    __AUI_CbDel($__AUI_CB_POST_TASK_DATA, $iToken)
    If $f <> "" Then __AUI_SafeCall($f, $vData, 0, 0, 1)
EndFunc

Func __AUI_DispTimer($hWnd, $iTimerId)
    Local $f = __AUI_CbGet($__AUI_CB_TIMER, $iTimerId, $hWnd)
    Local $bRepeat = __AUI_CbGet($__AUI_CB_TIMER_REPEAT, $iTimerId, $hWnd)
    If Not $bRepeat Then
        __AUI_CbDel($__AUI_CB_TIMER, $iTimerId, $hWnd)
        __AUI_CbDel($__AUI_CB_TIMER_REPEAT, $iTimerId, $hWnd)
    EndIf
    If $f <> "" Then __AUI_SafeCall($f, $hWnd, $iTimerId, 0, 2)
EndFunc

Func __AUI_DispClose($hWnd)
	Local $f = __AUI_CbGet($__AUI_CB_WINDOW_CLOSE, $hWnd, $hWnd)
    If $f <> "" Then __AUI_SafeCall($f, $hWnd, 0, 0, 1)
EndFunc

Func __AUI_DispWindowDestroyed($hWnd)
    __AUI_CbDelWindow($hWnd)
EndFunc

Func __AUI_DispResize($hWnd, $iW, $iH)
    Local $f = __AUI_CbGet($__AUI_CB_WINDOW_RESIZE, $hWnd, $hWnd)
    If $f <> "" Then __AUI_SafeCall($f, $hWnd, $iW, $iH, 3)
EndFunc

Func __AUI_DispBeforeClose($hWnd, $iAct)
    Local $f = __AUI_CbGet($__AUI_CB_WINDOW_BEFORE_CLOSE, $hWnd, $hWnd)
    If $f = "" Then Return 1
    Local $r = Call($f, $hWnd, $iAct)
    If $r = False Then Return 0
    Return 1
EndFunc

Func __AUI_AttachLifecycleDispatchers($hWnd)
    If $g_pAuiDispWindowDestroyed = 0 Then
        $g_pAuiDispWindowDestroyed = __AUI_RegisterCallback("__AUI_DispWindowDestroyed", "hwnd")
        Local $iRegisterError = @error
        If $g_pAuiDispWindowDestroyed = 0 Then
            __AUI_Call("int", "_UI_WindowClose", "hwnd", $hWnd)
            Return SetError($iRegisterError, 0, 0)
        EndIf
    EndIf
    If $g_pAuiDispDestroyed = 0 Then
        $g_pAuiDispDestroyed = __AUI_RegisterCallback("__AUI_DispDestroyed", "hwnd;int")
        Local $iElementError = @error
        If $g_pAuiDispDestroyed = 0 Then
            __AUI_Call("int", "_UI_WindowClose", "hwnd", $hWnd)
            Return SetError($iElementError, 0, 0)
        EndIf
    EndIf
    Local $iInstalled = __AUI_Call("int", "_UI_SetLifecycleObservers", _
            "hwnd", $hWnd, "ptr", $g_pAuiDispWindowDestroyed, "ptr", $g_pAuiDispDestroyed)
    Local $iCallError = @error
    If $iCallError Or $iInstalled = 0 Then
        Local $iFailure = $iCallError
        If $iFailure = 0 Then $iFailure = __AUI_ReadNativeLastError()
        __AUI_CbDelWindow($hWnd)
        __AUI_Call("int", "_UI_WindowClose", "hwnd", $hWnd)
        Return SetError($iFailure, 0, 0)
    EndIf
    Return SetError(0, 0, 1)
EndFunc

; #FUNCTION# ===================================================================================================================
