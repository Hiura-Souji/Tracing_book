; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_TreeOnSelect
; 說明 ...: Registers node selection callback.
; 語法 ........: _UI_TreeOnSelect( $hWnd, $iTree, $sFuncName )
; 參數 ....: $hWnd - Window handle returned by _UI_WindowCreate
;                  $iTree - Tree control ID
;                  $sFuncName - Callback function name; signature Func F($iNode), empty string cancels callback
; 傳回值 .: Success - 1
;                  Failure - 0; the callback name is invalid, callback registration failed, or the native call failed
; 作者 ........: Fanxing
; 範例 .......: Yes
; ===============================================================================================================================
Func _UI_TreeOnSelect($hWnd, $iTree, $sFuncName)
	If __AUI_ValidateOptionalCallback($sFuncName) = 0 Then Return SetError(@error, 0, 0)
	If $sFuncName <> "" And $g_pAuiDispTreeSelect = 0 Then $g_pAuiDispTreeSelect = __AUI_RegisterCallback("__AUI_TreeSelectProxy", "hwnd;int;int64")
	If $sFuncName <> "" And $g_pAuiDispTreeSelect = 0 Then Return SetError(@error, 0, 0)
	Local $sOldFunc = __AUI_CbGet($__AUI_CB_TREE_SELECT, $iTree, $hWnd)
	If __AUI_CbSet($__AUI_CB_TREE_SELECT, $iTree, $sFuncName, $hWnd) = 0 Then Return SetError(@error, 0, 0)
	Local $pCallback = $sFuncName = "" ? 0 : $g_pAuiDispTreeSelect
	Local $iResult = __AUI_Call("int", "_UI_TreeOnSelect", "hwnd", $hWnd, "int", $iTree, "ptr", $pCallback)
	Local $iCallError = @error
	If $iCallError Or $iResult = 0 Then
		__AUI_CbSet($__AUI_CB_TREE_SELECT, $iTree, $sOldFunc, $hWnd)
		Return SetError($iCallError, 0, 0)
	EndIf
	Return SetError(0, 0, 1)
EndFunc

; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_TreeOnNodeDblClick
; 說明 ...: Registers node double-click callback Func F($iNode).
; 語法 ........: _UI_TreeOnNodeDblClick( $hWnd, $iTree, $sFuncName )
; 參數 ....: $hWnd - Window handle returned by _UI_WindowCreate
;                  $iTree - Tree control ID
;                  $sFuncName - Callback function name; pass an empty string to unregister the callback
; 傳回值 .: Success - 1
;                  Failure - 0; the callback name is invalid, callback registration failed, or the native call failed
; 作者 ........: Fanxing
; 範例 .......: No
; ===============================================================================================================================
Func _UI_TreeOnNodeDblClick($hWnd, $iTree, $sFuncName)
	If __AUI_ValidateOptionalCallback($sFuncName) = 0 Then Return SetError(@error, 0, 0)
	If $sFuncName <> "" And $g_pAuiDispTreeDbl = 0 Then $g_pAuiDispTreeDbl = __AUI_RegisterCallback("__AUI_TreeDblProxy", "hwnd;int;int64")
	If $sFuncName <> "" And $g_pAuiDispTreeDbl = 0 Then Return SetError(@error, 0, 0)
	Local $sOldFunc = __AUI_CbGet($__AUI_CB_TREE_DBLCLICK, $iTree, $hWnd)
	If __AUI_CbSet($__AUI_CB_TREE_DBLCLICK, $iTree, $sFuncName, $hWnd) = 0 Then Return SetError(@error, 0, 0)
	Local $pCallback = $sFuncName = "" ? 0 : $g_pAuiDispTreeDbl
	Local $iResult = __AUI_Call("int", "_UI_TreeOnNodeDblClick", "hwnd", $hWnd, "int", $iTree, "ptr", $pCallback)
	Local $iCallError = @error
	If $iCallError Or $iResult = 0 Then
		__AUI_CbSet($__AUI_CB_TREE_DBLCLICK, $iTree, $sOldFunc, $hWnd)
		Return SetError($iCallError, 0, 0)
	EndIf
	Return SetError(0, 0, 1)
EndFunc

; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_TreeSetReorderable
; 說明 ...: Enables or disables Tree node drag-and-drop reordering. Dropping on a node makes the item its child, while
;                  dropping at the upper or lower edge inserts it before or after the node. Cycles are rejected automatically.
; 語法 ........: _UI_TreeSetReorderable( $hWnd, $iTree [, $bEnable = True] )
; 參數 ....: $hWnd - Window handle returned by _UI_WindowCreate
;                  $iTree - Tree control ID
;                  $bEnable - [Optional] True to enable or False to disable; default True
; 傳回值 .: Success - 1
;                  Failure - 0; the callback name is invalid, callback registration failed, or the native call failed
; 作者 ........: Fanxing
; 範例 .......: No
; ===============================================================================================================================
Func _UI_TreeSetReorderable($hWnd, $iTree, $bEnable = True)
	Local $vAuiForwardResult = __AUI_Call("int", "_UI_TreeSetReorderable", "hwnd", $hWnd, "int", $iTree, "int", $bEnable ? 1 : 0)
	Return SetError(@error, @extended, $vAuiForwardResult)
EndFunc

; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_TreeOnReorder
; 說明 ...: Registers the reorder-completed callback Func F($iNode, $iParent, $iPosition).
; 語法 ........: _UI_TreeOnReorder( $hWnd, $iTree, $sFuncName )
; 參數 ....: $hWnd - Window handle returned by _UI_WindowCreate
;                  $iTree - Tree control ID
;                  $sFuncName - Callback function name; the parameters are stable node ID, stable parent ID, and sibling
;                  position starting from 0; empty string cancels the callback
; 傳回值 .: Success - 1
;                  Failure - 0; the callback name is invalid, callback registration failed, or the native call failed
; 作者 ........: Fanxing
; 範例 .......: No
; ===============================================================================================================================
Func _UI_TreeOnReorder($hWnd, $iTree, $sFuncName)
	If __AUI_ValidateOptionalCallback($sFuncName) = 0 Then Return SetError(@error, 0, 0)
	If $sFuncName <> "" And $g_pAuiDispTreeReorder = 0 Then $g_pAuiDispTreeReorder = __AUI_RegisterCallback("__AUI_TreeReorderProxy", "hwnd;int;int64;int64;int")
	If $sFuncName <> "" And $g_pAuiDispTreeReorder = 0 Then Return SetError(@error, 0, 0)
	Local $sOldFunc = __AUI_CbGet($__AUI_CB_TREE_REORDER, $iTree, $hWnd)
	If __AUI_CbSet($__AUI_CB_TREE_REORDER, $iTree, $sFuncName, $hWnd) = 0 Then Return SetError(@error, 0, 0)
	Local $pCallback = $sFuncName = "" ? 0 : $g_pAuiDispTreeReorder
	Local $iResult = __AUI_Call("int", "_UI_TreeOnReorder", "hwnd", $hWnd, "int", $iTree, "ptr", $pCallback)
	Local $iCallError = @error
	If $iCallError Or $iResult = 0 Then
		__AUI_CbSet($__AUI_CB_TREE_REORDER, $iTree, $sOldFunc, $hWnd)
		Return SetError($iCallError, 0, 0)
	EndIf
	Return SetError(0, 0, 1)
EndFunc

