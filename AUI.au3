;                  Failure - 0
; 作者 ........: Fanxing
; 相關函式 .......: _UI_ThemeSetMode
; 範例 .......: Yes
; ===============================================================================================================================
Func _UI_ThemeGetMode($hWnd)
    Local $vAuiForwardResult = __AUI_Call("int", "_UI_ThemeGetMode", "hwnd", $hWnd)
    Return SetError(@error, @extended, $vAuiForwardResult)
EndFunc

; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_ThemeSetAccent
; 說明 ...: Sets theme accent color.
; 語法 ........: _UI_ThemeSetAccent( $hWnd, $iAccentColor )
; 參數 ....: $hWnd - Window handle returned by _UI_WindowCreate
;                  $iAccentColor - Accent color 0xAARRGGBB
; 傳回值 .: Success - 1
;                  Failure - 0
; 作者 ........: Fanxing
; 相關函式 .......: _UI_ThemeSetColor
; 範例 .......: Yes
; ===============================================================================================================================
Func _UI_ThemeSetAccent($hWnd, $iAccentColor)
    Local $vAuiForwardResult = __AUI_Call("int", "_UI_ThemeSetAccent", "hwnd", $hWnd, "uint", $iAccentColor)
    Return SetError(@error, @extended, $vAuiForwardResult)
EndFunc

; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_ThemeSetColor
; 說明 ...: Overrides a theme color token (token).
; 語法 ........: _UI_ThemeSetColor( $hWnd, $sToken, $iColor )
; 參數 ....: $hWnd - Window handle returned by _UI_WindowCreate
;                  $sToken - Theme color token name (such as "accent", "panel_bg")
;                  $iColor - Color 0xAARRGGBB
; 傳回值 .: Success - 1
;                  Failure - 0
; 作者 ........: Fanxing
; 相關函式 .......: _UI_ThemeGetColor
; 範例 .......: Yes
; ===============================================================================================================================
Func _UI_ThemeSetColor($hWnd, $sToken, $iColor)
    Local $vAuiForwardResult = __AUI_Call("int", "_UI_ThemeSetColor", _
                       "hwnd", $hWnd, "wstr", $sToken, "uint", $iColor)
    Return SetError(@error, @extended, $vAuiForwardResult)
EndFunc

; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_ThemeGetColor
; 說明 ...: Retrieves the current value of a theme color token.
; 語法 ........: _UI_ThemeGetColor( $hWnd, $sToken )
; 參數 ....: $hWnd - Window handle returned by _UI_WindowCreate
;                  $sToken - Theme color token name
; 傳回值 .: Success - Theme token’s current 0xAARRGGBB color value
;                  Failure - 0
; 作者 ........: Fanxing
; 相關函式 .......: _UI_ThemeSetColor
; 範例 .......: Yes
; ===============================================================================================================================
Func _UI_ThemeGetColor($hWnd, $sToken)
    If __AUI_EnsureDll() = 0 Then Return SetError($g_iAuiLoadError, 0, 0)
    Local $tOut = DllStructCreate("uint")
    Local $aRet = __AUI_DllCall("int", "_UI_ThemeGetColor", _
                          "hwnd", $hWnd, "wstr", $sToken, _
                          "ptr", DllStructGetPtr($tOut))
    Local $iErr = @error
    If $iErr Or Not IsArray($aRet) Then Return SetError($iErr, 0, 0)
    If $aRet[0] = 0 Then
        Local $iNativeError = _UI_GetLastError()
        If @error Or $iNativeError = $AUI_OK Then $iNativeError = $AUI_ERR_INVALID_ARGUMENT
        Return SetError($iNativeError, 0, 0)
    EndIf
    Return SetError(0, 0, DllStructGetData($tOut, 1))
EndFunc

; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_SetTokenOverride
; 說明 ...: Overrides a single theme color token for the element and its whole subtree (the nearest override on the
;                  parent chain wins).
; 語法 ........: _UI_SetTokenOverride( $hWnd, $iId, $sToken, $iColor )
; 參數 ....: $hWnd - Window handle returned by _UI_WindowCreate
;                  $iId - Target element ID (its subtree is included)
;                  $sToken - Theme color token name (such as "accent", "panel_bg")
;                  $iColor - Override color 0xAARRGGBB
; 傳回值 .: Success - 1
;                  Failure - 0; the element is invalid, or the token name is empty, unknown, or too long
; 作者 ........: Fanxing
; 備註 .......: Resolution order: the target element's own override, then each ancestor's override, then the window theme
;                  (including window-level overrides from _UI_ThemeSetColor), then the default theme table. Use
;                  _UI_ClearTokenOverride to remove an override; changing an override increments the theme epoch and repaints
;                  the window (cached derived values keyed by epoch are invalidated). Ideal for localized restyling inside a
;                  window.
; 相關函式 .......: _UI_ClearTokenOverride, _UI_ThemeSetColor
; 範例 .......: No
; ===============================================================================================================================
Func _UI_SetTokenOverride($hWnd, $iId, $sToken, $iColor)
    Local $vAuiForwardResult = __AUI_Call("int", "_UI_SetTokenOverride", _
                       "hwnd", $hWnd, "int", $iId, "wstr", $sToken, "uint", $iColor)
    Return SetError(@error, @extended, $vAuiForwardResult)
EndFunc

; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_ClearTokenOverride
; 說明 ...: Removes an element-level theme color token override, restoring parent-chain/window resolution.
; 語法 ........: _UI_ClearTokenOverride( $hWnd, $iId, $sToken )
; 參數 ....: $hWnd - Window handle returned by _UI_WindowCreate
;                  $iId - Target element ID
;                  $sToken - Theme color token name
; 傳回值 .: Success - 1 (also returns 1 when there is no override to remove)
;                  Failure - 0; the element is invalid, or the token name is empty or too long
; 作者 ........: Fanxing
; 相關函式 .......: _UI_SetTokenOverride
; 範例 .......: No
; ===============================================================================================================================
Func _UI_ClearTokenOverride($hWnd, $iId, $sToken)
    Local $vAuiForwardResult = __AUI_Call("int", "_UI_ClearTokenOverride", _
                       "hwnd", $hWnd, "int", $iId, "wstr", $sToken)
    Return SetError(@error, @extended, $vAuiForwardResult)
EndFunc
; ────────────────────────────────────────────────────────────────────────────
;  JSON
; ────────────────────────────────────────────────────────────────────────────
Func __AUI_JsonReadText($sFuncName, $iJson, $sPath, $iIndex, $bIndexed)
    If __AUI_EnsureDll() = 0 Then Return SetError($g_iAuiLoadError, 0, "")
    Local $aNeed
    If $bIndexed Then
        $aNeed = __AUI_DllCall("int", $sFuncName, "int", $iJson, "wstr", $sPath, "int", $iIndex, "ptr", 0, "int", 0)
    Else
        $aNeed = __AUI_DllCall("int", $sFuncName, "int", $iJson, "wstr", $sPath, "ptr", 0, "int", 0)
    EndIf
    Local $iDllError = @error
    If $iDllError Or Not IsArray($aNeed) Then Return SetError($iDllError, 0, "")
    If $aNeed[0] < 0 Then Return SetError(__AUI_ReadNativeLastError(), 0, "")
    If $aNeed[0] = 0 Then
        Local $iNativeError = __AUI_ReadNativeLastError()
        Local $iNativeDllError = @error
        If $iNativeDllError Then Return SetError($iNativeDllError, 0, "")
        If $iNativeError <> $AUI_OK Then Return SetError($iNativeError, 0, "")
    EndIf
    Local $iCap = $aNeed[0] + 1
    If $iCap < 1 Then $iCap = 1
    If $iCap > $__AUI_READ_TEXT_MAX_CHARS Then
        $g_iAuiUdfErrorCode = $AUI_ERR_LIMIT_EXCEEDED
        Return SetError($g_iAuiUdfErrorCode, 0, "")
    EndIf
    Local $tBuf = DllStructCreate("wchar[" & $iCap & "]")
    If @error Or Not IsDllStruct($tBuf) Then
        $g_iAuiUdfErrorCode = $AUI_ERR_LIMIT_EXCEEDED
        Return SetError($g_iAuiUdfErrorCode, 0, "")
    EndIf
    Local $aRead
    If $bIndexed Then
        $aRead = __AUI_DllCall("int", $sFuncName, "int", $iJson, "wstr", $sPath, "int", $iIndex, "ptr", DllStructGetPtr($tBuf), "int", $iCap)
    Else
        $aRead = __AUI_DllCall("int", $sFuncName, "int", $iJson, "wstr", $sPath, "ptr", DllStructGetPtr($tBuf), "int", $iCap)
    EndIf
    $iDllError = @error
    If $iDllError Or Not IsArray($aRead) Then Return SetError($iDllError, 0, "")
    If $aRead[0] < 0 Then Return SetError(__AUI_ReadNativeLastError(), 0, "")
    If $aRead[0] >= $iCap Then
        $g_iAuiUdfErrorCode = $AUI_ERR_BUFFER_TOO_SMALL
        Return SetError($g_iAuiUdfErrorCode, $aRead[0] + 1, "")
    EndIf
    If $aRead[0] = 0 Then
        Local $iReadError = __AUI_ReadNativeLastError()
        Local $iReadDllError = @error
        If $iReadDllError Then Return SetError($iReadDllError, 0, "")
        If $iReadError <> $AUI_OK Then Return SetError($iReadError, 0, "")
    EndIf
    Return SetError(0, 0, DllStructGetData($tBuf, 1))
EndFunc

; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_JsonParse
; 說明 ...: Parses a JSON text and returns a document handle; the parsed tree stays inside the AUI runtime and is
;                  accessed by path, so large JSON documents are not copied into AutoIt variables.
; 語法 ........: _UI_JsonParse( $sJson )
; 參數 ....: $sJson - JSON text (UTF-16; an optional leading U+FEFF byte-order mark is accepted); up to 16 million
;                  characters
; 傳回值 .: Success - Document handle (>=1); use _UI_JsonFree to release it
;                  Failure - 0; @error = $AUI_ERR_JSON for a syntax error or duplicate object key; @error =
;                  $AUI_ERR_LIMIT_EXCEEDED when the input or the 128-level container nesting limit is exceeded
; 作者 ........: Fanxing
; 備註 .......: Path syntax is "a.b[0].c" (empty string = root), up to 1,024 characters and 32 segments. Access errors map to
;                  $AUI_ERR_OUT_OF_RANGE (missing path or invalid handle), $AUI_ERR_WRONG_ELEMENT_TYPE (type mismatch), and
;                  $AUI_ERR_INVALID_ARGUMENT (malformed path). Keys containing ".", "[", or an empty name are accessed by
;                  enumeration with _UI_JsonKeyName/_UI_JsonChild. Up to 64 live documents are allowed; _UI_Shutdown releases
;                  all.
; 相關函式 .......: _UI_JsonLoadFile, _UI_JsonGetDiagnostic, _UI_JsonFree, _UI_JsonSerialize
; 範例 .......: No
; ===============================================================================================================================
Func _UI_JsonParse($sJson)
    Local $vAuiForwardResult = __AUI_Call("int", "_UI_JsonParse", "wstr", $sJson)
    Return SetError(@error, @extended, $vAuiForwardResult)
EndFunc

; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_JsonLoadFile
; 說明 ...: Loads and parses JSON from a file and returns a document handle.
; 語法 ........: _UI_JsonLoadFile( $sPath )
; 參數 ....: $sPath - JSON file path
; 傳回值 .: Success - Document handle; release it with _UI_JsonFree
;                  Failure - 0 and set @error
; 作者 ........: Fanxing
; 備註 .......: Accepts UTF-8 with or without a BOM and BOM-marked UTF-16 LE/BE. A file without a BOM is read as UTF-8. Files
;                  are limited to 64 MiB, and decoded JSON content is limited to 16 million UTF-16 code units in every encoding.
; 相關函式 .......: _UI_JsonSaveFile, _UI_JsonGetDiagnostic, _UI_JsonFree
; 範例 .......: No
; ===============================================================================================================================
Func _UI_JsonLoadFile($sPath)
    Local $vAuiForwardResult = __AUI_Call("int", "_UI_JsonLoadFile", "wstr", $sPath)
    Return SetError(@error, @extended, $vAuiForwardResult)
EndFunc

; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_JsonGetDiagnostic
; 說明 ...: Returns detailed information about the most recent JSON failure on the current thread.
; 語法 ........: _UI_JsonGetDiagnostic()
; 參數 ....: None
; 傳回值 .: Success - A four-item array: [message, line, column, zero-based character position]; numeric fields that do
;                  not apply are 0
;                  Failure - 0 and set @error
; 作者 ........: Fanxing
; 備註 .......: Line and column numbers are one-based. A successful JSON operation clears the previous diagnostic, so
;                  retrieve it immediately after a failure.
; 相關函式 .......: _UI_JsonParse, _UI_JsonLoadFile, _UI_GetLastError
; 範例 .......: No
; ===============================================================================================================================
Func _UI_JsonGetDiagnostic()
    If __AUI_EnsureDll() = 0 Then Return SetError($g_iAuiLoadError, 0, 0)
    Local $tLine = DllStructCreate("int"), $tColumn = DllStructCreate("int"), $tCharacter = DllStructCreate("int")
    If @error Or Not IsDllStruct($tLine) Or Not IsDllStruct($tColumn) Or Not IsDllStruct($tCharacter) Then
        $g_iAuiUdfErrorCode = $AUI_ERR_LIMIT_EXCEEDED
        Return SetError($g_iAuiUdfErrorCode, 0, 0)
    EndIf
    Local $aNeed = __AUI_DllCall("int", "_UI_JsonGetDiagnostic", _
            "ptr", DllStructGetPtr($tLine), "ptr", DllStructGetPtr($tColumn), "ptr", DllStructGetPtr($tCharacter), _
            "ptr", 0, "int", 0)
    Local $iDllError = @error
    If $iDllError Or Not IsArray($aNeed) Then Return SetError($iDllError, 0, 0)
    If $aNeed[0] < 0 Then Return SetError(__AUI_ReadNativeLastError(), 0, 0)
    Local $iCap = $aNeed[0] + 1
    If $iCap < 1 Then $iCap = 1
    If $iCap > $__AUI_READ_TEXT_MAX_CHARS Then
        $g_iAuiUdfErrorCode = $AUI_ERR_LIMIT_EXCEEDED
        Return SetError($g_iAuiUdfErrorCode, 0, 0)
    EndIf
    Local $tBuffer = DllStructCreate("wchar[" & $iCap & "]")
    If @error Or Not IsDllStruct($tBuffer) Then
        $g_iAuiUdfErrorCode = $AUI_ERR_LIMIT_EXCEEDED
        Return SetError($g_iAuiUdfErrorCode, 0, 0)
    EndIf
    Local $aRead = __AUI_DllCall("int", "_UI_JsonGetDiagnostic", _
            "ptr", DllStructGetPtr($tLine), "ptr", DllStructGetPtr($tColumn), "ptr", DllStructGetPtr($tCharacter), _
            "ptr", DllStructGetPtr($tBuffer), "int", $iCap)
    $iDllError = @error
    If $iDllError Or Not IsArray($aRead) Then Return SetError($iDllError, 0, 0)
    If $aRead[0] >= $iCap Then
        $g_iAuiUdfErrorCode = $AUI_ERR_BUFFER_TOO_SMALL
        Return SetError($g_iAuiUdfErrorCode, $aRead[0] + 1, 0)
    EndIf
    Local $aResult[4]
    $aResult[0] = DllStructGetData($tBuffer, 1)
    $aResult[1] = DllStructGetData($tLine, 1)
    $aResult[2] = DllStructGetData($tColumn, 1)
    $aResult[3] = DllStructGetData($tCharacter, 1)
    Return SetError(0, 0, $aResult)
EndFunc

; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_JsonFree
; 說明 ...: Releases an owned JSON document or releases a borrowed child handle early.
; 語法 ........: _UI_JsonFree( $iJson )
; 參數 ....: $iJson - Document or borrowed child handle
; 傳回值 .: Success - 1
;                  Failure - 0; the handle is invalid or already released ($AUI_ERR_OUT_OF_RANGE)
; 作者 ........: Fanxing
; 相關函式 .......: _UI_JsonParse, _UI_JsonChild, _UI_JsonPointer
; 範例 .......: No
; ===============================================================================================================================
Func _UI_JsonFree($iJson)
    Local $vAuiForwardResult = __AUI_Call("int", "_UI_JsonFree", "int", $iJson)
    Return SetError(@error, @extended, $vAuiForwardResult)
EndFunc

; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_JsonType
; 說明 ...: Returns the value type at a path: $AUI_JSON_NULL/_BOOL/_INT/_DOUBLE/_STRING/_ARRAY/_OBJECT.
; 語法 ........: _UI_JsonType( $iJson [, $sPath = ""] )
; 參數 ....: $iJson - Document handle
;                  $sPath - [Optional] Path such as "a.b[0].c"; empty string or omitted = root
; 傳回值 .: Success - One of the $AUI_JSON_* constants
;                  Failure - -1
; 作者 ........: Fanxing
; 相關函式 .......: _UI_JsonGetString, _UI_JsonCount
; 範例 .......: No
; ===============================================================================================================================
Func _UI_JsonType($iJson, $sPath = "")
    Local $vAuiForwardResult = __AUI_Call("int", "_UI_JsonType", "int", $iJson, "wstr", $sPath)
    Return SetError(@error, @extended, $vAuiForwardResult)
EndFunc

