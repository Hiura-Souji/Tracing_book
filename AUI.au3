EndFunc

; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_PumpOnce
; 說明 ...: Processes a round of messages in a non-blocking manner (used when building a self-built loop, and can also be
;                  called inside the callback to avoid freezing the interface for long tasks).
; 語法 ........: _UI_PumpOnce()
; 參數 ....: None
; 傳回值 .: Success - Greater than or equal to 0, the number of messages processed in this round; 0 when there are no
;                  messages to be processed
;                  Failure - -1; the last window has been closed, an exit message has been received, or the call was made from
;                  the wrong thread, the self-built loop should be exited
; 作者 ........: Fanxing
; 備註 .......: Calling in the callback of _UI_Run will form a nested pump; input and user callback messages will be
;                  temporarily stored until the end of the outer transaction and then delivered, and the window release will
;                  also be delayed. During long tasks, it is still recommended to cooperate with _UI_SetBusy() to clearly
;                  display and limit the busy status.
; 相關函式 .......: _UI_Run, _UI_SetBusy, _UI_IsAlive
; 範例 .......: No
; ===============================================================================================================================
Func _UI_PumpOnce()
    Local $vAuiForwardResult = __AUI_Call("int", "_UI_PumpOnce")
    Return SetError(@error, @extended, $vAuiForwardResult)
EndFunc

; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_PostTask
; 說明 ...: Posts a script callback from any thread to the UI thread of AUI; callback signature Func($vUserData).
; 語法 ........: _UI_PostTask( $sFuncName [, $vUserData = 0] )
; 參數 ....: $sFuncName - The name of the callback function to be executed on the UI thread, with the signature
;                  Func($vUserData)
;                  $vUserData - [Optional] The user data returned to the callback as it is with the task defaults to 0
; 傳回值 .: Success - 1. The task has been delivered asynchronously
;                  Failure - 0, the UI thread is not ready or the parameters are wrong
;                  @error - On failure, @error carries the specific reason, such as $AUI_ERR_NO_UI_THREAD
; 作者 ........: Fanxing
; 範例 .......: No
; ===============================================================================================================================
Func _UI_PostTask($sFuncName, $vUserData = 0)
    If __AUI_ValidateOptionalCallback($sFuncName) = 0 Or $sFuncName = "" Then Return SetError($AUI_UDF_ERR_INVALID_CALLBACK, 0, 0)
    If $g_pAuiDispPostTask = 0 Then $g_pAuiDispPostTask = __AUI_RegisterCallback("__AUI_DispPostTask", "ptr")
    If $g_pAuiDispPostTask = 0 Then Return SetError(@error, 0, 0)
    Local $iFirstCandidate = 0
    Local $iToken = 0
    Do
        $g_iAuiPostToken += 1
        If $g_iAuiPostToken <= 0 Or $g_iAuiPostToken > 0x7FFFFFFF Then $g_iAuiPostToken = 1
        If $iFirstCandidate = 0 Then
            $iFirstCandidate = $g_iAuiPostToken
        ElseIf $g_iAuiPostToken = $iFirstCandidate Then
            ExitLoop
        EndIf
        If __AUI_CbGet($__AUI_CB_POST_TASK, $g_iAuiPostToken) = "" Then
            $iToken = $g_iAuiPostToken
            ExitLoop
        EndIf
    Until False
    If $iToken = 0 Then
        $g_iAuiUdfErrorCode = $AUI_ERR_LIMIT_EXCEEDED
        Return SetError($g_iAuiUdfErrorCode, 0, 0)
    EndIf
    If __AUI_CbSet($__AUI_CB_POST_TASK, $iToken, $sFuncName) = 0 Then Return SetError(@error, 0, 0)
    If __AUI_CbSet($__AUI_CB_POST_TASK_DATA, $iToken, $vUserData, 0, False) = 0 Then
        __AUI_CbDel($__AUI_CB_POST_TASK, $iToken)
        Return SetError(@error, 0, 0)
    EndIf
    Local $ok = __AUI_Call("int", "_UI_PostTask", "ptr", $g_pAuiDispPostTask, "ptr", $iToken)
    If Not $ok Then
        Local $iCallError = @error, $iCallExtended = @extended
        __AUI_CbDel($__AUI_CB_POST_TASK, $iToken)
        __AUI_CbDel($__AUI_CB_POST_TASK_DATA, $iToken)
        Return SetError($iCallError, $iCallExtended, $ok)
    EndIf
    Return SetError(0, 0, $ok)
EndFunc

