; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_CanvasSetView
; 說明 ...: Sets the global pan and zoom applied to all stored drawing commands without modifying the commands or the
;                  current transform.
; 語法 ........: _UI_CanvasSetView( $hWnd, $iId, $nPanX, $nPanY, $nZoom )
; 參數 ....: $hWnd - Window handle
;                  $iId - Canvas element ID
;                  $nPanX - Viewport horizontal translation distance (logical pixels)
;                  $nPanY - Viewport vertical translation distance (logical pixels)
;                  $nZoom - Uniform zoom factor in the 0.01–1,000 range
; 傳回值 .: Success - 1
;                  Failure - 0, and set the error code
; 作者 ........: Fanxing
; 範例 .......: Yes
; ===============================================================================================================================
Func _UI_CanvasSetView($hWnd, $iId, $nPanX, $nPanY, $nZoom)
    Local $vAuiForwardResult = __AUI_Call("int", "_UI_CanvasSetView", "hwnd", $hWnd, "int", $iId, "float", $nPanX, "float", $nPanY, "float", $nZoom)
    Return SetError(@error, @extended, $vAuiForwardResult)
EndFunc

; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_CanvasGetView
; 說明 ...: Retrieves the current Canvas overall viewport pan and zoom.
; 語法 ........: _UI_CanvasGetView( $hWnd, $iId )
; 參數 ....: $hWnd - Window handle
;                  $iId - Canvas element ID
; 傳回值 .: Success - Three-item array [translation X, translation Y, zoom factor]
;                  Failure - 0, and set @error
; 作者 ........: Fanxing
; 相關函式 .......: _UI_CanvasSetView, _UI_CanvasResetView
; 範例 .......: Yes
; ===============================================================================================================================
Func _UI_CanvasGetView($hWnd, $iId)
    Local $tPanX = DllStructCreate("float"), $tPanY = DllStructCreate("float"), $tZoom = DllStructCreate("float")
    Local $iResult = __AUI_Call("int", "_UI_CanvasGetView", "hwnd", $hWnd, "int", $iId, _
            "ptr", DllStructGetPtr($tPanX), "ptr", DllStructGetPtr($tPanY), "ptr", DllStructGetPtr($tZoom))
    Local $iDllError = @error
    If $iDllError Then Return SetError($iDllError, 0, 0)
    If $iResult = 0 Then
        Local $iNativeError = _UI_GetLastError()
        If @error Or $iNativeError = $AUI_OK Then $iNativeError = $AUI_ERR_INVALID_ARGUMENT
        Return SetError($iNativeError, 0, 0)
    EndIf
    Local $aView[3] = [DllStructGetData($tPanX, 1), DllStructGetData($tPanY, 1), DllStructGetData($tZoom, 1)]
    Return SetError(0, 0, $aView)
EndFunc

