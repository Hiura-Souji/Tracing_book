; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_DataViewSetCellStyle
; 說明 ...: Sets explicit foreground and background colors for the specified cell. Styles bind to the stable row ID and
;                  follow the original data row after sorting and reordering.
; 語法 ........: _UI_DataViewSetCellStyle( $hWnd, $iDataView, $iRow, $iCol [, $iForeground = 0 [, $iBackground = 0]] )
; 參數 ....: $hWnd - Window handle returned by _UI_WindowCreate
;                  $iDataView - DataView control ID
;                  $iRow - Current row index (starts at 0; the virtual view must have committed the row's stable ID)
;                  $iCol - Zero-based column index
;                  $iForeground - [Optional] Foreground color, ARGB 0xAARRGGBB; 0 uses the default foreground color, default 0
;                  $iBackground - [Optional] Background color, ARGB 0xAARRGGBB; 0 uses the default background color, default 0
; 傳回值 .: Success - 1
;                  Failure - 0
; 作者 ........: Fanxing
; 範例 .......: No
; ===============================================================================================================================
Func _UI_DataViewSetCellStyle($hWnd, $iDataView, $iRow, $iCol, $iForeground = 0, $iBackground = 0)
    Local $vAuiForwardResult = __AUI_Call("int", "_UI_DataViewSetCellStyle", _
                       "hwnd", $hWnd, "int", $iDataView, "int", $iRow, "int", $iCol, _
                       "uint", $iForeground, "uint", $iBackground)
    Return SetError(@error, @extended, $vAuiForwardResult)
EndFunc

; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_DataViewGetCellStyle
; 說明 ...: Retrieves the current explicit foreground and background colors of the specified cell.
; 語法 ........: _UI_DataViewGetCellStyle( $hWnd, $iDataView, $iRow, $iCol )
; 參數 ....: $hWnd - Window handle returned by _UI_WindowCreate
;                  $iDataView - DataView control ID
;                  $iRow - Current row index (starts at 0; the virtual view must have committed the row's stable ID)
;                  $iCol - Zero-based column index
; 傳回值 .: Success - Two-item array [foreground color, background color]; 0 indicates that the corresponding color uses
;                  the default style
;                  Failure - 0, and set @error
; 作者 ........: Fanxing
; 相關函式 .......: _UI_DataViewSetCellStyle, _UI_DataViewClearCellStyle
; 範例 .......: Yes
; ===============================================================================================================================
Func _UI_DataViewGetCellStyle($hWnd, $iDataView, $iRow, $iCol)
    Local $tForeground = DllStructCreate("uint"), $tBackground = DllStructCreate("uint")
    Local $iResult = __AUI_Call("int", "_UI_DataViewGetCellStyle", _
            "hwnd", $hWnd, "int", $iDataView, "int", $iRow, "int", $iCol, _
            "ptr", DllStructGetPtr($tForeground), "ptr", DllStructGetPtr($tBackground))
    Local $iDllError = @error
    If $iDllError Then Return SetError($iDllError, 0, 0)
    If $iResult = 0 Then
        Local $iNativeError = _UI_GetLastError()
        If @error Or $iNativeError = $AUI_OK Then $iNativeError = $AUI_ERR_INVALID_ARGUMENT
        Return SetError($iNativeError, 0, 0)
    EndIf
    Local $aStyle[2] = [DllStructGetData($tForeground, 1), DllStructGetData($tBackground, 1)]
    Return SetError(0, 0, $aStyle)
EndFunc

