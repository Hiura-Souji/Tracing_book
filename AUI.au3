; 傳回值 .: Success - Two-element array [minimum size of first panel, minimum size of second panel]
;                  Failure - Null, and set @error
; 作者 ........: Fanxing
; 範例 .......: Yes
; ===============================================================================================================================
Func _UI_SplitGetMinSizes($hWnd, $iId)
	If __AUI_EnsureDll() = 0 Then Return SetError($g_iAuiLoadError, 0, Null)
	Local $aCall = __AUI_DllCall("int", "_UI_SplitGetMinSizes", _
		"hwnd", $hWnd, "int", $iId, "int*", 0, "int*", 0)
	Local $iError = @error
	If $iError Or Not IsArray($aCall) Then Return SetError($iError, 0, Null)
	If $aCall[0] = 0 Then Return SetError(__AUI_ReadNativeLastError(), 0, Null)
	Local $aSizes[2] = [$aCall[3], $aCall[4]]
	Return $aSizes
EndFunc

; #FUNCTION# ===================================================================================================================
