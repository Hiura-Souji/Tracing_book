; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_Glyph
; 說明 ...: Constructs "icon + text" combination string (for Menu/Sidebar and other items).
; 語法 ........: _UI_Glyph( $iCode, $sLabel )
; 參數 ....: $iCode - Icon glyph code (such as $AUI_GLYPH_HOME)
;                  $sLabel - The text that appears with the icon
; 傳回值 .: Success - Segoe MDL2 glyph characters; when text is passed in, "glyph + space + text" is returned
;                  Failure - ""
; 作者 ........: Fanxing
; 相關函式 .......: _UI_Icon, _UI_Menu
; 範例 .......: No
; ===============================================================================================================================
Func _UI_Glyph($iCode, $sLabel)
    Return ChrW($iCode) & @TAB & $sLabel
EndFunc
; ────────────────────────────────────────────────────────────────────────────
;  Image
; ────────────────────────────────────────────────────────────────────────────
; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_Image
; 說明 ...: Creates a picture control that supports local files, HTTP/HTTPS and SVG.
; 語法 ........: _UI_Image( $hWnd, $iParent, $sSource [, $iX = 0 [, $iY = 0 [, $iW = 0 [, $iH = 0 [, $iNetFlags =
;                  $AUI_NET_DEFAULT]]]]] )
; 參數 ....: $hWnd - Window handle returned by _UI_WindowCreate
;                  $iParent - Parent element ID; use 0 for the window root
;                  $sSource - Local image path or HTTP/HTTPS address; can be empty
;                  $iX - [Optional] Logical X coordinate, default 0
;                  $iY - [Optional] Logical Y coordinate, default 0
;                  $iW - [Optional] Logical width; when 0, try to use the original image ratio/size, default 0
;                  $iH - [Optional] Logical height; when 0, try to use the original ratio/size of the image, default 0
;                  $iNetFlags - [Optional] Composable $AUI_NET_* request-level security flag, default $AUI_NET_DEFAULT
; 傳回值 .: Success - New image element ID (integer, >=1)
;                  Failure - 0
; 作者 ........: Fanxing
; 相關函式 .......: _UI_ImageSetSource, _UI_SvgSetMarkup, _UI_SvgSetFile, _UI_Avatar
; 範例 .......: Yes
; ===============================================================================================================================
Func _UI_Image($hWnd, $iParent, $sSource, $iX = 0, $iY = 0, $iW = 0, $iH = 0, $iNetFlags = $AUI_NET_DEFAULT)
    Local $iId = __AUI_Call("int", "_UI_Image", _
            "hwnd", $hWnd, "int", $iParent, "wstr", $sSource, _
            "int", $iX, "int", $iY, "int", $iW, "int", $iH)
    If $iId <= 0 Then Return 0
    If $iNetFlags <> $AUI_NET_DEFAULT And _UI_ImageSetNetworkFlags($hWnd, $iId, $iNetFlags) = 0 Then
        _UI_Destroy($hWnd, $iId)
        Return 0
    EndIf
    Return $iId
EndFunc

; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_ImageSetSource
; 說明 ...: Changes the image source to a local path or network URL and reloads it.
; 語法 ........: _UI_ImageSetSource( $hWnd, $iImage, $sSource )
; 參數 ....: $hWnd - Window handle returned by _UI_WindowCreate
;                  $iImage - _UI_Image returned image element ID
;                  $sSource - Local path or HTTP/HTTPS address; empty string clears source
; 傳回值 .: Success - 1
;                  Failure - 0; Wrong format HTTP/HTTPS address returns $AUI_ERR_INVALID_ARGUMENT
; 作者 ........: Fanxing
; 備註 .......: The HTTP/HTTPS address must contain a valid host name. Validation or allocation failure preserves the current
;                  image source. Successful results are cached for 10 minutes; the existing image remains visible while an
;                  expired entry is refreshed. Network failures use a 1–30 second backoff and retry automatically while a live
;                  window is still waiting.
; 相關函式 .......: _UI_ImageGetSource, _UI_ImageGetLoadState
; 範例 .......: Yes
; ===============================================================================================================================
Func _UI_ImageSetSource($hWnd, $iImage, $sSource)
    Local $vAuiForwardResult = __AUI_Call("int", "_UI_ImageSetSource", "hwnd", $hWnd, "int", $iImage, "wstr", $sSource)
    Return SetError(@error, @extended, $vAuiForwardResult)
EndFunc

