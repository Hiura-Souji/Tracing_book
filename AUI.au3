; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_DataViewOnSort
; 說明 ...: Registers sorting callback; whether users are allowed to click on the table header is controlled by
;                  _UI_DataViewEnableSort. When the column head is clicked, the library updates ▲/▼ and calls back the function
;                  (id, col, dir), and the script sorts its own data and then refreshes it.
; 語法 ........: _UI_DataViewOnSort( $hWnd, $iDataView, $sFunc )
; 參數 ....: $hWnd - Window handle
;                  $iDataView - View ID
;                  $sFunc - Callback function name, signature Func cb($id, $iCol, $iDir)
; 傳回值 .: Success - 1
;                  Failure - 0; the callback name is invalid, callback registration failed, or the native call failed
; 作者 ........: Fanxing
; 範例 .......: No
; ===============================================================================================================================
Func _UI_DataViewOnSort($hWnd, $iDataView, $sFunc)
	If __AUI_ValidateOptionalCallback($sFunc) = 0 Then Return SetError(@error, 0, 0)
	If $sFunc <> "" And $g_pAuiDispSort = 0 Then $g_pAuiDispSort = __AUI_RegisterCallback("__AUI_DispSort", "hwnd;int;int;int")
	If $sFunc <> "" And $g_pAuiDispSort = 0 Then Return SetError(@error, 0, 0)
	Local $sOldFunc = __AUI_CbGet($__AUI_CB_DATAVIEW_SORT, $iDataView, $hWnd)
	If __AUI_CbSet($__AUI_CB_DATAVIEW_SORT, $iDataView, $sFunc, $hWnd) = 0 Then Return SetError(@error, 0, 0)
	Local $pCallback = $sFunc = "" ? 0 : $g_pAuiDispSort
	Local $iResult = __AUI_Call("int", "_UI_DataViewOnSort", "hwnd", $hWnd, "int", $iDataView, "ptr", $pCallback)
	Local $iCallError = @error
	If $iCallError Or $iResult = 0 Then
		__AUI_CbSet($__AUI_CB_DATAVIEW_SORT, $iDataView, $sOldFunc, $hWnd)
		Return SetError($iCallError, 0, 0)
	EndIf
	Return SetError(0, 0, 1)
EndFunc

; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_DataViewSort
; 說明 ...: Sets the DataView sort column and direction explicitly.
; 語法 ........: _UI_DataViewSort( $hWnd, $iDataView, $iColumn, $iDirection )
; 參數 ....: $hWnd - Window handle returned by _UI_WindowCreate
;                  $iDataView - DataView control ID
;                  $iColumn - Column index starting from 0; when clearing sorting, you can pass the current column or -1
