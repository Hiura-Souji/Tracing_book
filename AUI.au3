    Local $f = __AUI_CbGet($__AUI_CB_DATAVIEW_CELL_CLICK, $iDataView, $hWnd)
    If $f <> "" Then __AUI_SafeCall($f, $iRow, $iCol, 0, 2)
EndFunc

