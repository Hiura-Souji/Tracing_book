    Return SetError(@error, @extended, $vAuiForwardResult)
EndFunc

; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_DataViewSetColumnProgress
; 說明 ...: Sets a column as a progress bar and specify the value range and percentage text.
; 語法 ........: _UI_DataViewSetColumnProgress( $hWnd, $iDataView, $iCol [, $iMinimum = 0 [, $iMaximum = 100 [, $bShowText =
;                  True]]] )
; 參數 ....: $hWnd - Window handle
;                  $iDataView - DataView control ID
;                  $iCol - Zero-based column index
;                  $iMinimum - [optional] minimum value, default 0
;                  $iMaximum - [Optional] Maximum value, must be greater than minimum value, default 100
;                  $bShowText - [Optional] Whether to display the normalized percentage in the center, default True
; 傳回值 .: Success - 1
;                  Failure - 0
; 作者 ........: Fanxing
; 備註 .......: Cell text must be a limited value; illegal text safely displays empty progress and dashes without throwing an
;                  exception.
; 相關函式 .......: _UI_DataViewGetColumnProgress
; 範例 .......: Yes
; ===============================================================================================================================
Func _UI_DataViewSetColumnProgress($hWnd, $iDataView, $iCol, $iMinimum = 0, $iMaximum = 100, $bShowText = True)
    Local $vAuiForwardResult = __AUI_Call("int", "_UI_DataViewSetColumnProgress", "hwnd", $hWnd, "int", $iDataView, _
            "int", $iCol, "int", $iMinimum, "int", $iMaximum, "int", $bShowText ? 1 : 0)
    Return SetError(@error, @extended, $vAuiForwardResult)
EndFunc

; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_DataViewGetColumnProgress
; 說明 ...: Retrieves the range and text-display settings of a Progress column.
; 語法 ........: _UI_DataViewGetColumnProgress( $hWnd, $iDataView, $iCol )
; 參數 ....: $hWnd - Window handle
;                  $iDataView - DataView control ID
;                  $iCol - Progress column index
; 傳回值 .: Success - Three-item array [minimum value, maximum value, whether to display text]
;                  Failure - 0 and set @error
; 作者 ........: Fanxing
; 相關函式 .......: _UI_DataViewSetColumnProgress
; 範例 .......: Yes
; ===============================================================================================================================
Func _UI_DataViewGetColumnProgress($hWnd, $iDataView, $iCol)
    Local $tMinimum = DllStructCreate("int"), $tMaximum = DllStructCreate("int"), $tShowText = DllStructCreate("int")
    Local $iResult = __AUI_Call("int", "_UI_DataViewGetColumnProgress", "hwnd", $hWnd, "int", $iDataView, _
            "int", $iCol, "ptr", DllStructGetPtr($tMinimum), "ptr", DllStructGetPtr($tMaximum), "ptr", DllStructGetPtr($tShowText))
    Local $iCallError = @error
    If $iCallError Then Return SetError($iCallError, 0, 0)
    If $iResult = 0 Then
        Local $iNativeError = _UI_GetLastError()
        If @error Or $iNativeError = $AUI_OK Then $iNativeError = $AUI_ERR_INVALID_ARGUMENT
        Return SetError($iNativeError, 0, 0)
    EndIf
    Local $aProgress[3] = [DllStructGetData($tMinimum, 1), DllStructGetData($tMaximum, 1), DllStructGetData($tShowText, 1) <> 0]
    Return SetError(0, 0, $aProgress)
EndFunc

; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_DataViewOnCellEdited
; 說明 ...: Registers DataView cell edit submit callback.
; 語法 ........: _UI_DataViewOnCellEdited( $hWnd, $iDataView, $sFunc )
; 參數 ....: $hWnd - Window handle
;                  $iDataView - DataView element ID returned by _UI_DataView
;                  $sFunc - Callback function name, signature Func($iRow, $iCol, $sNewText)
; 傳回值 .: Success - 1
;                  Failure - 0; the callback name is invalid, callback registration failed, or the native call failed
; 作者 ........: Fanxing
; 相關函式 .......: _UI_DataViewSetEditable, _UI_DataViewSetColumnCombo
; 範例 .......: Yes
; ===============================================================================================================================
Func _UI_DataViewOnCellEdited($hWnd, $iDataView, $sFunc)
	If __AUI_ValidateOptionalCallback($sFunc) = 0 Then Return SetError(@error, 0, 0)
	If $sFunc <> "" And $g_pAuiDispCellEdited = 0 Then $g_pAuiDispCellEdited = __AUI_RegisterCallback("__AUI_DispCellEdited", "hwnd;int;int;int;wstr")
	If $sFunc <> "" And $g_pAuiDispCellEdited = 0 Then Return SetError(@error, 0, 0)
	Local $sOldFunc = __AUI_CbGet($__AUI_CB_DATAVIEW_CELL_EDITED, $iDataView, $hWnd)
	If __AUI_CbSet($__AUI_CB_DATAVIEW_CELL_EDITED, $iDataView, $sFunc, $hWnd) = 0 Then Return SetError(@error, 0, 0)
	Local $pCallback = $sFunc = "" ? 0 : $g_pAuiDispCellEdited
	Local $iResult = __AUI_Call("int", "_UI_DataViewOnCellEdited", "hwnd", $hWnd, "int", $iDataView, "ptr", $pCallback)
	Local $iCallError = @error
	If $iCallError Or $iResult = 0 Then
		__AUI_CbSet($__AUI_CB_DATAVIEW_CELL_EDITED, $iDataView, $sOldFunc, $hWnd)
		Return SetError($iCallError, 0, 0)
	EndIf
	Return SetError(0, 0, 1)
EndFunc

