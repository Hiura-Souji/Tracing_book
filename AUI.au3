; ────────────────────────────────────────────────────────────────────────────
;  Tabs
; ────────────────────────────────────────────────────────────────────────────
; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_Tabs
; 說明 ...: Creates a tab control with a separate page container.
; 語法 ........: _UI_Tabs( $hWnd, $iParent, $sTabs [, $iSelected = 0 [, $iX = 0 [, $iY = 0 [, $iW = 0 [, $iH = 0]]]]] )
; 參數 ....: $hWnd - Window handle returned by _UI_WindowCreate
;                  $iParent - Parent element ID; use 0 for the window root
;                  $sTabs - Tab title, vertical bar | separator
;                  $iSelected - [Optional] Initial selection index; default 0
;                  $iX - [Optional] Logical X coordinate (relative to parent container; ignored in flexible containers such as
;                  Row/Column), default 0
;                  $iY - [Optional] Logical Y coordinate (relative to parent container; ignored in flexible containers), default
;                  0
;                  $iW - [Optional] Logical width; 0 = automatically determined/filled by layout, default 0
;                  $iH - [Optional] Total logical height of the control (including tab bar and page), default 0
; 傳回值 .: Success - New element ID (integer, >= 1)
;                  Failure - 0
; 作者 ........: Fanxing
; 備註 .......: Each tab has a stable page container managed by the control; get its page ID with _UI_TabsGetPage and add
;                  controls to it.
; 相關函式 .......: _UI_TabsGetPage, _UI_TabsSetSelected
; 範例 .......: Yes
; ===============================================================================================================================
Func _UI_Tabs($hWnd, $iParent, $sTabs, $iSelected = 0, $iX = 0, $iY = 0, $iW = 0, $iH = 0)
    Local $vAuiForwardResult = __AUI_Call("int", "_UI_Tabs", _
                       "hwnd", $hWnd, "int", $iParent, "wstr", $sTabs, "int", $iSelected, _
                       "int", $iX, "int", $iY, "int", $iW, "int", $iH)
    Return SetError(@error, @extended, $vAuiForwardResult)
EndFunc

