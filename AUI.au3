; ────────────────────────────────────────────────────────────────────────────
;  通用事件
; ────────────────────────────────────────────────────────────────────────────
Func __AUI_EventTypeValid($iType)
    Return $iType >= $AUI_EVENT_CLICK And $iType <= $AUI_EVENT_NUMBER
EndFunc

Func __AUI_EventFindToken($iToken)
    For $i = 1 To UBound($g_aAuiEventSubs) - 1
        If $g_aAuiEventSubs[$i][0] = $iToken Then Return $i
    Next
    Return 0
EndFunc

Func __AUI_EventHasSubscribers($hWnd, $iType, $iId)
    For $i = 1 To UBound($g_aAuiEventSubs) - 1
        If $g_aAuiEventSubs[$i][1] = $hWnd And $g_aAuiEventSubs[$i][2] = $iType And _
                $g_aAuiEventSubs[$i][3] = $iId Then Return True
    Next
    Return False
EndFunc

Func __AUI_EventAddRecord($hWnd, $iType, $iId, $sFuncName)
    If UBound($g_aAuiEventSubs) >= 4097 Then
        $g_iAuiUdfErrorCode = $AUI_ERR_LIMIT_EXCEEDED
        Return SetError($g_iAuiUdfErrorCode, 0, 0)
    EndIf
    Local $iToken = 0
    For $i = 1 To 4096
        If $g_iAuiEventNextToken <= 0 Or $g_iAuiEventNextToken > 0x7FFFFFFF Then $g_iAuiEventNextToken = 1
        Local $iCandidate = $g_iAuiEventNextToken
        $g_iAuiEventNextToken += 1
        If __AUI_EventFindToken($iCandidate) = 0 Then
            $iToken = $iCandidate
            ExitLoop
        EndIf
    Next
    If $iToken = 0 Then
        $g_iAuiUdfErrorCode = $AUI_ERR_LIMIT_EXCEEDED
        Return SetError($g_iAuiUdfErrorCode, 0, 0)
    EndIf
    Local $n = UBound($g_aAuiEventSubs)
    ReDim $g_aAuiEventSubs[$n + 1][5]
    $g_aAuiEventSubs[$n][0] = $iToken
    $g_aAuiEventSubs[$n][1] = $hWnd
    $g_aAuiEventSubs[$n][2] = $iType
    $g_aAuiEventSubs[$n][3] = $iId
    $g_aAuiEventSubs[$n][4] = $sFuncName
    Return SetError(0, 0, $iToken)
EndFunc

Func __AUI_EventDeleteIndex($iIndex)
    Local $n = UBound($g_aAuiEventSubs)
    If $iIndex <= 0 Or $iIndex >= $n Then Return
    For $i = $iIndex To $n - 2
        For $j = 0 To 4
            $g_aAuiEventSubs[$i][$j] = $g_aAuiEventSubs[$i + 1][$j]
        Next
    Next
    ReDim $g_aAuiEventSubs[$n - 1][5]
EndFunc

Func __AUI_EventDelElement($hWnd, $iId)
    For $i = UBound($g_aAuiEventSubs) - 1 To 1 Step -1
        If $g_aAuiEventSubs[$i][1] = $hWnd And $g_aAuiEventSubs[$i][3] = $iId Then _
            __AUI_EventDeleteIndex($i)
    Next
EndFunc

Func __AUI_EventDelWindow($hWnd)
    For $i = UBound($g_aAuiEventSubs) - 1 To 1 Step -1
        If $g_aAuiEventSubs[$i][1] = $hWnd Then __AUI_EventDeleteIndex($i)
    Next
EndFunc

Func __AUI_EventClear()
    ReDim $g_aAuiEventSubs[1][5]
EndFunc

Func __AUI_EventDispatch($hWnd, $iType, $iId, $v1 = 0, $v2 = 0, $iArgc = 1)
    Local $aHandlers[1][2], $iCount = 0
    For $i = UBound($g_aAuiEventSubs) - 1 To 1 Step -1
        If $g_aAuiEventSubs[$i][1] <> $hWnd Or $g_aAuiEventSubs[$i][2] <> $iType Or _
                $g_aAuiEventSubs[$i][3] <> $iId Then ContinueLoop
        ReDim $aHandlers[$iCount + 1][2]
        $aHandlers[$iCount][0] = $g_aAuiEventSubs[$i][0]
        $aHandlers[$iCount][1] = $g_aAuiEventSubs[$i][4]
        $iCount += 1
    Next
    For $i = 0 To $iCount - 1
        Local $iLiveIndex = __AUI_EventFindToken($aHandlers[$i][0])
        If $iLiveIndex = 0 Then ContinueLoop
        If $g_aAuiEventSubs[$iLiveIndex][1] <> $hWnd Or _
                $g_aAuiEventSubs[$iLiveIndex][2] <> $iType Or _
                $g_aAuiEventSubs[$iLiveIndex][3] <> $iId Then ContinueLoop
        Local $vHandled = __AUI_SafeCallResult($aHandlers[$i][1], $iId, $v1, $v2, $iArgc)
        If $vHandled Then Return True
    Next
    Return False
EndFunc

Func __AUI_EventNativeSet($hWnd, $iId, $iType, $bEnable)
    Local $pCallback = 0, $sExport = ""
    Switch $iType
        Case $AUI_EVENT_CLICK
            If $bEnable And $g_pAuiDispClick = 0 Then $g_pAuiDispClick = __AUI_RegisterCallback("__AUI_DispClick", "hwnd;int")
            $pCallback = $g_pAuiDispClick
            $sExport = "_UI_OnClick"
        Case $AUI_EVENT_CHANGE
            If $bEnable And $g_pAuiDispChange = 0 Then $g_pAuiDispChange = __AUI_RegisterCallback("__AUI_DispChange", "hwnd;int;wstr")
            $pCallback = $g_pAuiDispChange
            $sExport = "_UI_OnChange"
        Case $AUI_EVENT_VALUE
            If $bEnable And $g_pAuiDispValue = 0 Then $g_pAuiDispValue = __AUI_RegisterCallback("__AUI_DispValue", "hwnd;int;int")
            $pCallback = $g_pAuiDispValue
            $sExport = "_UI_OnValue"
        Case $AUI_EVENT_KEY
            If $bEnable And $g_pAuiDispKey = 0 Then $g_pAuiDispKey = __AUI_RegisterCallback("__AUI_DispKey", "hwnd;int;int;int")
            $pCallback = $g_pAuiDispKey
            $sExport = "_UI_OnKey"
        Case $AUI_EVENT_NUMBER
            If $bEnable And $g_pAuiDispNumber = 0 Then $g_pAuiDispNumber = __AUI_RegisterCallback("__AUI_DispNumber", "hwnd;int;double")
            $pCallback = $g_pAuiDispNumber
            $sExport = "_UI_OnNumberChange"
        Case Else
            $g_iAuiUdfErrorCode = $AUI_ERR_INVALID_ARGUMENT
            Return SetError($g_iAuiUdfErrorCode, 0, 0)
    EndSwitch
    If $bEnable And $pCallback = 0 Then Return SetError($AUI_UDF_ERR_CALLBACK_REGISTER, 0, 0)
    If Not $bEnable Then $pCallback = 0
    Local $iResult = __AUI_Call("int", $sExport, "hwnd", $hWnd, "int", $iId, "ptr", $pCallback)
    Return SetError(@error, 0, $iResult)
EndFunc
Func __AUI_DispClick($hWnd, $iId)
    If __AUI_EventDispatch($hWnd, $AUI_EVENT_CLICK, $iId, 0, 0, 1) Then Return
    Local $f = __AUI_CbGet($__AUI_CB_CLICK, $iId, $hWnd)
    If $f <> "" Then __AUI_SafeCall($f, $iId, 0, 0, 1)
EndFunc

Func __AUI_DispChange($hWnd, $iId, $sVal)
    If __AUI_EventDispatch($hWnd, $AUI_EVENT_CHANGE, $iId, $sVal, 0, 2) Then Return
    Local $f = __AUI_CbGet($__AUI_CB_CHANGE, $iId, $hWnd)
    If $f <> "" Then __AUI_SafeCall($f, $iId, $sVal, 0, 2)
EndFunc

Func __AUI_DispValue($hWnd, $iId, $iVal)
    If __AUI_EventDispatch($hWnd, $AUI_EVENT_VALUE, $iId, $iVal, 0, 2) Then Return
    Local $f = __AUI_CbGet($__AUI_CB_VALUE, $iId, $hWnd)
    If $f <> "" Then __AUI_SafeCall($f, $iId, $iVal, 0, 2)
EndFunc

Func __AUI_DispNumber($hWnd, $iId, $nVal)
    If __AUI_EventDispatch($hWnd, $AUI_EVENT_NUMBER, $iId, $nVal, 0, 2) Then Return
    Local $f = __AUI_CbGet($__AUI_CB_NUMBER, $iId, $hWnd)
    If $f <> "" Then __AUI_SafeCall($f, $iId, $nVal, 0, 2)
EndFunc

Func __AUI_DispKey($hWnd, $iId, $iK1, $iK2)
    If __AUI_EventDispatch($hWnd, $AUI_EVENT_KEY, $iId, $iK1, $iK2, 3) Then Return
    Local $f = __AUI_CbGet($__AUI_CB_KEY, $iId, $hWnd)
    If $f <> "" Then __AUI_SafeCall($f, $iId, $iK1, $iK2, 3)
EndFunc

Func __AUI_ReadFileDropPath($hWnd, $iDropId, $iIndex)
    Local $aNeed = __AUI_DllCall("int", "_UI_FileDropGetPath", _
            "hwnd", $hWnd, "uint64", $iDropId, "int", $iIndex, "ptr", 0, "int", 0)
    Local $iDllError = @error
    If $iDllError Or Not IsArray($aNeed) Then Return SetError($iDllError, 0, "")
    If $aNeed[0] < 0 Then Return SetError(__AUI_ReadNativeLastError(), 0, "")
    If $aNeed[0] = 0 Then
        Local $iNeedError = __AUI_ReadNativeLastError()
        Local $iNeedDllError = @error
        If $iNeedDllError Then Return SetError($iNeedDllError, 0, "")
        If $iNeedError <> $AUI_OK Then Return SetError($iNeedError, 0, "")
    EndIf
    Local $iCapacity = $aNeed[0] + 1
    If $iCapacity > $__AUI_READ_TEXT_MAX_CHARS Then
        $g_iAuiUdfErrorCode = $AUI_ERR_LIMIT_EXCEEDED
        Return SetError($g_iAuiUdfErrorCode, 0, "")
    EndIf
    Local $tBuffer = DllStructCreate("wchar[" & $iCapacity & "]")
    If @error Then
        $g_iAuiUdfErrorCode = $AUI_ERR_LIMIT_EXCEEDED
        Return SetError($g_iAuiUdfErrorCode, 0, "")
    EndIf
    Local $aRead = __AUI_DllCall("int", "_UI_FileDropGetPath", _
            "hwnd", $hWnd, "uint64", $iDropId, "int", $iIndex, _
            "ptr", DllStructGetPtr($tBuffer), "int", $iCapacity)
    $iDllError = @error
    If $iDllError Or Not IsArray($aRead) Then Return SetError($iDllError, 0, "")
    If $aRead[0] < 0 Then Return SetError(__AUI_ReadNativeLastError(), 0, "")
    If $aRead[0] = 0 Then
        Local $iReadError = __AUI_ReadNativeLastError()
        Local $iReadDllError = @error
        If $iReadDllError Then Return SetError($iReadDllError, 0, "")
        If $iReadError <> $AUI_OK Then Return SetError($iReadError, 0, "")
    EndIf
    If $aRead[0] >= $iCapacity Then
        $g_iAuiUdfErrorCode = $AUI_ERR_BUFFER_TOO_SMALL
        Return SetError($g_iAuiUdfErrorCode, $aRead[0] + 1, "")
    EndIf
    Return SetError(0, 0, DllStructGetData($tBuffer, 1))
EndFunc

Func __AUI_DispFileDrop($hWnd, $iTargetId, $iDropId, $iX, $iY)
    Local $aCount = __AUI_DllCall("int", "_UI_FileDropGetCount", _
            "hwnd", $hWnd, "uint64", $iDropId)
    If @error Or Not IsArray($aCount) Or $aCount[0] < 1 Then Return
    Local $aFiles[$aCount[0]]
    For $i = 0 To $aCount[0] - 1
        $aFiles[$i] = __AUI_ReadFileDropPath($hWnd, $iDropId, $i)
        If @error Then Return
    Next
    Local $f = __AUI_CbGet($__AUI_CB_FILE_DROP, $iTargetId, $hWnd)
    If $f <> "" Then Call($f, $hWnd, $iTargetId, $aFiles, $iX, $iY)
EndFunc

; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_EventSubscribe
; 說明 ...: Adds a handler to an element event and returns a stable token for exact unsubscription.
; 語法 ........: _UI_EventSubscribe( $hWnd, $iId, $iEvent, $sFuncName )
; 參數 ....: $hWnd - AUI window handle
;                  $iId - Target element ID
;                  $iEvent - $AUI_EVENT_CLICK/CHANGE/VALUE/KEY/NUMBER
;                  $sFuncName - User function name; signature is consistent with the corresponding _UI_On* function
; 傳回值 .: Success - Positive integer subscription token
;                  Failure - 0, and set @error
; 作者 ........: Fanxing
; 備註 .......: Additional handlers for the same event run in LIFO order, the most recently registered first. Returning True
;                  marks the event as handled and stops later subscriptions and the convenience main handler.
; 相關函式 .......: _UI_EventUnsubscribe, _UI_OnClick, _UI_OnChange, _UI_OnValue, _UI_OnKey, _UI_OnNumberChange
; 範例 .......: Yes
; ===============================================================================================================================
Func _UI_EventSubscribe($hWnd, $iId, $iEvent, $sFuncName)
    If Not __AUI_EventTypeValid($iEvent) Then
        $g_iAuiUdfErrorCode = $AUI_ERR_INVALID_ARGUMENT
        Return SetError($g_iAuiUdfErrorCode, 0, 0)
    EndIf
    If __AUI_IsCallable($sFuncName) = 0 Then Return SetError($AUI_UDF_ERR_INVALID_CALLBACK, 0, 0)
    Local $bHadSubscribers = __AUI_EventHasSubscribers($hWnd, $iEvent, $iId)
    Local $iToken = __AUI_EventAddRecord($hWnd, $iEvent, $iId, $sFuncName)
    Local $iAddError = @error
    If $iToken = 0 Then Return SetError($iAddError, 0, 0)
    If __AUI_EventNativeSet($hWnd, $iId, $iEvent, True) = 0 Then
        Local $iNativeError = @error
        __AUI_EventDeleteIndex(__AUI_EventFindToken($iToken))
        If Not $bHadSubscribers And __AUI_CbGet($iEvent, $iId, $hWnd) = "" Then _
            __AUI_EventNativeSet($hWnd, $iId, $iEvent, False)
        Return SetError($iNativeError, 0, 0)
    EndIf
    Return SetError(0, 0, $iToken)
EndFunc

; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_EventUnsubscribe
; 說明 ...: Removes an append event handler exactly by subscription token.
; 語法 ........: _UI_EventUnsubscribe( $iToken )
; 參數 ....: $iToken - _UI_EventSubscribe The token returned
; 傳回值 .: Success - 1
;                  Failure - 0; The token is invalid or the native event unbinding failed
; 作者 ........: Fanxing
; 備註 .......: When an element or window is destroyed, all its tokens will automatically expire and be recycled.
; 相關函式 .......: _UI_EventSubscribe
; 範例 .......: Yes
; ===============================================================================================================================
Func _UI_EventUnsubscribe($iToken)
    Local $iIndex = __AUI_EventFindToken($iToken)
    If $iIndex = 0 Then
        $g_iAuiUdfErrorCode = $AUI_ERR_INVALID_ARGUMENT
        Return SetError($g_iAuiUdfErrorCode, 0, 0)
    EndIf
    Local $hWnd = $g_aAuiEventSubs[$iIndex][1]
    Local $iEvent = $g_aAuiEventSubs[$iIndex][2]
    Local $iId = $g_aAuiEventSubs[$iIndex][3]
    Local $iSame = 0
    For $i = 1 To UBound($g_aAuiEventSubs) - 1
        If $g_aAuiEventSubs[$i][1] = $hWnd And $g_aAuiEventSubs[$i][2] = $iEvent And _
                $g_aAuiEventSubs[$i][3] = $iId Then $iSame += 1
    Next
    If $iSame = 1 And __AUI_CbGet($iEvent, $iId, $hWnd) = "" Then
        If __AUI_EventNativeSet($hWnd, $iId, $iEvent, False) = 0 Then Return SetError(@error, 0, 0)
    EndIf
    __AUI_EventDeleteIndex($iIndex)
    Return SetError(0, 0, 1)
EndFunc

; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_OnClick
; 說明 ...: Registers click callback Func($id).
; 語法 ........: _UI_OnClick( $hWnd, $iId, $sFuncName )
; 參數 ....: $hWnd - Window handle returned by _UI_WindowCreate
;                  $iId - Target element ID
;                  $sFuncName - Callback function name (string)
; 傳回值 .: Success - 1
;                  Failure - 0; the callback name is invalid, callback registration failed, or the native call failed
; 作者 ........: Fanxing
; 相關函式 .......: _UI_OnChange, _UI_OnValue
; 範例 .......: Yes
; ===============================================================================================================================
Func _UI_OnClick($hWnd, $iId, $sFuncName)
    If __AUI_ValidateOptionalCallback($sFuncName) = 0 Then Return SetError(@error, 0, 0)
    If $sFuncName <> "" And $g_pAuiDispClick = 0 Then $g_pAuiDispClick = __AUI_RegisterCallback("__AUI_DispClick", "hwnd;int")
    If $sFuncName <> "" And $g_pAuiDispClick = 0 Then Return SetError($AUI_UDF_ERR_CALLBACK_REGISTER, 0, 0)
    Local $sOldFunc = __AUI_CbGet($__AUI_CB_CLICK, $iId, $hWnd)
    If __AUI_CbSet($__AUI_CB_CLICK, $iId, $sFuncName, $hWnd) = 0 Then Return SetError($AUI_UDF_ERR_INVALID_CALLBACK, 0, 0)
    Local $pCallback = ($sFuncName = "" And Not __AUI_EventHasSubscribers($hWnd, $AUI_EVENT_CLICK, $iId)) ? 0 : $g_pAuiDispClick
    Local $iResult = __AUI_Call("int", "_UI_OnClick", "hwnd", $hWnd, "int", $iId, "ptr", $pCallback)
    Local $iCallError = @error
    If $iCallError Or $iResult = 0 Then
        __AUI_CbSet($__AUI_CB_CLICK, $iId, $sOldFunc, $hWnd)
        Return SetError($iCallError, 0, 0)
    EndIf
    Return SetError(0, 0, 1)
EndFunc

; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_OnChange
