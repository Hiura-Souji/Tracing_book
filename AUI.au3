; ────────────────────────────────────────────────────────────────────────────
;  Slider
; ────────────────────────────────────────────────────────────────────────────
Func __AUI_DispSliderCommit($hWnd, $iId, $iValue)
    Local $f = __AUI_CbGet($__AUI_CB_SLIDER_COMMIT, $iId, $hWnd)
    If $f <> "" Then __AUI_SafeCall($f, $iId, $iValue, 0, 2)
EndFunc

; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_Slider
; 說明 ...: Creates a slider (rangeable).
; 語法 ........: _UI_Slider( $hWnd, $iParent [, $iValue = 50 [, $iMin = 0 [, $iMax = 100 [, $iStep = 1 [, $iX = 0 [, $iY = 0
;                  [, $iW = 0 [, $iH = 0]]]]]]]] )
; 參數 ....: $hWnd - Window handle returned by _UI_WindowCreate
;                  $iParent - Parent element ID; use 0 for the window root
;                  $iValue - [Optional] Initial value, default 50
;                  $iMin - [optional] minimum value, default 0
;                  $iMax - [Optional] Maximum value, default 100
;                  $iStep - [Optional] Positive integer step size, default 1
;                  $iX - [Optional] Logical X coordinate (relative to parent container; ignored in flexible containers such as
;                  Row/Column), default 0
;                  $iY - [Optional] Logical Y coordinate (relative to parent container; ignored in flexible containers), default
;                  0
;                  $iW - [Optional] Logical width; 0 = automatically determined/filled by layout, default 0
;                  $iH - [Optional] Logical height; 0 = automatically determined/filled by layout, default 0
; 傳回值 .: Success - New element ID (integer, >= 1)
;                  Failure - 0
; 作者 ........: Fanxing
; 相關函式 .......: _UI_NumberInput, _UI_OnValue
; 範例 .......: Yes
; ===============================================================================================================================
Func _UI_Slider($hWnd, $iParent, $iValue = 50, $iMin = 0, $iMax = 100, $iStep = 1, _
