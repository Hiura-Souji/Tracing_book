; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_CanvasDrawImage
; 說明 ...: Draws local or HTTP(S) raster images in retained Canvas; image decoding is completed in the background and
;                  automatically re-uploaded after device rebuild.
; 語法 ........: _UI_CanvasDrawImage( $hWnd, $iId, $sSource, $nX, $nY, $nW, $nH [, $iFit = $AUI_FIT_CONTAIN [, $nOpacity = 1
;                  [, $iNetFlags = $AUI_NET_DEFAULT]]] )
; 參數 ....: $hWnd - Window handle
;                  $iId - Canvas element ID
;                  $sSource - Local image path or HTTP(S) address; only ordinary raster images are supported
;                  $nX - The horizontal logical coordinate of the upper left corner of the image area
;                  $nY - The vertical logical coordinate of the upper left corner of the image area
;                  $nW - Picture area logical width
;                  $nH - Picture area logical height
;                  $iFit - [Optional] $AUI_FIT_CONTAIN/COVER/STRETCH, the default is to keep the proportion and leave margins
;                  $nOpacity - [Optional] Opacity in the 0–1 range; default is 1.
;                  $iNetFlags - [Optional] Security flag of network source, default strict verification certificate
; 傳回值 .: Success - 1
;                  Failure - 0, and set the error code
; 作者 ........: Fanxing
; 範例 .......: Yes
; ===============================================================================================================================
Func _UI_CanvasDrawImage($hWnd, $iId, $sSource, $nX, $nY, $nW, $nH, $iFit = $AUI_FIT_CONTAIN, $nOpacity = 1, $iNetFlags = $AUI_NET_DEFAULT)
    Local $vAuiForwardResult = __AUI_Call("int", "_UI_CanvasDrawImage", "hwnd", $hWnd, "int", $iId, "wstr", $sSource, _
            "float", $nX, "float", $nY, "float", $nW, "float", $nH, "int", $iFit, "float", $nOpacity, "uint", $iNetFlags)
    Return SetError(@error, @extended, $vAuiForwardResult)
EndFunc

Func __AUI_CanvasBuildPoints(Const ByRef $aPoints, ByRef $tPoints, ByRef $iCount, $iMinimum = 3)
    If Not IsArray($aPoints) Or UBound($aPoints, 0) <> 1 Then
        $g_iAuiUdfErrorCode = $AUI_ERR_INVALID_ARGUMENT
        Return SetError($g_iAuiUdfErrorCode, 0, 0)
    EndIf
    Local $iValues = UBound($aPoints)
    If Mod($iValues, 2) <> 0 Then
        $g_iAuiUdfErrorCode = $AUI_ERR_INVALID_ARGUMENT
        Return SetError($g_iAuiUdfErrorCode, $iValues, 0)
    EndIf
    $iCount = Int($iValues / 2)
    If $iCount < $iMinimum Then
        $g_iAuiUdfErrorCode = $AUI_ERR_INVALID_ARGUMENT
        Return SetError($g_iAuiUdfErrorCode, $iCount, 0)
    EndIf
    If $iCount > 65535 Then
        $g_iAuiUdfErrorCode = $AUI_ERR_LIMIT_EXCEEDED
        Return SetError($g_iAuiUdfErrorCode, $iCount, 0)
    EndIf
    $tPoints = DllStructCreate("float[" & $iValues & "]")
    If @error Then
        $g_iAuiUdfErrorCode = $AUI_ERR_LIMIT_EXCEEDED
        Return SetError($g_iAuiUdfErrorCode, $iCount, 0)
    EndIf
    For $i = 0 To $iValues - 1
        DllStructSetData($tPoints, 1, $aPoints[$i], $i + 1)
    Next
    Return 1
EndFunc
; ────────────────────────────────────────────────────────────────────────────
;  Progress
