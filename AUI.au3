; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_WebViewExecuteScriptAsync
; 說明 ...: Executes JavaScript asynchronously on the current tab.
; 語法 ........: _UI_WebViewExecuteScriptAsync( $hWnd, $iWebId, $sScript [, $sOnDone = ""] )
; 參數 ....: $hWnd - Window handle returned by _UI_WindowCreate
;                  $iWebId - WebView control ID (_UI_WebView returned)
;                  $sScript - JavaScript code to execute
;                  $sOnDone - [Optional] Completion callback function name; an empty string indicates polling status by the
;                  caller, the default is ""
; 傳回值 .: Success - Request ID (> 0)
;                  Failure - 0; a parameter is invalid or the maximum number of unreleased requests has been reached
; 作者 ........: Fanxing
; 相關函式 .......: _UI_WebViewResultGet, _UI_WebViewResultRelease
; 範例 .......: Yes
; ===============================================================================================================================
Func _UI_WebViewExecuteScriptAsync($hWnd, $iWebId, $sScript, $sOnDone = "")
    If __AUI_ValidateOptionalCallback($sOnDone) = 0 Then Return SetError(@error, 0, 0)
    Local $pCallback = 0
    If $sOnDone <> "" Then
        If $g_pAuiDispWebResult = 0 Then $g_pAuiDispWebResult = __AUI_RegisterCallback("__AUI_DispWebResult", "hwnd;int;int;int")
        If $g_pAuiDispWebResult = 0 Then Return SetError(@error, 0, 0)
        $pCallback = $g_pAuiDispWebResult
    EndIf
    Local $iRequestId = __AUI_Call("int", "_UI_WebViewExecuteScriptAsync", _
            "hwnd", $hWnd, "int", $iWebId, "wstr", $sScript, "ptr", $pCallback)
    If @error Then Return SetError(@error, 0, 0)
    If __AUI_WebResultAttachCallback($hWnd, $iWebId, $iRequestId, $sOnDone) = 0 Then Return SetError(@error, 0, 0)
    Return $iRequestId
EndFunc

; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_WebViewCallCdpAsync
; 說明 ...: Asynchronously calls Chrome DevTools Protocol methods on the current tab.
; 語法 ........: _UI_WebViewCallCdpAsync( $hWnd, $iWebId, $sMethod [, $sParamsJson = "{}" [, $sOnDone = ""]] )
; 參數 ....: $hWnd - Window handle returned by _UI_WindowCreate
;                  $iWebId - WebView control ID (_UI_WebView returned)
;                  $sMethod - CDP method name (such as "Page.captureScreenshot")
;                  $sParamsJson - [Optional] CDP parameter JSON, default "{}"
;                  $sOnDone - [Optional] Completion callback function name; an empty string indicates polling status by the
;                  caller, the default is ""
; 傳回值 .: Success - Request ID (> 0)
;                  Failure - 0; a parameter is invalid or the maximum number of unreleased requests has been reached
; 作者 ........: Fanxing
; 相關函式 .......: _UI_WebViewResultGet, _UI_WebViewResultError
; 範例 .......: Yes
; ===============================================================================================================================
Func _UI_WebViewCallCdpAsync($hWnd, $iWebId, $sMethod, $sParamsJson = "{}", $sOnDone = "")
    If __AUI_ValidateOptionalCallback($sOnDone) = 0 Then Return SetError(@error, 0, 0)
    Local $pCallback = 0
    If $sOnDone <> "" Then
        If $g_pAuiDispWebResult = 0 Then $g_pAuiDispWebResult = __AUI_RegisterCallback("__AUI_DispWebResult", "hwnd;int;int;int")
        If $g_pAuiDispWebResult = 0 Then Return SetError(@error, 0, 0)
        $pCallback = $g_pAuiDispWebResult
    EndIf
    Local $iRequestId = __AUI_Call("int", "_UI_WebViewCallCdpAsync", _
            "hwnd", $hWnd, "int", $iWebId, "wstr", $sMethod, "wstr", $sParamsJson, "ptr", $pCallback)
    If @error Then Return SetError(@error, 0, 0)
    If __AUI_WebResultAttachCallback($hWnd, $iWebId, $iRequestId, $sOnDone) = 0 Then Return SetError(@error, 0, 0)
    Return $iRequestId
EndFunc

; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_WebViewResultStatus
; 說明 ...: Queries the status of an asynchronous JavaScript or CDP request.
; 語法 ........: _UI_WebViewResultStatus( $hWnd, $iWebId, $iRequestId )
; 參數 ....: $hWnd - Window handle returned by _UI_WindowCreate
;                  $iWebId - WebView control ID (_UI_WebView returned)
;                  $iRequestId - Asynchronous request ID
; 傳回值 .: Success - A $AUI_WEB_RESULT_* status
;                  Failure - $AUI_WEB_RESULT_INVALID
; 作者 ........: Fanxing
; 相關函式 .......: _UI_WebViewResultGet, _UI_WebViewResultError
; 範例 .......: Yes
; ===============================================================================================================================
Func _UI_WebViewResultStatus($hWnd, $iWebId, $iRequestId)
    Local $vAuiForwardResult = __AUI_Call("int", "_UI_WebViewResultStatus", "hwnd", $hWnd, "int", $iWebId, "int", $iRequestId)
    Return SetError(@error, @extended, $vAuiForwardResult)
EndFunc

; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_WebViewResultGet
; 說明 ...: Retrieves the result text of a successful asynchronous request.
; 語法 ........: _UI_WebViewResultGet( $hWnd, $iWebId, $iRequestId )
; 參數 ....: $hWnd - Window handle returned by _UI_WindowCreate
;                  $iWebId - WebView control ID (_UI_WebView returned)
;                  $iRequestId - Asynchronous request ID
; 傳回值 .: Success - JSON of original script/CDP, or locator decoded text; legal result can be the empty string
;                  Failure - "", @error: 1=invalid, 2=waiting, 3=failed, other=UDF loading error
; 作者 ........: Fanxing
; 相關函式 .......: _UI_WebViewResultStatus, _UI_WebViewResultRelease
; 範例 .......: Yes
; ===============================================================================================================================
Func _UI_WebViewResultGet($hWnd, $iWebId, $iRequestId)
    Local $iStatus = _UI_WebViewResultStatus($hWnd, $iWebId, $iRequestId)
    Local $iStatusError = @error
    If $iStatusError Then Return SetError($iStatusError, 0, "")
    Switch $iStatus
        Case $AUI_WEB_RESULT_INVALID
            $g_iAuiUdfErrorCode = 1
            Return SetError($g_iAuiUdfErrorCode, 0, "")
        Case $AUI_WEB_RESULT_PENDING
            $g_iAuiUdfErrorCode = 2
            Return SetError($g_iAuiUdfErrorCode, 0, "")
        Case $AUI_WEB_RESULT_FAILED
            $g_iAuiUdfErrorCode = 3
            Return SetError($g_iAuiUdfErrorCode, 0, "")
    EndSwitch
    Local $vAuiHelperResult = __AUI_ReadIndexedText("_UI_WebViewResultGet", $hWnd, $iWebId, $iRequestId)
    Return SetError(@error, @extended, $vAuiHelperResult)
EndFunc

; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_WebViewResultGetInt
; 說明 ...: Retrieves the decimal integer result of a successful asynchronous request.
; 語法 ........: _UI_WebViewResultGetInt( $hWnd, $iWebId, $iRequestId )
; 參數 ....: $hWnd - Window handle returned by _UI_WindowCreate
;                  $iWebId - WebView control ID (_UI_WebView returned)
;                  $iRequestId - Asynchronous request ID
; 傳回值 .: Success - Decimal integer
;                  Failure - 0, @error: same as _UI_WebViewResultGet; 5=The result is not an integer
; 作者 ........: Fanxing
; 相關函式 .......: _UI_WebViewResultGet, _UI_WebViewResultRelease
; 範例 .......: Yes
; ===============================================================================================================================
Func _UI_WebViewResultGetInt($hWnd, $iWebId, $iRequestId)
    Local $sValue = _UI_WebViewResultGet($hWnd, $iWebId, $iRequestId)
    Local $iError = @error
    If $iError Then Return SetError($iError, 0, 0)
    If Not StringRegExp($sValue, "^-?\d+$") Then
        $g_iAuiUdfErrorCode = 5
        Return SetError($g_iAuiUdfErrorCode, 0, 0)
    EndIf
    Return SetError(0, 0, Number($sValue))
EndFunc

; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_WebViewResultError
; 說明 ...: Retrieves the original HRESULT error code of the asynchronous request.
; 語法 ........: _UI_WebViewResultError( $hWnd, $iWebId, $iRequestId )
; 參數 ....: $hWnd - Window handle returned by _UI_WindowCreate
;                  $iWebId - WebView control ID (_UI_WebView returned)
;                  $iRequestId - Asynchronous request ID
; 傳回值 .: Success - Signed 32-bit HRESULT of failed request; 0 on success or pending
;                  Failure - E_INVALIDARG (invalid request)
; 作者 ........: Fanxing
; 相關函式 .......: _UI_WebViewResultStatus
; 範例 .......: Yes
; ===============================================================================================================================
Func _UI_WebViewResultError($hWnd, $iWebId, $iRequestId)
    Local $vAuiForwardResult = __AUI_Call("int", "_UI_WebViewResultError", "hwnd", $hWnd, "int", $iWebId, "int", $iRequestId)
    Return SetError(@error, @extended, $vAuiForwardResult)
EndFunc

; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_WebViewResultRelease
; 說明 ...: Releases the asynchronous request and its result storage.
; 語法 ........: _UI_WebViewResultRelease( $hWnd, $iWebId, $iRequestId )
; 參數 ....: $hWnd - Window handle returned by _UI_WindowCreate
;                  $iWebId - WebView control ID (_UI_WebView returned)
;                  $iRequestId - Asynchronous request ID; pending requests can also be released
; 傳回值 .: Success - 1
;                  Failure - 0 (request does not exist or has been released)
; 作者 ........: Fanxing
; 相關函式 .......: _UI_WebViewExecuteScriptAsync, _UI_WebViewCallCdpAsync, _UI_WebViewCountAsync
; 範例 .......: Yes
; ===============================================================================================================================
Func _UI_WebViewResultRelease($hWnd, $iWebId, $iRequestId)
    __AUI_CbDel($__AUI_CB_WEB_RESULT, $iWebId & ":" & $iRequestId, $hWnd)
    Local $vAuiForwardResult = __AUI_Call("int", "_UI_WebViewResultRelease", "hwnd", $hWnd, "int", $iWebId, "int", $iRequestId)
    Return SetError(@error, @extended, $vAuiForwardResult)
EndFunc

; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_WebViewStartPick
; 說明 ...: Starts element picking (click the mouse to select the page element).
; 語法 ........: _UI_WebViewStartPick( $hWnd, $iWebId )
; 參數 ....: $hWnd - Window handle returned by _UI_WindowCreate
;                  $iWebId - WebView control ID (_UI_WebView returned)
; 傳回值 .: Success - 1
;                  Failure - 0 (the control is not ready or the pick script failed to start)
; 作者 ........: Fanxing
; 相關函式 .......: _UI_WebViewGetPick, _UI_WebViewStopPick
; 範例 .......: Yes
; ===============================================================================================================================
Func _UI_WebViewStartPick($hWnd, $iWebId)
    Local $iStarted = __AUI_Call("int", "_UI_WebViewStartPick", "hwnd", $hWnd, "int", $iWebId)
    Local $iCallError = @error, $iCallExtended = @extended
    If $iStarted Then __AUI_CbDel($__AUI_CB_WEB_PICK_CACHE, $iWebId, $hWnd)
    Return SetError($iCallError, $iCallExtended, $iStarted)
EndFunc

