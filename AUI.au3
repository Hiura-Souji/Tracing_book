; 參數 ....: $hWnd - Window handle
;                  $iId - Target element ID
;                  $iColor1 - Starting point color, format 0xAARRGGBB
;                  $iColor2 - End color, format 0xAARRGGBB
;                  $iAngle - [Optional] Gradient angle: 0 left to right, 90 top to bottom, 45 top left to bottom right, default
;                  90
; 傳回值 .: Success - 1
;                  Failure - 0; angle is not a valid value
; 作者 ........: Fanxing
; 備註 .......: Gradient takes precedence over the solid background set by _UI_SetColor.
; 相關函式 .......: _UI_SetColor
; 範例 .......: Yes
; ===============================================================================================================================
Func _UI_SetGradient($hWnd, $iId, $iColor1, $iColor2, $iAngle = 90)
    Local $vAuiForwardResult = __AUI_Call("int", "_UI_SetGradient", _
               "hwnd", $hWnd, "int", $iId, "uint", $iColor1, "uint", $iColor2, _
               "double", $iAngle)
    Return SetError(@error, @extended, $vAuiForwardResult)
EndFunc

; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_SetFrosted
; 說明 ...: Turns the partial frosted background on or off for the element; this is an additional visual effect and does
;                  not create a new element.
; 語法 ........: _UI_SetFrosted( $hWnd, $iId [, $bEnable = True [, $iTint = 0 [, $iBlur = 16]]] )
; 參數 ....: $hWnd - Window handle
;                  $iId - Target element ID; typically Panel, Card, Drawer, or Popover
;                  $bEnable - [Optional] True to turn on, False to turn off, default True
;                  $iTint - [Optional] 0xAARRGGBB tint; 0 = follow the current theme, default 0
;                  $iBlur - [Optional] Blur radius in the 0–1,000 logical-pixel range; 0 applies the tint only. Default is 16.
; 傳回值 .: Success - 1
;                  Failure - 0; the blur radius is out of bounds or the element is invalid
; 作者 ........: Fanxing
; 備註 .......: Matte samples the drawn content behind the element; the shade remains when the device does not support
;                  blurring at the moment.
; 相關函式 .......: _UI_GetFrosted, _UI_SetColor, _UI_SetGradient
; 範例 .......: Yes
; ===============================================================================================================================
Func _UI_SetFrosted($hWnd, $iId, $bEnable = True, $iTint = 0, $iBlur = 16)
    Local $vAuiForwardResult = __AUI_Call("int", "_UI_SetFrosted", "hwnd", $hWnd, "int", $iId, _
               "int", ($bEnable ? 1 : 0), "uint", $iTint, "int", $iBlur)
    Return SetError(@error, @extended, $vAuiForwardResult)
EndFunc

; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_GetFrosted
; 說明 ...: Reads the element's current matte toggle, color yarn, and blur strengths.
; 語法 ........: _UI_GetFrosted( $hWnd, $iId )
; 參數 ....: $hWnd - Window handle
;                  $iId - Target element ID
; 傳回值 .: Success - Three-item array [whether enabled, color yarn ARGB, logical pixel blur intensity]
;                  Failure - 0, and set @error
; 作者 ........: Fanxing
; 相關函式 .......: _UI_SetFrosted
; 範例 .......: No
; ===============================================================================================================================
Func _UI_GetFrosted($hWnd, $iId)
    Local $tEnable = DllStructCreate("int"), $tTint = DllStructCreate("uint"), $tBlur = DllStructCreate("int")
    Local $iResult = __AUI_Call("int", "_UI_GetFrosted", "hwnd", $hWnd, "int", $iId, _
            "ptr", DllStructGetPtr($tEnable), "ptr", DllStructGetPtr($tTint), "ptr", DllStructGetPtr($tBlur))
    Local $iDllError = @error
    If $iDllError Then Return SetError($iDllError, 0, 0)
    If $iResult = 0 Then
        Local $iNativeError = _UI_GetLastError()
        If @error Or $iNativeError = $AUI_OK Then $iNativeError = $AUI_ERR_INVALID_ARGUMENT
        Return SetError($iNativeError, 0, 0)
    EndIf
    Local $aState[3] = [DllStructGetData($tEnable, 1) <> 0, DllStructGetData($tTint, 1), DllStructGetData($tBlur, 1)]
    Return SetError(0, 0, $aState)
EndFunc

