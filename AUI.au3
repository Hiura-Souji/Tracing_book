    Return SetError(@error, @extended, $vAuiForwardResult)
EndFunc

; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_SystemNotifyRegister
; 說明 ...: Registers the Windows system notification identity for the current process through the current user
;                  AppUserModelId registry.
; 語法 ........: _UI_SystemNotifyRegister( $sAppId, $sDisplayName [, $sIconPath = ""] )
; 參數 ....: $sAppId - Stable App ID; 1 to 128 ASCII letters, numbers, dots, underscores, or hyphens
;                  $sDisplayName - App name displayed in Notification Center; 1 to 128 characters
;                  $sIconPath - [Optional].ico,.exe, or.dll icon file; an empty string uses the current program icon
; 傳回值 .: Success - 1
;                  Failure - 0; The system does not support it, the parameters are invalid, the icon is unreadable, or the
;                  notification identity registration failed.
; 作者 ........: Fanxing
; 備註 .......: Only one App ID can be registered per process; please call before displaying notification for the first time.
;                  AUI writes the current user's AppUserModelId\<AppId> DisplayName/IconUri, without creating a Start menu
;                  shortcut. Registering the same ID repeatedly updates the display name and icon.
; 相關函式 .......: _UI_SystemNotifyIsSupported, _UI_SystemNotifyShow, _UI_GetLastError
; 範例 .......: Yes
; ===============================================================================================================================
Func _UI_SystemNotifyRegister($sAppId, $sDisplayName, $sIconPath = "")
    Local $vAuiForwardResult = __AUI_Call("int", "_UI_SystemNotifyRegister", _
                      "wstr", $sAppId, "wstr", $sDisplayName, "wstr", $sIconPath)
    Return SetError(@error, @extended, $vAuiForwardResult)
EndFunc

; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_SystemNotifyShow
; 說明 ...: Displays a native notification in Windows Notification Center.
; 語法 ........: _UI_SystemNotifyShow( $sTitle [, $sBody = "" [, $iDuration = $AUI_SYSTEM_NOTIFY_SHORT]] )
; 參數 ....: $sTitle - Notification title; cannot be empty together with body, maximum 4096 UTF-16 characters
;                  $sBody - [Optional] Notification text, up to 4096 UTF-16 characters
;                  $iDuration - [Optional] $AUI_SYSTEM_NOTIFY_SHORT or $AUI_SYSTEM_NOTIFY_LONG
; 傳回值 .: Success - 1
;                  Failure - 0; not yet registered, invalid parameter, notification rejected by system policy, or WinRT call
;                  failed
; 作者 ........: Fanxing
; 相關函式 .......: _UI_SystemNotifyRegister, _UI_SystemNotifyIsSupported, _UI_GetLastError
; 範例 .......: Yes
; ===============================================================================================================================
Func _UI_SystemNotifyShow($sTitle, $sBody = "", $iDuration = $AUI_SYSTEM_NOTIFY_SHORT)
    Local $vAuiForwardResult = __AUI_Call("int", "_UI_SystemNotifyShow", _
                      "wstr", $sTitle, "wstr", $sBody, "int", $iDuration)
    Return SetError(@error, @extended, $vAuiForwardResult)
EndFunc

; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_MessageBox
; 說明 ...: Displays up a system style message box ($AUI_ICON_* / $AUI_BTN_*).
; 語法 ........: _UI_MessageBox( $hWnd, $sTitle, $sBody [, $iIcon = $AUI_ICON_INFO [, $iButtons = $AUI_BTN_OK]] )
; 參數 ....: $hWnd - Owner window handle (_UI_WindowCreate returned)
;                  $sTitle - Title text
;                  $sBody - Text content
;                  $iIcon - [Optional] Icon $AUI_ICON_*, default $AUI_ICON_INFO
;                  $iButtons - [Optional] Button combination $AUI_BTN_*, default $AUI_BTN_OK
; 傳回值 .: Success - The system identifier of the button that was clicked
;                  Failure - 0
; 作者 ........: Fanxing
; 備註 .......: This is a synchronous window-level procedure API that does not create AUI elements or persistent state.
; 相關函式 .......: _UI_Dialog
; 範例 .......: Yes
; ===============================================================================================================================
Func _UI_MessageBox($hWnd, $sTitle, $sBody, $iIcon = $AUI_ICON_INFO, $iButtons = $AUI_BTN_OK)
    Local $vAuiForwardResult = __AUI_Call("int", "_UI_MessageBox", _
                       "hwnd", $hWnd, "wstr", $sTitle, "wstr", $sBody, _
                       "int", $iIcon, "int", $iButtons)
    Return SetError(@error, @extended, $vAuiForwardResult)
EndFunc

; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_WindowCreate
; 說明 ...: Creates a modern window (borderless + rounded corners + self-drawn title bar + resizable, opaque background).
; 語法 ........: _UI_WindowCreate( $sTitle, $iWidth, $iHeight )
; 參數 ....: $sTitle - Title text
;                  $iWidth - Window width (logical pixels)
;                  $iHeight - Window height (logical pixels)
; 傳回值 .: Success - Window handle HWND
;                  Failure - 0 with @error set to an $AUI_ERR_* code; use _UI_GetLastErrorText for diagnostic text
; 作者 ........: Fanxing
; 相關函式 .......: _UI_WindowCreateEx, _UI_WindowShow, _UI_Run
; 範例 .......: Yes
; ===============================================================================================================================
Func _UI_WindowCreate($sTitle, $iWidth, $iHeight)
    Local $hWnd = __AUI_Call("hwnd", "_UI_WindowCreate", _
                             "wstr", $sTitle, "int", $iWidth, "int", $iHeight)
    Local $iCreateError = @error
    If $hWnd = 0 Then Return SetError($iCreateError, 0, 0)
    If __AUI_AttachLifecycleDispatchers($hWnd) = 0 Then Return SetError(@error, 0, 0)
    Return SetError(0, 0, $hWnd)
EndFunc

; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_WindowCreateEx
; 說明 ...: Creates a window and specify the position and flag ($AUI_WIN_*, which can be combined in bits).
; 語法 ........: _UI_WindowCreateEx( $sTitle, $iX, $iY, $iWidth, $iHeight [, $iFlags = $AUI_WIN_DEFAULT] )
; 參數 ....: $sTitle - Title text
;                  $iX - Win32 in the upper left corner of the window virtual screen X coordinate (device pixels); -1 and $iY=-1
;                  represent the default position
;                  $iY - Win32 in the upper left corner of the window virtual screen Y coordinate (device pixels); -1 and $iX=-1
;                  represent the default position
;                  $iWidth - Window width (logical pixels)
;                  $iHeight - Window height (logical pixels)
;                  $iFlags - [Optional] Bitwise $AUI_WIN_* window flags, default $AUI_WIN_DEFAULT
; 傳回值 .: Success - Window handle HWND
;                  Failure - 0 with @error set to an $AUI_ERR_* code; use _UI_GetLastErrorText for diagnostic text
; 作者 ........: Fanxing
; 相關函式 .......: _UI_WindowCreate
; 範例 .......: Yes
; ===============================================================================================================================
Func _UI_WindowCreateEx($sTitle, $iX, $iY, $iWidth, $iHeight, $iFlags = $AUI_WIN_DEFAULT)
    Local $hWnd = __AUI_Call("hwnd", "_UI_WindowCreateEx", _
                             "wstr", $sTitle, "int", $iX, "int", $iY, _
                             "int", $iWidth, "int", $iHeight, "int", $iFlags)
    Local $iCreateError = @error
    If $hWnd = 0 Then Return SetError($iCreateError, 0, 0)
    If __AUI_AttachLifecycleDispatchers($hWnd) = 0 Then Return SetError(@error, 0, 0)
    Return SetError(0, 0, $hWnd)
EndFunc

