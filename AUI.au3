; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_GridSetCell
; 說明 ...: Sets an explicit zero-based row, column, and spans for a Grid child, or restores automatic placement.
; 語法 ........: _UI_GridSetCell( $hWnd, $iChild, $iRow, $iColumn [, $iRowSpan = 1 [, $iColumnSpan = 1]] )
; 參數 ....: $hWnd - Window handle returned by _UI_WindowCreate
;                  $iChild - ID of a child attached directly to the Grid
;                  $iRow - Zero-based row index within 0~65535; pass -1 together with $iColumn to restore automatic placement
;                  $iColumn - Zero-based column index, less than the current Grid column count; pass -1 together with $iRow to
;                  restore automatic placement
;                  $iRowSpan - [Optional] Number of rows occupied, within 1~256 and with $iRow + $iRowSpan not exceeding 65536;
;                  default 1
;                  $iColumnSpan - [Optional] Number of columns occupied, within 1~256 and not extending past the final Grid
;                  column; default 1
; 傳回值 .: Success - 1
;                  Failure - 0, and set @error
; 作者 ........: Fanxing
; 備註 .......: An explicitly positioned cell cannot overlap another explicitly positioned child participating in layout.
;                  Failure preserves the previous placement; spans remain effective in automatic placement mode.
; 相關函式 .......: _UI_Grid, _UI_GridGetCell, _UI_GridSetCols
; 範例 .......: Yes
; ===============================================================================================================================
Func _UI_GridSetCell($hWnd, $iChild, $iRow, $iColumn, $iRowSpan = 1, $iColumnSpan = 1)
    Local $vAuiForwardResult = __AUI_Call("int", "_UI_GridSetCell", _
            "hwnd", $hWnd, "int", $iChild, "int", $iRow, "int", $iColumn, _
            "int", $iRowSpan, "int", $iColumnSpan)
    Return SetError(@error, @extended, $vAuiForwardResult)
EndFunc

; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_GridGetCell
; 說明 ...: Returns the row, column, and spans of a Grid child.
; 語法 ........: _UI_GridGetCell( $hWnd, $iChild )
; 參數 ....: $hWnd - Window handle returned by _UI_WindowCreate
;                  $iChild - ID of a child attached directly to the Grid
; 傳回值 .: Success - A four-element array: [row, column, row span, column span]. Automatically placed items return -1
;                  for both row and column
;                  Failure - 0, and set @error
; 作者 ........: Fanxing
; 相關函式 .......: _UI_Grid, _UI_GridSetCell
; 範例 .......: Yes
; ===============================================================================================================================
Func _UI_GridGetCell($hWnd, $iChild)
    Local $tRow = DllStructCreate("int"), $tColumn = DllStructCreate("int")
    Local $tRowSpan = DllStructCreate("int"), $tColumnSpan = DllStructCreate("int")
    If @error Or Not IsDllStruct($tRow) Or Not IsDllStruct($tColumn) Or _
            Not IsDllStruct($tRowSpan) Or Not IsDllStruct($tColumnSpan) Then
        $g_iAuiUdfErrorCode = $AUI_ERR_LIMIT_EXCEEDED
        Return SetError($g_iAuiUdfErrorCode, 0, 0)
    EndIf
    Local $iResult = __AUI_Call("int", "_UI_GridGetCell", _
            "hwnd", $hWnd, "int", $iChild, _
            "ptr", DllStructGetPtr($tRow), "ptr", DllStructGetPtr($tColumn), _
            "ptr", DllStructGetPtr($tRowSpan), "ptr", DllStructGetPtr($tColumnSpan))
    If @error Or $iResult = 0 Then Return SetError(@error, @extended, 0)
    Local $aPlacement[4] = [DllStructGetData($tRow, 1), DllStructGetData($tColumn, 1), _
            DllStructGetData($tRowSpan, 1), DllStructGetData($tColumnSpan, 1)]
    Return SetError(0, 0, $aPlacement)
EndFunc
