;                  $sPointer - RFC 6901 JSON Pointer to an array; an empty string selects a root array
;                  $vValue - A native AutoIt value supported by _UI_JsonFromAutoIt
; 傳回值 .: Success - 1
;                  Failure - 0 and set @error
; 作者 ........: Fanxing
; 相關函式 .......: _UI_JsonArrayAppendRaw, _UI_JsonFromAutoIt
; 範例 .......: No
; ===============================================================================================================================
Func _UI_JsonArrayAppend($iJson, $sPointer, $vValue)
    Local $sJson = _UI_JsonFromAutoIt($vValue)
