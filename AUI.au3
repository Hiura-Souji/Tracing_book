    If $sFuncName <> "" And $g_pAuiDispValue = 0 Then Return SetError($AUI_UDF_ERR_CALLBACK_REGISTER, 0, 0)
    Local $sOldFunc = __AUI_CbGet($__AUI_CB_VALUE, $iId, $hWnd)
