; 語法 ........: _UI_StepsSetItemStatus( $hWnd, $iSteps, $iIndex, $iStatus )
; 參數 ....: $hWnd - Window handle returned by _UI_WindowCreate
;                  $iSteps - Steps control ID
;                  $iIndex - Zero-based step index
;                  $iStatus - $AUI_STEP_AUTO/WAIT/PROCESS/FINISH/ERROR
; 傳回值 .: Success - 1
;                  Failure - 0
; 作者 ........: Fanxing
; 備註 .......: AUTO is automatically derived based on the current step; explicit status is used for failed, skipped, or
;                  parallel processes and will not be overridden by SetCurrent.
; 相關函式 .......: _UI_StepsGetItemStatus, _UI_StepsGetEffectiveItemStatus
; 範例 .......: Yes
; ===============================================================================================================================
Func _UI_StepsSetItemStatus($hWnd, $iSteps, $iIndex, $iStatus)
    Local $vAuiForwardResult = __AUI_Call("int", "_UI_StepsSetItemStatus", _
                      "hwnd", $hWnd, "int", $iSteps, "int", $iIndex, "int", $iStatus)
    Return SetError(@error, @extended, $vAuiForwardResult)
EndFunc

