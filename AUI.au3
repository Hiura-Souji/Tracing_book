; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_DataViewBeginUpdate
; 說明 ...: Begins one level of a DataView model update and coalesces repeated redraw requests.
; 語法 ........: _UI_DataViewBeginUpdate( $hWnd, $iDataViewId )
; 參數 ....: $hWnd - Window handle
;                  $iDataViewId - DataView control ID
; 傳回值 .: Success - 1
;                  Failure - 0, and set @error
; 作者 ........: Fanxing
; 備註 .......: Nesting is supported; each successful call must be paired with _UI_DataViewEndUpdate.
; 相關函式 .......: _UI_DataViewEndUpdate, _UI_BeginUpdate
; 範例 .......: Yes
; ===============================================================================================================================
Func _UI_DataViewBeginUpdate($hWnd, $iDataViewId)
    Local $vAuiForwardResult = __AUI_Call("int", "_UI_DataViewBeginUpdate", "hwnd", $hWnd, "int", $iDataViewId)
    Return SetError(@error, @extended, $vAuiForwardResult)
EndFunc

; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_DataViewEndUpdate
; 說明 ...: Ends one level of a DataView model update and submits one redraw when the outermost update ends.
; 語法 ........: _UI_DataViewEndUpdate( $hWnd, $iDataViewId )
; 參數 ....: $hWnd - Window handle
;                  $iDataViewId - DataView control ID
; 傳回值 .: Success - 1
;                  Failure - 0, and set @error; fail when there is no corresponding Begin
; 作者 ........: Fanxing
; 備註 .......: Nested batches only increment the model revision number and refresh the view when the outermost End is
;                  executed.
; 相關函式 .......: _UI_DataViewBeginUpdate, _UI_EndUpdate
; 範例 .......: Yes
; ===============================================================================================================================
Func _UI_DataViewEndUpdate($hWnd, $iDataViewId)
    Local $vAuiForwardResult = __AUI_Call("int", "_UI_DataViewEndUpdate", "hwnd", $hWnd, "int", $iDataViewId)
    Return SetError(@error, @extended, $vAuiForwardResult)
EndFunc

