; 參數 ....: $hWnd - Window handle returned by _UI_WindowCreate
;                  $iImage - Image element ID
; 傳回值 .: Success - $AUI_IMAGE_LOAD_EMPTY/PENDING/READY/FAILED
;                  Failure - -1
; 作者 ........: Fanxing
; 相關函式 .......: _UI_ImageGetPixelSize, _UI_ImageSetSource
; 範例 .......: Yes
; ===============================================================================================================================
Func _UI_ImageGetLoadState($hWnd, $iImage)
    Local $vAuiForwardResult = __AUI_Call("int", "_UI_ImageGetLoadState", "hwnd", $hWnd, "int", $iImage)
    Return SetError(@error, @extended, $vAuiForwardResult)
EndFunc

; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_ImageGetPixelSize
; 說明 ...: Retrieves the original pixel dimensions of a decoded raster image.
; 語法 ........: _UI_ImageGetPixelSize( $hWnd, $iImage )
; 參數 ....: $hWnd - Window handle returned by _UI_WindowCreate
;                  $iImage - Image element ID
; 傳回值 .: Success - Two-element array [pixel width, pixel height]; SVG or null source is [0, 0]
;                  Failure - Null; the image is not ready or failed to load
; 作者 ........: Fanxing
; 相關函式 .......: _UI_ImageGetLoadState
; 範例 .......: Yes
; ===============================================================================================================================
Func _UI_ImageGetPixelSize($hWnd, $iImage)
    If __AUI_EnsureDll() = 0 Then Return SetError($g_iAuiLoadError, 0, Null)
    Local $aCall = __AUI_DllCall("int", "_UI_ImageGetPixelSize", _
            "hwnd", $hWnd, "int", $iImage, "int*", 0, "int*", 0)
    Local $iError = @error
    If $iError Or Not IsArray($aCall) Then Return SetError($iError, 0, Null)
    If $aCall[0] = 0 Then Return SetError(__AUI_ReadNativeLastError(), 0, Null)
    Local $aSize[2] = [$aCall[3], $aCall[4]]
    Return $aSize
EndFunc

; #FUNCTION# ===================================================================================================================
