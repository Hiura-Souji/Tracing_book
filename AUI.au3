    Local $pCallback = ($sFuncName = "" And Not __AUI_EventHasSubscribers($hWnd, $AUI_EVENT_VALUE, $iId)) ? 0 : $g_pAuiDispValue
    Local $iResult = __AUI_Call("int", "_UI_OnValue", "hwnd", $hWnd, "int", $iId, "ptr", $pCallback)
    Local $iCallError = @error
    If $iCallError Or $iResult = 0 Then
        __AUI_CbSet($__AUI_CB_VALUE, $iId, $sOldFunc, $hWnd)
        Return SetError($iCallError, 0, 0)
    EndIf
    Return SetError(0, 0, 1)
EndFunc

