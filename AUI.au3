Func __AUI_TreeSelectProxy($hWnd, $iId, $iNode)
    Local $f = __AUI_CbGet($__AUI_CB_TREE_SELECT, $iId, $hWnd)
    If $f <> "" Then __AUI_SafeCall($f, $iNode, 0, 0, 1)
EndFunc

Func __AUI_TreeDblProxy($hWnd, $iId, $iNode)
    Local $f = __AUI_CbGet($__AUI_CB_TREE_DBLCLICK, $iId, $hWnd)
    If $f <> "" Then __AUI_SafeCall($f, $iNode, 0, 0, 1)
EndFunc

Func __AUI_TreeReorderProxy($hWnd, $iId, $iNode, $iParent, $iPosition)
    Local $f = __AUI_CbGet($__AUI_CB_TREE_REORDER, $iId, $hWnd)
    If $f <> "" Then __AUI_SafeCall($f, $iNode, $iParent, $iPosition, 3)
EndFunc

; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_Tree
; 說明 ...: Creates a tree control (then use _UI_TreeAdd to add nodes).
; 語法 ........: _UI_Tree( $hWnd, $iParent [, $iX = 0 [, $iY = 0 [, $iW = 0 [, $iH = 0]]]] )
; 參數 ....: $hWnd - Window handle returned by _UI_WindowCreate
;                  $iParent - Parent element ID; use 0 for the window root
;                  $iX - [Optional] Logical X coordinate (relative to parent container; ignored in flexible containers such as
;                  Row/Column), default 0
;                  $iY - [Optional] Logical Y coordinate (relative to parent container; ignored in flexible containers), default
;                  0
;                  $iW - [Optional] Logical width; 0 = automatically determined/filled by layout, default 0
;                  $iH - [Optional] Logical height; 0 = automatically determined/filled by layout, default 0
; 傳回值 .: Success - New element ID (integer, >= 1)
;                  Failure - 0
; 作者 ........: Fanxing
; 備註 .......: UI Automation exposes SelectionItem and ExpandCollapse by stable 64-bit node ID. Collapsed nodes do not
;                  expose children, and removal invalidates existing providers.
; 相關函式 .......: _UI_TreeAdd, _UI_TreeFromArray, _UI_TreeFromMap
; 範例 .......: Yes
; ===============================================================================================================================
Func _UI_Tree($hWnd, $iParent, $iX = 0, $iY = 0, $iW = 0, $iH = 0)
    Local $vAuiForwardResult = __AUI_Call("int", "_UI_Tree", _
                       "hwnd", $hWnd, "int", $iParent, _
                       "int", $iX, "int", $iY, "int", $iW, "int", $iH)
    Return SetError(@error, @extended, $vAuiForwardResult)
EndFunc

; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_TreeBeginUpdate
; 說明 ...: Begins a Tree batch update and suspends visible-node cache rebuilding and layout.
; 語法 ........: _UI_TreeBeginUpdate( $hWnd, $iTree )
; 參數 ....: $hWnd - Window handle returned by _UI_WindowCreate
;                  $iTree - Tree control ID (_UI_Tree returned)
; 傳回值 .: Success - 1
;                  Failure - 0
; 作者 ........: Fanxing
; 備註 .......: Nestable; each successful call must pair _UI_TreeEndUpdate.
; 範例 .......: Yes
; ===============================================================================================================================
Func _UI_TreeBeginUpdate($hWnd, $iTree)
    Local $vAuiForwardResult = __AUI_Call("int", "_UI_TreeBeginUpdate", "hwnd", $hWnd, "int", $iTree)
    Return SetError(@error, @extended, $vAuiForwardResult)
EndFunc

; #FUNCTION# ===================================================================================================================
