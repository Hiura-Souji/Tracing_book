;                  0]]]]]] )
; 參數 ....: $hWnd - Window handle returned by _UI_WindowCreate
;                  $iParent - Parent container element ID
;                  $sPlaceholder - [Optional] Placeholder text to display when the value is empty
;                  $sValue - [optional] initial text
;                  $iX - [Optional] Left logical pixel coordinate, default 0
;                  $iY - [Optional] Top logical pixel coordinate, default 0
;                  $iW - [Optional] Logical pixel width, default 0 (auto)
;                  $iH - [Optional] Logical pixel height, default 0 (auto)
; 傳回值 .: Success - Element ID
;                  Failure - 0
; 作者 ........: Fanxing
; 範例 .......: Yes
; ===============================================================================================================================
Func _UI_Input($hWnd, $iParent, $sPlaceholder = "", $sValue = "", $iX = 0, $iY = 0, $iW = 0, $iH = 0)
