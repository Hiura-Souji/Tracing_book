; 參數 ....: $hWnd - Window handle
;                  $iDataView - DataView control ID
;                  $iCol - Label column index
; 傳回值 .: Success - $AUI_VAR_* constant
;                  Failure - -1
; 作者 ........: Fanxing
; 相關函式 .......: _UI_DataViewSetColumnTag
; 範例 .......: Yes
; ===============================================================================================================================
Func _UI_DataViewGetColumnTag($hWnd, $iDataView, $iCol)
    Local $vAuiForwardResult = __AUI_Call("int", "_UI_DataViewGetColumnTag", "hwnd", $hWnd, "int", $iDataView, "int", $iCol)
    Return SetError(@error, @extended, $vAuiForwardResult)
EndFunc

; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_DataViewSetColumnTagVariant
; 說明 ...: Sets a semantic appearance for an exact text in the label column.
; 語法 ........: _UI_DataViewSetColumnTagVariant( $hWnd, $iDataView, $iCol, $sValue, $iVariant )
; 參數 ....: $hWnd - Window handle
;                  $iDataView - DataView control ID
;                  $iCol - Label column index
;                  $sValue - The complete cell text to match
;                  $iVariant - $AUI_VAR_DEFAULT/PRIMARY/SUCCESS/WARNING/DANGER
; 傳回值 .: Success - 1
;                  Failure - 0
; 作者 ........: Fanxing
; 備註 .......: Mappings are explicit; AUI never infers a color from cell text. Each Tag column stores at most 256 exact-text
;                  mappings. Exceeding this limit sets @error to $AUI_ERR_LIMIT_EXCEEDED.
; 相關函式 .......: _UI_DataViewGetColumnTagVariant, _UI_DataViewClearColumnTagVariants
; 範例 .......: Yes
; ===============================================================================================================================
Func _UI_DataViewSetColumnTagVariant($hWnd, $iDataView, $iCol, $sValue, $iVariant)
    Local $vAuiForwardResult = __AUI_Call("int", "_UI_DataViewSetColumnTagVariant", "hwnd", $hWnd, "int", $iDataView, _
            "int", $iCol, "wstr", $sValue, "int", $iVariant)
    Return SetError(@error, @extended, $vAuiForwardResult)
EndFunc

; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_DataViewGetColumnTagVariant
; 說明 ...: Retrieves the final semantic appearance of the tag used by the specified text.
; 語法 ........: _UI_DataViewGetColumnTagVariant( $hWnd, $iDataView, $iCol, $sValue )
; 參數 ....: $hWnd - Window handle
;                  $iDataView - DataView control ID
;                  $iCol - Label column index
;                  $sValue - The complete cell text to be queried
; 傳回值 .: Success - Private mapping; returns column default variant when no mapping exists
;                  Failure - -1
; 作者 ........: Fanxing
; 相關函式 .......: _UI_DataViewSetColumnTagVariant
; 範例 .......: Yes
; ===============================================================================================================================
Func _UI_DataViewGetColumnTagVariant($hWnd, $iDataView, $iCol, $sValue)
    Local $vAuiForwardResult = __AUI_Call("int", "_UI_DataViewGetColumnTagVariant", "hwnd", $hWnd, "int", $iDataView, _
            "int", $iCol, "wstr", $sValue)
    Return SetError(@error, @extended, $vAuiForwardResult)
EndFunc

