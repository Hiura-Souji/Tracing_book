; 說明 ...: Turns on or off the element's perfect circle/capsule background (rounded corners = half of the short side).
; 語法 ........: _UI_SetCircle( $hWnd, $iId [, $bEnable = True] )
; 參數 ....: $hWnd - Window handle
;                  $iId - Element ID (usually a fixed-size square container, such as a round button)
;                  $bEnable - [Optional] True to turn on, False to turn off, default True
; 傳回值 .: Success - 1
;                  Failure - 0
; 作者 ........: Fanxing
; 範例 .......: No
; ===============================================================================================================================
Func _UI_SetCircle($hWnd, $iId, $bEnable = True)
    Local $vAuiForwardResult = __AUI_Call("int", "_UI_SetCircle", "hwnd", $hWnd, "int", $iId, "int", $bEnable ? 1 : 0)
    Return SetError(@error, @extended, $vAuiForwardResult)
EndFunc

; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_SetFont
; 說明 ...: Sets element font and size.
; 語法 ........: _UI_SetFont( $hWnd, $iId [, $sFamily = "" [, $fSize = 14.0]] )
; 參數 ....: $hWnd - Window handle returned by _UI_WindowCreate
;                  $iId - Target element ID
;                  $sFamily - [Optional] Font name; the default is an empty string, which means using the theme default font
;                  $fSize - [Optional] Font size (96-DPI equivalent logical pixels), default 14.0
; 傳回值 .: Success - 1
;                  Failure - 0; Invalid font name or size
; 作者 ........: Fanxing
; 相關函式 .......: _UI_SetColor
; 範例 .......: Yes
; ===============================================================================================================================
Func _UI_SetFont($hWnd, $iId, $sFamily = "", $fSize = 14.0)
    Local $vAuiForwardResult = __AUI_Call("int", "_UI_SetFont", _
               "hwnd", $hWnd, "int", $iId, "wstr", $sFamily, "float", $fSize)
    Return SetError(@error, @extended, $vAuiForwardResult)
EndFunc

; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_SetFocus
; 說明 ...: Moves keyboard focus to an element.
; 語法 ........: _UI_SetFocus( $hWnd, $iId )
; 參數 ....: $hWnd - Window handle returned by _UI_WindowCreate
;                  $iId - Target element ID
; 傳回值 .: Success - 1
;                  Failure - 0; element is not focusable, disabled, or invisible
; 作者 ........: Fanxing
; 範例 .......: Yes
; ===============================================================================================================================
Func _UI_SetFocus($hWnd, $iId)
    Local $vAuiForwardResult = __AUI_Call("int", "_UI_SetFocus", "hwnd", $hWnd, "int", $iId)
    Return SetError(@error, @extended, $vAuiForwardResult)
EndFunc

; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_SetTabIndex
; 說明 ...: Sets an element's position in Tab and Shift+Tab navigation.
; 語法 ........: _UI_SetTabIndex( $hWnd, $iId, $iTabIndex )
; 參數 ....: $hWnd - Window handle returned by _UI_WindowCreate
;                  $iId - Target element ID
;                  $iTabIndex - -1 skips Tab navigation; 0 follows element-tree order; values from 1 through 32767 are visited
;                  before default-order elements in ascending order
; 傳回值 .: Success - 1
;                  Failure - 0; the order is outside -1 through 32767, or the element is invalid
; 作者 ........: Fanxing
; 備註 .......: -1 excludes the element only from Tab and Shift+Tab navigation; it remains focusable by mouse and
;                  _UI_SetFocus. Hidden, collapsed, or disabled elements, and all their descendants, are always excluded from
;                  focus navigation.
; 相關函式 .......: _UI_GetTabIndex, _UI_SetFocus
; 範例 .......: No
; ===============================================================================================================================
Func _UI_SetTabIndex($hWnd, $iId, $iTabIndex)
    Local $vAuiForwardResult = __AUI_Call("int", "_UI_SetTabIndex", "hwnd", $hWnd, "int", $iId, "int", $iTabIndex)
    Return SetError(@error, @extended, $vAuiForwardResult)
EndFunc

; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_GetTabIndex
; 說明 ...: Returns an element's Tab navigation order.
; 語法 ........: _UI_GetTabIndex( $hWnd, $iId )
; 參數 ....: $hWnd - Window handle returned by _UI_WindowCreate
;                  $iId - Target element ID
; 傳回值 .: Success - Current Tab order from -1 through 32767
;                  Failure - -2; invalid element
; 作者 ........: Fanxing
; 相關函式 .......: _UI_SetTabIndex, _UI_SetFocus
; 範例 .......: No
; ===============================================================================================================================
Func _UI_GetTabIndex($hWnd, $iId)
    Local $vAuiForwardResult = __AUI_Call("int", "_UI_GetTabIndex", "hwnd", $hWnd, "int", $iId)
    Return SetError(@error, @extended, $vAuiForwardResult)
EndFunc

