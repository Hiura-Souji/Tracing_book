; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_WebSocketCreate
; 說明 ...: Creates a configurable WebSocket object.
; 語法 ........: _UI_WebSocketCreate( $hWnd, $sUrl [, $iTimeout = 0 [, $iNetFlags = $AUI_NET_DEFAULT [, $sOnEvent = ""]]] )
; 參數 ....: $hWnd - Target window handle
;                  $sUrl - Ws:// or wss:// address
;                  $iTimeout - Number of milliseconds for handshake and network timeouts; 0 uses the 30 second default
;                  $iNetFlags - Request level network security flags
;                  $sOnEvent - Optional callback Func($iSocketId, $iEvent)
; 傳回值 .: Success - Socket ID
;                  Failure - 0
; 作者 ........: Fanxing
; 備註 .......: A process supports at most 64 WebSocket objects. A handshake follows at most 10 redirects, all of which count
;                  toward the total timeout. Cross-origin redirects remove Authorization, Proxy-Authorization, and Cookie;
;                  WSS-to-WS downgrade is rejected by default and is permitted only when $AUI_NET_ALLOW_INSECURE_REDIRECT is set
;                  explicitly. WinHTTP does not expose an API for actively sending protocol-level Ping or Pong frames; use
;                  application-level heartbeat messages when keepalive traffic is required. WSS explicitly prevents WinHTTP from
;                  automatically selecting a client certificate from the current user's certificate store; the current API does
;                  not expose mTLS client-certificate configuration.
; 範例 .......: Yes
; ===============================================================================================================================
Func _UI_WebSocketCreate($hWnd, $sUrl, $iTimeout = 0, $iNetFlags = $AUI_NET_DEFAULT, $sOnEvent = "")
    Local $vAbortResult
    If __AUI_ValidateOptionalCallback($sOnEvent) = 0 Then Return SetError(@error, 0, 0)
    Local $pCallback = 0
    If $sOnEvent <> "" Then
        If $g_pAuiDispWebSocket = 0 Then $g_pAuiDispWebSocket = __AUI_RegisterCallback("__AUI_DispWebSocket", "int;int")
        If $g_pAuiDispWebSocket = 0 Then Return SetError(@error, 0, 0)
        $pCallback = $g_pAuiDispWebSocket
    EndIf
    Local $iId = __AUI_Call("int", "_UI_WebSocketCreate", "hwnd", $hWnd, "wstr", $sUrl, "int", $iTimeout, "uint", $iNetFlags, "ptr", $pCallback)
    If @error Then Return SetError(@error, 0, 0)
    If $iId > 0 Then
        If $sOnEvent <> "" And __AUI_CbSet($__AUI_CB_WEBSOCKET, $iId, $sOnEvent, 0, False) = 0 Then
            $vAbortResult = __AUI_WebSocketAbortRegistration($iId, @error)
            Return SetError(@error, @extended, $vAbortResult)
        EndIf
        If $sOnEvent <> "" And __AUI_CbSet($__AUI_CB_WEBSOCKET_OWNER, $iId, $hWnd, 0, False) = 0 Then
            $vAbortResult = __AUI_WebSocketAbortRegistration($iId, @error)
            Return SetError(@error, @extended, $vAbortResult)
        EndIf
    EndIf
    Return $iId
EndFunc

; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_WebSocketSetHeader
; 說明 ...: Sets or replaces a WebSocket handshake header.
; 語法 ........: _UI_WebSocketSetHeader( $iSocketId, $sName, $sValue )
; 參數 ....: $iSocketId - Socket ID
;                  $sName - Header name
;                  $sValue - Header value
; 傳回值 .: Success - 1
;                  Failure - 0
; 作者 ........: Fanxing
; 備註 .......: One object accepts at most 128 handshake headers. A name is limited to 256 characters and a value to 8,192
;                  characters. CR/LF injection and managed headers such as Host, Connection, Upgrade, Content-Length, and
;                  Sec-WebSocket-* are rejected.
; 範例 .......: No
; ===============================================================================================================================
Func _UI_WebSocketSetHeader($iSocketId, $sName, $sValue)
    Local $vAuiForwardResult = __AUI_Call("int", "_UI_WebSocketSetHeader", "int", $iSocketId, "wstr", $sName, "wstr", $sValue)
    Return SetError(@error, @extended, $vAuiForwardResult)
EndFunc

; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_WebSocketSetProtocols
; 說明 ...: Sets the ordered list of requested WebSocket subprotocols.
; 語法 ........: _UI_WebSocketSetProtocols( $iSocketId, $sProtocols )
; 參數 ....: $iSocketId - Socket ID
;                  $sProtocols - Comma-separated list of RFC tokens; an empty string means no subprotocols are requested
; 傳回值 .: Success - 1
;                  Failure - 0
; 作者 ........: Fanxing
; 備註 .......: The complete list is limited to 8,192 characters. Every item must be a valid RFC token; empty items and
;                  trailing commas are rejected.
; 範例 .......: No
; ===============================================================================================================================
Func _UI_WebSocketSetProtocols($iSocketId, $sProtocols)
    Local $vAuiForwardResult = __AUI_Call("int", "_UI_WebSocketSetProtocols", "int", $iSocketId, "wstr", $sProtocols)
    Return SetError(@error, @extended, $vAuiForwardResult)
EndFunc

; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_WebSocketConnect
; 說明 ...: Starts the WebSocket handshake on a background thread.
; 語法 ........: _UI_WebSocketConnect( $iSocketId )
; 參數 ....: $iSocketId - _UI_WebSocketCreate Socket ID returned
; 傳回值 .: Success - 1
;                  Failure - 0
; 作者 ........: Fanxing
; 備註 .......: Does not block the AutoIt UI thread. The handshake must receive HTTP 101; success raises $AUI_WS_OPEN.
; 範例 .......: No
; ===============================================================================================================================
Func _UI_WebSocketConnect($iSocketId)
    Local $vAuiForwardResult = __AUI_Call("int", "_UI_WebSocketConnect", "int", $iSocketId)
    Return SetError(@error, @extended, $vAuiForwardResult)
EndFunc
; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_WebSocketSendText
; 說明 ...: Send UTF-8 text messages.
; 語法 ........: _UI_WebSocketSendText( $iSocketId, $sText )
; 參數 ....: $iSocketId - Socket ID
;                  $sText - Text message
; 傳回值 .: Success - 1
;                  Failure - 0
; 作者 ........: Fanxing
; 備註 .......: An empty text message is valid. One message is limited to 16 MiB, and the send queue is limited to 256
;                  messages and 64 MiB in total.
; 範例 .......: No
; ===============================================================================================================================
Func _UI_WebSocketSendText($iSocketId, $sText)
    Local $vAuiForwardResult = __AUI_Call("int", "_UI_WebSocketSendText", "int", $iSocketId, "wstr", $sText)
    Return SetError(@error, @extended, $vAuiForwardResult)
EndFunc
; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_WebSocketSendBytes
; 說明 ...: Send binary message.
; 語法 ........: _UI_WebSocketSendBytes( $iSocketId, $vBinary )
; 參數 ....: $iSocketId - Socket ID
;                  $vBinary - AutoIt Binary value
; 傳回值 .: Success - 1
;                  Failure - 0
; 作者 ........: Fanxing
; 備註 .......: Accepts only an AutoIt Binary value; an empty Binary message is valid. One message is limited to 16 MiB, and
;                  the send queue is limited to 256 messages and 64 MiB in total.
; 範例 .......: No
; ===============================================================================================================================
Func _UI_WebSocketSendBytes($iSocketId, $vBinary)
    If Not IsBinary($vBinary) Then
        Local $vInvalidResult = __AUI_Fail($AUI_ERR_INVALID_ARGUMENT, 0, 0)
        Return SetError(@error, @extended, $vInvalidResult)
    EndIf
    Local $iSize = BinaryLen($vBinary), $iCapacity = $iSize
    If $iCapacity < 1 Then $iCapacity = 1
    Local $tBytes = DllStructCreate("byte[" & $iCapacity & "]")
    If $iSize > 0 Then DllStructSetData($tBytes, 1, $vBinary)
    Local $vAuiForwardResult = __AUI_Call("int", "_UI_WebSocketSendBytes", "int", $iSocketId, "ptr", DllStructGetPtr($tBytes), "int", $iSize)
    Return SetError(@error, @extended, $vAuiForwardResult)
EndFunc
; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_WebSocketClose
; 說明 ...: Closes WebSocket.
; 語法 ........: _UI_WebSocketClose( $iSocketId [, $iStatus = 1000 [, $sReason = ""]] )
; 參數 ....: $iSocketId - Socket ID
;                  $iStatus - [Optional] WebSocket close status code
;                  $sReason - [Optional] Close reason, converted internally to UTF-8
; 傳回值 .: Success - 1
;                  Failure - 0
; 作者 ........: Fanxing
; 備註 .......: The close reason is limited to 123 bytes after UTF-8 conversion. Only RFC-permitted status codes and private
;                  status codes from 3000 through 4999 are accepted. A configured object transitions directly to the closed
;                  terminal state. A connected object sends a close frame asynchronously and reaches the terminal state after
;                  receiving the peer's close frame. A successful graceful close raises $AUI_WS_CLOSE exactly once and leaves
;                  the error code at zero.
; 範例 .......: No
; ===============================================================================================================================
Func _UI_WebSocketClose($iSocketId, $iStatus = 1000, $sReason = "")
    Local $vAuiForwardResult = __AUI_Call("int", "_UI_WebSocketClose", "int", $iSocketId, "int", $iStatus, "wstr", $sReason)
    Return SetError(@error, @extended, $vAuiForwardResult)
EndFunc
; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_WebSocketCancel
; 說明 ...: Cancel connection or close request.
; 語法 ........: _UI_WebSocketCancel( $iSocketId )
; 參數 ....: $iSocketId - Socket ID
; 傳回值 .: Success - 1
;                  Failure - 0
; 作者 ........: Fanxing
; 備註 .......: A configured, connecting, open, or closing object can be cancelled; a terminal object cannot be cancelled
;                  again. Cancellation closes the active WinHTTP handle and raises $AUI_WS_CLOSE once.
; 範例 .......: No
; ===============================================================================================================================
Func _UI_WebSocketCancel($iSocketId)
    Local $vAuiForwardResult = __AUI_Call("int", "_UI_WebSocketCancel", "int", $iSocketId)
    Return SetError(@error, @extended, $vAuiForwardResult)
EndFunc
; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_WebSocketRelease
; 說明 ...: Releases a WebSocket object.
; 語法 ........: _UI_WebSocketRelease( $iSocketId )
; 參數 ....: $iSocketId - Socket ID
; 傳回值 .: Success - 1
;                  Failure - 0
; 作者 ........: Fanxing
; 備註 .......: A configured or terminal object can be released; CONNECTING, OPEN, and CLOSING objects cannot be released.
;                  The socket ID becomes invalid immediately after release.
; 範例 .......: No
; ===============================================================================================================================
Func _UI_WebSocketRelease($iSocketId)
    Local $v = __AUI_Call("int", "_UI_WebSocketRelease", "int", $iSocketId)
    Local $iError = @error, $iExtended = @extended
    If $v Then
        __AUI_CbDel($__AUI_CB_WEBSOCKET, $iSocketId)
        __AUI_CbDel($__AUI_CB_WEBSOCKET_OWNER, $iSocketId)
    EndIf
    Return SetError($iError, $iExtended, $v)
EndFunc
; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_WebSocketStatus
; 說明 ...: Queries WebSocket status.
; 語法 ........: _UI_WebSocketStatus( $iSocketId )
; 參數 ....: $iSocketId - Socket ID
; 傳回值 .: Success - Status value
;                  Failure - -1
; 作者 ........: Fanxing
; 備註 .......: The state is CONFIGURED, CONNECTING, OPEN, CLOSING, CLOSED, FAILED, or CANCELLED.
; 範例 .......: No
; ===============================================================================================================================
Func _UI_WebSocketStatus($iSocketId)
    Local $vAuiForwardResult = __AUI_Call("int", "_UI_WebSocketStatus", "int", $iSocketId)
    Return SetError(@error, @extended, $vAuiForwardResult)
EndFunc
; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_WebSocketRead
; 說明 ...: Retrieves the currently received WebSocket message.
; 語法 ........: _UI_WebSocketRead( $iSocketId, $iMessageType )
; 參數 ....: $iSocketId - Socket ID
;                  $iMessageType - ByRef output message type
; 傳回值 .: Success - Text messages return String, binary messages return Binary
;                  Failure - Empty string
; 作者 ........: Fanxing
; 備註 .......: The receive queue is limited to 256 messages and 64 MiB in total, and one message is limited to 16 MiB. A
;                  valid empty text message returns "" and a valid empty binary message returns an empty Binary value; both set
;                  @error = 0. Use @error to distinguish an empty queue or a failed call.
; 範例 .......: No
; ===============================================================================================================================
Func _UI_WebSocketRead($iSocketId, ByRef $iMessageType)
    Local $tType = DllStructCreate("int")
    Local $aNeed = __AUI_DllCall("int", "_UI_WebSocketRead", "int", $iSocketId, "ptr", 0, "int", 0, "ptr", DllStructGetPtr($tType))
    If @error Or Not IsArray($aNeed) Then Return SetError(@error, 0, "")
    If $aNeed[0] < 0 Then Return SetError(__AUI_ReadNativeLastError(), 0, "")
    $iMessageType = DllStructGetData($tType, 1)
    If $aNeed[0] = 0 Then
        Local $iNativeError = __AUI_ReadNativeLastError()
        Local $iNativeDllError = @error
        If $iNativeDllError Then Return SetError($iNativeDllError, 0, "")
        If $iNativeError <> $AUI_OK Then Return SetError($iNativeError, 0, "")
    EndIf
    Local $iCapacity = $aNeed[0]
    If $iCapacity < 1 Then $iCapacity = 1
    Local $tBuffer = DllStructCreate("byte[" & $iCapacity & "]")
    Local $aRead = __AUI_DllCall("int", "_UI_WebSocketRead", "int", $iSocketId, "ptr", DllStructGetPtr($tBuffer), "int", $aNeed[0], "ptr", DllStructGetPtr($tType))
    If @error Or Not IsArray($aRead) Then Return SetError(@error, 0, "")
    If $aRead[0] = 0 Then
        Local $iReadError = __AUI_ReadNativeLastError()
        Local $iReadDllError = @error
        If $iReadDllError Then Return SetError($iReadDllError, 0, "")
        If $iReadError <> $AUI_OK Then Return SetError($iReadError, 0, "")
        If $iMessageType = $AUI_WS_TEXT Then Return SetError(0, 0, "")
        Return SetError(0, 0, StringToBinary(""))
    EndIf
    Local $vBinary = DllStructGetData($tBuffer, 1)
    If $iMessageType = $AUI_WS_TEXT Then Return SetError(0, 0, BinaryToString($vBinary, 4))
    Return SetError(0, 0, $vBinary)
EndFunc
