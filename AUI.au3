; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_WebViewJsonField
; 說明 ...: Retrieves the value of a key from the JSON string (auxiliary; parsed by the AUI JSON runtime, so escaped
;                  characters, surrogate pairs, and numeric formats follow full JSON semantics).
; 語法 ........: _UI_WebViewJsonField( $sJson, $sKey )
; 參數 ....: $sJson - JSON text (an object is expected)
;                  $sKey - Key name to be taken
; 傳回值 .: Success - The value is returned as text: strings return their decoded content, numbers preserve their
;                  complete JSON token, and bool/null values return "true", "false", or "null"
;                  Failure - ""; @error = $AUI_ERR_JSON for a syntax error, $AUI_ERR_OUT_OF_RANGE for a missing key
; 作者 ........: Fanxing
; 備註 .......: Replaces the former regular-expression extractor; the value is returned as text for compatibility with
;                  _UI_WebViewGetPick. Numeric tokens such as 1.2300, 1e+03, and integers outside Int64 are returned exactly as
;                  written. A string containing U+0000 fails with $AUI_ERR_LIMIT_EXCEEDED.
; 相關函式 .......: _UI_WebViewGetPick, _UI_JsonGetNumberText
; 範例 .......: No
; ===============================================================================================================================
Func _UI_WebViewJsonField($sJson, $sKey)
    If __AUI_EnsureDll() = 0 Then Return SetError($g_iAuiLoadError, 0, "")
    Local $iJson = _UI_JsonParse($sJson)
    If $iJson = 0 Then Return SetError(@error, 0, "")
    Local $iType = _UI_JsonType($iJson, $sKey)
    If @error Then
        Local $iTypeError = @error
        _UI_JsonFree($iJson)
        Return SetError($iTypeError, 0, "")
    EndIf
    If $iType = $AUI_JSON_INT Or $iType = $AUI_JSON_DOUBLE Then
        Local $sNumber = _UI_JsonGetNumberText($iJson, $sKey)
        Local $iNumberError = @error
        _UI_JsonFree($iJson)
        If $iNumberError Then Return SetError($iNumberError, 0, "")
        Return SetError(0, 0, $sNumber)
    EndIf
    Switch $iType
        Case $AUI_JSON_STRING
            Local $sValue = _UI_JsonGetString($iJson, $sKey)
            $iErr = @error
            _UI_JsonFree($iJson)
            If $iErr Then Return SetError($iErr, 0, "")
            Return SetError(0, 0, $sValue)
        Case $AUI_JSON_BOOL
            Local $bValue = _UI_JsonGetBool($iJson, $sKey)
            $iErr = @error
            _UI_JsonFree($iJson)
            If $iErr Then Return SetError($iErr, 0, "")
            Return SetError(0, 0, ($bValue ? "true" : "false"))
        Case $AUI_JSON_NULL
            _UI_JsonFree($iJson)
            Return SetError(0, 0, "null")
        Case Else
            _UI_JsonFree($iJson)
            $g_iAuiUdfErrorCode = $AUI_ERR_WRONG_ELEMENT_TYPE
            Return SetError($g_iAuiUdfErrorCode, 0, "")
    EndSwitch
EndFunc

; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_WebViewOnPick
; 說明 ...: Registers the "pick complete" callback.
; 語法 ........: _UI_WebViewOnPick( $hWnd, $iWebId, $sFunc )
; 參數 ....: $hWnd - Window handle returned by _UI_WindowCreate
;                  $iWebId - WebView control ID (_UI_WebView returned)
;                  $sFunc - Callback function name (string)
; 傳回值 .: Success - 1
;                  Failure - 0; the callback name is invalid, callback registration failed, or the native call failed
; 作者 ........: Fanxing
; 相關函式 .......: _UI_WebViewStartPick
; 範例 .......: Yes
; ===============================================================================================================================
Func _UI_WebViewOnPick($hWnd, $iWebId, $sFunc)
    If __AUI_ValidateOptionalCallback($sFunc) = 0 Then Return SetError(@error, 0, 0)
    If $sFunc <> "" And $g_pAuiDispWebTab = 0 Then $g_pAuiDispWebTab = __AUI_RegisterCallback("__AUI_DispWebTab", "hwnd;int;int;int")
    If $sFunc <> "" And $g_pAuiDispWebTab = 0 Then Return SetError(@error, 0, 0)
    Local $sOldFunc = __AUI_CbGet($__AUI_CB_WEB_PICK, $iWebId, $hWnd)
    If __AUI_CbSet($__AUI_CB_WEB_PICK, $iWebId, $sFunc, $hWnd) = 0 Then Return SetError(@error, 0, 0)
    Local $pCallback = $sFunc = "" ? 0 : $g_pAuiDispWebTab
    Local $iResult = __AUI_Call("int", "_UI_WebViewOnPick", "hwnd", $hWnd, "int", $iWebId, "ptr", $pCallback)
    Local $iCallError = @error
    If $iCallError Or $iResult = 0 Then
        __AUI_CbSet($__AUI_CB_WEB_PICK, $iWebId, $sOldFunc, $hWnd)
        Return SetError($iCallError, 0, 0)
    EndIf
    Return SetError(0, 0, 1)
EndFunc

; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_WebViewIsRuntimeInstalled
; 說明 ...: Checks whether the Microsoft Edge WebView2 Runtime is installed.
; 語法 ........: _UI_WebViewIsRuntimeInstalled()
; 參數 ....: None
; 傳回值 .: Success - 1
;                  Failure - 0
; 作者 ........: Fanxing
; 相關函式 .......: _UI_WebView
; 範例 .......: Yes
; ===============================================================================================================================
Func _UI_WebViewIsRuntimeInstalled()
    If __AUI_EnsureDll() = 0 Then Return SetError($g_iAuiLoadError, 0, 0)
    Local $a = __AUI_DllCall("int", "_UI_WebViewIsRuntimeInstalled")
    Local $iDllError = @error
    If $iDllError Or Not IsArray($a) Then Return SetError($iDllError, 0, 0)
    Return SetError(0, 0, $a[0])
EndFunc
; ────────────────────────────────────────────────────────────────────────────
;  MediaView
; ────────────────────────────────────────────────────────────────────────────
Func __AUI_DispMedia($hWnd, $iMediaId, $iEvent)
    Local $f = __AUI_CbGet($__AUI_CB_MEDIA, $iMediaId, $hWnd)
    If $f <> "" Then __AUI_SafeCall($f, $iEvent, 0, 0, 1)
EndFunc

; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_MediaView
; 說明 ...: Creates Windows MediaPlayer audio/video elements; video frames are still self-drawn in AUI single HWND.
; 語法 ........: _UI_MediaView( $hWnd, $iParent, $sSource [, $iX = 0 [, $iY = 0 [, $iW = 0 [, $iH = 0]]]] )
; 參數 ....: $hWnd - Window handle returned by _UI_WindowCreate
;                  $iParent - Parent container element ID
;                  $sSource - Media source; supports local path, local file, HTTP/HTTPS, empty string means not loading yet
;                  $iX - [Optional] Left logical pixel coordinate, default 0
;                  $iY - [Optional] Top logical pixel coordinate, default 0
;                  $iW - [Optional] Logical pixel width, default 0 (auto)
;                  $iH - [Optional] Logical pixel height, default 0 (auto)
; 傳回值 .: Returns MediaView element ID on success, 0 on failure
; 作者 ........: Fanxing
; 範例 .......: Yes
; ===============================================================================================================================
Func _UI_MediaView($hWnd, $iParent, $sSource, $iX = 0, $iY = 0, $iW = 0, $iH = 0)
    Local $vAuiForwardResult = __AUI_Call("int", "_UI_MediaView", _
            "hwnd", $hWnd, "int", $iParent, "wstr", $sSource, _
            "int", $iX, "int", $iY, "int", $iW, "int", $iH)
    Return SetError(@error, @extended, $vAuiForwardResult)
EndFunc

