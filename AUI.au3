; ────────────────────────────────────────────────────────────────────────────
;  Divider
; ────────────────────────────────────────────────────────────────────────────
; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_Divider
; 說明 ...: Creates a divider line (horizontal or vertical) that divides areas in the layout. Commonly used horizontal
;                  lines are $iW=0 (filled with width) $iH=1; commonly used vertical lines are $iW=1 $iH=0 (filled with height).
;                  The color can be set with _UI_SetColor (the background color is the line color).
; 語法 ........: _UI_Divider( $hWnd, $iParent [, $bVertical = False [, $iX = 0 [, $iY = 0 [, $iW = 0 [, $iH = 0]]]]] )
; 參數 ....: $hWnd - Window handle returned by _UI_WindowCreate
;                  $iParent - Parent element ID; use 0 for the window root
;                  $bVertical - [Optional] True means vertical lines, False means horizontal lines; default False
;                  $iX - [Optional] The logical X coordinate relative to the parent container; within a flexible layout
;                  container, it is usually automatically calculated by the layout and defaults to 0
;                  $iY - [Optional] Logical Y coordinate relative to the parent container; within a flexible layout container,
;                  it is usually automatically calculated by the layout and defaults to 0
;                  $iW - [Optional] Logical width; 0 means automatically determined by layout, default 0
;                  $iH - [Optional] Logical height; 0 means automatically determined by layout, default 0
; 傳回值 .: Success - New element ID (integer, >=1)
;                  Failure - 0
; 作者 ........: Fanxing
; 相關函式 .......: _UI_DividerSetThickness, _UI_DividerSetInset, _UI_SetColor
; 範例 .......: No
; ===============================================================================================================================
Func _UI_Divider($hWnd, $iParent, $bVertical = False, $iX = 0, $iY = 0, $iW = 0, $iH = 0)
	Local $vAuiForwardResult = __AUI_Call("int", "_UI_Divider", _
	                   "hwnd", $hWnd, "int", $iParent, "int", $bVertical ? 1 : 0, _
	                   "int", $iX, "int", $iY, "int", $iW, "int", $iH)
	Return SetError(@error, @extended, $vAuiForwardResult)
EndFunc

; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_DividerSetVertical
; 說明 ...: Sets divider direction.
; 語法 ........: _UI_DividerSetVertical( $hWnd, $iDivider, $bVertical )
; 參數 ....: $hWnd - Window handle returned by _UI_WindowCreate
;                  $iDivider - _UI_Divider returns the separator element ID
;                  $bVertical - True is a vertical line, False is a horizontal line
; 傳回值 .: Success - 1
;                  Failure - 0
; 作者 ........: Fanxing
; 相關函式 .......: _UI_DividerGetVertical
; 範例 .......: Yes
; ===============================================================================================================================
Func _UI_DividerSetVertical($hWnd, $iDivider, $bVertical)
	Local $vAuiForwardResult = __AUI_Call("int", "_UI_DividerSetVertical", "hwnd", $hWnd, "int", $iDivider, "int", $bVertical ? 1 : 0)
	Return SetError(@error, @extended, $vAuiForwardResult)
EndFunc

; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_DividerGetVertical
; 說明 ...: Checks whether the dividing line is a vertical line.
; 語法 ........: _UI_DividerGetVertical( $hWnd, $iDivider )
; 參數 ....: $hWnd - Window handle returned by _UI_WindowCreate
;                  $iDivider - Divider element ID
; 傳回值 .: Success - 1 is a vertical line, 0 is a horizontal line
;                  Failure - 0; call _UI_GetLastError to identify the failure
; 作者 ........: Fanxing
; 相關函式 .......: _UI_DividerSetVertical
; 範例 .......: Yes
; ===============================================================================================================================
Func _UI_DividerGetVertical($hWnd, $iDivider)
	Local $vAuiForwardResult = __AUI_Call("int", "_UI_DividerGetVertical", "hwnd", $hWnd, "int", $iDivider)
	Return SetError(@error, @extended, $vAuiForwardResult)
EndFunc

; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_DividerSetThickness
; 說明 ...: Sets the divider thickness. 0 = fill the entire strip (line thickness = thickness of the strip); >0 = draw a
;                  thin line of this thickness (logical pixels) in the center of the strip to leave white space on both sides.
; 語法 ........: _UI_DividerSetThickness( $hWnd, $iId, $iPx )
; 參數 ....: $hWnd - Window handle returned by _UI_WindowCreate
;                  $iId - Target element ID
;                  $iPx - The thickness of the dividing line in logical pixels
; 傳回值 .: Success - 1
;                  Failure - 0
; 作者 ........: Fanxing
; 相關函式 .......: _UI_DividerGetThickness
; 範例 .......: No
; ===============================================================================================================================
Func _UI_DividerSetThickness($hWnd, $iId, $iPx)
	Local $vAuiForwardResult = __AUI_Call("int", "_UI_DividerSetThickness", "hwnd", $hWnd, "int", $iId, "int", $iPx)
	Return SetError(@error, @extended, $vAuiForwardResult)
EndFunc

; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_DividerGetThickness
; 說明 ...: Queries the current thickness of the separator line.
; 語法 ........: _UI_DividerGetThickness( $hWnd, $iDivider )
; 參數 ....: $hWnd - Window handle returned by _UI_WindowCreate
;                  $iDivider - Divider element ID
; 傳回值 .: Success - Logical pixel thickness; 0 means fill the divider
;                  Failure - -1
; 作者 ........: Fanxing
; 相關函式 .......: _UI_DividerSetThickness
; 範例 .......: No
; ===============================================================================================================================
Func _UI_DividerGetThickness($hWnd, $iDivider)
	Local $vAuiForwardResult = __AUI_Call("int", "_UI_DividerGetThickness", "hwnd", $hWnd, "int", $iDivider)
	Return SetError(@error, @extended, $vAuiForwardResult)
EndFunc

; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_DividerSetInset
; 說明 ...: Sets the pixels at both ends of the long axis of the divider to be indented so that the line does not hit the
;                  edge of the container (to create a separation with white space).
; 語法 ........: _UI_DividerSetInset( $hWnd, $iId, $iPx )
; 參數 ....: $hWnd - Window handle returned by _UI_WindowCreate
;                  $iId - Target element ID
;                  $iPx - Indent both ends of the divider in logical pixels
; 傳回值 .: Success - 1
;                  Failure - 0
; 作者 ........: Fanxing
; 相關函式 .......: _UI_DividerGetInset
; 範例 .......: No
; ===============================================================================================================================
Func _UI_DividerSetInset($hWnd, $iId, $iPx)
	Local $vAuiForwardResult = __AUI_Call("int", "_UI_DividerSetInset", "hwnd", $hWnd, "int", $iId, "int", $iPx)
	Return SetError(@error, @extended, $vAuiForwardResult)
EndFunc

; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_DividerGetInset
; 說明 ...: Queries the current indentation of both ends of the long axis of the dividing line.
; 語法 ........: _UI_DividerGetInset( $hWnd, $iDivider )
; 參數 ....: $hWnd - Window handle returned by _UI_WindowCreate
;                  $iDivider - Divider element ID
; 傳回值 .: Success - Logical pixel indentation value
;                  Failure - -1
; 作者 ........: Fanxing
; 相關函式 .......: _UI_DividerSetInset
; 範例 .......: No
; ===============================================================================================================================
Func _UI_DividerGetInset($hWnd, $iDivider)
	Local $vAuiForwardResult = __AUI_Call("int", "_UI_DividerGetInset", "hwnd", $hWnd, "int", $iDivider)
	Return SetError(@error, @extended, $vAuiForwardResult)
