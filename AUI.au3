;                  $iIndex - Insertion index from 0 through the current array length
;                  $sValueJson - A complete, valid JSON value
; 傳回值 .: Success - 1
;                  Failure - 0 and set @error
; 作者 ........: Fanxing
; 相關函式 .......: _UI_JsonArrayInsert, _UI_JsonArrayAppendRaw
; 範例 .......: No
; ===============================================================================================================================
Func _UI_JsonArrayInsertRaw($iJson, $sPointer, $iIndex, $sValueJson)
    Local $vAuiForwardResult = __AUI_Call("int", "_UI_JsonArrayInsertRaw", "int", $iJson, "wstr", $sPointer, _
            "int", $iIndex, "wstr", $sValueJson)
    Return SetError(@error, @extended, $vAuiForwardResult)
EndFunc

