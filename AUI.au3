; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_DataViewSetArray
; 說明 ...: Replaces all rows in a non-virtual DataView with a one- or two-dimensional AutoIt array.
; 語法 ........: _UI_DataViewSetArray( $hWnd, $iDataView, Const ByRef $aData )
; 參數 ....: $hWnd - Window handle returned by _UI_WindowCreate
;                  $iDataView - DataView control ID
;                  $aData - A one-dimensional array represents a single column, and a two-dimensional array represents multiple
;                  columns.
; 傳回值 .: Success - 1
;                  Failure - 0 and set @error
; 作者 ........: Fanxing
; 備註 .......: The array is first encoded as TAB/CRLF text in one pass, across the DLL only once; cells cannot contain TAB
;                  or line breaks.
; 範例 .......: Yes
; ===============================================================================================================================
Func _UI_DataViewSetArray($hWnd, $iDataView, Const ByRef $aData)
    Local $sRows = __AUI_DataViewArrayToText($aData)
    If @error Then Return SetError(@error, @extended, 0)
    Local $vAuiForwardResult = _UI_DataViewSetRows($hWnd, $iDataView, $sRows)
    Return SetError(@error, @extended, $vAuiForwardResult)
EndFunc

; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_DataViewAppendArray
; 說明 ...: Appends a one- or two-dimensional AutoIt array to a DataView in one batch.
; 語法 ........: _UI_DataViewAppendArray( $hWnd, $iDataView, Const ByRef $aData )
; 參數 ....: $hWnd - Window handle returned by _UI_WindowCreate
;                  $iDataView - DataView control ID
;                  $aData - A one-dimensional array represents a single column, and a two-dimensional array represents multiple
;                  columns.
; 傳回值 .: Success - Actual number of rows appended
;                  Failure - -1 and set @error
; 作者 ........: Fanxing
; 範例 .......: Yes
; ===============================================================================================================================
Func _UI_DataViewAppendArray($hWnd, $iDataView, Const ByRef $aData)
    Local $sRows = __AUI_DataViewArrayToText($aData)
    If @error Then Return SetError(@error, @extended, -1)
    Local $vAuiForwardResult = _UI_DataViewAppendRows($hWnd, $iDataView, $sRows)
    Return SetError(@error, @extended, $vAuiForwardResult)
EndFunc

; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_DataViewGetArray
; 說明 ...: Retrieves consecutive rows from a non-virtual DataView as a two-dimensional AutoIt array.
; 語法 ........: _UI_DataViewGetArray( $hWnd, $iDataView [, $iFirst = 0 [, $iCount = -1]] )
; 參數 ....: $hWnd - Window handle returned by _UI_WindowCreate
;                  $iDataView - DataView control ID
;                  $iFirst - [optional] starting line, default 0
;                  $iCount - [Optional] Number of lines; -1 means to the end, default -1
; 傳回值 .: Success - 2D array [row][column]
;                  Failure - 0 and set @error; the virtual table is explicitly rejected to avoid materialization of millions of
;                  rows
; 作者 ........: Fanxing
; 範例 .......: Yes
; ===============================================================================================================================
Func _UI_DataViewGetArray($hWnd, $iDataView, $iFirst = 0, $iCount = -1)
    Local $iTotal = _UI_DataViewGetRowCount($hWnd, $iDataView)
    If $iTotal = 0 Then
        Local $iRowCountError = _UI_GetLastError()
        If $iRowCountError <> $AUI_OK Then Return SetError($iRowCountError, 0, 0)
    EndIf
    If $iFirst < 0 Or $iFirst > $iTotal Then
        $g_iAuiUdfErrorCode = $AUI_ERR_OUT_OF_RANGE
        Return SetError($g_iAuiUdfErrorCode, 0, 0)
    EndIf
    If $iCount = -1 Then $iCount = $iTotal - $iFirst
    If $iCount < 0 Or $iCount > $iTotal - $iFirst Then
        $g_iAuiUdfErrorCode = $AUI_ERR_OUT_OF_RANGE
        Return SetError($g_iAuiUdfErrorCode, 0, 0)
    EndIf
    Local $iColumns = _UI_DataViewGetColumnCount($hWnd, $iDataView)
    If $iColumns <= 0 Then
        Local $iColumnCountError = _UI_GetLastError()
        Return SetError($iColumnCountError <> $AUI_OK ? $iColumnCountError : $AUI_ERR_INVALID_ARGUMENT, 0, 0)
    EndIf
    Local $aResult[$iCount][$iColumns]
    If $iCount = 0 Then Return SetError(0, 0, $aResult)
    Local $sRows = _UI_DataViewGetRows($hWnd, $iDataView, $iFirst, $iCount)
    If @error Then Return SetError(@error, @extended, 0)
    Local $aLines = StringSplit($sRows, @CRLF, 3)
    For $iRow = 0 To $iCount - 1
        Local $sLine = $iRow < UBound($aLines) ? $aLines[$iRow] : ""
        Local $aCells = StringSplit($sLine, @TAB, 3)
        For $iColumn = 0 To $iColumns - 1
            If $iColumn < UBound($aCells) Then $aResult[$iRow][$iColumn] = $aCells[$iColumn]
        Next
    Next
    Return SetError(0, 0, $aResult)
EndFunc

; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_DataViewFindText
; 說明 ...: Finds text in plain DataView.
; 語法 ........: _UI_DataViewFindText( $hWnd, $iDataView, $sText [, $iStartRow = 0 [, $iColumn = -1 [, $iFlags =
;                  $AUI_DATAVIEW_FIND_CONTAINS]]] )
; 參數 ....: $hWnd - Window handle returned by _UI_WindowCreate
;                  $iDataView - DataView control ID
;                  $sText - Target text
;                  $iStartRow - [optional] starting line, default 0
;                  $iColumn - [Optional] Specify columns; -1 searches all columns, default -1
;                  $iFlags - [Optional] $AUI_DATAVIEW_FIND_* flag, default contains matching
; 傳回值 .: Success - The row index found, @extended is the column index
;                  Failure - -1; @error is 0 when not found, non-zero when the parameter is wrong
; 作者 ........: Fanxing
; 範例 .......: Yes
; ===============================================================================================================================
Func _UI_DataViewFindText($hWnd, $iDataView, $sText, $iStartRow = 0, $iColumn = -1, $iFlags = $AUI_DATAVIEW_FIND_CONTAINS)
    If __AUI_EnsureDll() = 0 Then Return SetError($g_iAuiLoadError, -1, -1)
    Local $aResult = __AUI_DllCall("int", "_UI_DataViewFindText", "hwnd", $hWnd, "int", $iDataView, _
        "wstr", $sText, "int", $iStartRow, "int", $iColumn, "int", $iFlags, "int*", -1)
    Local $iDllError = @error
    If $iDllError Or Not IsArray($aResult) Then Return SetError($iDllError, -1, -1)
    Local $iNativeError = __AUI_ReadNativeLastError()
    Return SetError($iNativeError, $aResult[7], $aResult[0])
EndFunc

