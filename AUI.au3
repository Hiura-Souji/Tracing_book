; 參數 ....: $hWnd - Window handle returned by _UI_WindowCreate
;                  $iParent - Parent element ID; use 0 for the window root
;                  $sIconOrEmoji - Icon: Segoe MDL2 glyph code (such as 0xE713) or Emoji character
;                  $iX - [Optional] Logical X coordinate (relative to parent container; ignored in flexible containers such as
;                  Row/Column), default 0
;                  $iY - [Optional] Logical Y coordinate (relative to parent container; ignored in flexible containers), default
;                  0
;                  $iW - [Optional] Logical width; 0 = use control's intrinsic size or content measurement; explicit size takes
;                  precedence, default 0
;                  $iH - [Optional] Logical height; 0 = use control's intrinsic size or content measurement; explicit size takes
;                  precedence, default 0
; 傳回值 .: Success - New element ID (integer, >= 1)
;                  Failure - 0
; 作者 ........: Fanxing
; 相關函式 .......: _UI_IconSetIcon, _UI_IconGetIcon, _UI_Glyph, _UI_IconButton
; 範例 .......: Yes
; ===============================================================================================================================
Func _UI_Icon($hWnd, $iParent, $sIconOrEmoji, $iX = 0, $iY = 0, $iW = 0, $iH = 0)
    Local $vAuiForwardResult = __AUI_Call("int", "_UI_Icon", _
                       "hwnd", $hWnd, "int", $iParent, "wstr", $sIconOrEmoji, _
                       "int", $iX, "int", $iY, "int", $iW, "int", $iH)
    Return SetError(@error, @extended, $vAuiForwardResult)
EndFunc

