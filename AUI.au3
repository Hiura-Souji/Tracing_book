Func _UI_DataViewSort($hWnd, $iDataView, $iColumn, $iDirection)
    Local $vAuiForwardResult = __AUI_Call("int", "_UI_DataViewSort", "hwnd", $hWnd, "int", $iDataView, "int", $iColumn, "int", $iDirection)
