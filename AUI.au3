; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_ProgressSetRange
; 說明 ...: Atomically sets the Progress range and clamps the current value to the new range.
; 語法 ........: _UI_ProgressSetRange( $hWnd, $iId, $iMin, $iMax )
; 參數 ....: $hWnd - Window handle returned by _UI_WindowCreate
;                  $iId - Progress element ID
;                  $iMin - Minimum business value
;                  $iMax - Maximum business value; must be greater than the minimum value
; 傳回值 .: Success - 1
;                  Failure - 0, and set the error code; the original range and value remain unchanged on failure
; 作者 ........: Fanxing
; 相關函式 .......: _UI_ProgressGetRange, _UI_ProgressSetValue
; 範例 .......: Yes
; ===============================================================================================================================
Func _UI_ProgressSetRange($hWnd, $iId, $iMin, $iMax)
    Local $vAuiForwardResult = __AUI_Call("int", "_UI_ProgressSetRange", "hwnd", $hWnd, "int", $iId, _
            "int", $iMin, "int", $iMax)
    Return SetError(@error, @extended, $vAuiForwardResult)
EndFunc

; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_ProgressGetRange
; 說明 ...: Retrieves the current integer range of the progress bar.
; 語法 ........: _UI_ProgressGetRange( $hWnd, $iId )
; 參數 ....: $hWnd - Window handle returned by _UI_WindowCreate
;                  $iId - Progress element ID
; 傳回值 .: Success - Two-element array [minimum value, maximum value]
;                  Failure - Null, and set @error
; 作者 ........: Fanxing
; 相關函式 .......: _UI_ProgressSetRange
; 範例 .......: Yes
; ===============================================================================================================================
Func _UI_ProgressGetRange($hWnd, $iId)
    If __AUI_EnsureDll() = 0 Then Return SetError($g_iAuiLoadError, 0, Null)
    Local $aCall = __AUI_DllCall("int", "_UI_ProgressGetRange", _
            "hwnd", $hWnd, "int", $iId, "int*", 0, "int*", 0)
    Local $iError = @error
    If $iError Or Not IsArray($aCall) Then Return SetError($iError, 0, Null)
    If $aCall[0] = 0 Then Return SetError(__AUI_ReadNativeLastError(), 0, Null)
    Local $aRange[2] = [$aCall[3], $aCall[4]]
    Return $aRange
EndFunc

