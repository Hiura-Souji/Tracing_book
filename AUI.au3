; 範例 .......: Yes
; ===============================================================================================================================
Func _UI_DbBusyTimeout($iDatabase, $iMilliseconds)
    Local $vAuiForwardResult = __AUI_Call("int", "_UI_DbBusyTimeout", "uint64", $iDatabase, "int", $iMilliseconds)
