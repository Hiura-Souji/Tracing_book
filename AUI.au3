; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_OnFileDrop
; 說明 ...: Registers an OLE file-drop callback for the window content area or any element, with support for single
;                  files, multiple files, and folders.
; 語法 ........: _UI_OnFileDrop( $hWnd, $iTargetId, $sFuncName )
; 參數 ....: $hWnd - Window handle returned by _UI_WindowCreate
;                  $iTargetId - Target element ID; 0 selects the window content area
;                  $sFuncName - Callback function name; empty string to cancel registration
; 傳回值 .: Success - 1
;                  Failure - 0, and set @error
; 作者 ........: Fanxing
; 備註 .......: The callback signature is Func($hWnd, $iTargetId, $aFiles, $iX, $iY). $aFiles is a one-dimensional array of
;                  full paths in drop order; both files and folders retain their original paths. $iX and $iY are 96-DPI logical
;                  coordinates relative to the target's upper-left corner. AUI accepts copy operations for Windows file-system
;                  items only: it never moves or deletes source items, and it does not accept webpage text, URLs, or Outlook
;                  virtual attachments. Windows UIPI normally prevents an elevated application from receiving drops initiated by
;                  a non-elevated File Explorer process.
; 相關函式 .......: _UI_OnClick
; 範例 .......: Yes
; ===============================================================================================================================
Func _UI_OnFileDrop($hWnd, $iTargetId, $sFuncName)
    If __AUI_ValidateOptionalCallback($sFuncName) = 0 Then Return SetError(@error, 0, 0)
    If $sFuncName <> "" And $g_pAuiDispFileDrop = 0 Then _
        $g_pAuiDispFileDrop = __AUI_RegisterCallback("__AUI_DispFileDrop", "hwnd;int;uint64;int;int")
    If $sFuncName <> "" And $g_pAuiDispFileDrop = 0 Then Return SetError($AUI_UDF_ERR_CALLBACK_REGISTER, 0, 0)
    Local $sOldFunc = __AUI_CbGet($__AUI_CB_FILE_DROP, $iTargetId, $hWnd)
    If __AUI_CbSet($__AUI_CB_FILE_DROP, $iTargetId, $sFuncName, $hWnd) = 0 Then _
        Return SetError($AUI_UDF_ERR_INVALID_CALLBACK, 0, 0)
    Local $pCallback = $sFuncName = "" ? 0 : $g_pAuiDispFileDrop
    Local $iResult = __AUI_Call("int", "_UI_OnFileDrop", _
            "hwnd", $hWnd, "int", $iTargetId, "ptr", $pCallback)
    Local $iCallError = @error
    If $iCallError Or $iResult = 0 Then
        __AUI_CbSet($__AUI_CB_FILE_DROP, $iTargetId, $sOldFunc, $hWnd)
        If $iCallError = 0 Then $iCallError = __AUI_ReadNativeLastError()
        Return SetError($iCallError, 0, 0)
    EndIf
    Return SetError(0, 0, 1)
EndFunc

; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_OnBeforeClose
; 說明 ...: Registers a callback before the window is closed (return False to prevent closing).
; 語法 ........: _UI_OnBeforeClose( $hWnd, $sFuncName )
; 參數 ....: $hWnd - Window handle returned by _UI_WindowCreate
;                  $sFuncName - Callback function name (string)
; 傳回值 .: Success - 1
;                  Failure - 0; the callback name is invalid, callback registration failed, or the native call failed
; 作者 ........: Fanxing
; 相關函式 .......: _UI_OnClose
; 範例 .......: Yes
; ===============================================================================================================================
Func _UI_OnBeforeClose($hWnd, $sFuncName)
    If __AUI_ValidateOptionalCallback($sFuncName) = 0 Then Return SetError(@error, 0, 0)
    If $sFuncName <> "" And $g_pAuiDispBeforeClose = 0 Then $g_pAuiDispBeforeClose = __AUI_RegisterCallback("__AUI_DispBeforeClose", "hwnd;int", "int")
    If $sFuncName <> "" And $g_pAuiDispBeforeClose = 0 Then Return SetError($AUI_UDF_ERR_CALLBACK_REGISTER, 0, 0)
    Local $sOldFunc = __AUI_CbGet($__AUI_CB_WINDOW_BEFORE_CLOSE, $hWnd, $hWnd)
    If __AUI_CbSet($__AUI_CB_WINDOW_BEFORE_CLOSE, $hWnd, $sFuncName, $hWnd) = 0 Then Return SetError($AUI_UDF_ERR_INVALID_CALLBACK, 0, 0)
    Local $pCallback = $sFuncName = "" ? 0 : $g_pAuiDispBeforeClose
    Local $iResult = __AUI_Call("int", "_UI_OnBeforeClose", "hwnd", $hWnd, "ptr", $pCallback)
    Local $iCallError = @error
    If $iCallError Or $iResult = 0 Then
        __AUI_CbSet($__AUI_CB_WINDOW_BEFORE_CLOSE, $hWnd, $sOldFunc, $hWnd)
        Return SetError($iCallError, 0, 0)
    EndIf
    Return SetError(0, 0, 1)
EndFunc

; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_OnClose
; 說明 ...: Registers the callback invoked after the close is approved (the window is not destroyed yet when it is
;                  called).
; 語法 ........: _UI_OnClose( $hWnd, $sFuncName )
; 參數 ....: $hWnd - Window handle returned by _UI_WindowCreate
;                  $sFuncName - Callback function name (string)
; 傳回值 .: Success - 1
;                  Failure - 0; the callback name is invalid, callback registration failed, or the native call failed
; 作者 ........: Fanxing
; 相關函式 .......: _UI_OnBeforeClose
; 範例 .......: Yes
; ===============================================================================================================================
Func _UI_OnClose($hWnd, $sFuncName)
    If __AUI_ValidateOptionalCallback($sFuncName) = 0 Then Return SetError(@error, 0, 0)
    Local $sOldFunc = __AUI_CbGet($__AUI_CB_WINDOW_CLOSE, $hWnd, $hWnd)
    If __AUI_CbSet($__AUI_CB_WINDOW_CLOSE, $hWnd, $sFuncName, $hWnd) = 0 Then Return SetError($AUI_UDF_ERR_INVALID_CALLBACK, 0, 0)
    If $sFuncName <> "" And $g_pAuiDispClose = 0 Then
        $g_pAuiDispClose = __AUI_RegisterCallback("__AUI_DispClose", "hwnd")
        If $g_pAuiDispClose = 0 Then
            __AUI_CbSet($__AUI_CB_WINDOW_CLOSE, $hWnd, $sOldFunc, $hWnd)
            Return SetError($AUI_UDF_ERR_CALLBACK_REGISTER, 0, 0)
        EndIf
    EndIf
    Local $pCallback = $sFuncName = "" ? 0 : $g_pAuiDispClose
    Local $iResult = __AUI_Call("int", "_UI_OnClose", "hwnd", $hWnd, "ptr", $pCallback)
    Local $iCallError = @error
    If $iCallError Or $iResult = 0 Then
        __AUI_CbSet($__AUI_CB_WINDOW_CLOSE, $hWnd, $sOldFunc, $hWnd)
        Return SetError($iCallError, 0, 0)
    EndIf
    Return SetError(0, 0, 1)
EndFunc

; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_OnResize
; 說明 ...: Registers window size change callback Func($hWnd, $w, $h). $w and $h are the [logical dimensions] of the
;                  client area. They use the same set of coordinates as _UI_SetBounds and the width and height of the control.
;                  You can backfill the layout directly without pressing DPI for conversion.
; 語法 ........: _UI_OnResize( $hWnd, $sFuncName )
; 參數 ....: $hWnd - Window handle returned by _UI_WindowCreate
;                  $sFuncName - Callback function name (string)
; 傳回值 .: Success - 1
;                  Failure - 0; the callback name is invalid, callback registration failed, or the native call failed
; 作者 ........: Fanxing
; 範例 .......: Yes
; ===============================================================================================================================
Func _UI_OnResize($hWnd, $sFuncName)
    If __AUI_ValidateOptionalCallback($sFuncName) = 0 Then Return SetError(@error, 0, 0)
    If $sFuncName <> "" And $g_pAuiDispResize = 0 Then $g_pAuiDispResize = __AUI_RegisterCallback("__AUI_DispResize", "hwnd;int;int")
    If $sFuncName <> "" And $g_pAuiDispResize = 0 Then Return SetError($AUI_UDF_ERR_CALLBACK_REGISTER, 0, 0)
    Local $sOldFunc = __AUI_CbGet($__AUI_CB_WINDOW_RESIZE, $hWnd, $hWnd)
    If __AUI_CbSet($__AUI_CB_WINDOW_RESIZE, $hWnd, $sFuncName, $hWnd) = 0 Then Return SetError($AUI_UDF_ERR_INVALID_CALLBACK, 0, 0)
    Local $pCallback = $sFuncName = "" ? 0 : $g_pAuiDispResize
    Local $iResult = __AUI_Call("int", "_UI_OnResize", "hwnd", $hWnd, "ptr", $pCallback)
    Local $iCallError = @error
    If $iCallError Or $iResult = 0 Then
        __AUI_CbSet($__AUI_CB_WINDOW_RESIZE, $hWnd, $sOldFunc, $hWnd)
        Return SetError($iCallError, 0, 0)
    EndIf
    Return SetError(0, 0, 1)
EndFunc
; ────────────────────────────────────────────────────────────────────────────
;  佈景主題
; ────────────────────────────────────────────────────────────────────────────
Func __AUI_DispThemeChange($hWnd, $iEffectiveMode)
    Local $f = __AUI_CbGet($__AUI_CB_WINDOW_THEME, $hWnd, $hWnd)
    If $f <> "" Then __AUI_SafeCall($f, $hWnd, $iEffectiveMode, 0, 2)
EndFunc

; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_OnThemeChange
; 說明 ...: Registers window theme actual change callback Func($hWnd, $iEffectiveMode).
; 語法 ........: _UI_OnThemeChange( $hWnd, $sFuncName )
; 參數 ....: $hWnd - Window handle returned by _UI_WindowCreate
;                  $sFuncName - Callback function name; empty string to cancel registration
; 傳回值 .: Success - 1
;                  Failure - 0; the callback name is invalid, callback registration failed, or the native call failed
; 作者 ........: Fanxing
; 備註 .......: The callback is triggered lazily from the clean message stack. $iEffectiveMode is always the actual
;                  $AUI_THEME_LIGHT or $AUI_THEME_DARK; Auto mode will not return $AUI_THEME_AUTO.
; 相關函式 .......: _UI_ThemeSetMode, _UI_ThemeGetMode, _UI_ThemeGetColor
; 範例 .......: Yes
; ===============================================================================================================================
Func _UI_OnThemeChange($hWnd, $sFuncName)
    If __AUI_ValidateOptionalCallback($sFuncName) = 0 Then Return SetError(@error, 0, 0)
    If $sFuncName <> "" And $g_pAuiDispThemeChange = 0 Then _
        $g_pAuiDispThemeChange = __AUI_RegisterCallback("__AUI_DispThemeChange", "hwnd;int")
    If $sFuncName <> "" And $g_pAuiDispThemeChange = 0 Then Return SetError($AUI_UDF_ERR_CALLBACK_REGISTER, 0, 0)

    Local $sOldFunc = __AUI_CbGet($__AUI_CB_WINDOW_THEME, $hWnd, $hWnd)
    If __AUI_CbSet($__AUI_CB_WINDOW_THEME, $hWnd, $sFuncName, $hWnd) = 0 Then _
        Return SetError($AUI_UDF_ERR_INVALID_CALLBACK, 0, 0)
    Local $pCallback = $sFuncName = "" ? 0 : $g_pAuiDispThemeChange
    Local $iResult = __AUI_Call("int", "_UI_OnThemeChange", "hwnd", $hWnd, "ptr", $pCallback)
    Local $iCallError = @error
    If $iCallError Or $iResult = 0 Then
        __AUI_CbSet($__AUI_CB_WINDOW_THEME, $hWnd, $sOldFunc, $hWnd)
        If $iCallError = 0 Then $iCallError = __AUI_ReadNativeLastError()
        Return SetError($iCallError, 0, 0)
    EndIf
    Return SetError(0, 0, 1)
EndFunc

; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_ThemeSetMode
; 說明 ...: Sets theme mode ($AUI_THEME_AUTO/LIGHT/DARK).
; 語法 ........: _UI_ThemeSetMode( $hWnd [, $iMode = $AUI_THEME_AUTO] )
; 參數 ....: $hWnd - Window handle returned by _UI_WindowCreate
;                  $iMode - [Optional] $AUI_THEME_AUTO/LIGHT/DARK, default $AUI_THEME_AUTO
; 傳回值 .: Success - 1
;                  Failure - 0; theme mode out of bounds
; 作者 ........: Fanxing
; 相關函式 .......: _UI_ThemeGetMode
; 範例 .......: Yes
; ===============================================================================================================================
Func _UI_ThemeSetMode($hWnd, $iMode = $AUI_THEME_AUTO)
    Local $vAuiForwardResult = __AUI_Call("int", "_UI_ThemeSetMode", "hwnd", $hWnd, "int", $iMode)
    Return SetError(@error, @extended, $vAuiForwardResult)
EndFunc

; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_ThemeGetMode
