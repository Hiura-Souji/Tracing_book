             $iX = 0, $iY = 0, $iW = 0, $iH = 0)
    Local $vAuiForwardResult = __AUI_Call("int", "_UI_Tag", _
                       "hwnd", $hWnd, "int", $iParent, "wstr", $sText, _
                       "int", $iVariant, "int", ($bClosable ? 1 : 0), _
                       "int", $iX, "int", $iY, "int", $iW, "int", $iH)
    Return SetError(@error, @extended, $vAuiForwardResult)
EndFunc

