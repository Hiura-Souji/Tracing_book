EndFunc

; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_HttpRequestGetAttemptCount
; 說明 ...: Returns the number of network attempts started for the current request.
; 語法 ........: _UI_HttpRequestGetAttemptCount( $iRequestId )
; 參數 ....: $iRequestId - Request ID
; 傳回值 .: Success - Attempt count; 0 before sending, 1 for the initial request, and incremented for each retry or
;                  redirect
;                  Failure - 0
; 作者 ........: Fanxing
; 備註 .......: This value counts actual wire attempts, including both automatic retries and new requests created by
;                  redirects.
; 相關函式 .......: _UI_HttpRequestSetRetryPolicy, _UI_HttpRequestGetRedirectHistory
; 範例 .......: No
; ===============================================================================================================================
Func _UI_HttpRequestGetAttemptCount($iRequestId)
    Local $vResult = __AUI_Call("int", "_UI_HttpRequestGetAttemptCount", "int", $iRequestId)
    Return SetError(@error, @extended, $vResult)
EndFunc

Func __AUI_HttpReadText($sFunction, $iRequestId, $sName = "")
    Local $aNeed, $aRead
    If $sName = "" Then
        $aNeed = __AUI_DllCall("int", $sFunction, "int", $iRequestId, "ptr", 0, "int", 0)
    Else
        $aNeed = __AUI_DllCall("int", $sFunction, "int", $iRequestId, "wstr", $sName, "ptr", 0, "int", 0)
    EndIf
    If @error Or Not IsArray($aNeed) Then Return SetError(@error, 0, "")
    If $aNeed[0] < 0 Then Return SetError(__AUI_ReadNativeLastError(), 0, "")
    If $aNeed[0] = 0 Then
        Local $iNativeError = __AUI_ReadNativeLastError()
        Local $iNativeDllError = @error
        If $iNativeDllError Then Return SetError($iNativeDllError, 0, "")
        If $iNativeError <> $AUI_OK Then Return SetError($iNativeError, 0, "")
    EndIf
    Local $iCapacity = $aNeed[0] + 1
    If $iCapacity < 1 Or $iCapacity > $__AUI_READ_TEXT_MAX_CHARS Then
        $g_iAuiUdfErrorCode = $AUI_ERR_LIMIT_EXCEEDED
        Return SetError($g_iAuiUdfErrorCode, 0, "")
    EndIf
    Local $tBuffer = DllStructCreate("wchar[" & $iCapacity & "]")
    If $sName = "" Then
        $aRead = __AUI_DllCall("int", $sFunction, "int", $iRequestId, "ptr", DllStructGetPtr($tBuffer), "int", $iCapacity)
    Else
        $aRead = __AUI_DllCall("int", $sFunction, "int", $iRequestId, "wstr", $sName, "ptr", DllStructGetPtr($tBuffer), "int", $iCapacity)
    EndIf
    If @error Or Not IsArray($aRead) Then Return SetError(@error, 0, "")
    If $aRead[0] = 0 Then
        Local $iReadError = __AUI_ReadNativeLastError()
        Local $iReadDllError = @error
        If $iReadDllError Then Return SetError($iReadDllError, 0, "")
        If $iReadError <> $AUI_OK Then Return SetError($iReadError, 0, "")
    EndIf
    Return SetError(0, 0, DllStructGetData($tBuffer, 1))
EndFunc
