; 範例 .......: Yes
; ===============================================================================================================================
Func _UI_DataViewSupplyCell($hWnd, $iDataView, $iToken, $iRow, $iCol, $sText, $iForeground = 0, $iBackground = 0)
    Local $vAuiForwardResult = __AUI_Call("int", "_UI_DataViewSupplyCell", "hwnd", $hWnd, "int", $iDataView, _
        "uint64", $iToken, "int", $iRow, "int", $iCol, "wstr", $sText, _
        "uint", $iForeground, "uint", $iBackground)
    Return SetError(@error, @extended, $vAuiForwardResult)
EndFunc

