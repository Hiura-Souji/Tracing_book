; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_IsAlive
; 說明 ...: Indicates whether the window is still alive (not closed/destroyed).
; 語法 ........: _UI_IsAlive( $hWnd )
; 參數 ....: $hWnd - Window handle returned by _UI_WindowCreate
; 傳回值 .: Success - 1 (survive)
;                  Failure - 0 (closed)
; 作者 ........: Fanxing
; 備註 .......: When running _UI_PumpOnce() in a long task, the user may close the window midway. Use this function to detect
;                  and safely exit your own loop to avoid idling against a destroyed handle. Does not affect _UI_GetLastError().
; 相關函式 .......: _UI_PumpOnce, _UI_SetBusy
; 範例 .......: No
; ===============================================================================================================================
Func _UI_IsAlive($hWnd)
    Local $vAuiForwardResult = __AUI_Call("int", "_UI_IsAlive", "hwnd", $hWnd)
    Return SetError(@error, @extended, $vAuiForwardResult)
EndFunc

; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_SetBusy
; 說明 ...: Enables or disables the busy overlay, which blocks content input while leaving the title bar accessible.
; 語法 ........: _UI_SetBusy( $hWnd [, $bBusy = True] )
; 參數 ....: $hWnd - Window handle
;                  $bBusy - [Optional] True=Enter busy state, False=Exit (default True)
; 傳回值 .: Success - 1
;                  Failure - 0
; 作者 ........: Fanxing
; 備註 .......: Title bar (drag/minimize/maximize/close) intentionally exempted - the user must still be able to close the
;                  window during long tasks. Long tasks are called in pairs before and after, and combined with _UI_PumpOnce(),
;                  you can keep the interface responsive and prevent callback reentry.
; 相關函式 .......: _UI_PumpOnce, _UI_IsAlive
; 範例 .......: No
; ===============================================================================================================================
Func _UI_SetBusy($hWnd, $bBusy = True)
    Local $vAuiForwardResult = __AUI_Call("int", "_UI_SetBusy", "hwnd", $hWnd, "int", $bBusy)
    Return SetError(@error, @extended, $vAuiForwardResult)
EndFunc

; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_OnIdle
; 說明 ...: Registers the "idle slice" callback: cut long tasks into small slices driven by the message loop so the UI
;                  stays responsive.
; 語法 ........: _UI_OnIdle( $hWnd, $sFuncName )
; 參數 ....: $hWnd - Window handle
;                  $sFuncName - Callback function name; pass "" to cancel in advance
; 傳回值 .: Success - 1
;                  Failure - 0; the callback name is invalid, callback registration failed, or the native call failed
; 作者 ........: Fanxing
; 備註 .......: The callback should finish one splittable slice within about 5 ms. 0/False means done, 1/True means continue
;                  as soon as possible, and N>1 means continue after about N ms (clamped to 0-60000). It only takes effect in
;                  _UI_Run mode; do not perform synchronous blocking calls inside a slice.
; 相關函式 .......: _UI_SetBusy, _UI_PumpOnce, _UI_Run
; 範例 .......: Yes
; ===============================================================================================================================
Func _UI_OnIdle($hWnd, $sFuncName)
    Local $sOldFunc = __AUI_CbGet($__AUI_CB_IDLE, $hWnd, $hWnd)
    If $sFuncName = "" Then
        __AUI_CbSet($__AUI_CB_IDLE, $hWnd, "", $hWnd)
        Local $iClear = __AUI_Call("int", "_UI_OnIdle", "hwnd", $hWnd, "ptr", 0)
        Local $iClearError = @error
        If $iClearError Or $iClear = 0 Then
            __AUI_CbSet($__AUI_CB_IDLE, $hWnd, $sOldFunc, $hWnd)
            Return SetError($iClearError, 0, 0)
        EndIf
        Return SetError(0, 0, $iClear)
    EndIf
    If Not __AUI_IsCallable($sFuncName) Then Return SetError($AUI_UDF_ERR_INVALID_CALLBACK, 0, 0)
    If $g_pAuiDispIdle = 0 Then $g_pAuiDispIdle = __AUI_RegisterCallback("__AUI_DispIdle", "hwnd", "int")
    If $g_pAuiDispIdle = 0 Then Return SetError($AUI_UDF_ERR_CALLBACK_REGISTER, 0, 0)
    If __AUI_CbSet($__AUI_CB_IDLE, $hWnd, $sFuncName, $hWnd) = 0 Then Return SetError(@error, 0, 0)
    Local $iResult = __AUI_Call("int", "_UI_OnIdle", "hwnd", $hWnd, "ptr", $g_pAuiDispIdle)
    Local $iCallError = @error
    If $iCallError Or $iResult = 0 Then
        __AUI_CbSet($__AUI_CB_IDLE, $hWnd, $sOldFunc, $hWnd)
        Return SetError($iCallError, 0, 0)
    EndIf
    Return SetError(0, 0, $iResult)
EndFunc

Func __AUI_DispIdle($hWnd)
    Local $f = __AUI_CbGet($__AUI_CB_IDLE, $hWnd, $hWnd)
    If $f = "" Then Return 0
    Local $r = Call($f, $hWnd)
    If @error Then Return 0
    If IsBool($r) Then Return ($r ? 1 : 0)
    If IsNumber($r) Then
        Local $n = Int($r)
        Return ($n < 0) ? 0 : $n
    EndIf
    Return 0
EndFunc

; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_TimerStart
; 說明 ...: Creates a delayed or periodic task driven by the AUI message loop; the same window can register multiple ones
;                  in parallel.
; 語法 ........: _UI_TimerStart( $hWnd, $iIntervalMs, $sFuncName [, $bRepeat = True] )
; 參數 ....: $hWnd - Window handle
;                  $iIntervalMs - Interval in milliseconds; must be greater than 0. Values in the 1–9 range run at the Windows
;                  10 ms minimum.
;                  $sFuncName - Callback function name, signature Func F($hWnd, $iTimerId)
;                  $bRepeat - [Optional] True=periodic task, False=delay once, default True
; 傳回值 .: Success - Independent Timer ID greater than 0
;                  Failure - 0; available @error or _UI_GetLastError to query the reason
; 作者 ........: Fanxing
; 備註 .......: Callbacks are executed on the UI thread and must return quickly. The missed cycles during the blocking period
;                  are combined into one and will not be caught up for reissue; they are automatically canceled when the window
;                  is closed.
; 相關函式 .......: _UI_TimerStop, _UI_OnIdle, _UI_Run
; 範例 .......: Yes
; ===============================================================================================================================
Func _UI_TimerStart($hWnd, $iIntervalMs, $sFuncName, $bRepeat = True)
    If Not __AUI_IsCallable($sFuncName) Then Return SetError($AUI_UDF_ERR_INVALID_CALLBACK, 0, 0)
    If $g_pAuiDispTimer = 0 Then $g_pAuiDispTimer = __AUI_RegisterCallback("__AUI_DispTimer", "hwnd;int")
    If $g_pAuiDispTimer = 0 Then Return SetError($AUI_UDF_ERR_CALLBACK_REGISTER, 0, 0)

    Local $iTimerId = __AUI_Call("int", "_UI_TimerStart", "hwnd", $hWnd, "int", $iIntervalMs, _
            "ptr", $g_pAuiDispTimer, "int", $bRepeat)
    Local $iCallError = @error
    If $iCallError Or $iTimerId <= 0 Then Return SetError($iCallError, 0, 0)

    If __AUI_CbSet($__AUI_CB_TIMER, $iTimerId, $sFuncName, $hWnd) = 0 Then
        Local $iMapError = @error
        __AUI_Call("int", "_UI_TimerStop", "hwnd", $hWnd, "int", $iTimerId)
        Return SetError($iMapError, 0, 0)
    EndIf
    If __AUI_CbSet($__AUI_CB_TIMER_REPEAT, $iTimerId, ($bRepeat ? 1 : 0), $hWnd, False) = 0 Then
        Local $iMetaError = @error
        __AUI_CbDel($__AUI_CB_TIMER, $iTimerId, $hWnd)
        __AUI_Call("int", "_UI_TimerStop", "hwnd", $hWnd, "int", $iTimerId)
        Return SetError($iMetaError, 0, 0)
    EndIf
    Return SetError(0, 0, $iTimerId)
EndFunc

; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_TimerStop
; 說明 ...: Stops a task created by _UI_TimerStart.
; 語法 ........: _UI_TimerStop( $hWnd, $iTimerId )
; 參數 ....: $hWnd - The window handle to which Timer belongs
;                  $iTimerId - _UI_TimerStart returns the independent Timer ID, not the element ID
; 傳回值 .: Success - 1
;                  Failure - 0; invalid window or timer ID
; 作者 ........: Fanxing
; 備註 .......: You can stop yourself within the periodic callback; the one-time task has automatically ended before entering
;                  the callback and does not need to be stopped again.
; 相關函式 .......: _UI_TimerStart
; 範例 .......: Yes
; ===============================================================================================================================
Func _UI_TimerStop($hWnd, $iTimerId)
    Local $iResult = __AUI_Call("int", "_UI_TimerStop", "hwnd", $hWnd, "int", $iTimerId)
    Local $iCallError = @error
    If $iCallError Or $iResult = 0 Then Return SetError($iCallError, 0, 0)
    __AUI_CbDel($__AUI_CB_TIMER, $iTimerId, $hWnd)
    __AUI_CbDel($__AUI_CB_TIMER_REPEAT, $iTimerId, $hWnd)
    Return SetError(0, 0, 1)
EndFunc

; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_WindowSetBounds
; 說明 ...: Sets the virtual screen position and logical size of the window.
; 語法 ........: _UI_WindowSetBounds( $hWnd, $iX, $iY, $iW, $iH )
; 參數 ....: $hWnd - Window handle returned by _UI_WindowCreate
;                  $iX - Win32 Virtual screen X coordinate (device pixels, can be negative)
;                  $iY - Win32 Virtual screen Y coordinate (device pixels, can be negative)
;                  $iW - Window logical width, must be greater than 0
;                  $iH - Window logical height, must be greater than 0
; 傳回值 .: Success - 1
;                  Failure - 0; width and height are invalid or the system fails to move the window
; 作者 ........: Fanxing
; 相關函式 .......: _UI_WindowGetBounds
; 範例 .......: Yes
; ===============================================================================================================================
Func _UI_WindowSetBounds($hWnd, $iX, $iY, $iW, $iH)
    Local $vAuiForwardResult = __AUI_Call("int", "_UI_WindowSetBounds", _
               "hwnd", $hWnd, "int", $iX, "int", $iY, "int", $iW, "int", $iH)
    Return SetError(@error, @extended, $vAuiForwardResult)
EndFunc

; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_WindowGetBounds
; 說明 ...: Retrieves the window position and size as [x, y, w, h].
; 語法 ........: _UI_WindowGetBounds( $hWnd )
; 參數 ....: $hWnd - Window handle returned by _UI_WindowCreate
; 傳回值 .: Success - Four-element array [$iX, $iY, $iWidth, $iHeight]; position is virtual screen device pixels, size is
;                  logical pixels
;                  Failure - 0
; 作者 ........: Fanxing
; 相關函式 .......: _UI_WindowSetBounds
; 範例 .......: Yes
; ===============================================================================================================================
Func _UI_WindowGetBounds($hWnd)
    If __AUI_EnsureDll() = 0 Then Return SetError($g_iAuiLoadError, 0, 0)
    Local $tX = DllStructCreate("int")
    Local $tY = DllStructCreate("int")
    Local $tW = DllStructCreate("int")
    Local $tH = DllStructCreate("int")
    Local $aCall = __AUI_DllCall("int", "_UI_WindowGetBounds", _
            "hwnd", $hWnd, _
            "ptr", DllStructGetPtr($tX), _
            "ptr", DllStructGetPtr($tY), _
            "ptr", DllStructGetPtr($tW), _
            "ptr", DllStructGetPtr($tH))
    Local $iErr = @error
    If $iErr Then Return SetError($iErr, 0, 0)
    If Not IsArray($aCall) Or $aCall[0] = 0 Then Return SetError(__AUI_ReadNativeLastError(), 0, 0)
    Local $aResult[4] = [ DllStructGetData($tX, 1), DllStructGetData($tY, 1), _
                          DllStructGetData($tW, 1), DllStructGetData($tH, 1) ]
    Return $aResult
EndFunc

