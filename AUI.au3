; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_EditSetValidation
; 說明 ...: Atomically configures required-field, extended-grapheme length, and validation trigger rules for an edit
;                  control.
; 語法 ........: _UI_EditSetValidation( $hWnd, $iId [, $bRequired = False [, $iMinLength = 0 [, $iMaxLength = 0 [, $iTrigger =
;                  $AUI_VALIDATE_ON_BLUR [, $sRequiredMessage = "This field is required." [, $sLengthMessage = "The value does
;                  not meet the length requirement."]]]]]] )
; 參數 ....: $hWnd - Window handle
;                  $iId - Input, PasswordInput, TextArea, NumberInput, or AutoComplete element ID
;                  $bRequired - [Optional] Whether empty and all-Unicode-whitespace strings are invalid
;                  $iMinLength - [Optional] Minimum extended grapheme count; 0 disables the lower bound
;                  $iMaxLength - [Optional] Maximum extended grapheme count; 0 disables the upper bound
;                  $iTrigger - [Optional] $AUI_VALIDATE_MANUAL, ON_BLUR, ON_CHANGE, or ON_BLUR_OR_CHANGE
;                  $sRequiredMessage - [Optional] Message displayed when the required-field rule fails
;                  $sLengthMessage - [Optional] Message displayed when the length rule fails
; 傳回值 .: Success - 1
;                  Failure - 0
; 作者 ........: Fanxing
; 備註 .......: Length rules validate without truncating text; _UI_EditSetMaxLength is the input-limiting API. Configuring
;                  rules does not validate immediately; validation begins at the selected trigger or through an explicit
;                  validation call.
; 相關函式 .......: _UI_EditGetValidation, _UI_EditValidate, _UI_FormValidate, _UI_EditSetMaxLength
; 範例 .......: Yes
; ===============================================================================================================================
Func _UI_EditSetValidation($hWnd, $iId, $bRequired = False, $iMinLength = 0, $iMaxLength = 0, _
        $iTrigger = $AUI_VALIDATE_ON_BLUR, $sRequiredMessage = "This field is required.", _
        $sLengthMessage = "The value does not meet the length requirement.")
    Local $vAuiForwardResult = __AUI_Call("int", "_UI_EditSetValidation", "hwnd", $hWnd, "int", $iId, _
            "int", $bRequired ? 1 : 0, "int", $iMinLength, "int", $iMaxLength, "int", $iTrigger, _
            "wstr", $sRequiredMessage, "wstr", $sLengthMessage)
    Return SetError(@error, @extended, $vAuiForwardResult)
EndFunc

; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_EditGetValidation
; 說明 ...: Retrieves the unified validation rules of an edit control.
; 語法 ........: _UI_EditGetValidation( $hWnd, $iId )
; 參數 ....: $hWnd - Window handle
;                  $iId - Edit control element ID
; 傳回值 .: Success - Four-element array [required, minimum length, maximum length, trigger]
;                  Failure - 0, and set @error
; 作者 ........: Fanxing
; 相關函式 .......: _UI_EditSetValidation, _UI_EditGetValidationMessage
; 範例 .......: Yes
; ===============================================================================================================================
Func _UI_EditGetValidation($hWnd, $iId)
    If __AUI_EnsureDll() = 0 Then Return SetError($g_iAuiLoadError, 0, 0)
    Local $aCall = __AUI_DllCall("int", "_UI_EditGetValidation", "hwnd", $hWnd, "int", $iId, _
            "int*", 0, "int*", 0, "int*", 0, "int*", 0)
    Local $iError = @error
    If $iError Or Not IsArray($aCall) Then Return SetError($iError, 0, 0)
    If Not $aCall[0] Then Return SetError(__AUI_ReadNativeLastError(), 0, 0)
    Local $aValidation[4] = [$aCall[3], $aCall[4], $aCall[5], $aCall[6]]
    Return $aValidation
EndFunc

; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_EditGetValidationMessage
; 說明 ...: Retrieves one configured validation message.
; 語法 ........: _UI_EditGetValidationMessage( $hWnd, $iId, $iMessageKind )
; 參數 ....: $hWnd - Window handle
;                  $iId - Edit control element ID
;                  $iMessageKind - $AUI_VALIDATION_MESSAGE_REQUIRED/LENGTH/NUMBER_RANGE
; 傳回值 .: Success - Message text, including a valid empty string
;                  Failure - Empty string and set @error
; 作者 ........: Fanxing
; 備註 .......: NUMBER_RANGE applies only to NumberInput and fails for other edit controls.
; 相關函式 .......: _UI_EditSetValidation, _UI_NumberInputSetValidationRange
; 範例 .......: Yes
; ===============================================================================================================================
Func _UI_EditGetValidationMessage($hWnd, $iId, $iMessageKind)
    If __AUI_EnsureDll() = 0 Then Return SetError($g_iAuiLoadError, 0, "")
    Local $aNeed = __AUI_DllCall("int", "_UI_EditGetValidationMessage", "hwnd", $hWnd, "int", $iId, _
            "int", $iMessageKind, "ptr", 0, "int", 0)
    Local $iError = @error
    If $iError Or Not IsArray($aNeed) Then Return SetError($iError, 0, "")
    If $aNeed[0] = 0 Then
        Local $iNativeError = __AUI_ReadNativeLastError()
        If @error Or $iNativeError <> $AUI_OK Then Return SetError($iNativeError, 0, "")
    EndIf
    Local $iCapacity = $aNeed[0] + 1
    If $iCapacity < 1 Then $iCapacity = 1
    Local $tBuffer = DllStructCreate("wchar[" & $iCapacity & "]")
    Local $aRead = __AUI_DllCall("int", "_UI_EditGetValidationMessage", "hwnd", $hWnd, "int", $iId, _
            "int", $iMessageKind, "ptr", DllStructGetPtr($tBuffer), "int", $iCapacity)
    $iError = @error
    If $iError Or Not IsArray($aRead) Then Return SetError($iError, 0, "")
    If $aRead[0] >= $iCapacity Then
        $g_iAuiUdfErrorCode = $AUI_ERR_BUFFER_TOO_SMALL
        Return SetError($g_iAuiUdfErrorCode, $aRead[0] + 1, "")
    EndIf
    Return SetError(0, 0, DllStructGetData($tBuffer, 1))
EndFunc

; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_NumberInputSetValidationRange
; 說明 ...: Configures an independent NumberInput form-validation range without changing or clamping the business value
;                  range.
; 語法 ........: _UI_NumberInputSetValidationRange( $hWnd, $iId, $bEnabled, $nMin, $nMax [, $sMessage = "The value is outside
;                  the allowed range."] )
; 參數 ....: $hWnd - Window handle
;                  $iId - NumberInput element ID
;                  $bEnabled - Whether range validation is enabled
;                  $nMin - Finite validation minimum
;                  $nMax - Finite validation maximum; must not be less than the minimum
;                  $sMessage - [Optional] Message displayed when range validation fails
; 傳回值 .: Success - 1
;                  Failure - 0
; 作者 ........: Fanxing
; 備註 .......: The business input range remains controlled by _UI_NumberInputSetRange. For example, the business range may
;                  be 0~100 while the form rule accepts only 18~65.
; 相關函式 .......: _UI_NumberInputGetValidationRange, _UI_NumberInputSetRange, _UI_EditValidate
; 範例 .......: Yes
; ===============================================================================================================================
Func _UI_NumberInputSetValidationRange($hWnd, $iId, $bEnabled, $nMin, $nMax, _
        $sMessage = "The value is outside the allowed range.")
    Local $vAuiForwardResult = __AUI_Call("int", "_UI_NumberInputSetValidationRange", "hwnd", $hWnd, "int", $iId, _
            "int", $bEnabled ? 1 : 0, "double", $nMin, "double", $nMax, "wstr", $sMessage)
    Return SetError(@error, @extended, $vAuiForwardResult)
EndFunc

; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_NumberInputGetValidationRange
; 說明 ...: Retrieves the independent NumberInput form-validation range.
; 語法 ........: _UI_NumberInputGetValidationRange( $hWnd, $iId )
; 參數 ....: $hWnd - Window handle
;                  $iId - NumberInput element ID
; 傳回值 .: Success - Three-element array [enabled, minimum, maximum]
;                  Failure - 0, and set @error
; 作者 ........: Fanxing
; 相關函式 .......: _UI_NumberInputSetValidationRange
; 範例 .......: Yes
; ===============================================================================================================================
Func _UI_NumberInputGetValidationRange($hWnd, $iId)
    If __AUI_EnsureDll() = 0 Then Return SetError($g_iAuiLoadError, 0, 0)
    Local $aCall = __AUI_DllCall("int", "_UI_NumberInputGetValidationRange", "hwnd", $hWnd, "int", $iId, _
            "int*", 0, "double*", 0, "double*", 0)
    Local $iError = @error
    If $iError Or Not IsArray($aCall) Then Return SetError($iError, 0, 0)
    If Not $aCall[0] Then Return SetError(__AUI_ReadNativeLastError(), 0, 0)
    Local $aRange[3] = [$aCall[3], $aCall[4], $aCall[5]]
    Return $aRange
EndFunc

; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_EditValidate
; 說明 ...: Immediately validates one edit control and enables continued revalidation after subsequent text changes.
; 語法 ........: _UI_EditValidate( $hWnd, $iId )
; 參數 ....: $hWnd - Window handle
;                  $iId - Edit control element ID
; 傳回值 .: Success - 1 when valid; 0 when a validation error is present
;                  Failure - -1 and sets @error
; 作者 ........: Fanxing
; 備註 .......: An existing manual error set by _UI_EditSetError takes precedence. Application code must clear it before a
;                  rule-generated error can be shown.
; 相關函式 .......: _UI_EditSetValidation, _UI_FormValidate, _UI_EditGetError
; 範例 .......: Yes
; ===============================================================================================================================
Func _UI_EditValidate($hWnd, $iId)
    If __AUI_EnsureDll() = 0 Then Return SetError($g_iAuiLoadError, 0, -1)
    Local $aCall = __AUI_DllCall("int", "_UI_EditValidate", "hwnd", $hWnd, "int", $iId)
    Local $iDllError = @error
    If $iDllError Or Not IsArray($aCall) Then Return SetError($iDllError, 0, -1)
    If $aCall[0] = -1 Then
        Local $iNativeError = __AUI_ReadNativeLastError()
        Local $iNativeDllError = @error
        If $iNativeDllError Then Return SetError($iNativeDllError, 0, -1)
        Return SetError($iNativeError, 0, -1)
    EndIf
    Return SetError(0, 0, $aCall[0])
EndFunc

; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_FormValidate
; 說明 ...: Validates all eligible edit controls in a container subtree in element-tree order.
; 語法 ........: _UI_FormValidate( $hWnd [, $iParent = 0 [, $bFocusFirst = True]] )
; 參數 ....: $hWnd - Window handle
;                  $iParent - [Optional] Container element ID; use 0 for the window root
;                  $bFocusFirst - [Optional] Whether to focus and reveal the first invalid field
; 傳回值 .: Success - Number of invalid fields; 0 means all fields are valid
;                  Failure - -1 and sets @error
; 作者 ........: Fanxing
; 備註 .......: Hidden, collapsed, disabled, and disabled-by-ancestor fields are skipped. Participating fields continue to
;                  revalidate after subsequent edits.
; 相關函式 .......: _UI_EditValidate, _UI_EditSetValidation, _UI_EditGetError
; 範例 .......: Yes
; ===============================================================================================================================
Func _UI_FormValidate($hWnd, $iParent = 0, $bFocusFirst = True)
    If __AUI_EnsureDll() = 0 Then Return SetError($g_iAuiLoadError, 0, -1)
    Local $aCall = __AUI_DllCall("int", "_UI_FormValidate", "hwnd", $hWnd, "int", $iParent, _
            "int", $bFocusFirst ? 1 : 0)
    Local $iDllError = @error
    If $iDllError Or Not IsArray($aCall) Then Return SetError($iDllError, 0, -1)
    If $aCall[0] = -1 Then
        Local $iNativeError = __AUI_ReadNativeLastError()
        Local $iNativeDllError = @error
        If $iNativeDllError Then Return SetError($iNativeDllError, 0, -1)
        Return SetError($iNativeError, 0, -1)
    EndIf
    Return SetError(0, 0, $aCall[0])
EndFunc

; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_EditSetSelectAllOnFocus
; 說明 ...: Sets whether to automatically select all controls when they gain focus from an unfocused state.
; 語法 ........: _UI_EditSetSelectAllOnFocus( $hWnd, $iId [, $bEnable = True] )
; 參數 ....: $hWnd - Window handle
;                  $iId - Edit control element ID
;                  $bEnable - [Optional] Whether to enable
