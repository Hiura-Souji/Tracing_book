; ────────────────────────────────────────────────────────────────────────────
; AUI（AutoIt 使用者介面程式庫）0.9.5 測試版
; ────────────────────────────────────────────────────────────────────────────

#include-once

; ────────────────────────────────────────────────────────────────────────────
;  內嵌執行階段載入器
; ────────────────────────────────────────────────────────────────────────────

Global Const $__AUI_MEMERR_NONE = 0
Global Const $__AUI_MEMERR_PLATFORM = 1
Global Const $__AUI_MEMERR_EMBEDDED_DATA = 2
Global Const $__AUI_MEMERR_PE_FORMAT = 3
Global Const $__AUI_MEMERR_UNSUPPORTED = 4
Global Const $__AUI_MEMERR_ALLOC = 5
Global Const $__AUI_MEMERR_RELOCATION = 6
Global Const $__AUI_MEMERR_IMPORT = 7
Global Const $__AUI_MEMERR_EXPORT = 8
Global Const $__AUI_MEMERR_PROTECTION = 9
Global Const $__AUI_MEMERR_ENTRY = 10

Global Const $__AUI_MEM_MAX_FILE_SIZE = 32 * 1024 * 1024
Global Const $__AUI_MEM_MAX_IMAGE_SIZE = 128 * 1024 * 1024
Global Const $__AUI_MEM_MAX_SECTIONS = 96
Global Const $__AUI_MEM_MAX_IMPORT_DLLS = 256
Global Const $__AUI_MEM_MAX_IMPORTS = 65536
Global Const $__AUI_MEM_MAX_EXPORTS = 8192

Global $__g_pAuiMemoryBase = 0
Global $__g_pAuiMemoryEntry = 0
Global $__g_bAuiMemoryAttached = False
Global $__g_iAuiMemoryError = $__AUI_MEMERR_NONE
Global $__g_sAuiMemoryError = ""
Global $__g_mAuiMemoryExports[]
Global $__g_aAuiMemoryDependencies[1]
Global $__g_iAuiMemoryDependencyCount = 0

Global $iErr
Global $iResolvedExtended
Global $iResolvedError
Global $idDialog

Func __AUI_MemoryFail($iCode, $sMessage)
    $__g_iAuiMemoryError = $iCode
    $__g_sAuiMemoryError = $sMessage
    Return SetError($iCode, 0, 0)
EndFunc

Func __AUI_MemoryGetError()
    Return $__g_iAuiMemoryError
EndFunc

Func __AUI_MemoryGetErrorText()
    Return $__g_sAuiMemoryError
EndFunc

Func __AUI_MemorySpan($iOffset, $iSize, $iLimit)
    Return IsNumber($iOffset) And IsNumber($iSize) And $iOffset >= 0 And $iSize >= 0 And _
            $iOffset <= $iLimit And $iSize <= $iLimit - $iOffset
EndFunc

Func __AUI_MemoryU8($pBase, $iOffset)
    Return DllStructGetData(DllStructCreate("byte", $pBase + $iOffset), 1)
EndFunc

Func __AUI_MemoryU16($pBase, $iOffset)
    Return DllStructGetData(DllStructCreate("ushort", $pBase + $iOffset), 1)
EndFunc

Func __AUI_MemoryU32($pBase, $iOffset)
    Return DllStructGetData(DllStructCreate("dword", $pBase + $iOffset), 1)
EndFunc

Func __AUI_MemoryWriteU32($pBase, $iOffset, $iValue)
    Local $tValue = DllStructCreate("dword", $pBase + $iOffset)
    DllStructSetData($tValue, 1, $iValue)
EndFunc

Func __AUI_MemoryReadAnsi($pBase, $iRva, $iImageSize, $iMaxChars)
    If Not __AUI_MemorySpan($iRva, 1, $iImageSize) Then Return SetError(1, 0, "")
    Local $iCapacity = $iImageSize - $iRva
    If $iCapacity > $iMaxChars + 1 Then $iCapacity = $iMaxChars + 1
    Local $sValue = DllStructGetData(DllStructCreate("char[" & $iCapacity & "]", $pBase + $iRva), 1)
    Local $iLength = StringLen($sValue)
    If $iLength > $iMaxChars Or $iLength >= $iCapacity Then Return SetError(1, 0, "")
    If __AUI_MemoryU8($pBase, $iRva + $iLength) <> 0 Then Return SetError(1, 0, "")
    Return SetError(0, 0, $sValue)
EndFunc

Func __AUI_EmbeddedDllDecodeChunk($pCompressed, ByRef $iWritten, $sChunk)
    Local $iCompressedSize = __AUI_EmbeddedDllCompressedSize()
    Local $iExpected = __AUI_EmbeddedDllChunkBytes()
    If $iExpected > $iCompressedSize - $iWritten Then _
            $iExpected = $iCompressedSize - $iWritten
    If $iExpected <= 0 Or $sChunk = "" Then Return False
    Local $aDecode = DllCall("crypt32.dll", "bool", "CryptStringToBinaryW", _
            "wstr", $sChunk, "dword", StringLen($sChunk), "dword", 1, _
            "ptr", $pCompressed + $iWritten, "dword*", $iExpected, "ptr", 0, "ptr", 0)
    If @error Or Not IsArray($aDecode) Or Not $aDecode[0] Or $aDecode[5] <> $iExpected Then Return False
    $iWritten += $iExpected
    Return True
EndFunc

Func __AUI_EmbeddedDllInflate()
    Local $iDllSize = __AUI_EmbeddedDllSize()
    Local $iCompressedSize = __AUI_EmbeddedDllCompressedSize()
    If $iDllSize < 64 Or $iDllSize > $__AUI_MEM_MAX_FILE_SIZE Or $iCompressedSize <= 0 Then _
            Return __AUI_MemoryFail($__AUI_MEMERR_EMBEDDED_DATA, "內嵌 DLL 的大小中繼資料無效")

    Local $tCompressed = DllStructCreate("byte[" & $iCompressedSize & "]")
    Local $pCompressed = DllStructGetPtr($tCompressed)
    Local $iWritten = __AUI_EmbeddedDllWriteCompressed($pCompressed)
    If @error Then Return __AUI_MemoryFail($__AUI_MEMERR_EMBEDDED_DATA, "內嵌 DLL 的 Base64 資料已損毀")
    If $iWritten <> $iCompressedSize Then _
            Return __AUI_MemoryFail($__AUI_MEMERR_EMBEDDED_DATA, "內嵌 DLL 的壓縮資料長度與中繼資料不符")

    Local $tDll = DllStructCreate("byte[" & $iDllSize & "]")
    Local $aCreate = DllCall("cabinet.dll", "bool", "CreateDecompressor", _
            "dword", 5, "ptr", 0, "handle*", 0)
    If @error Or Not IsArray($aCreate) Or Not $aCreate[0] Or Not $aCreate[3] Then _
            Return __AUI_MemoryFail($__AUI_MEMERR_EMBEDDED_DATA, "無法建立 Windows LZMS 解壓縮器")
    Local $aInflate = DllCall("cabinet.dll", "bool", "Decompress", _
            "handle", $aCreate[3], "ptr", $pCompressed, _
            "ulong_ptr", $iCompressedSize, _
            "ptr", DllStructGetPtr($tDll), "ulong_ptr", $iDllSize, _
            "ulong_ptr*", 0)
    Local $iInflateError = @error
    DllCall("cabinet.dll", "bool", "CloseDecompressor", "handle", $aCreate[3])
    If $iInflateError Or Not IsArray($aInflate) Or Not $aInflate[0] Or _
            $aInflate[6] <> $iDllSize Then _
            Return __AUI_MemoryFail($__AUI_MEMERR_EMBEDDED_DATA, "內嵌 DLL 解壓縮失敗")

    Local $tHash = DllStructCreate("byte[32]")
    Local $aHash = DllCall("crypt32.dll", "bool", "CryptHashCertificate", _
            "ulong_ptr", 0, "dword", 0x0000800C, "dword", 0, _
            "ptr", DllStructGetPtr($tDll), "dword", $iDllSize, _
            "ptr", DllStructGetPtr($tHash), "dword*", 32)
    If @error Or Not IsArray($aHash) Or Not $aHash[0] Or $aHash[7] <> 32 Or _
            StringLower(Hex(DllStructGetData($tHash, 1))) <> __AUI_EmbeddedDllSha256() Then _
            Return __AUI_MemoryFail($__AUI_MEMERR_EMBEDDED_DATA, "內嵌 DLL 的 SHA-256 驗證失敗")
    Return SetError(0, 0, $tDll)
EndFunc

Func __AUI_MemoryFreeDependencies(ByRef $aDependencies, $iCount)
    For $i = $iCount - 1 To 0 Step -1
        If $aDependencies[$i] Then DllCall("kernel32.dll", "bool", "FreeLibrary", "handle", $aDependencies[$i])
    Next
EndFunc

Func __AUI_MemoryRollback($pBase, ByRef $aDependencies, $iCount)
    __AUI_MemoryFreeDependencies($aDependencies, $iCount)
    If $pBase Then DllCall("kernel32.dll", "bool", "VirtualFree", "ptr", $pBase, "ulong_ptr", 0, "dword", 0x8000)
EndFunc

Func __AUI_MemoryBuildImports($pBase, $iImageSize, $iDirectoryRva, $iDirectorySize, _
        ByRef $aDependencies, ByRef $iDependencyCount)
    If $iDirectoryRva = 0 And $iDirectorySize = 0 Then Return True
    If $iDirectoryRva = 0 Or $iDirectorySize < 20 Or _
            Not __AUI_MemorySpan($iDirectoryRva, $iDirectorySize, $iImageSize) Then Return False

    Local $iDescriptorOffset = 0
    Local $iImportCount = 0
    While __AUI_MemorySpan($iDescriptorOffset, 20, $iDirectorySize)
        Local $iDesc = $iDirectoryRva + $iDescriptorOffset
        Local $iOriginalFirstThunk = __AUI_MemoryU32($pBase, $iDesc)
        Local $iTimeDateStamp = __AUI_MemoryU32($pBase, $iDesc + 4)
        Local $iForwarderChain = __AUI_MemoryU32($pBase, $iDesc + 8)
        Local $iNameRva = __AUI_MemoryU32($pBase, $iDesc + 12)
        Local $iFirstThunk = __AUI_MemoryU32($pBase, $iDesc + 16)
        If $iOriginalFirstThunk = 0 And $iTimeDateStamp = 0 And $iForwarderChain = 0 And _
                $iNameRva = 0 And $iFirstThunk = 0 Then Return True
        If $iDependencyCount >= $__AUI_MEM_MAX_IMPORT_DLLS Or $iNameRva = 0 Or $iFirstThunk = 0 Then Return False

        Local $sLibrary = __AUI_MemoryReadAnsi($pBase, $iNameRva, $iImageSize, 260)
        If @error Or $sLibrary = "" Then Return False
        Local $aLoad = DllCall("kernel32.dll", "handle", "LoadLibraryW", "wstr", $sLibrary)
        If @error Or Not IsArray($aLoad) Or Not $aLoad[0] Then Return False
        If $iDependencyCount >= UBound($aDependencies) Then ReDim $aDependencies[$iDependencyCount + 16]
        $aDependencies[$iDependencyCount] = $aLoad[0]
        $iDependencyCount += 1

        Local $iLookupThunk = $iOriginalFirstThunk
        If $iLookupThunk = 0 Then $iLookupThunk = $iFirstThunk
        Local $iThunkIndex = 0
        While True
            If $iImportCount >= $__AUI_MEM_MAX_IMPORTS Or _
                    Not __AUI_MemorySpan($iLookupThunk + $iThunkIndex * 4, 4, $iImageSize) Or _
                    Not __AUI_MemorySpan($iFirstThunk + $iThunkIndex * 4, 4, $iImageSize) Then Return False
            Local $iThunk = __AUI_MemoryU32($pBase, $iLookupThunk + $iThunkIndex * 4)
            If $iThunk = 0 Then ExitLoop
            Local $aProc
            If BitAND($iThunk, 0x80000000) Then
                Local $iOrdinal = BitAND($iThunk, 0xFFFF)
                If $iOrdinal = 0 Then Return False
                $aProc = DllCall("kernel32.dll", "ptr", "GetProcAddress", "handle", $aLoad[0], "ptr", $iOrdinal)
            Else
                If Not __AUI_MemorySpan($iThunk, 3, $iImageSize) Then Return False
                Local $sImport = __AUI_MemoryReadAnsi($pBase, $iThunk + 2, $iImageSize, 512)
                If @error Or $sImport = "" Then Return False
                $aProc = DllCall("kernel32.dll", "ptr", "GetProcAddress", _
                        "handle", $aLoad[0], "ptr", $pBase + $iThunk + 2)
            EndIf
            If @error Or Not IsArray($aProc) Or Not $aProc[0] Then Return False
            __AUI_MemoryWriteU32($pBase, $iFirstThunk + $iThunkIndex * 4, $aProc[0])
            $iThunkIndex += 1
            $iImportCount += 1
        WEnd
        $iDescriptorOffset += 20
    WEnd
    Return False
EndFunc

Func __AUI_MemoryRelocate($pBase, $iImageSize, $iDirectoryRva, $iDirectorySize, $iDelta)
    If $iDelta = 0 Then Return True
    If $iDirectoryRva = 0 Or $iDirectorySize < 8 Or _
            Not __AUI_MemorySpan($iDirectoryRva, $iDirectorySize, $iImageSize) Then Return False
    Local $iCursor = 0
    While $iCursor < $iDirectorySize
        If Not __AUI_MemorySpan($iCursor, 8, $iDirectorySize) Then Return False
        Local $iPageRva = __AUI_MemoryU32($pBase, $iDirectoryRva + $iCursor)
        Local $iBlockSize = __AUI_MemoryU32($pBase, $iDirectoryRva + $iCursor + 4)
        If $iBlockSize < 8 Or Mod($iBlockSize - 8, 2) <> 0 Or _
                Not __AUI_MemorySpan($iCursor, $iBlockSize, $iDirectorySize) Then Return False
        Local $iEntries = ($iBlockSize - 8) / 2
        For $i = 0 To $iEntries - 1
            Local $iReloc = __AUI_MemoryU16($pBase, $iDirectoryRva + $iCursor + 8 + $i * 2)
            Local $iType = BitShift($iReloc, 12)
            Local $iOffset = BitAND($iReloc, 0x0FFF)
            If $iType = 0 Then ContinueLoop
            If $iType <> 3 Or Not __AUI_MemorySpan($iPageRva + $iOffset, 4, $iImageSize) Then Return False
            Local $iValue = __AUI_MemoryU32($pBase, $iPageRva + $iOffset) + $iDelta
            $iValue = Mod($iValue, 4294967296)
            If $iValue < 0 Then $iValue += 4294967296
            __AUI_MemoryWriteU32($pBase, $iPageRva + $iOffset, $iValue)
        Next
        $iCursor += $iBlockSize
    WEnd
    Return $iCursor = $iDirectorySize
EndFunc

Func __AUI_MemoryRvaIsExecutable($iRva, ByRef $aSections)
    For $i = 0 To UBound($aSections) - 1
        If $iRva >= $aSections[$i][0] And $iRva < $aSections[$i][0] + $aSections[$i][1] Then _
                Return BitAND($aSections[$i][4], 0x20000000) <> 0
    Next
    Return False
EndFunc

Func __AUI_MemoryBuildExports($pBase, $iImageSize, $iDirectoryRva, $iDirectorySize, _
        ByRef $aSections, ByRef $mExports)
    If $iDirectoryRva = 0 Or $iDirectorySize < 40 Or _
            Not __AUI_MemorySpan($iDirectoryRva, $iDirectorySize, $iImageSize) Then Return False
    Local $iFunctions = __AUI_MemoryU32($pBase, $iDirectoryRva + 20)
    Local $iNames = __AUI_MemoryU32($pBase, $iDirectoryRva + 24)
    Local $iFunctionTable = __AUI_MemoryU32($pBase, $iDirectoryRva + 28)
    Local $iNameTable = __AUI_MemoryU32($pBase, $iDirectoryRva + 32)
    Local $iOrdinalTable = __AUI_MemoryU32($pBase, $iDirectoryRva + 36)
    If $iFunctions <= 0 Or $iNames <= 0 Or $iFunctions > $__AUI_MEM_MAX_EXPORTS Or _
            $iNames > $__AUI_MEM_MAX_EXPORTS Or $iNames > $iFunctions Or _
            Not __AUI_MemorySpan($iFunctionTable, $iFunctions * 4, $iImageSize) Or _
            Not __AUI_MemorySpan($iNameTable, $iNames * 4, $iImageSize) Or _
            Not __AUI_MemorySpan($iOrdinalTable, $iNames * 2, $iImageSize) Then Return False

    For $i = 0 To $iNames - 1
        Local $iNameRva = __AUI_MemoryU32($pBase, $iNameTable + $i * 4)
        Local $sName = __AUI_MemoryReadAnsi($pBase, $iNameRva, $iImageSize, 255)
        If @error Or StringLeft($sName, 4) <> "_UI_" Or MapExists($mExports, $sName) Then Return False
        Local $iOrdinal = __AUI_MemoryU16($pBase, $iOrdinalTable + $i * 2)
        If $iOrdinal >= $iFunctions Then Return False
        Local $iFunctionRva = __AUI_MemoryU32($pBase, $iFunctionTable + $iOrdinal * 4)
        If $iFunctionRva >= $iDirectoryRva And $iFunctionRva < $iDirectoryRva + $iDirectorySize Then Return False
        If Not __AUI_MemorySpan($iFunctionRva, 1, $iImageSize) Or _
                Not __AUI_MemoryRvaIsExecutable($iFunctionRva, $aSections) Then Return False
        $mExports[$sName] = Ptr($pBase + $iFunctionRva)
    Next
    Return MapExists($mExports, "_UI_GetVersion") And MapExists($mExports, "_UI_Shutdown")
EndFunc

Func __AUI_MemoryFinalizeSections($pBase, $iSizeOfHeaders, ByRef $aSections)
    Local $aHeaderProtect = DllCall("kernel32.dll", "bool", "VirtualProtect", _
            "ptr", $pBase, "ulong_ptr", $iSizeOfHeaders, "dword", 0x02, "dword*", 0)
    If @error Or Not IsArray($aHeaderProtect) Or Not $aHeaderProtect[0] Then Return False
    Local $aProtection[8] = [0x01, 0x10, 0x02, 0x20, 0x04, 0x40, 0x04, 0x40]
    For $i = 0 To UBound($aSections) - 1
        Local $iSize = $aSections[$i][1]
        If $iSize <= 0 Then ContinueLoop
        Local $iFlags = $aSections[$i][4]
        Local $iIndex = (BitAND($iFlags, 0x20000000) <> 0) + _
                (BitAND($iFlags, 0x40000000) <> 0) * 2 + _
                (BitAND($iFlags, 0x80000000) <> 0) * 4
        Local $iProtect = $aProtection[$iIndex]
        If BitAND($iFlags, 0x04000000) Then $iProtect = BitOR($iProtect, 0x200)
        Local $aProtect = DllCall("kernel32.dll", "bool", "VirtualProtect", _
                "ptr", $pBase + $aSections[$i][0], "ulong_ptr", $iSize, _
                "dword", $iProtect, "dword*", 0)
        If @error Or Not IsArray($aProtect) Or Not $aProtect[0] Then Return False
    Next
    Local $aFlush = DllCall("kernel32.dll", "bool", "FlushInstructionCache", _
            "handle", -1, "ptr", $pBase, "ulong_ptr", 0)
    Return Not @error And IsArray($aFlush) And $aFlush[0]
EndFunc

Func __AUI_MemoryMap($tDll)
    If @AutoItX64 Then Return __AUI_MemoryFail($__AUI_MEMERR_PLATFORM, "AUI 僅支援 32 位元 AutoIt")
    If Not IsDllStruct($tDll) Then Return __AUI_MemoryFail($__AUI_MEMERR_EMBEDDED_DATA, "內嵌 DLL 緩衝區無效")
    Local $pFile = DllStructGetPtr($tDll)
    Local $iFileSize = __AUI_EmbeddedDllSize()
    If $iFileSize < 0x100 Or $iFileSize > $__AUI_MEM_MAX_FILE_SIZE Or _
            __AUI_MemoryU16($pFile, 0) <> 0x5A4D Then _
            Return __AUI_MemoryFail($__AUI_MEMERR_PE_FORMAT, "DLL 的 DOS 標頭無效")
    Local $iNt = __AUI_MemoryU32($pFile, 0x3C)
    If Not __AUI_MemorySpan($iNt, 24, $iFileSize) Or __AUI_MemoryU32($pFile, $iNt) <> 0x4550 Then _
            Return __AUI_MemoryFail($__AUI_MEMERR_PE_FORMAT, "DLL 的 PE 標頭無效")

    Local $iFileHeader = $iNt + 4
    Local $iMachine = __AUI_MemoryU16($pFile, $iFileHeader)
    Local $iSectionCount = __AUI_MemoryU16($pFile, $iFileHeader + 2)
    Local $iOptionalSize = __AUI_MemoryU16($pFile, $iFileHeader + 16)
    Local $iCharacteristics = __AUI_MemoryU16($pFile, $iFileHeader + 18)
    Local $iOptional = $iFileHeader + 20
    If $iMachine <> 0x014C Or $iSectionCount <= 0 Or $iSectionCount > $__AUI_MEM_MAX_SECTIONS Or _
            BitAND($iCharacteristics, 0x2000) = 0 Or $iOptionalSize < 224 Or _
            Not __AUI_MemorySpan($iOptional, $iOptionalSize, $iFileSize) Or _
            __AUI_MemoryU16($pFile, $iOptional) <> 0x010B Then _
            Return __AUI_MemoryFail($__AUI_MEMERR_UNSUPPORTED, "僅支援標準 PE32/x86 DLL")

    Local $iEntryRva = __AUI_MemoryU32($pFile, $iOptional + 16)
    Local $iPreferredBase = __AUI_MemoryU32($pFile, $iOptional + 28)
    Local $iSectionAlignment = __AUI_MemoryU32($pFile, $iOptional + 32)
    Local $iFileAlignment = __AUI_MemoryU32($pFile, $iOptional + 36)
    Local $iImageSize = __AUI_MemoryU32($pFile, $iOptional + 56)
    Local $iHeadersSize = __AUI_MemoryU32($pFile, $iOptional + 60)
    Local $iDirectoryCount = __AUI_MemoryU32($pFile, $iOptional + 92)
    If $iDirectoryCount < 16 Or $iOptionalSize < 224 Or $iSectionAlignment < 0x1000 Or _
            $iFileAlignment <= 0 Or $iImageSize <= 0 Or $iImageSize > $__AUI_MEM_MAX_IMAGE_SIZE Or _
            $iHeadersSize <= 0 Or $iHeadersSize > $iImageSize Or _
            Not __AUI_MemorySpan(0, $iHeadersSize, $iFileSize) Then _
            Return __AUI_MemoryFail($__AUI_MEMERR_PE_FORMAT, "DLL 的 PE32 選用標頭無效")

    Local $iDirectory = $iOptional + 96
    Local $iExportRva = __AUI_MemoryU32($pFile, $iDirectory)
    Local $iExportSize = __AUI_MemoryU32($pFile, $iDirectory + 4)
    Local $iImportRva = __AUI_MemoryU32($pFile, $iDirectory + 8)
    Local $iImportSize = __AUI_MemoryU32($pFile, $iDirectory + 12)
    Local $iRelocRva = __AUI_MemoryU32($pFile, $iDirectory + 5 * 8)
    Local $iRelocSize = __AUI_MemoryU32($pFile, $iDirectory + 5 * 8 + 4)
    Local $iTlsRva = __AUI_MemoryU32($pFile, $iDirectory + 9 * 8)
    Local $iTlsSize = __AUI_MemoryU32($pFile, $iDirectory + 9 * 8 + 4)
    Local $iBoundRva = __AUI_MemoryU32($pFile, $iDirectory + 11 * 8)
    Local $iBoundSize = __AUI_MemoryU32($pFile, $iDirectory + 11 * 8 + 4)
    Local $iDelayRva = __AUI_MemoryU32($pFile, $iDirectory + 13 * 8)
    Local $iDelaySize = __AUI_MemoryU32($pFile, $iDirectory + 13 * 8 + 4)
    If $iDelayRva <> 0 Or $iDelaySize <> 0 Or _
            $iBoundRva <> 0 Or $iBoundSize <> 0 Then _
            Return __AUI_MemoryFail($__AUI_MEMERR_UNSUPPORTED, "DLL 包含延遲載入或繫結匯入項目")
    If $iTlsRva <> 0 Or $iTlsSize <> 0 Then _
            Return __AUI_MemoryFail($__AUI_MEMERR_UNSUPPORTED, "內嵌執行階段映像不得包含編譯器產生的靜態 TLS")

    Local $iSectionTable = $iOptional + $iOptionalSize
    If Not __AUI_MemorySpan($iSectionTable, $iSectionCount * 40, $iFileSize) Then _
            Return __AUI_MemoryFail($__AUI_MEMERR_PE_FORMAT, "DLL 區段表超出範圍")
    Local $aSections[$iSectionCount][5]
    For $i = 0 To $iSectionCount - 1
        Local $iSection = $iSectionTable + $i * 40
        Local $iVirtualSize = __AUI_MemoryU32($pFile, $iSection + 8)
        Local $iVirtualAddress = __AUI_MemoryU32($pFile, $iSection + 12)
        Local $iRawSize = __AUI_MemoryU32($pFile, $iSection + 16)
        Local $iRawOffset = __AUI_MemoryU32($pFile, $iSection + 20)
        Local $iMappedSize = $iVirtualSize
        If $iRawSize > $iMappedSize Then $iMappedSize = $iRawSize
        If $iMappedSize <= 0 Or Mod($iVirtualAddress, $iSectionAlignment) <> 0 Or _
                Not __AUI_MemorySpan($iVirtualAddress, $iMappedSize, $iImageSize) Or _
                ($iRawSize > 0 And (Mod($iRawOffset, $iFileAlignment) <> 0 Or _
                 Not __AUI_MemorySpan($iRawOffset, $iRawSize, $iFileSize))) Then _
                Return __AUI_MemoryFail($__AUI_MEMERR_PE_FORMAT, "DLL 區段的範圍或對齊設定無效")
        For $j = 0 To $i - 1
            If $iVirtualAddress < $aSections[$j][0] + $aSections[$j][1] And _
                    $aSections[$j][0] < $iVirtualAddress + $iMappedSize Then _
                    Return __AUI_MemoryFail($__AUI_MEMERR_PE_FORMAT, "DLL 區段的虛擬位址範圍互相重疊")
        Next
        $aSections[$i][0] = $iVirtualAddress
        $aSections[$i][1] = $iMappedSize
        $aSections[$i][2] = $iRawSize
        $aSections[$i][3] = $iRawOffset
        $aSections[$i][4] = __AUI_MemoryU32($pFile, $iSection + 36)
    Next
    If $iEntryRva = 0 Or Not __AUI_MemorySpan($iEntryRva, 1, $iImageSize) Or _
            Not __AUI_MemoryRvaIsExecutable($iEntryRva, $aSections) Then _
            Return __AUI_MemoryFail($__AUI_MEMERR_PE_FORMAT, "DLL 進入點無效")

    Local $aAllocate = DllCall("kernel32.dll", "ptr", "VirtualAlloc", _
            "ptr", Ptr($iPreferredBase), "ulong_ptr", $iImageSize, "dword", 0x3000, "dword", 0x04)
    Local $pBase = 0
    If Not @error And IsArray($aAllocate) Then $pBase = $aAllocate[0]
    If Not $pBase Then
        $aAllocate = DllCall("kernel32.dll", "ptr", "VirtualAlloc", _
                "ptr", 0, "ulong_ptr", $iImageSize, "dword", 0x3000, "dword", 0x04)
        If Not @error And IsArray($aAllocate) Then $pBase = $aAllocate[0]
    EndIf
    If Not $pBase Then Return __AUI_MemoryFail($__AUI_MEMERR_ALLOC, "無法為 AUI 映像配置記憶體")

    Local $aDependencies[1]
    Local $iDependencyCount = 0
    DllCall("kernel32.dll", "none", "RtlMoveMemory", "ptr", $pBase, "ptr", $pFile, "ulong_ptr", $iHeadersSize)
    For $i = 0 To $iSectionCount - 1
        If $aSections[$i][2] > 0 Then DllCall("kernel32.dll", "none", "RtlMoveMemory", _
                "ptr", $pBase + $aSections[$i][0], "ptr", $pFile + $aSections[$i][3], _
                "ulong_ptr", $aSections[$i][2])
    Next

    Local $iDelta = Number($pBase) - $iPreferredBase
    If Not __AUI_MemoryRelocate($pBase, $iImageSize, $iRelocRva, $iRelocSize, $iDelta) Then
        __AUI_MemoryRollback($pBase, $aDependencies, $iDependencyCount)
        Return __AUI_MemoryFail($__AUI_MEMERR_RELOCATION, "DLL 的基底重定位表無效")
    EndIf
    If Not __AUI_MemoryBuildImports($pBase, $iImageSize, $iImportRva, $iImportSize, _
            $aDependencies, $iDependencyCount) Then
        __AUI_MemoryRollback($pBase, $aDependencies, $iDependencyCount)
        Return __AUI_MemoryFail($__AUI_MEMERR_IMPORT, "DLL 匯入表無效，或無法載入相依元件")
    EndIf
    Local $mExports[]
    If Not __AUI_MemoryBuildExports($pBase, $iImageSize, $iExportRva, $iExportSize, _
            $aSections, $mExports) Then
        __AUI_MemoryRollback($pBase, $aDependencies, $iDependencyCount)
        Return __AUI_MemoryFail($__AUI_MEMERR_EXPORT, "DLL 匯出表無效")
    EndIf
    If Not __AUI_MemoryFinalizeSections($pBase, $iHeadersSize, $aSections) Then
        __AUI_MemoryRollback($pBase, $aDependencies, $iDependencyCount)
        Return __AUI_MemoryFail($__AUI_MEMERR_PROTECTION, "無法套用 DLL 最終的記憶體保護設定")
    EndIf

    Local $pEntry = Ptr($pBase + $iEntryRva)
    Local $aAttach = DllCallAddress("bool", $pEntry, "ptr", $pBase, "dword", 1, "ptr", 0)
    If @error Or Not IsArray($aAttach) Or Not $aAttach[0] Then
        __AUI_MemoryRollback($pBase, $aDependencies, $iDependencyCount)
        Return __AUI_MemoryFail($__AUI_MEMERR_ENTRY, "AUI DLL 進入點初始化失敗")
    EndIf

    $__g_pAuiMemoryBase = Ptr($pBase)
    $__g_pAuiMemoryEntry = $pEntry
    $__g_bAuiMemoryAttached = True
    $__g_mAuiMemoryExports = $mExports
    ReDim $__g_aAuiMemoryDependencies[$iDependencyCount + 1]
    For $i = 0 To $iDependencyCount - 1
        $__g_aAuiMemoryDependencies[$i] = $aDependencies[$i]
    Next
    $__g_iAuiMemoryDependencyCount = $iDependencyCount
    $__g_iAuiMemoryError = $__AUI_MEMERR_NONE
    $__g_sAuiMemoryError = ""
    Return SetError(0, 0, $__g_pAuiMemoryBase)
EndFunc

Func __AUI_MemoryLoadEmbedded()
    If $__g_pAuiMemoryBase Then Return SetError(0, 0, $__g_pAuiMemoryBase)
    Local $tDll = __AUI_EmbeddedDllInflate()
    If @error Or Not IsDllStruct($tDll) Then Return SetError($__g_iAuiMemoryError, 0, 0)
    Local $vAuiMemoryResult = __AUI_MemoryMap($tDll)
    Return SetError(@error, @extended, $vAuiMemoryResult)
EndFunc

Func __AUI_MemoryGetProcAddress($sName)
    If Not $__g_pAuiMemoryBase Or Not MapExists($__g_mAuiMemoryExports, $sName) Then Return 0
    Return $__g_mAuiMemoryExports[$sName]
EndFunc
