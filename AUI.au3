EndFunc

; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_ArchiveListGetCount
; 說明 ...: Reads the entry count stored by a completed archive listing task.
; 語法 ........: _UI_ArchiveListGetCount( $iTaskId )
; 參數 ....: $iTaskId - Archive listing task ID
; 傳回值 .: Success - Entry count
;                  Failure - -1 and sets @error
; 作者 ........: Fanxing
; 備註 .......: Call this before the completion callback returns and the task is reclaimed. An unfinished, unknown, or
;                  non-listing task fails.
; 相關函式 .......: _UI_ArchiveListAsync, _UI_ArchiveListGetEntry
; 範例 .......: Yes
; ===============================================================================================================================
Func _UI_ArchiveListGetCount($iTaskId)
    Local $iCount = __AUI_Call("int", "_UI_ArchiveListGetCount", "int", $iTaskId)
    Return SetError(@error, @extended, $iCount)
EndFunc

; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_ArchiveListGetEntry
; 說明 ...: Reads one entry from a completed archive listing task.
; 語法 ........: _UI_ArchiveListGetEntry( $iTaskId, $iIndex )
; 參數 ....: $iTaskId - Archive listing task ID
;                  $iIndex - Zero-based entry index
; 傳回值 .: Success - Five-element array: [path, is directory, size, Unix modification time, is encrypted]
;                  Failure - 0, and set @error
; 作者 ........: Fanxing
; 備註 .......: Call this before the completion callback returns. Array elements 1 and 4 are Boolean; directory size is 0,
;                  and an unknown modification time is 0.
; 相關函式 .......: _UI_ArchiveListAsync, _UI_ArchiveListGetCount
; 範例 .......: Yes
; ===============================================================================================================================
Func _UI_ArchiveListGetEntry($iTaskId, $iIndex)
    Local $tEntry = DllStructCreate("int isDirectory;uint64 size;int64 modifiedTime;int encrypted")
    If @error Or Not IsDllStruct($tEntry) Then
        $g_iAuiUdfErrorCode = $AUI_ERR_LIMIT_EXCEEDED
        Return SetError($AUI_ERR_LIMIT_EXCEEDED, 0, 0)
    EndIf
    Local $iNeeded = __AUI_Call("int", "_UI_ArchiveListGetEntry", _
            "int", $iTaskId, "int", $iIndex, "ptr", 0, "int", 0, _
            "ptr", DllStructGetPtr($tEntry, "isDirectory"), "ptr", DllStructGetPtr($tEntry, "size"), _
            "ptr", DllStructGetPtr($tEntry, "modifiedTime"), "ptr", DllStructGetPtr($tEntry, "encrypted"))
    If @error Or $iNeeded <= 0 Then Return SetError(@error, @extended, 0)
    Local $tPath = DllStructCreate("wchar[" & ($iNeeded + 1) & "]")
    If @error Or Not IsDllStruct($tPath) Then
        $g_iAuiUdfErrorCode = $AUI_ERR_LIMIT_EXCEEDED
        Return SetError($AUI_ERR_LIMIT_EXCEEDED, 0, 0)
    EndIf
    Local $iCopied = __AUI_Call("int", "_UI_ArchiveListGetEntry", _
            "int", $iTaskId, "int", $iIndex, "ptr", DllStructGetPtr($tPath), "int", $iNeeded + 1, _
            "ptr", DllStructGetPtr($tEntry, "isDirectory"), "ptr", DllStructGetPtr($tEntry, "size"), _
            "ptr", DllStructGetPtr($tEntry, "modifiedTime"), "ptr", DllStructGetPtr($tEntry, "encrypted"))
    If @error Or $iCopied <> $iNeeded Then Return SetError(@error, @extended, 0)
    Local $aEntry[5] = [DllStructGetData($tPath, 1), DllStructGetData($tEntry, "isDirectory") <> 0, _
            DllStructGetData($tEntry, "size"), DllStructGetData($tEntry, "modifiedTime"), _
            DllStructGetData($tEntry, "encrypted") <> 0]
    Return SetError(0, 0, $aEntry)
EndFunc

; ────────────────────────────────────────────────────────────────────────────
;  Layout
; ────────────────────────────────────────────────────────────────────────────
; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_Row
; 說明 ...: Creates a horizontal flexible container (child elements are arranged from left to right).
; 語法 ........: _UI_Row( $hWnd, $iParent [, $iX = 0 [, $iY = 0 [, $iW = 0 [, $iH = 0]]]] )
; 參數 ....: $hWnd - Window handle returned by _UI_WindowCreate
;                  $iParent - Parent element ID; use 0 for the window root
;                  $iX - [Optional] Logical X coordinate; ignored within flex containers, default 0
;                  $iY - [Optional] Logical Y coordinate; ignored within flex containers, default 0
;                  $iW - [Optional] Logical width; 0 means automatically determined by the layout, default 0
;                  $iH - [Optional] Logical height; 0 means automatically determined by the layout, default 0
; 傳回值 .: Success - New element ID (integer, >=1)
;                  Failure - 0
; 作者 ........: Fanxing
; 相關函式 .......: _UI_Column, _UI_SetGap, _UI_SetFlexGrow
; 範例 .......: Yes
; ===============================================================================================================================
Func _UI_Row($hWnd, $iParent, $iX = 0, $iY = 0, $iW = 0, $iH = 0)
    Local $vAuiForwardResult = __AUI_Call("int", "_UI_Row", _
                       "hwnd", $hWnd, "int", $iParent, _
                       "int", $iX, "int", $iY, "int", $iW, "int", $iH)
    Return SetError(@error, @extended, $vAuiForwardResult)
EndFunc

; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_Column
; 說明 ...: Creates a vertical flexible container (child elements are arranged from top to bottom).
; 語法 ........: _UI_Column( $hWnd, $iParent [, $iX = 0 [, $iY = 0 [, $iW = 0 [, $iH = 0]]]] )
; 參數 ....: $hWnd - Window handle returned by _UI_WindowCreate
;                  $iParent - Parent element ID; use 0 for the window root
;                  $iX - [Optional] Logical X coordinate; ignored within flex containers, default 0
;                  $iY - [Optional] Logical Y coordinate; ignored within flex containers, default 0
;                  $iW - [Optional] Logical width; 0 means automatically determined by the layout, default 0
;                  $iH - [Optional] Logical height; 0 means automatically determined by the layout, default 0
; 傳回值 .: Success - New element ID (integer, >=1)
;                  Failure - 0
; 作者 ........: Fanxing
; 備註 .......: When hanging in the window root container (parent=0), the window is automatically filled and scrollable; the
;                  restricted scroll area should be embedded in the non-root container.
; 相關函式 .......: _UI_Row, _UI_ScrollView
; 範例 .......: Yes
; ===============================================================================================================================
Func _UI_Column($hWnd, $iParent, $iX = 0, $iY = 0, $iW = 0, $iH = 0)
    Local $vAuiForwardResult = __AUI_Call("int", "_UI_Column", _
                       "hwnd", $hWnd, "int", $iParent, _
                       "int", $iX, "int", $iY, "int", $iW, "int", $iH)
    Return SetError(@error, @extended, $vAuiForwardResult)
EndFunc

; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_Wrap
; 說明 ...: Creates a flow container that automatically wraps to another line or column when space is exhausted.
; 語法 ........: _UI_Wrap( $hWnd, $iParent [, $iDirection = $AUI_DIR_ROW [, $iX = 0 [, $iY = 0 [, $iW = 0 [, $iH = 0]]]]] )
; 參數 ....: $hWnd - Window handle returned by _UI_WindowCreate
;                  $iParent - Parent element ID; use 0 for the window root
;                  $iDirection - [Optional] $AUI_DIR_ROW lays out items horizontally and wraps downward; $AUI_DIR_COLUMN lays
;                  out items vertically and wraps to the right. The default is $AUI_DIR_ROW
;                  $iX - [Optional] Logical X coordinate, default 0
;                  $iY - [Optional] Logical Y coordinate, default 0
;                  $iW - [Optional] Logical width; 0 lets the parent layout determine the width; default 0
;                  $iH - [Optional] Logical height; 0 lets the content or parent layout determine the height; default 0
; 傳回值 .: Success - New element ID (integer, >=1)
;                  Failure - 0, and set @error
; 作者 ........: Fanxing
; 備註 .......: Gap, padding, alignment, and vertical scrolling use the common layout APIs. Row mode wraps at the available
;                  width; column mode starts a new column at the available height.
; 相關函式 .......: _UI_WrapSetDirection, _UI_Row, _UI_Column, _UI_SetGap, _UI_SetAlign
; 範例 .......: Yes
; ===============================================================================================================================
Func _UI_Wrap($hWnd, $iParent, $iDirection = $AUI_DIR_ROW, $iX = 0, $iY = 0, $iW = 0, $iH = 0)
    Local $vAuiForwardResult = __AUI_Call("int", "_UI_Wrap", _
            "hwnd", $hWnd, "int", $iParent, "int", $iDirection, _
            "int", $iX, "int", $iY, "int", $iW, "int", $iH)
    Return SetError(@error, @extended, $vAuiForwardResult)
EndFunc

; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_WrapSetDirection
; 說明 ...: Sets a Wrap container to horizontal line wrapping or vertical column wrapping.
; 語法 ........: _UI_WrapSetDirection( $hWnd, $iWrap, $iDirection )
