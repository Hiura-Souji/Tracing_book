; ────────────────────────────────────────────────────────────────────────────
;  DatePicker
; ────────────────────────────────────────────────────────────────────────────
; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_DatePicker
; 說明 ...: Creates a date picker.
; 語法 ........: _UI_DatePicker( $hWnd, $iParent [, $sValueISO = "" [, $sMinISO = "" [, $sMaxISO = "" [, $iX = 0 [, $iY = 0 [,
;                  $iW = 0 [, $iH = 0]]]]]]] )
; 參數 ....: $hWnd - Window handle returned by _UI_WindowCreate
;                  $iParent - Parent element ID; use 0 for the window root
;                  $sValueISO - [Optional] Initial date in ISO YYYY-MM-DD format; may be empty, default ""; out-of-range date
;                  components are clamped (e.g. 2024-02-30 becomes 2024-02-29)
;                  $sMinISO - [Optional] Minimum date; empty string means 0001-01-01, default ""
;                  $sMaxISO - [Optional] Maximum date; empty string means 9999-12-31, default ""
;                  $iX - [Optional] Logical X coordinate (relative to parent container; ignored in flexible containers such as
;                  Row/Column), default 0
;                  $iY - [Optional] Logical Y coordinate (relative to parent container; ignored in flexible containers), default
;                  0
;                  $iW - [Optional] Logical width; 0 = automatically determined/filled by layout, default 0
;                  $iH - [Optional] Logical height; 0 = automatically determined/filled by layout, default 0
; 傳回值 .: Success - New element ID (integer, >= 1)
;                  Failure - 0
; 作者 ........: Fanxing
; 相關函式 .......: _UI_TimePicker
; 範例 .......: Yes
; ===============================================================================================================================
Func _UI_DatePicker($hWnd, $iParent, $sValueISO = "", $sMinISO = "", $sMaxISO = "", _
                    $iX = 0, $iY = 0, $iW = 0, $iH = 0)
    Local $vAuiForwardResult = __AUI_Call("int", "_UI_DatePicker", _
                       "hwnd", $hWnd, "int", $iParent, "wstr", $sValueISO, _
                       "wstr", $sMinISO, "wstr", $sMaxISO, _
                       "int", $iX, "int", $iY, "int", $iW, "int", $iH)
    Return SetError(@error, @extended, $vAuiForwardResult)
EndFunc

; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_DatePickerSetDate
; 說明 ...: Silently sets the current date of the date picker; out-of-range month/day components are clamped to valid
;                  dates.
; 語法 ........: _UI_DatePickerSetDate( $hWnd, $iId, $sValueISO )
; 參數 ....: $hWnd - Window handle
;                  $iId - DatePicker element ID returned by _UI_DatePicker
;                  $sValueISO - YYYY-MM-DD format date
; 傳回值 .: Success - 1; out-of-range components are clamped (e.g. 2024-02-30 becomes 2024-02-29, 2024-13-01 becomes
;                  2024-12-01) and the result is further clamped into the current minimum/maximum date range
;                  Failure - 0; the format is not YYYY-MM-DD or the element is invalid
; 作者 ........: Fanxing
; 相關函式 .......: _UI_DatePicker, _UI_GetText
; 範例 .......: Yes
; ===============================================================================================================================
Func _UI_DatePickerSetDate($hWnd, $iId, $sValueISO)
    Local $vAuiForwardResult = __AUI_Call("int", "_UI_DatePickerSetDate", "hwnd", $hWnd, "int", $iId, "wstr", $sValueISO)
    Return SetError(@error, @extended, $vAuiForwardResult)
EndFunc

; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_DatePickerSetRange
; 說明 ...: Atomically sets the DatePicker range and clamps the current date.
; 語法 ........: _UI_DatePickerSetRange( $hWnd, $iId [, $sMinISO = "" [, $sMaxISO = ""]] )
; 參數 ....: $hWnd - Window handle returned by _UI_WindowCreate
;                  $iId - DatePicker element ID
;                  $sMinISO - [Optional] Minimum date; empty string means 0001-01-01
;                  $sMaxISO - [Optional] Maximum date; empty string means 9999-12-31
; 傳回值 .: Success - 1
;                  Failure - 0; The format is illegal or the minimum date is later than the maximum date
; 作者 ........: Fanxing
; 相關函式 .......: _UI_DatePickerGetRange, _UI_DatePickerSetDate
; 範例 .......: Yes
; ===============================================================================================================================
Func _UI_DatePickerSetRange($hWnd, $iId, $sMinISO = "", $sMaxISO = "")
    Local $vAuiForwardResult = __AUI_Call("int", "_UI_DatePickerSetRange", "hwnd", $hWnd, "int", $iId, _
            "wstr", $sMinISO, "wstr", $sMaxISO)
    Return SetError(@error, @extended, $vAuiForwardResult)
EndFunc

; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_DatePickerGetRange
; 說明 ...: Retrieves date selection range.
; 語法 ........: _UI_DatePickerGetRange( $hWnd, $iId )
; 參數 ....: $hWnd - Window handle returned by _UI_WindowCreate
;                  $iId - DatePicker element ID
; 傳回值 .: Success - Two-element array [minimum date, maximum date], both YYYY-MM-DD
;                  Failure - NULL value and set @error
; 作者 ........: Fanxing
; 相關函式 .......: _UI_DatePickerSetRange
; 範例 .......: Yes
; ===============================================================================================================================
Func _UI_DatePickerGetRange($hWnd, $iId)
    If __AUI_EnsureDll() = 0 Then Return SetError($g_iAuiLoadError, 0, Null)
    Local $tMin = DllStructCreate("wchar[11]")
    Local $tMax = DllStructCreate("wchar[11]")
    Local $aCall = __AUI_DllCall("int", "_UI_DatePickerGetRange", _
            "hwnd", $hWnd, "int", $iId, _
            "ptr", DllStructGetPtr($tMin), "int", 11, _
            "ptr", DllStructGetPtr($tMax), "int", 11)
    Local $iError = @error
    If $iError Or Not IsArray($aCall) Then Return SetError($iError, 0, Null)
    If $aCall[0] = 0 Then Return SetError(__AUI_ReadNativeLastError(), 0, Null)
    Local $aRange[2] = [DllStructGetData($tMin, 1), DllStructGetData($tMax, 1)]
    Return $aRange
EndFunc

; #FUNCTION# ===================================================================================================================
