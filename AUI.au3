; 說明 ...: Sets read-only status; selection and copying are still possible when read-only.
; 語法 ........: _UI_EditSetReadOnly( $hWnd, $iId [, $bEnable = True] )
; 參數 ....: $hWnd - Window handle
;                  $iId - Edit control element ID
;                  $bEnable - [Optional] Whether to read only
; 傳回值 .: Success - 1
;                  Failure - 0
; 作者 ........: Fanxing
; 備註 .......: A read-only TextArea remains scrollable with the mouse wheel, scrollbar thumbs, and scrolling APIs. Manual
;                  scrolling is not reset merely because the control retains focus.
; 範例 .......: Yes
; ===============================================================================================================================
Func _UI_EditSetReadOnly($hWnd, $iId, $bEnable = True)
    Local $vAuiForwardResult = __AUI_Call("int", "_UI_EditSetReadOnly", "hwnd", $hWnd, "int", $iId, "int", $bEnable ? 1 : 0)
    Return SetError(@error, @extended, $vAuiForwardResult)
EndFunc

