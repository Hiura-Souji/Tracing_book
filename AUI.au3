; 作者 ........: Fanxing
; 相關函式 .......: _UI_ToggleButtonSetChecked
; 範例 .......: Yes
; ===============================================================================================================================
Func _UI_ToggleButtonGetChecked($hWnd, $iButton)
    Local $vAuiForwardResult = __AUI_Call("int", "_UI_ToggleButtonGetChecked", "hwnd", $hWnd, "int", $iButton)
    Return SetError(@error, @extended, $vAuiForwardResult)
EndFunc
