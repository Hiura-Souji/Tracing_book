EndFunc

; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_DbWalCheckpoint
; 說明 ...: Runs a WAL checkpoint on the main database and returns frame statistics.
; 語法 ........: _UI_DbWalCheckpoint( $iDatabase, ByRef $iLogFrames, ByRef $iCheckpointedFrames [, $iMode =
;                  $AUI_DB_WAL_PASSIVE] )
; 參數 ....: $iDatabase - Database connection ID
;                  $iLogFrames - [Output] Receives the total WAL frame count on success; -1 when not applicable; remains
;                  unchanged on failure
;                  $iCheckpointedFrames - [Output] Receives the checkpointed frame count on success; -1 when not applicable;
;                  remains unchanged on failure
;                  $iMode - [Optional] $AUI_DB_WAL_* checkpoint mode
; 傳回值 .: Success - 1; Failure - 0. SQLite diagnostics remain available when the database is busy.
; 作者 ........: Fanxing
; 相關函式 .......: _UI_DbBusyTimeout
; 範例 .......: Yes
; ===============================================================================================================================
Func _UI_DbWalCheckpoint($iDatabase, ByRef $iLogFrames, ByRef $iCheckpointedFrames, $iMode = $AUI_DB_WAL_PASSIVE)
    Local $aResult = __AUI_DllCall("int", "_UI_DbWalCheckpoint", "uint64", $iDatabase, "int", $iMode, "int*", 0, "int*", 0)
    Local $iCallError = @error, $iCallExtended = @extended
    If $iCallError Or Not IsArray($aResult) Then Return SetError($iCallError ? $iCallError : $AUI_ERR_IO, $iCallExtended, 0)
    If Not $aResult[0] Then
        Local $iResolvedError = __AUI_DbResolveFailure($iCallError, $iCallExtended)
        Local $iResolvedExtended = @extended
        Return SetError($iResolvedError, $iResolvedExtended, 0)
    EndIf
    $iLogFrames = $aResult[3]
    $iCheckpointedFrames = $aResult[4]
    Return SetError(0, 0, 1)
EndFunc

; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_DbInterrupt
; 說明 ...: Requests interruption of the database operation currently executing on the specified connection.
; 語法 ........: _UI_DbInterrupt( $iDatabase )
; 參數 ....: $iDatabase - Database connection ID
; 傳回值 .: Returns 1 when the interrupt request is submitted successfully, or 0 on failure
; 作者 ........: Fanxing
; 備註 .......: This function may be called from another host thread without waiting for the connection's long-running query;
;                  SQLite returns SQLITE_INTERRUPT at a safe point.
; 相關函式 .......: _UI_DbStep, _UI_DbExec
; 範例 .......: No
; ===============================================================================================================================
Func _UI_DbInterrupt($iDatabase)
    Local $vAuiForwardResult = __AUI_Call("int", "_UI_DbInterrupt", "uint64", $iDatabase)
    Return SetError(@error, @extended, $vAuiForwardResult)
EndFunc

; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_DbBackupBegin
; 說明 ...: Creates an incremental backup session that copies the main database to a destination file.
; 語法 ........: _UI_DbBackupBegin( $iDatabase, $sDestinationPath )
; 參數 ....: $iDatabase - Source database connection ID
;                  $sDestinationPath - Target database file path
; 傳回值 .: Returns a positive backup session ID on success, or 0 on failure
; 作者 ........: Fanxing
; 備註 .......: The source connection must not have an active transaction, and no more than 32 backup sessions may exist
;                  concurrently. The destination must be a persistent local file, not :memory:. The session writes a temporary
;                  file in the destination directory and publishes it atomically only after completion.
; 相關函式 .......: _UI_DbBackupStep, _UI_DbBackupFinish
; 範例 .......: Yes
; ===============================================================================================================================
Func _UI_DbBackupBegin($iDatabase, $sDestinationPath)
    Local $vAuiForwardResult = __AUI_Call("uint64", "_UI_DbBackupBegin", "uint64", $iDatabase, "wstr", $sDestinationPath)
    Return SetError(@error, @extended, $vAuiForwardResult)
EndFunc

; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_DbBackupStep
; 說明 ...: Copies a batch of database pages for an incremental backup session and reports progress.
; 語法 ........: _UI_DbBackupStep( $iBackup, $iPages, ByRef $iRemainingPages, ByRef $iTotalPages )
; 參數 ....: $iBackup - The backup session ID returned by _UI_DbBackupBegin
;                  $iPages - The maximum number of pages to copy in this call, from 1 through 65,536
;                  $iRemainingPages - [Output] Receives the remaining page count on success; remains unchanged on failure
;                  $iTotalPages - [Output] Receives the current source-database page count on success; remains unchanged on
;                  failure
; 傳回值 .: Returns $AUI_DB_BACKUP_MORE when more work remains, $AUI_DB_BACKUP_DONE when complete, or -1 on failure
; 作者 ........: Fanxing
; 備註 .......: The session remains retryable after SQLITE_BUSY or SQLITE_LOCKED; call _UI_DbBackupFinish after completion or
;                  any other failure.
; 相關函式 .......: _UI_DbBackupBegin, _UI_DbBackupFinish
; 範例 .......: Yes
; ===============================================================================================================================
Func _UI_DbBackupStep($iBackup, $iPages, ByRef $iRemainingPages, ByRef $iTotalPages)
    Local $aResult = __AUI_DllCall("int", "_UI_DbBackupStep", "uint64", $iBackup, "int", $iPages, _
            "int*", 0, "int*", 0)
    Local $iCallError = @error, $iCallExtended = @extended
    If $iCallError Or Not IsArray($aResult) Then Return SetError($iCallError ? $iCallError : $AUI_ERR_IO, $iCallExtended, -1)
    If $aResult[0] < 0 Then
        Local $iResolvedError = __AUI_DbResolveFailure($iCallError, $iCallExtended)
        Local $iResolvedExtended = @extended
        Return SetError($iResolvedError, $iResolvedExtended, -1)
    EndIf
    $iRemainingPages = $aResult[3]
    $iTotalPages = $aResult[4]
    Return SetError(0, 0, $aResult[0])
EndFunc

; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_DbBackupFinish
; 說明 ...: Releases an incremental backup session that completed, failed, or was canceled by the caller.
; 語法 ........: _UI_DbBackupFinish( $iBackup )
; 參數 ....: $iBackup - A backup session ID
; 傳回值 .: Returns 1 when the session is released successfully, or 0 on failure
; 作者 ........: Fanxing
; 備註 .......: Calling this before completion cancels the backup and removes the unpublished temporary file; an existing
;                  destination is never replaced by a partial backup.
; 相關函式 .......: _UI_DbBackupBegin, _UI_DbBackupStep
; 範例 .......: Yes
; ===============================================================================================================================
Func _UI_DbBackupFinish($iBackup)
    Local $vAuiForwardResult = __AUI_Call("int", "_UI_DbBackupFinish", "uint64", $iBackup)
    Return SetError(@error, @extended, $vAuiForwardResult)
EndFunc

; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_DbBackup
; 說明 ...: Creates a consistent backup of the main database in the target file.
; 語法 ........: _UI_DbBackup( $iDatabase, $sDestinationPath )
; 參數 ....: $iDatabase - Source database connection ID
;                  $sDestinationPath - Target database file path
; 傳回值 .: Success 1, Failure 0
; 作者 ........: Fanxing
; 備註 .......: A backup cannot begin while the source connection has an active transaction. The backup first writes a
;                  separate temporary file in the destination directory and atomically replaces the destination only after
;                  complete success. Cancellation, failure, or publish failure removes the temporary file and preserves the
;                  original destination. Use the incremental backup functions for progress or retry control.
; 相關函式 .......: _UI_DbBackupBegin, _UI_DbBackupStep, _UI_DbBackupFinish
; 範例 .......: Yes
; ===============================================================================================================================
Func _UI_DbBackup($iDatabase, $sDestinationPath)
    Local $vAuiForwardResult = __AUI_Call("int", "_UI_DbBackup", "uint64", $iDatabase, "wstr", $sDestinationPath)
    Return SetError(@error, @extended, $vAuiForwardResult)
EndFunc

; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_DbQueryRow
; 說明 ...: Prepares a query, optionally binds values, reads its first row, and always finalizes the statement.
; 語法 ........: _UI_DbQueryRow( $iDatabase, $sSql, ByRef $aRow [, $aParameters = Default] )
; 參數 ....: $iDatabase - Database connection ID
;                  $sSql - One query statement
;                  $aRow - [Output] Receives a typed one-dimensional row for ROW or an empty array when no row exists
;                  $aParameters - [Optional] One-dimensional array matching all statement parameters. Default omits parameter
;                  binding; pass SQL NULL as a Null element inside the array
; 傳回值 .: Returns $AUI_DB_ROW when a row exists, $AUI_DB_DONE when no row exists, or -1 on failure and sets @error
; 作者 ........: Fanxing
; 備註 .......: The output array is committed only after query preparation, row retrieval, and statement finalization all
;                  succeed; it remains unchanged on failure.
; 相關函式 .......: _UI_DbQueryValue, _UI_DbQueryAll
; 範例 .......: Yes
; ===============================================================================================================================
Func _UI_DbQueryRow($iDatabase, $sSql, ByRef $aRow, $aParameters = Default)
    Local $iResolvedError, $iResolvedExtended   ; 修正：原本只在某個分支內宣告，其他分支執行時會出現「變數未宣告」
    Local $iStatement = _UI_DbPrepare($iDatabase, $sSql)
    Local $iPrepareError = @error, $iPrepareExtended = @extended
    If Not $iStatement Then
        $iResolvedError = __AUI_DbResolveFailure($iPrepareError, $iPrepareExtended)
        $iResolvedExtended = @extended
        Return SetError($iResolvedError, $iResolvedExtended, -1)
    EndIf
    If IsKeyword($aParameters) And Not __AUI_DbParametersOmitted($aParameters) Then
        _UI_DbFinalize($iStatement)
        $g_iAuiUdfErrorCode = $AUI_ERR_INVALID_ARGUMENT
        Return SetError($g_iAuiUdfErrorCode, 0, -1)
    EndIf
    If Not __AUI_DbParametersOmitted($aParameters) Then
        If Not _UI_DbBindValues($iStatement, $aParameters) Then
            Local $iBindError = @error
            Local $iBindExtended = @extended
            _UI_DbFinalize($iStatement)
            Return SetError($iBindError, $iBindExtended, -1)
        EndIf
    EndIf
    Local $aResultRow
    Local $iResult = _UI_DbFetchRow($iStatement, $aResultRow)
    Local $iFetchError = @error
    Local $iFetchExtended = @extended
    If $iResult = -1 Then
        _UI_DbFinalize($iStatement)
        Return SetError($iFetchError, $iFetchExtended, -1)
    EndIf
    Local $iFinalized = _UI_DbFinalize($iStatement)
    Local $iFinalizeError = @error, $iFinalizeExtended = @extended
    If Not $iFinalized Then
        $iResolvedError = __AUI_DbResolveFailure($iFinalizeError, $iFinalizeExtended)
        $iResolvedExtended = @extended
        Return SetError($iResolvedError, $iResolvedExtended, -1)
    EndIf
    $aRow = $aResultRow
    Return SetError(0, 0, $iResult)
EndFunc

; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_DbQueryValue
; 說明 ...: Executes a query and returns the first column of the first row.
; 語法 ........: _UI_DbQueryValue( $iDatabase, $sSql [, $aParameters = Default [, $vDefault = Null]] )
; 參數 ....: $iDatabase - Database connection ID
;                  $sSql - One query statement
;                  $aParameters - [Optional] One-dimensional array matching all statement parameters. Default omits parameter
;                  binding; pass SQL NULL as a Null element inside the array
;                  $vDefault - [Optional] Value returned when the query produces no row
; 傳回值 .: Returns the typed column value with @extended=1 when a row exists, or the default value with @extended=0 when
;                  no row exists; failure sets @error.
; 作者 ........: Fanxing
; 相關函式 .......: _UI_DbQueryRow
; 範例 .......: Yes
; ===============================================================================================================================
Func _UI_DbQueryValue($iDatabase, $sSql, $aParameters = Default, $vDefault = Null)
    Local $aRow
    Local $iResult = _UI_DbQueryRow($iDatabase, $sSql, $aRow, $aParameters)
    If $iResult = -1 Then Return SetError(@error, @extended, $vDefault)
    If $iResult = $AUI_DB_DONE Then Return SetError(0, 0, $vDefault)
    If UBound($aRow) = 0 Then
        $g_iAuiUdfErrorCode = $AUI_ERR_DATABASE
        Return SetError($g_iAuiUdfErrorCode, 0, $vDefault)
    EndIf
    Return SetError(0, 1, $aRow[0])
EndFunc

; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_DbQueryAll
; 說明 ...: Executes a query and materializes its complete result as a typed two-dimensional array.
; 語法 ........: _UI_DbQueryAll( $iDatabase, $sSql, ByRef $aRows, ByRef $aColumns [, $aParameters = Default [, $iMaxRows =
;                  $AUI_DB_QUERY_MAX_ROWS]] )
; 參數 ....: $iDatabase - Database connection ID
;                  $sSql - One query statement
;                  $aRows - [Output] Receives the row-by-column two-dimensional array on success
;                  $aColumns - [Output] Receives the one-dimensional column-name array on success
;                  $aParameters - [Optional] One-dimensional array matching all statement parameters. Default omits parameter
;                  binding; pass SQL NULL as a Null element inside the array
;                  $iMaxRows - [Optional] Maximum rows allowed for this call, from 1 through 100,000
; 傳回值 .: Success - The row count; Failure - -1 and sets @error without modifying either output array
; 作者 ........: Fanxing
; 備註 .......: One call materializes at most 100,000 rows, 1,000,000 cells, and 64 MiB of user payload. This budget excludes
;                  AutoIt Variant, array-descriptor, and temporary-structure overhead. Stream larger results with Prepare and
;                  FetchRow.
; 相關函式 .......: _UI_DbFetchRow, _UI_DbQueryRow
; 範例 .......: Yes
; ===============================================================================================================================
Func _UI_DbQueryAll($iDatabase, $sSql, ByRef $aRows, ByRef $aColumns, $aParameters = Default, $iMaxRows = $AUI_DB_QUERY_MAX_ROWS)
    Local $iResolvedError, $iResolvedExtended   ; 修正：原本只在某個分支內宣告，其他分支執行時會出現「變數未宣告」
    If Not __AUI_IsIntegerVariant($iMaxRows) Or $iMaxRows < 1 Or $iMaxRows > $AUI_DB_QUERY_MAX_ROWS Then
        $g_iAuiUdfErrorCode = $AUI_ERR_OUT_OF_RANGE
        Return SetError($g_iAuiUdfErrorCode, 0, -1)
    EndIf
    Local $iStatement = _UI_DbPrepare($iDatabase, $sSql)
    Local $iPrepareError = @error, $iPrepareExtended = @extended
    If Not $iStatement Then
        $iResolvedError = __AUI_DbResolveFailure($iPrepareError, $iPrepareExtended)
        $iResolvedExtended = @extended
        Return SetError($iResolvedError, $iResolvedExtended, -1)
    EndIf
    If IsKeyword($aParameters) And Not __AUI_DbParametersOmitted($aParameters) Then
        _UI_DbFinalize($iStatement)
        $g_iAuiUdfErrorCode = $AUI_ERR_INVALID_ARGUMENT
        Return SetError($g_iAuiUdfErrorCode, 0, -1)
    EndIf
    If Not __AUI_DbParametersOmitted($aParameters) Then
        If Not _UI_DbBindValues($iStatement, $aParameters) Then
            Local $iBindError = @error
            Local $iBindExtended = @extended
            _UI_DbFinalize($iStatement)
            Return SetError($iBindError, $iBindExtended, -1)
        EndIf
    EndIf
    Local $aResultColumns
    Local $iColumnCount = _UI_DbFetchColumnNames($iStatement, $aResultColumns)
    If $iColumnCount <= 0 Then
        Local $iColumnError = @error
        _UI_DbFinalize($iStatement)
        Return SetError($iColumnError ? $iColumnError : $AUI_ERR_INVALID_ARGUMENT, 0, -1)
    EndIf
    Local $iCapacity = 64
    If $iCapacity > $iMaxRows Then $iCapacity = $iMaxRows
    Local $aResultRows[$iCapacity][$iColumnCount]
    Local $iRowCount = 0
    Local $iPayloadBytes = 0
    While True
        Local $iStep = _UI_DbStep($iStatement)
        If $iStep = $AUI_DB_DONE Then ExitLoop
        If $iStep <> $AUI_DB_ROW Then
            Local $iFetchError = @error
            Local $iFetchExtended = @extended
            _UI_DbFinalize($iStatement)
            Return SetError($iFetchError, $iFetchExtended, -1)
        EndIf
        If $iRowCount >= $iMaxRows Or ($iRowCount + 1) * $iColumnCount > $AUI_DB_QUERY_MAX_CELLS Then
            _UI_DbFinalize($iStatement)
            $g_iAuiUdfErrorCode = $AUI_ERR_LIMIT_EXCEEDED
            Return SetError($g_iAuiUdfErrorCode, $iRowCount, -1)
        EndIf
        If $iRowCount >= $iCapacity Then
            Local $iNewCapacity = $iCapacity * 2
            If $iNewCapacity > $iMaxRows Then $iNewCapacity = $iMaxRows
            Local $iCellCapacity = Int($AUI_DB_QUERY_MAX_CELLS / $iColumnCount)
            If $iNewCapacity > $iCellCapacity Then $iNewCapacity = $iCellCapacity
            If $iNewCapacity <= $iCapacity Then
                _UI_DbFinalize($iStatement)
                $g_iAuiUdfErrorCode = $AUI_ERR_LIMIT_EXCEEDED
                Return SetError($g_iAuiUdfErrorCode, $iRowCount, -1)
            EndIf
            ReDim $aResultRows[$iNewCapacity][$iColumnCount]
            $iCapacity = $iNewCapacity
        EndIf
        Local $aRow[$iColumnCount]
        Local $iRowPayloadBytes = 0
        For $iColumn = 0 To $iColumnCount - 1
            $aRow[$iColumn] = _UI_DbColumnValue($iStatement, $iColumn)
            If @error Then
                Local $iColumnReadError = @error
                _UI_DbFinalize($iStatement)
                Return SetError($iColumnReadError, $iColumn, -1)
            EndIf
            $iRowPayloadBytes += __AUI_DbValueBytes($aRow[$iColumn])
            If $iPayloadBytes + $iRowPayloadBytes > $AUI_DB_QUERY_MAX_BYTES Then
                _UI_DbFinalize($iStatement)
                $g_iAuiUdfErrorCode = $AUI_ERR_LIMIT_EXCEEDED
                Return SetError($g_iAuiUdfErrorCode, $iRowCount, -1)
            EndIf
        Next
        For $iColumn = 0 To $iColumnCount - 1
            $aResultRows[$iRowCount][$iColumn] = $aRow[$iColumn]
        Next
        $iPayloadBytes += $iRowPayloadBytes
        $iRowCount += 1
    WEnd
    Local $iFinalized = _UI_DbFinalize($iStatement)
    Local $iFinalizeError = @error, $iFinalizeExtended = @extended
    If Not $iFinalized Then
        $iResolvedError = __AUI_DbResolveFailure($iFinalizeError, $iFinalizeExtended)
        $iResolvedExtended = @extended
        Return SetError($iResolvedError, $iResolvedExtended, -1)
    EndIf
    ReDim $aResultRows[$iRowCount][$iColumnCount]
    $aRows = $aResultRows
    $aColumns = $aResultColumns
    Return SetError(0, 0, $iRowCount)
EndFunc

