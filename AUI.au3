; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_CheckboxGetChecked
; 說明 ...: Retrieves the checked status of a checkbox.
; 語法 ........: _UI_CheckboxGetChecked( $hWnd, $iCheckbox )
; 參數 ....: $hWnd - Window handle returned by _UI_WindowCreate
;                  $iCheckbox - Checkbox control ID
; 傳回值 .: Success - 1 means checked, 0 means unchecked
;                  Failure - 0; call _UI_GetLastError to identify the failure
; 作者 ........: Fanxing
; 相關函式 .......: _UI_CheckboxSetChecked
; 範例 .......: Yes
; ===============================================================================================================================
Func _UI_CheckboxGetChecked($hWnd, $iCheckbox)
    Local $vAuiForwardResult = __AUI_Call("int", "_UI_CheckboxGetChecked", "hwnd", $hWnd, "int", $iCheckbox)
    Return SetError(@error, @extended, $vAuiForwardResult)
EndFunc

; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_CheckboxSetState
; 說明 ...: Sets the three-state value of the checkbox.
; 語法 ........: _UI_CheckboxSetState( $hWnd, $iCheckbox, $iState )
; 參數 ....: $hWnd - Window handle returned by _UI_WindowCreate
;                  $iCheckbox - Checkbox control ID
;                  $iState - $AUI_CHECK_UNCHECKED, $AUI_CHECK_CHECKED or $AUI_CHECK_MIXED
; 傳回值 .: Success - 1
;                  Failure - 0
; 作者 ........: Fanxing
; 備註 .......: This function silently updates the state; the uncertain state is displayed with a horizontal line in the box.
; 相關函式 .......: _UI_CheckboxGetState, _UI_CheckboxSetThreeState
; 範例 .......: Yes
; ===============================================================================================================================
Func _UI_CheckboxSetState($hWnd, $iCheckbox, $iState)
    Local $vAuiForwardResult = __AUI_Call("int", "_UI_CheckboxSetState", "hwnd", $hWnd, "int", $iCheckbox, "int", $iState)
    Return SetError(@error, @extended, $vAuiForwardResult)
EndFunc

; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_CheckboxGetState
; 說明 ...: Queries the three-state value of the check box.
; 語法 ........: _UI_CheckboxGetState( $hWnd, $iCheckbox )
; 參數 ....: $hWnd - Window handle returned by _UI_WindowCreate
;                  $iCheckbox - Checkbox control ID
; 傳回值 .: Success - $AUI_CHECK_UNCHECKED, $AUI_CHECK_CHECKED or $AUI_CHECK_MIXED
;                  Failure - -1
; 作者 ........: Fanxing
; 相關函式 .......: _UI_CheckboxSetState
; 範例 .......: Yes
; ===============================================================================================================================
Func _UI_CheckboxGetState($hWnd, $iCheckbox)
    Local $vAuiForwardResult = __AUI_Call("int", "_UI_CheckboxGetState", "hwnd", $hWnd, "int", $iCheckbox)
    Return SetError(@error, @extended, $vAuiForwardResult)
EndFunc

; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_CheckboxSetThreeState
; 說明 ...: Sets whether the user operation loops through the indeterminate state.
; 語法 ........: _UI_CheckboxSetThreeState( $hWnd, $iCheckbox, $bEnable )
; 參數 ....: $hWnd - Window handle returned by _UI_WindowCreate
;                  $iCheckbox - Checkbox control ID
;                  $bEnable - True = unselected→selected→uncertain cycle, False = ordinary two-state switching
; 傳回值 .: Success - 1
;                  Failure - 0
; 作者 ........: Fanxing
; 備註 .......: When the tri-state loop is closed, the current indeterminate state is classified as unselected.
; 相關函式 .......: _UI_CheckboxGetThreeState, _UI_CheckboxSetState
; 範例 .......: Yes
; ===============================================================================================================================
Func _UI_CheckboxSetThreeState($hWnd, $iCheckbox, $bEnable)
    Local $vAuiForwardResult = __AUI_Call("int", "_UI_CheckboxSetThreeState", "hwnd", $hWnd, "int", $iCheckbox, "int", $bEnable ? 1 : 0)
    Return SetError(@error, @extended, $vAuiForwardResult)
EndFunc

; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_CheckboxGetThreeState
; 說明 ...: Queries whether user operation enables tri-state loop.
; 語法 ........: _UI_CheckboxGetThreeState( $hWnd, $iCheckbox )
; 參數 ....: $hWnd - Window handle returned by _UI_WindowCreate
;                  $iCheckbox - Checkbox control ID
; 傳回值 .: Success - 1 = three-state cycle, 0 = ordinary two-state
;                  Failure - 0, and set the error code
; 作者 ........: Fanxing
; 相關函式 .......: _UI_CheckboxSetThreeState
; 範例 .......: Yes
; ===============================================================================================================================
Func _UI_CheckboxGetThreeState($hWnd, $iCheckbox)
    Local $vAuiForwardResult = __AUI_Call("int", "_UI_CheckboxGetThreeState", "hwnd", $hWnd, "int", $iCheckbox)
    Return SetError(@error, @extended, $vAuiForwardResult)
EndFunc
; ────────────────────────────────────────────────────────────────────────────
;  Radio
; ────────────────────────────────────────────────────────────────────────────
; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_Radio
; 說明 ...: Creates a radio group (Options | Separated, can be arranged horizontally).
; 語法 ........: _UI_Radio( $hWnd, $iParent, $sOptions [, $iSelected = 0 [, $iX = 0 [, $iY = 0 [, $iW = 0 [, $iH = 0 [,
;                  $bHorizontal = False]]]]]] )
; 參數 ....: $hWnd - Window handle returned by _UI_WindowCreate
;                  $iParent - Parent element ID; use 0 for the window root
;                  $sOptions - Pipe-delimited option list, for example "A|B|C"
;                  $iSelected - [Optional] Initial selected item index (starting from 0), default 0
;                  $iX - [Optional] Logical X coordinate (relative to parent container; ignored in flexible containers such as
;                  Row/Column), default 0
;                  $iY - [Optional] Logical Y coordinate (relative to parent container; ignored in flexible containers), default
;                  0
;                  $iW - [Optional] Logical width; 0 = automatically determined/filled by layout, default 0
;                  $iH - [Optional] Logical height; 0 = automatically determined/filled by layout, default 0
;                  $bHorizontal - [Optional] Whether to arrange horizontally (otherwise vertically), default False
; 傳回值 .: Success - New element ID (integer, >= 1)
;                  Failure - 0
; 作者 ........: Fanxing
; 相關函式 .......: _UI_Checkbox, _UI_OnValue
; 範例 .......: Yes
; ===============================================================================================================================
Func _UI_Radio($hWnd, $iParent, $sOptions, $iSelected = 0, $iX = 0, $iY = 0, $iW = 0, $iH = 0, $bHorizontal = False)
    Local $vAuiForwardResult = __AUI_Call("int", "_UI_Radio", _
                       "hwnd", $hWnd, "int", $iParent, "wstr", $sOptions, _
                       "int", $iSelected, _
                       "int", $iX, "int", $iY, "int", $iW, "int", $iH, _
                       "int", $bHorizontal)
    Return SetError(@error, @extended, $vAuiForwardResult)
EndFunc

