; ────────────────────────────────────────────────────────────────────────────
;  Dialog
; ────────────────────────────────────────────────────────────────────────────
; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_Dialog
; 說明 ...: Creates a non-blocking modal overlay (buttons separated by |); returns the dialog element ID.
; 語法 ........: _UI_Dialog( $hWnd, $sTitle, $sBody [, $sButtons = ""] )
; 參數 ....: $hWnd - Window handle returned by _UI_WindowCreate
;                  $sTitle - Title text
;                  $sBody - Text content
;                  $sButtons - [Optional] Button text, separated by vertical bars "|"; empty by default, in which case the
;                  window-locale "Cancel/OK" is shown; at most 8 buttons, and creation is rejected when the string is empty or
;                  has more than 8
; 傳回值 .: Success - Dialog element ID; use _UI_OnValue to bind the result callback, and the callback value is the
;                  button index (starting from 0)
; 作者 ........: Fanxing
; 備註 .......: A dialog shows at most 8 buttons; creation fails with the error code set when the button text is invalid
;                  (empty or more than 8 buttons).
; 相關函式 .......: _UI_MessageBox
; 範例 .......: Yes
; ===============================================================================================================================
Func _UI_Dialog($hWnd, $sTitle, $sBody, $sButtons = "")
    Local $vAuiForwardResult = __AUI_Call("int", "_UI_Dialog", _
                       "hwnd", $hWnd, "wstr", $sTitle, "wstr", $sBody, "wstr", $sButtons)
    Return SetError(@error, @extended, $vAuiForwardResult)
EndFunc

