; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_RegisterHotkey
; 說明 ...: Registers a window-level hotkey (effective only while this window is focused; not a system-wide hotkey).
; 語法 ........: _UI_RegisterHotkey( $hWnd, $iMods, $iVk, $sFunc )
; 參數 ....: $hWnd - Window handle returned by _UI_WindowCreate
;                  $iMods - Modification key mask: 1=Shift 2=Ctrl 4=Alt (can be added)
;                  $iVk - Virtual key code (such as 0x41=A)
;                  $sFunc - Callback function name; empty string cancels the combination
; 傳回值 .: Success - 1
;                  Failure - 0; the callback name is invalid, callback registration failed, or the native call failed
; 作者 ........: Fanxing
; 備註 .......: Unlike the system-level RegisterHotKey, this does not fire while the window is unfocused; keys are first
;                  matched against registered combinations, and unmatched keys fall through to the normal _UI_OnKey dispatch.
; 相關函式 .......: _UI_OnKey
; 範例 .......: Yes
; ===============================================================================================================================
Func _UI_RegisterHotkey($hWnd, $iMods, $iVk, $sFunc)
    If __AUI_ValidateOptionalCallback($sFunc) = 0 Then Return SetError(@error, 0, 0)
    If $sFunc <> "" And $g_pAuiDispHotkey = 0 Then $g_pAuiDispHotkey = __AUI_RegisterCallback("__AUI_DispHotkey", "hwnd;int;int")
    If $sFunc <> "" And $g_pAuiDispHotkey = 0 Then Return SetError(@error, 0, 0)
    Local $sKey = $iVk & ":" & $iMods
    Local $sOldFunc = __AUI_CbGet($__AUI_CB_HOTKEY, $sKey, $hWnd)
    If __AUI_CbSet($__AUI_CB_HOTKEY, $sKey, $sFunc, $hWnd) = 0 Then Return SetError(@error, 0, 0)
    Local $pCallback = $sFunc = "" ? 0 : $g_pAuiDispHotkey
    Local $iResult = __AUI_Call("int", "_UI_RegisterHotkey", _
                                "hwnd", $hWnd, "int", $iMods, "int", $iVk, "ptr", $pCallback)
    Local $iCallError = @error
    If $iCallError Or $iResult = 0 Then
        __AUI_CbSet($__AUI_CB_HOTKEY, $sKey, $sOldFunc, $hWnd)
        Return SetError($iCallError, 0, 0)
    EndIf
    Return SetError(0, 0, 1)
EndFunc
; ────────────────────────────────────────────────────────────────────────────
;  通用元素操作
; ────────────────────────────────────────────────────────────────────────────
; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_SetText
; 說明 ...: Sets element text.
; 語法 ........: _UI_SetText( $hWnd, $iId, $sText )
; 參數 ....: $hWnd - Window handle returned by _UI_WindowCreate
;                  $iId - Target element ID
;                  $sText - Text content
; 傳回值 .: Success - 1
;                  Failure - 0; The parameter is invalid or any panel display status setting fails, and @error is set.
; 作者 ........: Fanxing
; 備註 .......: Controls that support the UI Automation Text pattern also raise text-changed events. PasswordInput does not
;                  expose plaintext.
; 相關函式 .......: _UI_GetText
; 範例 .......: Yes
; ===============================================================================================================================
Func _UI_SetText($hWnd, $iId, $sText)
    Local $vAuiForwardResult = __AUI_Call("int", "_UI_SetText", "hwnd", $hWnd, "int", $iId, "wstr", $sText)
    Return SetError(@error, @extended, $vAuiForwardResult)
EndFunc

; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_GetText
; 說明 ...: Retrieves element text.
; 語法 ........: _UI_GetText( $hWnd, $iId [, $iBufSize = 0] )
; 參數 ....: $hWnd - Window handle returned by _UI_WindowCreate
;                  $iId - Target element ID
;                  $iBufSize - [Optional] Minimum number of characters in the receive buffer; when the default is 0, it is
;                  automatically allocated according to the actual length.
; 傳回值 .: Success - The element's current text; different controls return its editable content, label, or display value
;                  Failure - ""
; 作者 ........: Fanxing
; 相關函式 .......: _UI_SetText
; 範例 .......: Yes
; ===============================================================================================================================
Func _UI_GetText($hWnd, $iId, $iBufSize = 0)
    Local $vAuiHelperResult = __AUI_ReadElementText("_UI_GetText", $hWnd, $iId, $iBufSize)
    Return SetError(@error, @extended, $vAuiHelperResult)
EndFunc

; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_SetBounds
; 說明 ...: Sets element position and size.
; 語法 ........: _UI_SetBounds( $hWnd, $iId, $iX, $iY, $iW, $iH )
; 參數 ....: $hWnd - Window handle returned by _UI_WindowCreate
;                  $iId - Target element ID
;                  $iX - Logical X coordinate (relative to parent container; ignored within flex containers such as Row/Column)
;                  $iY - Logical Y coordinate (relative to parent container; ignored within flex containers)
;                  $iW - Logical width; 0 = automatically determined/filled by layout
;                  $iH - Logical height; 0 = automatically determined/filled by layout
; 傳回值 .: Success - 1
;                  Failure - 0; width and height cannot be negative numbers
; 作者 ........: Fanxing
; 相關函式 .......: _UI_GetBounds
; 範例 .......: Yes
; ===============================================================================================================================
Func _UI_SetBounds($hWnd, $iId, $iX, $iY, $iW, $iH)
    Local $vAuiForwardResult = __AUI_Call("int", "_UI_SetBounds", _
               "hwnd", $hWnd, "int", $iId, _
               "int", $iX, "int", $iY, "int", $iW, "int", $iH)
    Return SetError(@error, @extended, $vAuiForwardResult)
EndFunc

; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_GetBounds
; 說明 ...: Retrieves an element's position and size as [x, y, w, h].
; 語法 ........: _UI_GetBounds( $hWnd, $iId )
; 參數 ....: $hWnd - Window handle returned by _UI_WindowCreate
;                  $iId - Target element ID
; 傳回值 .: Success - Four-element array [$iX, $iY, $iWidth, $iHeight], unit is logical pixel
;                  Failure - 0
; 作者 ........: Fanxing
; 相關函式 .......: _UI_SetBounds
; 範例 .......: Yes
; ===============================================================================================================================
Func _UI_GetBounds($hWnd, $iId)
    If __AUI_EnsureDll() = 0 Then Return SetError($g_iAuiLoadError, 0, 0)
    Local $tX = DllStructCreate("int"), $tY = DllStructCreate("int")
    Local $tW = DllStructCreate("int"), $tH = DllStructCreate("int")
    Local $aCall = __AUI_DllCall("int", "_UI_GetBounds", _
            "hwnd", $hWnd, "int", $iId, _
            "ptr", DllStructGetPtr($tX), "ptr", DllStructGetPtr($tY), _
            "ptr", DllStructGetPtr($tW), "ptr", DllStructGetPtr($tH))
    Local $iErr = @error
    If $iErr Or Not IsArray($aCall) Then Return SetError($iErr, 0, 0)
    If $aCall[0] = 0 Then Return SetError(__AUI_ReadNativeLastError(), 0, 0)
    Local $a[4] = [ DllStructGetData($tX, 1), DllStructGetData($tY, 1), _
                    DllStructGetData($tW, 1), DllStructGetData($tH, 1) ]
    Return $a
EndFunc

