; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_TabsRemoveItem
; 說明 ...: Deletes the specified tag.
; 語法 ........: _UI_TabsRemoveItem( $hWnd, $iTabs, $iIndex )
; 參數 ....: $hWnd - Window handle returned by _UI_WindowCreate
;                  $iTabs - Tabs control ID
;                  $iIndex - Tab index to delete
; 傳回值 .: Success - 1
;                  Failure - 0
; 作者 ........: Fanxing
; 備註 .......: After deleting the current item, the next item at the original position will be selected first; if there is
;                  no next item, the previous item will be selected.
; 範例 .......: Yes
; ===============================================================================================================================
Func _UI_TabsRemoveItem($hWnd, $iTabs, $iIndex)
    Local $vAuiForwardResult = __AUI_Call("int", "_UI_TabsRemoveItem", "hwnd", $hWnd, "int", $iTabs, "int", $iIndex)
    Return SetError(@error, @extended, $vAuiForwardResult)
EndFunc

