; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_SliderOnCommit
; 說明 ...: Registers Slider user submission callback Func($id, $iValue). OnValue can be previewed continuously during
;                  the mouse dragging process. This callback is only triggered once when the mouse is released; it is triggered
;                  once every time the keyboard effectively changes the value.
; 語法 ........: _UI_SliderOnCommit( $hWnd, $iId, $sFuncName )
; 參數 ....: $hWnd - Window handle returned by _UI_WindowCreate
;                  $iId - Slider element ID
;                  $sFuncName - Callback function name; empty string to cancel registration
; 傳回值 .: Success - 1
;                  Failure - 0; the callback name is invalid, callback registration failed, or the native call failed
; 作者 ........: Fanxing
; 備註 .......: _UI_SliderSetValue, SetRange and SetStep all remain silent and do not trigger this callback.
; 相關函式 .......: _UI_OnValue, _UI_SliderSetValue
; 範例 .......: Yes
; ===============================================================================================================================
Func _UI_SliderOnCommit($hWnd, $iId, $sFuncName)
    If __AUI_ValidateOptionalCallback($sFuncName) = 0 Then Return SetError(@error, 0, 0)
    If $sFuncName <> "" And $g_pAuiDispSliderCommit = 0 Then $g_pAuiDispSliderCommit = __AUI_RegisterCallback("__AUI_DispSliderCommit", "hwnd;int;int")
    If $sFuncName <> "" And $g_pAuiDispSliderCommit = 0 Then Return SetError($AUI_UDF_ERR_CALLBACK_REGISTER, 0, 0)
    Local $sOldFunc = __AUI_CbGet($__AUI_CB_SLIDER_COMMIT, $iId, $hWnd)
    If __AUI_CbSet($__AUI_CB_SLIDER_COMMIT, $iId, $sFuncName, $hWnd) = 0 Then Return SetError($AUI_UDF_ERR_INVALID_CALLBACK, 0, 0)
    Local $pCallback = $sFuncName = "" ? 0 : $g_pAuiDispSliderCommit
    Local $iResult = __AUI_Call("int", "_UI_SliderOnCommit", "hwnd", $hWnd, "int", $iId, "ptr", $pCallback)
    Local $iCallError = @error
    If $iCallError Or $iResult = 0 Then
        __AUI_CbSet($__AUI_CB_SLIDER_COMMIT, $iId, $sOldFunc, $hWnd)
        Return SetError($iCallError, 0, 0)
    EndIf
    Return SetError(0, 0, 1)
EndFunc
