; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_SetPadding
; 說明 ...: Sets the padding of the element; give only one value to indicate that the four sides are the same.
; 語法 ........: _UI_SetPadding( $hWnd, $iId, $iLeft [, $iTop = -1 [, $iRight = -1 [, $iBottom = -1]]] )
; 參數 ....: $hWnd - Window handle returned by _UI_WindowCreate
;                  $iId - Target element ID
;                  $iLeft - Left margin
;                  $iTop - [optional] top margin, default -1
;                  $iRight - [optional] right margin, default -1
;                  $iBottom - [optional] bottom margin, default -1
; 傳回值 .: Success - 1
;                  Failure - 0; margin cannot be negative
; 作者 ........: Fanxing
; 相關函式 .......: _UI_SetMargin, _UI_SetGap
; 範例 .......: Yes
; ===============================================================================================================================
Func _UI_SetPadding($hWnd, $iId, $iLeft, $iTop = -1, $iRight = -1, $iBottom = -1)
    If $iTop = -1 Then
        $iTop = $iLeft
        $iRight = $iLeft
        $iBottom = $iLeft
    EndIf
    Local $vAuiForwardResult = __AUI_Call("int", "_UI_SetPadding", _
               "hwnd", $hWnd, "int", $iId, _
               "int", $iLeft, "int", $iTop, "int", $iRight, "int", $iBottom)
    Return SetError(@error, @extended, $vAuiForwardResult)
EndFunc

