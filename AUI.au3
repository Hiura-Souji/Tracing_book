; ===============================================================================================================================
Func _UI_JsonArrayInsert($iJson, $sPointer, $iIndex, $vValue)
    Local $sJson = _UI_JsonFromAutoIt($vValue)
    Local $iError = @error, $iExtended = @extended
    If $iError Then Return SetError($iError, $iExtended, 0)
    Local $iResult = _UI_JsonArrayInsertRaw($iJson, $sPointer, $iIndex, $sJson)
    Return SetError(@error, @extended, $iResult)
EndFunc

; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_JsonClear
; 說明 ...: Removes every member from the selected object or every element from the selected array.
; 語法 ........: _UI_JsonClear( $iJson [, $sPointer = ""] )
; 參數 ....: $iJson - Document handle; borrowed child handles are not accepted
;                  $sPointer - [Optional] RFC 6901 JSON Pointer; an empty string selects the document root
; 傳回值 .: Success - 1
;                  Failure - 0 and set @error
; 作者 ........: Fanxing
; 備註 .......: The selected value must be an object or array. All existing borrowed child handles are invalidated after
;                  success.
; 相關函式 .......: _UI_JsonRemove, _UI_JsonSet
; 範例 .......: No
; ===============================================================================================================================
Func _UI_JsonClear($iJson, $sPointer = "")
    Local $vAuiForwardResult = __AUI_Call("int", "_UI_JsonClear", "int", $iJson, "wstr", $sPointer)
    Return SetError(@error, @extended, $vAuiForwardResult)
EndFunc

Func __AUI_JsonScalar($iJson, $iType)
    Switch $iType
        Case $AUI_JSON_NULL
            Return SetError(0, 0, Null)
        Case $AUI_JSON_BOOL
            Local $vBool = _UI_JsonGetBool($iJson)
            If @error Then Return SetError(@error, 0, 0)
            Return SetError(0, 0, $vBool)
        Case $AUI_JSON_INT
            Local $vInt = _UI_JsonGetInt64($iJson)
            If @error Then Return SetError(@error, 0, 0)
            Return SetError(0, 0, $vInt)
        Case $AUI_JSON_DOUBLE
            Local $vDbl = _UI_JsonGetDouble($iJson)
            If @error Then Return SetError(@error, 0, 0)
            Return SetError(0, 0, $vDbl)
        Case $AUI_JSON_STRING
            Local $vStr = _UI_JsonGetString($iJson)
            If @error Then Return SetError(@error, 0, 0)
            Return SetError(0, 0, $vStr)
    EndSwitch
    $g_iAuiUdfErrorCode = $AUI_ERR_WRONG_ELEMENT_TYPE
    Return SetError($g_iAuiUdfErrorCode, 0, 0)
EndFunc

Func __AUI_JsonHandleToAutoIt($iJson)
    Local $iRootType = _UI_JsonType($iJson)
    If @error Then
        Local $iRootError = @error
        Return SetError($iRootError, 0, 0)
    EndIf

    If $iRootType <> $AUI_JSON_ARRAY And $iRootType <> $AUI_JSON_OBJECT Then
        Local $vScalarRoot = __AUI_JsonScalar($iJson, $iRootType)
        Local $iScalarError = @error
        If $iScalarError Then Return SetError($iScalarError, 0, 0)
        Return SetError(0, 0, $vScalarRoot)
    EndIf

    Local $vResult = 0
    Local $vRootContainer
    Local $iRootCount = _UI_JsonCount($iJson)
    If @error Then
        Local $iCountError = @error
        Return SetError($iCountError, 0, 0)
    EndIf
    If $iRootType = $AUI_JSON_ARRAY Then
        Local $aRoot[$iRootCount]
        $vRootContainer = $aRoot
    Else
        Local $mRoot[]
        $vRootContainer = $mRoot
    EndIf

    Local $aStack[1]
    Local $aRootFrame[6] = [$iJson, $iRootType, $vRootContainer, 0, $iRootCount, 1]
    $aStack[0] = $aRootFrame
    Local $iNodes = 1
    Local $iFail = 0
    Local $iActiveToken = $iJson
    Local $iPendingChild = 0

    While UBound($aStack) > 0
        Local $aFrame = $aStack[UBound($aStack) - 1]
        ReDim $aStack[UBound($aStack) - 1]
        Local $iToken = $aFrame[0], $iKind = $aFrame[1], $vOut = $aFrame[2]
        Local $iIdx = $aFrame[3], $iTotal = $aFrame[4], $iDepth = $aFrame[5]
        $iActiveToken = $iToken

        If $iIdx >= $iTotal Then
            If UBound($aStack) = 0 Then
                $vResult = $vOut
                ExitLoop
            EndIf
            Local $aParent = $aStack[UBound($aStack) - 1]
            If $aParent[1] = $AUI_JSON_ARRAY Then
                Local $aParentArr = $aParent[2]
                $aParentArr[$aParent[3]] = $vOut
                $aParent[2] = $aParentArr
            Else
                Local $mParentObj = $aParent[2]
                Local $sParentKey = _UI_JsonKeyName($aParent[0], "", $aParent[3])
                If @error Then
                    $iFail = @error
                    ExitLoop
                EndIf
                $mParentObj[$sParentKey] = $vOut
                $aParent[2] = $mParentObj
            EndIf
            $aParent[3] = $aParent[3] + 1
            $aStack[UBound($aStack) - 1] = $aParent
            If $iToken <> $iJson Then _UI_JsonFree($iToken)
            $iActiveToken = $iJson
            ContinueLoop
        EndIf

        $iNodes += 1
        If $iNodes > $__AUI_JSON_MAX_NODES Then
            $iFail = $AUI_ERR_LIMIT_EXCEEDED
            ExitLoop
        EndIf
        Local $iChild = _UI_JsonChild($iToken, "", $iIdx)
        If $iChild = 0 Then
            $iFail = @error
            ExitLoop
        EndIf
        $iPendingChild = $iChild
        Local $iChildType = _UI_JsonType($iChild)
        If @error Then
            $iFail = @error
            ExitLoop
        EndIf

        If $iChildType = $AUI_JSON_ARRAY Or $iChildType = $AUI_JSON_OBJECT Then
            If $iDepth >= $__AUI_JSON_MAX_DEPTH Then
                $iFail = $AUI_ERR_LIMIT_EXCEEDED
                ExitLoop
            EndIf
            Local $iChildCount = _UI_JsonCount($iChild)
            If @error Then
                $iFail = @error
                ExitLoop
            EndIf
            Local $vChildContainer
            If $iChildType = $AUI_JSON_ARRAY Then
                Local $aChild[$iChildCount]
                $vChildContainer = $aChild
            Else
                Local $mChild[]
                $vChildContainer = $mChild
            EndIf
            ReDim $aStack[UBound($aStack) + 1]
            $aStack[UBound($aStack) - 1] = $aFrame
            Local $aChildFrame[6] = [$iChild, $iChildType, $vChildContainer, 0, $iChildCount, $iDepth + 1]
            ReDim $aStack[UBound($aStack) + 1]
            $aStack[UBound($aStack) - 1] = $aChildFrame
            $iPendingChild = 0
        Else
            Local $vScalar = __AUI_JsonScalar($iChild, $iChildType)
            If @error Then
                $iFail = @error
                ExitLoop
            EndIf
            If $iKind = $AUI_JSON_ARRAY Then
                Local $aArr = $vOut
                $aArr[$iIdx] = $vScalar
                $vOut = $aArr
            Else
                Local $mObj = $vOut
                Local $sKey = _UI_JsonKeyName($iToken, "", $iIdx)
                If @error Then
                    $iFail = @error
                    ExitLoop
                EndIf
                $mObj[$sKey] = $vScalar
                $vOut = $mObj
            EndIf
            _UI_JsonFree($iChild)
            $iPendingChild = 0
            $aFrame[2] = $vOut
            $aFrame[3] = $iIdx + 1
            ReDim $aStack[UBound($aStack) + 1]
            $aStack[UBound($aStack) - 1] = $aFrame
        EndIf
    WEnd

    If $iFail Then
        If $iPendingChild <> 0 Then _UI_JsonFree($iPendingChild)
        If $iActiveToken <> $iJson Then _UI_JsonFree($iActiveToken)
        If UBound($aStack) > 0 Then
            For $iCleanup = 0 To UBound($aStack) - 1
                Local $aCleanupFrame = $aStack[$iCleanup]
                If $aCleanupFrame[0] <> $iJson And $aCleanupFrame[0] <> $iActiveToken Then _UI_JsonFree($aCleanupFrame[0])
            Next
        EndIf
        $g_iAuiUdfErrorCode = $iFail
        Return SetError($iFail, 0, 0)
    EndIf
    Return SetError(0, 0, $vResult)
EndFunc

; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_JsonToAutoIt
; 說明 ...: Converts JSON text to native AutoIt data: objects become Maps, arrays become one-dimensional arrays, integers
;                  become Int64, floating-point numbers become Double, booleans become True/False, and null becomes the Null
;                  keyword. The parse tree remains in the AUI runtime during conversion and is released automatically afterward.
; 語法 ........: _UI_JsonToAutoIt( $sJson )
; 參數 ....: $sJson - JSON text
; 傳回值 .: Success - The native AutoIt structure (Map / array / scalar)
;                  Failure - 0; @error = 12 for invalid JSON syntax, 7 for a number outside the target Int64 or Double range, or
;                  9 for a depth or size limit
; 作者 ........: Fanxing
; 備註 .......: Container nesting is limited to 64 levels and 100,000 nodes per call. A Map stored inside an array element
;                  cannot be subscripted directly as $aArr[0]["key"]; assign it to a variable first. JSON integers must fit
;                  signed Int64, and floating-point tokens must convert to a finite Double. Values outside those native ranges
;                  are rejected with $AUI_ERR_OUT_OF_RANGE but remain available exactly through _UI_JsonParse plus
;                  _UI_JsonGetNumberText. A string containing U+0000 is rejected with $AUI_ERR_LIMIT_EXCEEDED.
; 相關函式 .......: _UI_JsonToAutoItAt, _UI_JsonParse, _UI_JsonFromAutoIt
; 範例 .......: No
; ===============================================================================================================================
Func _UI_JsonToAutoIt($sJson)
    Local $iJson = _UI_JsonParse($sJson)
    Local $iParseError = @error
    If $iJson = 0 Then Return SetError($iParseError, 0, 0)
    Local $vResult = __AUI_JsonHandleToAutoIt($iJson)
    Local $iConvertError = @error, $iConvertExtended = @extended
    _UI_JsonFree($iJson)
    If $iConvertError Then
        $g_iAuiUdfErrorCode = $iConvertError
        Return SetError($g_iAuiUdfErrorCode, $iConvertExtended, 0)
    EndIf
    Return SetError(0, 0, $vResult)
EndFunc

; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_JsonToAutoItAt
; 說明 ...: Converts the subtree selected by an RFC 6901 JSON Pointer directly to native AutoIt data without serializing
;                  the complete document again.
; 語法 ........: _UI_JsonToAutoItAt( $iJson [, $sPointer = ""] )
; 參數 ....: $iJson - Document or borrowed child handle
;                  $sPointer - [Optional] RFC 6901 JSON Pointer; an empty string selects the current handle root
; 傳回值 .: Success - The native AutoIt structure (Map / array / scalar)
;                  Failure - 0 and set @error; @error = $AUI_ERR_OUT_OF_RANGE when a number exceeds the target Int64 or Double
;                  range
; 作者 ........: Fanxing
; 備註 .......: The source document remains open, and the temporary borrowed handle created internally is released before the
;                  function returns. The same conversion limits as _UI_JsonToAutoIt apply. Read an out-of-range or
;                  high-precision number separately with _UI_JsonGetNumberText; it is never converted implicitly with data loss.
; 相關函式 .......: _UI_JsonPointer, _UI_JsonToAutoIt, _UI_JsonFree
; 範例 .......: No
; ===============================================================================================================================
Func _UI_JsonToAutoItAt($iJson, $sPointer = "")
    Local $iChild = _UI_JsonPointer($iJson, $sPointer)
    Local $iPointerError = @error
    If $iChild = 0 Then Return SetError($iPointerError, 0, 0)
    Local $vResult = __AUI_JsonHandleToAutoIt($iChild)
    Local $iConvertError = @error, $iConvertExtended = @extended
    _UI_JsonFree($iChild)
    If $iConvertError Then
        $g_iAuiUdfErrorCode = $iConvertError
        Return SetError($g_iAuiUdfErrorCode, $iConvertExtended, 0)
    EndIf
    Return SetError(0, 0, $vResult)
EndFunc

Func __AUI_JsonEscapeString($s, $iMaxChars = $__AUI_JSON_MAX_OUTPUT_CHARS)
    Local $iCode, $iLow
    If $iMaxChars < 2 Then
        $g_iAuiUdfErrorCode = $AUI_ERR_LIMIT_EXCEEDED
        Return SetError($g_iAuiUdfErrorCode, 0, "")
    EndIf
    Local $iNeeded = 2, $iLen = StringLen($s)
    For $i = 1 To $iLen
        $iCode = AscW(StringMid($s, $i, 1))
        Switch $iCode
            Case 34, 92, 8, 12, 10, 13, 9
                $iNeeded += 2
            Case 0 To 31
                $iNeeded += 6
            Case 0xD800 To 0xDBFF
                If $i >= $iLen Then
                    $g_iAuiUdfErrorCode = $AUI_ERR_INVALID_ARGUMENT
                    Return SetError($g_iAuiUdfErrorCode, 0, "")
                EndIf
                $iLow = AscW(StringMid($s, $i + 1, 1))
                If $iLow < 0xDC00 Or $iLow > 0xDFFF Then
                    $g_iAuiUdfErrorCode = $AUI_ERR_INVALID_ARGUMENT
                    Return SetError($g_iAuiUdfErrorCode, 0, "")
                EndIf
                $iNeeded += 2
                $i += 1
            Case 0xDC00 To 0xDFFF
                $g_iAuiUdfErrorCode = $AUI_ERR_INVALID_ARGUMENT
                Return SetError($g_iAuiUdfErrorCode, 0, "")
            Case Else
                $iNeeded += 1
        EndSwitch
        If $iNeeded > $iMaxChars Then
            $g_iAuiUdfErrorCode = $AUI_ERR_LIMIT_EXCEEDED
            Return SetError($g_iAuiUdfErrorCode, 0, "")
        EndIf
    Next

    Local $sOut = Chr(34)
    For $i = 1 To $iLen
        $iCode = AscW(StringMid($s, $i, 1))
        Switch $iCode
            Case 34
                $sOut &= "\" & Chr(34)
            Case 92
                $sOut &= "\\"
            Case 8
                $sOut &= "\b"
            Case 12
                $sOut &= "\f"
            Case 10
                $sOut &= "\n"
            Case 13
                $sOut &= "\r"
            Case 9
                $sOut &= "\t"
            Case 0 To 31
                $sOut &= "\u" & Hex($iCode, 4)
            Case 0xD800 To 0xDBFF
                If $i >= $iLen Then
                    $g_iAuiUdfErrorCode = $AUI_ERR_INVALID_ARGUMENT
                    Return SetError($g_iAuiUdfErrorCode, 0, "")
                EndIf
                $iLow = AscW(StringMid($s, $i + 1, 1))
                If $iLow < 0xDC00 Or $iLow > 0xDFFF Then
                    $g_iAuiUdfErrorCode = $AUI_ERR_INVALID_ARGUMENT
                    Return SetError($g_iAuiUdfErrorCode, 0, "")
                EndIf
                $sOut &= StringMid($s, $i, 2)
                $i += 1
            Case 0xDC00 To 0xDFFF
                $g_iAuiUdfErrorCode = $AUI_ERR_INVALID_ARGUMENT
                Return SetError($g_iAuiUdfErrorCode, 0, "")
            Case Else
                $sOut &= StringMid($s, $i, 1)
        EndSwitch
    Next
    Return $sOut & Chr(34)
EndFunc

; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_JsonFromAutoIt
; 說明 ...: Serializes a native AutoIt structure into JSON text: Maps become objects, 1-D arrays become arrays, strings,
;                  integers (Int32/Int64), doubles, True/False, and the Null keyword become their JSON equivalents.
; 語法 ........: _UI_JsonFromAutoIt( $v )
; 參數 ....: $v - Native AutoIt value: Map, 1-D array, string, integer, double, True/False, or Null
; 傳回值 .: Success - JSON text
;                  Failure - ""; @error = $AUI_ERR_INVALID_ARGUMENT for an unsupported value type, multidimensional array,
;                  non-string/non-integer Map key, normalized-key collision, non-finite Double, or unpaired UTF-16 surrogate;
;                  $AUI_ERR_LIMIT_EXCEEDED for depth, node, or output-size limits
; 作者 ........: Fanxing
; 備註 .......: Integer Map keys are serialized as decimal strings, so integer key 1 cannot coexist with string key "1". A
;                  finite Double is formatted with 17 significant digits; when the text has no decimal point, ".0" is appended
;                  so it round-trips as a number. NaN and positive or negative infinity are not valid JSON numbers and are
;                  rejected. Depth is limited to 64 levels, 100,000 nodes, and 8 Mi characters.
; 相關函式 .......: _UI_JsonToAutoIt
; 範例 .......: No
; ===============================================================================================================================
Func _UI_JsonFromAutoIt($v)
    $g_iAuiUdfErrorCode = $AUI_OK
    $g_bAuiUdfErrorOverride = True
    Local $iNodes = 0, $iFail = 0, $sOut = ""
    Local $aStack[1]
    Local $aRootFrame[7] = [$v, 0, 0, 0, 0, 0, 0]
    $aStack[0] = $aRootFrame

    While UBound($aStack) > 0
        Local $aFrame = $aStack[UBound($aStack) - 1]
        ReDim $aStack[UBound($aStack) - 1]
        Local $vVal = $aFrame[0], $iKind = $aFrame[1], $iIdx = $aFrame[2]
        Local $iTotal = $aFrame[3], $iDepth = $aFrame[4], $aKeys = $aFrame[5], $aJsonKeys = $aFrame[6]

        If $iKind = 0 Then
            $iNodes += 1
            If $iNodes > $__AUI_JSON_MAX_NODES Then
                $iFail = $AUI_ERR_LIMIT_EXCEEDED
                ExitLoop
            EndIf
            Local $sType = VarGetType($vVal)
            Switch $sType
                Case "String"
                    Local $sEscapedValue = __AUI_JsonEscapeString($vVal, $__AUI_JSON_MAX_OUTPUT_CHARS - StringLen($sOut))
                    If @error Then
                        $iFail = @error
                        ExitLoop
                    EndIf
                    $sOut &= $sEscapedValue
                Case "Int32", "Int64"
                    $sOut &= String($vVal)
                Case "Double"
                    Local $sNum = StringFormat("%.17g", $vVal)
                    If StringInStr($sNum, "nan") Or StringInStr($sNum, "inf") Then
                        $iFail = $AUI_ERR_INVALID_ARGUMENT
                        ExitLoop
                    EndIf
                    If StringInStr($sNum, ".") = 0 And StringInStr($sNum, "e") = 0 And StringInStr($sNum, "E") = 0 Then
                        $sNum &= ".0"
                    EndIf
                    $sOut &= $sNum
                Case "Bool"
                    $sOut &= ($vVal ? "true" : "false")
                Case "Keyword"
                    If IsKeyword($vVal) = 2 Then
                        $sOut &= "null"
                    Else
                        $iFail = $AUI_ERR_INVALID_ARGUMENT
                        ExitLoop
                    EndIf
                Case "Map"
                    Local $aMapKeys = MapKeys($vVal)
                    If UBound($aMapKeys) > $__AUI_JSON_MAX_NODES - $iNodes Then
                        $iFail = $AUI_ERR_LIMIT_EXCEEDED
                        ExitLoop
                    EndIf
                    $sOut &= "{"
                    If UBound($aMapKeys) = 0 Then
                        $sOut &= "}"
                    Else
                        Local $aJsonMapKeys[UBound($aMapKeys)]
                        Local $mNormalizedKeys[]
                        For $iMapKey = 0 To UBound($aMapKeys) - 1
                            Local $sMapKeyType = VarGetType($aMapKeys[$iMapKey])
                            Local $sJsonMapKey = ""
                            If $sMapKeyType = "String" Then
                                $sJsonMapKey = $aMapKeys[$iMapKey]
                            ElseIf $sMapKeyType = "Int32" Or $sMapKeyType = "Int64" Then
                                $sJsonMapKey = String($aMapKeys[$iMapKey])
                            Else
                                $iFail = $AUI_ERR_INVALID_ARGUMENT
                                ExitLoop
                            EndIf
                            If MapExists($mNormalizedKeys, $sJsonMapKey) Then
                                $iFail = $AUI_ERR_INVALID_ARGUMENT
                                ExitLoop
                            EndIf
                            $mNormalizedKeys[$sJsonMapKey] = True
                            $aJsonMapKeys[$iMapKey] = $sJsonMapKey
                        Next
                        If $iFail Then ExitLoop
                        Local $aMapFrame[7] = [$vVal, 2, 0, UBound($aMapKeys), $iDepth + 1, $aMapKeys, $aJsonMapKeys]
                        ReDim $aStack[UBound($aStack) + 1]
                        $aStack[UBound($aStack) - 1] = $aMapFrame
                    EndIf
                Case "Array"
                    If UBound($vVal, 0) <> 1 Then
                        $iFail = $AUI_ERR_INVALID_ARGUMENT
                        ExitLoop
                    EndIf
                    If UBound($vVal) > $__AUI_JSON_MAX_NODES - $iNodes Then
                        $iFail = $AUI_ERR_LIMIT_EXCEEDED
                        ExitLoop
                    EndIf
                    $sOut &= "["
                    If UBound($vVal) = 0 Then
                        $sOut &= "]"
                    Else
                        Local $aArrFrame[7] = [$vVal, 1, 0, UBound($vVal), $iDepth + 1, 0, 0]
                        ReDim $aStack[UBound($aStack) + 1]
                        $aStack[UBound($aStack) - 1] = $aArrFrame
                    EndIf
                Case Else
                    $iFail = $AUI_ERR_INVALID_ARGUMENT
                    ExitLoop
            EndSwitch
            If $iFail Then ExitLoop
        Else
            If $iDepth > $__AUI_JSON_MAX_DEPTH Then
                $iFail = $AUI_ERR_LIMIT_EXCEEDED
                ExitLoop
            EndIf
            If $iIdx >= $iTotal Then
                $sOut &= ($iKind = 1 ? "]" : "}")
                ContinueLoop
            EndIf
            If $iIdx > 0 Then $sOut &= ","
            If $iKind = 2 Then
                Local $sEscapedKey = __AUI_JsonEscapeString($aJsonKeys[$iIdx], _
                    $__AUI_JSON_MAX_OUTPUT_CHARS - StringLen($sOut) - 1)
                If @error Then
                    $iFail = @error
                    ExitLoop
                EndIf
                $sOut &= $sEscapedKey & ":"
            EndIf
            $aFrame[2] = $iIdx + 1
            ReDim $aStack[UBound($aStack) + 1]
            $aStack[UBound($aStack) - 1] = $aFrame
            Local $vChild = ($iKind = 1) ? $vVal[$iIdx] : $vVal[$aKeys[$iIdx]]
            Local $aChildFrame[7] = [$vChild, 0, 0, 0, $iDepth, 0, 0]
            ReDim $aStack[UBound($aStack) + 1]
            $aStack[UBound($aStack) - 1] = $aChildFrame
        EndIf

        If StringLen($sOut) > $__AUI_JSON_MAX_OUTPUT_CHARS Then
            $iFail = $AUI_ERR_LIMIT_EXCEEDED
            ExitLoop
        EndIf
    WEnd

    If $iFail Then
        $g_iAuiUdfErrorCode = $iFail
        Return SetError($iFail, 0, "")
    EndIf
    Return SetError(0, 0, $sOut)
EndFunc

; ────────────────────────────────────────────────────────────────────────────
;  HTTP、WebSocket 與非同步工作
; ────────────────────────────────────────────────────────────────────────────
Func __AUI_DispAsyncDone($iId, $iStatus)
	Local $f = __AUI_CbGet($__AUI_CB_ASYNC_DONE, $iId)
	If $f <> "" Then __AUI_SafeCall($f, $iId, $iStatus, 0, 2)
	__AUI_CbDel($__AUI_CB_ASYNC_DONE, $iId)
	__AUI_CbDel($__AUI_CB_ASYNC_PROGRESS, $iId)
	__AUI_CbDel($__AUI_CB_ASYNC_OWNER, $iId)
EndFunc

Func __AUI_DispAsyncProgress($iId, $iDone, $iTotal)
	Local $f = __AUI_CbGet($__AUI_CB_ASYNC_PROGRESS, $iId)
	If $f <> "" Then __AUI_SafeCall($f, $iId, $iDone, $iTotal, 3)
EndFunc

Func __AUI_DispHttpDone($iId, $iState)
    Local $f = __AUI_CbGet($__AUI_CB_HTTP_DONE, $iId)
    If $f <> "" Then __AUI_SafeCall($f, $iId, $iState, 0, 2)
    __AUI_CbDel($__AUI_CB_HTTP_DONE, $iId)
    __AUI_CbDel($__AUI_CB_HTTP_PROGRESS, $iId)
    __AUI_CbDel($__AUI_CB_HTTP_OWNER, $iId)
EndFunc

Func __AUI_DispHttpProgress($iId, $iDone, $iTotal)
    Local $f = __AUI_CbGet($__AUI_CB_HTTP_PROGRESS, $iId)
    If $f <> "" Then __AUI_SafeCall($f, $iId, $iDone, $iTotal, 3)
EndFunc

Func __AUI_DispWebSocket($iId, $iEvent)
    Local $f = __AUI_CbGet($__AUI_CB_WEBSOCKET, $iId)
    If $f <> "" Then __AUI_SafeCall($f, $iId, $iEvent, 0, 2)
    If $iEvent = $AUI_WS_ERROR Or $iEvent = $AUI_WS_CLOSE Then
        __AUI_CbDel($__AUI_CB_WEBSOCKET, $iId)
        __AUI_CbDel($__AUI_CB_WEBSOCKET_OWNER, $iId)
    EndIf
EndFunc

Func __AUI_AsyncAbortRegistration($iTaskId)
    If $iTaskId > 0 Then _UI_AsyncCancel($iTaskId)
    __AUI_CbDel($__AUI_CB_ASYNC_DONE, $iTaskId)
    __AUI_CbDel($__AUI_CB_ASYNC_PROGRESS, $iTaskId)
    __AUI_CbDel($__AUI_CB_ASYNC_OWNER, $iTaskId)
EndFunc

Func __AUI_HttpAbortRegistration($iRequestId, $iError)
    If $iRequestId > 0 Then __AUI_DllCall("int", "_UI_HttpRequestRelease", "int", $iRequestId)
    __AUI_CbDel($__AUI_CB_HTTP_DONE, $iRequestId)
    __AUI_CbDel($__AUI_CB_HTTP_PROGRESS, $iRequestId)
    __AUI_CbDel($__AUI_CB_HTTP_OWNER, $iRequestId)
    __AUI_HttpEasyCleanup($iRequestId)
    $g_iAuiUdfErrorCode = $iError
    Return SetError($iError, 0, 0)
EndFunc

Func __AUI_HttpEasyCleanup($iRequestId)
    __AUI_CbDel($__AUI_CB_HTTP_EASY_DONE, $iRequestId)
    __AUI_CbDel($__AUI_CB_HTTP_EASY_MODE, $iRequestId)
    __AUI_CbDel($__AUI_CB_HTTP_EASY_TIMER, $iRequestId)
EndFunc

Func __AUI_HttpEasyResult($vValue, $iError = 0, $iExtended = 0)
    $g_iAuiUdfErrorCode = $iError
    Local $aResult[3] = [$vValue, $iError, $iExtended]
    Return $aResult
EndFunc

Func __AUI_HttpEasyFail($iRequestId, $iError, $iExtended = 0)
    __AUI_HttpEasyCleanup($iRequestId)
    If $iRequestId > 0 Then __AUI_DllCall("int", "_UI_HttpRequestRelease", "int", $iRequestId)
    __AUI_CbDel($__AUI_CB_HTTP_DONE, $iRequestId)
    __AUI_CbDel($__AUI_CB_HTTP_PROGRESS, $iRequestId)
    __AUI_CbDel($__AUI_CB_HTTP_OWNER, $iRequestId)
    Return __AUI_HttpEasyResult(0, $iError, $iExtended)
EndFunc

Func __AUI_HttpEasyValidateOptions($mOptions)
    If IsKeyword($mOptions) = 1 Then Return SetError(0, 0, 1)
    If Not IsMap($mOptions) Then
        $g_iAuiUdfErrorCode = $AUI_ERR_INVALID_ARGUMENT
        Return SetError($AUI_ERR_INVALID_ARGUMENT, 0, 0)
    EndIf
    Local $aKeys = MapKeys($mOptions)
    If @error Then
        $g_iAuiUdfErrorCode = $AUI_ERR_INVALID_ARGUMENT
        Return SetError($AUI_ERR_INVALID_ARGUMENT, 0, 0)
    EndIf
    For $vKey In $aKeys
        If VarGetType($vKey) <> "String" Then
            $g_iAuiUdfErrorCode = $AUI_ERR_INVALID_ARGUMENT
            Return SetError($AUI_ERR_INVALID_ARGUMENT, 0, 0)
        EndIf
        Switch $vKey
            Case "timeout", "timeouts", "retries", "netFlags", "progress", "headers", "params", "form", "multipart", "files", "auth", "bearer", "proxy", "body", "contentType", "bodyFile", "outputFile", "responseMode", "responseBytes", "downloadBytes"
            Case Else
                $g_iAuiUdfErrorCode = $AUI_ERR_INVALID_ARGUMENT
                Return SetError($AUI_ERR_INVALID_ARGUMENT, 0, 0)
        EndSwitch
    Next
    Return SetError(0, 0, 1)
EndFunc

Func __AUI_HttpEasyBuildResponse($iRequestId, $iState, $iMode, $hTimer)
    Local $mResponse[]
    $mResponse["requestId"] = $iRequestId
    $mResponse["state"] = $iState
    $mResponse["transportOk"] = ($iState = $AUI_HTTP_OK)
    $mResponse["statusCode"] = 0
    $mResponse["attempts"] = _UI_HttpRequestGetAttemptCount($iRequestId)
    $mResponse["ok"] = False
    $mResponse["finalUrl"] = ""
    $mResponse["headers"] = ""
    $mResponse["text"] = ""
    $mResponse["body"] = Binary("")
    $mResponse["outputFile"] = ""
    $mResponse["type"] = ($iMode = $AUI_HTTP_RESPONSE_BINARY) ? "binary" : "text"
    $mResponse["redirectHistory"] = "[]"
    $mResponse["certificate"] = ""
    $mResponse["errorCode"] = _UI_HttpRequestGetErrorCode($iRequestId)
    $mResponse["errorText"] = _UI_HttpRequestGetErrorText($iRequestId)
    $mResponse["elapsedMs"] = ($hTimer = "") ? 0 : Int(TimerDiff($hTimer))

    Local $sRedirectHistory = _UI_HttpRequestGetRedirectHistory($iRequestId)
    If @error = 0 Then $mResponse["redirectHistory"] = $sRedirectHistory
    If $iState <> $AUI_HTTP_OK Then Return $mResponse

    Local $iStatusCode = _UI_HttpRequestGetStatusCode($iRequestId)
    If @error = 0 Then $mResponse["statusCode"] = $iStatusCode
    $mResponse["ok"] = ($iStatusCode >= 200 And $iStatusCode < 400)
    Local $sFinalUrl = _UI_HttpRequestGetFinalUrl($iRequestId)
    If @error = 0 Then $mResponse["finalUrl"] = $sFinalUrl
    Local $sHeaders = _UI_HttpRequestGetHeaders($iRequestId)
    If @error = 0 Then $mResponse["headers"] = $sHeaders
    Local $sCertificate = _UI_HttpRequestGetCertificate($iRequestId)
    If @error = 0 Then $mResponse["certificate"] = $sCertificate
    Local $sOutputFile = _UI_HttpRequestGetOutputFile($iRequestId)
    If @error = 0 And $sOutputFile <> "" Then
        $mResponse["type"] = "file"
        $mResponse["outputFile"] = $sOutputFile
    ElseIf $iMode = $AUI_HTTP_RESPONSE_BINARY Then
        Local $vBody = _UI_HttpRequestGetBody($iRequestId)
        If @error = 0 Then $mResponse["body"] = $vBody
    Else
        Local $sText = _UI_HttpRequestGetText($iRequestId)
        If @error = 0 Then $mResponse["text"] = $sText
    EndIf
    Return $mResponse
EndFunc

Func __AUI_HttpEasyDone($iRequestId, $iState)
    Local $fDone = __AUI_CbGet($__AUI_CB_HTTP_EASY_DONE, $iRequestId)
    Local $iMode = Number(__AUI_CbGet($__AUI_CB_HTTP_EASY_MODE, $iRequestId))
    Local $hTimer = __AUI_CbGet($__AUI_CB_HTTP_EASY_TIMER, $iRequestId)
    Local $mResponse = __AUI_HttpEasyBuildResponse($iRequestId, $iState, $iMode, $hTimer)
    __AUI_HttpEasyCleanup($iRequestId)
    If $fDone <> "" Then __AUI_SafeCall($fDone, $iRequestId, $mResponse, 0, 2)
    __AUI_DllCall("int", "_UI_HttpRequestRelease", "int", $iRequestId)
EndFunc

Func __AUI_WebSocketAbortRegistration($iSocketId, $iError)
    If $iSocketId > 0 Then __AUI_DllCall("int", "_UI_WebSocketRelease", "int", $iSocketId)
    __AUI_CbDel($__AUI_CB_WEBSOCKET, $iSocketId)
    __AUI_CbDel($__AUI_CB_WEBSOCKET_OWNER, $iSocketId)
    $g_iAuiUdfErrorCode = $iError
    Return SetError($iError, 0, 0)
EndFunc

; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_HttpSessionCreate
; 說明 ...: Creates a reusable HTTP session.
; 語法 ........: _UI_HttpSessionCreate()
; 參數 ....: None
; 傳回值 .: Success - Session ID
;                  Failure - 0
; 作者 ........: Fanxing
; 備註 .......: Requests in the same session share WinHTTP connection reuse, default headers, the cookie jar, and redirect
;                  policy. A process can retain at most 64 public sessions; isolated one-shot requests do not consume this
;                  public-session quota.
; 相關函式 .......: _UI_HttpSessionRequestCreate, _UI_HttpSessionRelease
; 範例 .......: Yes
; ===============================================================================================================================
Func _UI_HttpSessionCreate()
    Local $vAuiForwardResult = __AUI_Call("int", "_UI_HttpSessionCreate")
    Return SetError(@error, @extended, $vAuiForwardResult)
EndFunc

; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_HttpSessionRelease
; 說明 ...: Releases a public HTTP session handle.
; 語法 ........: _UI_HttpSessionRelease( $iSessionId )
; 參數 ....: $iSessionId - Session ID
; 傳回值 .: Success - 1
;                  Failure - 0
; 作者 ........: Fanxing
; 備註 .......: Requests already created from this session safely retain the underlying session until the request objects are
;                  released. The public session ID becomes invalid immediately after this function succeeds and can no longer
;                  create requests or manage cookies.
; 相關函式 .......: _UI_HttpSessionCreate, _UI_HttpRequestRelease
; 範例 .......: No
; ===============================================================================================================================
Func _UI_HttpSessionRelease($iSessionId)
    Local $vAuiForwardResult = __AUI_Call("int", "_UI_HttpSessionRelease", "int", $iSessionId)
    Return SetError(@error, @extended, $vAuiForwardResult)
EndFunc

; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_HttpSessionSetHeader
; 說明 ...: Sets or replaces a session default request header.
; 語法 ........: _UI_HttpSessionSetHeader( $iSessionId, $sName, $sValue )
; 參數 ....: $iSessionId - Session ID
;                  $sName - Header name
;                  $sValue - Header value
; 傳回值 .: Success - 1
;                  Failure - 0
; 作者 ........: Fanxing
; 備註 .......: One session accepts at most 128 default headers. A name is limited to 256 characters and a value to 8,192. A
;                  request-level header overrides a session default with the same name. Content-Length, Transfer-Encoding, and
;                  Cookie are managed by the runtime and cannot be set manually.
; 相關函式 .......: _UI_HttpRequestSetHeader
; 範例 .......: No
; ===============================================================================================================================
Func _UI_HttpSessionSetHeader($iSessionId, $sName, $sValue)
    Local $vAuiForwardResult = __AUI_Call("int", "_UI_HttpSessionSetHeader", "int", $iSessionId, "wstr", $sName, "wstr", $sValue)
    Return SetError(@error, @extended, $vAuiForwardResult)
EndFunc

; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_HttpSessionSetCookie
; 說明 ...: Adds, replaces, or removes a cookie in the session cookie jar.
; 語法 ........: _UI_HttpSessionSetCookie( $iSessionId, $sSourceUrl, $sSetCookie )
; 參數 ....: $iSessionId - Session ID
;                  $sSourceUrl - HTTP or HTTPS URL used to establish the cookie scope
;                  $sSetCookie - Standard Set-Cookie text
; 傳回值 .: Success - 1
;                  Failure - 0
; 作者 ........: Fanxing
; 備註 .......: Supports Domain, Path, Expires, Max-Age, Secure, HttpOnly, and host-only cookies. Domain must match the
;                  source host. Max-Age takes precedence over Expires, and a value less than or equal to zero removes the
;                  matching cookie. A session stores at most 4,096 cookies and 2 Mi UTF-16 characters in total. A name is
;                  limited to 256 characters, a value to 4,096, a domain to 255, and a path to 2,048.
; 相關函式 .......: _UI_HttpSessionGetCookies, _UI_HttpSessionClearCookies
; 範例 .......: Yes
; ===============================================================================================================================
Func _UI_HttpSessionSetCookie($iSessionId, $sSourceUrl, $sSetCookie)
    Local $vAuiForwardResult = __AUI_Call("int", "_UI_HttpSessionSetCookie", "int", $iSessionId, "wstr", $sSourceUrl, "wstr", $sSetCookie)
    Return SetError(@error, @extended, $vAuiForwardResult)
EndFunc

; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_HttpSessionGetCookies
; 說明 ...: Retrieves the Cookie request-header value that would be sent to a URL.
; 語法 ........: _UI_HttpSessionGetCookies( $iSessionId, $sUrl )
; 參數 ....: $iSessionId - Session ID
;                  $sUrl - HTTP or HTTPS URL
; 傳回值 .: Success - Header value without the Cookie: prefix; an empty string with @error = 0 when no cookies match
;                  Failure - Empty string and set @error
; 作者 ........: Fanxing
; 備註 .......: Expired entries are removed while reading, and cookies are selected by domain, host-only, path, and Secure
;                  rules. One generated header is limited to 32,768 UTF-16 code units.
; 相關函式 .......: _UI_HttpSessionSetCookie, _UI_HttpSessionClearCookies
; 範例 .......: Yes
; ===============================================================================================================================
Func _UI_HttpSessionGetCookies($iSessionId, $sUrl)
    Local $vAuiHelperResult = __AUI_HttpReadText("_UI_HttpSessionGetCookies", $iSessionId, $sUrl)
    Return SetError(@error, @extended, $vAuiHelperResult)
EndFunc

; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_HttpSessionClearCookies
; 說明 ...: Clears all session cookies or cookies matching a specific URL.
; 語法 ........: _UI_HttpSessionClearCookies( $iSessionId [, $sUrl = ""] )
; 參數 ....: $iSessionId - Session ID
;                  $sUrl - [optional] An empty string clears the entire jar; otherwise, only cookies matching this URL are
;                  removed
; 傳回值 .: Success - 1
;                  Failure - 0
; 作者 ........: Fanxing
; 相關函式 .......: _UI_HttpSessionSetCookie, _UI_HttpSessionGetCookies
; 範例 .......: No
; ===============================================================================================================================
Func _UI_HttpSessionClearCookies($iSessionId, $sUrl = "")
    Local $vAuiForwardResult = __AUI_Call("int", "_UI_HttpSessionClearCookies", "int", $iSessionId, "wstr", $sUrl)
    Return SetError(@error, @extended, $vAuiForwardResult)
EndFunc

; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_HttpSessionSetRedirectPolicy
; 說明 ...: Configures automatic redirect handling for a session.
; 語法 ........: _UI_HttpSessionSetRedirectPolicy( $iSessionId [, $iMode = $AUI_HTTP_REDIRECT_FOLLOW [, $iMaxRedirects = 10]]
;                  )
; 參數 ....: $iSessionId - Session ID
;                  $iMode - $AUI_HTTP_REDIRECT_DISABLED or $AUI_HTTP_REDIRECT_FOLLOW
;                  $iMaxRedirects - Maximum number of redirects; follow mode accepts 1 through 20, and disabled mode also
;                  accepts 0
; 傳回值 .: Success - 1
;                  Failure - 0
; 作者 ........: Fanxing
; 備註 .......: By default, the session follows at most 10 redirects. A POST becomes GET after 301 or 302; 303 changes every
;                  method except HEAD to GET; 307 and 308 preserve the method and body. Cross-origin redirects remove
;                  Authorization and Proxy-Authorization, and cookies are matched again for every hop. HTTPS-to-HTTP downgrade
;                  is rejected by default and requires the request to set $AUI_NET_ALLOW_INSECURE_REDIRECT explicitly. An HTTPS
;                  hop that explicitly permits an invalid certificate neither reads nor updates the shared cookie jar. After an
;                  explicitly permitted HTTPS-to-HTTP downgrade, the remainder of that redirect chain also neither reads nor
;                  updates the shared cookie jar.
; 相關函式 .......: _UI_HttpRequestGetRedirectHistory
; 範例 .......: Yes
; ===============================================================================================================================
Func _UI_HttpSessionSetRedirectPolicy($iSessionId, $iMode = $AUI_HTTP_REDIRECT_FOLLOW, $iMaxRedirects = 10)
    Local $vAuiForwardResult = __AUI_Call("int", "_UI_HttpSessionSetRedirectPolicy", "int", $iSessionId, "int", $iMode, "int", $iMaxRedirects)
    Return SetError(@error, @extended, $vAuiForwardResult)
EndFunc

; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_HttpSessionSetProxy
; 說明 ...: Configures the session's default proxy policy.
; 語法 ........: _UI_HttpSessionSetProxy( $iSessionId [, $iMode = $AUI_HTTP_PROXY_SYSTEM [, $sProxy = "" [, $sBypass = "" [,
;                  $sUser = "" [, $sPassword = ""]]]]] )
; 參數 ....: $iSessionId - Session ID
;                  $iMode - SYSTEM, DIRECT, or NAMED proxy mode
;                  $sProxy - [Optional] Proxy address for NAMED mode, for example 127.0.0.1:8080
;                  $sBypass - [Optional] WinHTTP bypass list for NAMED mode
;                  $sUser - [Optional] Proxy user name
;                  $sPassword - [Optional] Proxy password; it cannot be specified when the proxy user name is empty
; 傳回值 .: Success - 1
;                  Failure - 0
; 作者 ........: Fanxing
; 備註 .......: SYSTEM uses the current user's system proxy configuration, DIRECT explicitly bypasses all proxies, and NAMED
;                  uses the specified proxy. A session reuses WinHTTP connections separately for each proxy configuration;
;                  _UI_HttpRequestSetProxy can override the session default for one request.
; 相關函式 .......: _UI_HttpRequestSetProxy
; 範例 .......: No
; ===============================================================================================================================
Func _UI_HttpSessionSetProxy($iSessionId, $iMode = $AUI_HTTP_PROXY_SYSTEM, $sProxy = "", $sBypass = "", $sUser = "", $sPassword = "")
    Local $vResult = __AUI_Call("int", "_UI_HttpSessionSetProxy", "int", $iSessionId, "int", $iMode, "wstr", $sProxy, "wstr", $sBypass, "wstr", $sUser, "wstr", $sPassword)
    Return SetError(@error, @extended, $vResult)
EndFunc

; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_HttpRequest
; 說明 ...: Creates, configures, and starts an asynchronous HTTP request in one call.
; 語法 ........: _UI_HttpRequest( $hWnd, $sMethod, $sUrl, $sOnDone [, $mOptions = Default [, $iSessionId = 0]] )
; 參數 ....: $hWnd - Target window handle
;                  $sMethod - HTTP method
;                  $sUrl - HTTP or HTTPS URL
;                  $sOnDone - Completion callback Func($iRequestId, $mResponse)
;                  $mOptions - [Optional] Request Options Map; Default uses all default settings
;                  $iSessionId - [Optional] Reusable session ID; 0 uses an isolated one-shot session
; 傳回值 .: Success - Request ID
;                  Failure - 0 and set @error
; 作者 ........: Fanxing
; 備註 .......: This is the preferred entry point for ordinary applications. Options may contain timeout, timeouts, retries,
;                  netFlags, progress, headers, params, form, multipart, files, auth, bearer, proxy, body, contentType,
;                  bodyFile, outputFile, responseMode, responseBytes, and downloadBytes; unknown keys are rejected. The
;                  completion Map contains requestId, state, transportOk, statusCode, ok, attempts, finalUrl, headers, text,
;                  body, outputFile, type, redirectHistory, certificate, errorCode, errorText, and elapsedMs. The request is
;                  released automatically after the completion callback returns. Read the Map inside the callback, but do not
;                  release the request manually. Use the lower-level Create/Set/Send/Release workflow only for incremental
;                  configuration or when the native request object must remain available after completion. retries.nonIdempotent
;                  accepts a Boolean or the integer 0 or 1 returned by common AUI state getters; all other values are rejected.
;                  HTTPS explicitly prevents WinHTTP from automatically selecting a client certificate from the current user's
;                  certificate store; the current API does not expose mTLS client-certificate configuration. transportOk is True
;                  whenever a server response is received; ok is True only for a 2xx status. Treat 403, 429, or vendor-defined
;                  security-policy statuses as server responses and provide a browser or manual fallback.
; 相關函式 .......: _UI_HttpRequestCreate, _UI_HttpSessionRequestCreate, _UI_HttpRequestCancel
; 範例 .......: Yes
; ===============================================================================================================================
Func _UI_HttpRequest($hWnd, $sMethod, $sUrl, $sOnDone, $mOptions = Default, $iSessionId = 0)
    Local $aEasyResult = __AUI_HttpRequestEasy($hWnd, $sMethod, $sUrl, $sOnDone, $mOptions, $iSessionId)
    Return SetError($aEasyResult[1], $aEasyResult[2], $aEasyResult[0])
EndFunc

Func __AUI_HttpRequestEasy($hWnd, $sMethod, $sUrl, $sOnDone, $mOptions, $iSessionId)
    If Not __AUI_IsCallable($sOnDone) Then Return __AUI_HttpEasyResult(0, $AUI_UDF_ERR_INVALID_CALLBACK)
    Local $bValidOptions = __AUI_HttpEasyValidateOptions($mOptions)
    Local $iOptionsError = @error, $iOptionsExtended = @extended
    If Not $bValidOptions Then Return __AUI_HttpEasyResult(0, $iOptionsError, $iOptionsExtended)
    If Not IsNumber($iSessionId) Or $iSessionId < 0 Then Return __AUI_HttpEasyResult(0, $AUI_ERR_INVALID_ARGUMENT)

    Local $iTimeout = 0, $iNetFlags = $AUI_NET_DEFAULT, $sProgress = ""
    Local $iMode = $AUI_HTTP_RESPONSE_TEXT
    If IsMap($mOptions) Then
        If MapExists($mOptions, "timeout") Then $iTimeout = $mOptions["timeout"]
        If MapExists($mOptions, "netFlags") Then $iNetFlags = $mOptions["netFlags"]
        If MapExists($mOptions, "progress") Then $sProgress = $mOptions["progress"]
        If MapExists($mOptions, "responseMode") Then $iMode = $mOptions["responseMode"]
    EndIf

    Local $iRequestId = 0
    If $iSessionId > 0 Then
        $iRequestId = _UI_HttpSessionRequestCreate($iSessionId, $hWnd, $sMethod, $sUrl, $iTimeout, $iNetFlags, "__AUI_HttpEasyDone", $sProgress)
    Else
        $iRequestId = _UI_HttpRequestCreate($hWnd, $sMethod, $sUrl, $iTimeout, $iNetFlags, "__AUI_HttpEasyDone", $sProgress)
    EndIf
    Local $iCreateError = @error, $iCreateExtended = @extended
    If $iRequestId <= 0 Then Return __AUI_HttpEasyResult(0, $iCreateError, $iCreateExtended)

    If Not __AUI_CbSet($__AUI_CB_HTTP_EASY_DONE, $iRequestId, $sOnDone) Then Return __AUI_HttpEasyFail($iRequestId, @error)
    If Not __AUI_CbSet($__AUI_CB_HTTP_EASY_MODE, $iRequestId, $iMode, 0, False) Then Return __AUI_HttpEasyFail($iRequestId, @error)

    If IsMap($mOptions) Then
        If MapExists($mOptions, "params") Then
            Local $mParams = $mOptions["params"]
            If Not IsMap($mParams) Then Return __AUI_HttpEasyFail($iRequestId, $AUI_ERR_INVALID_ARGUMENT)
            Local $aParamNames = MapKeys($mParams)
            If @error Then Return __AUI_HttpEasyFail($iRequestId, $AUI_ERR_INVALID_ARGUMENT)
            For $vParamName In $aParamNames
                If VarGetType($vParamName) <> "String" Or Not IsString($mParams[$vParamName]) Then _
                    Return __AUI_HttpEasyFail($iRequestId, $AUI_ERR_INVALID_ARGUMENT)
                If Not _UI_HttpRequestAddQuery($iRequestId, $vParamName, $mParams[$vParamName]) Then _
                    Return __AUI_HttpEasyFail($iRequestId, @error, @extended)
            Next
        EndIf

        If MapExists($mOptions, "headers") Then
            Local $mHeaders = $mOptions["headers"]
            If Not IsMap($mHeaders) Then Return __AUI_HttpEasyFail($iRequestId, $AUI_ERR_INVALID_ARGUMENT)
            Local $aHeaderNames = MapKeys($mHeaders)
            If @error Then Return __AUI_HttpEasyFail($iRequestId, $AUI_ERR_INVALID_ARGUMENT)
            For $vHeaderName In $aHeaderNames
                If VarGetType($vHeaderName) <> "String" Or Not IsString($mHeaders[$vHeaderName]) Then _
                    Return __AUI_HttpEasyFail($iRequestId, $AUI_ERR_INVALID_ARGUMENT)
                If Not _UI_HttpRequestSetHeader($iRequestId, $vHeaderName, $mHeaders[$vHeaderName]) Then _
                    Return __AUI_HttpEasyFail($iRequestId, @error, @extended)
            Next
        EndIf

        If MapExists($mOptions, "proxy") Then
            Local $mProxy = $mOptions["proxy"]
            If Not IsMap($mProxy) Then Return __AUI_HttpEasyFail($iRequestId, $AUI_ERR_INVALID_ARGUMENT)
            Local $iProxyMode = $AUI_HTTP_PROXY_SYSTEM
            Local $sProxy = "", $sBypass = "", $sProxyUser = "", $sProxyPassword = ""
            Local $aProxyKeys = MapKeys($mProxy)
            If @error Then Return __AUI_HttpEasyFail($iRequestId, $AUI_ERR_INVALID_ARGUMENT)
            For $vProxyKey In $aProxyKeys
                If VarGetType($vProxyKey) <> "String" Then Return __AUI_HttpEasyFail($iRequestId, $AUI_ERR_INVALID_ARGUMENT)
                Switch $vProxyKey
                    Case "mode", "server", "bypass", "user", "password"
                    Case Else
                        Return __AUI_HttpEasyFail($iRequestId, $AUI_ERR_INVALID_ARGUMENT)
                EndSwitch
            Next
            If MapExists($mProxy, "mode") Then $iProxyMode = $mProxy["mode"]
            If MapExists($mProxy, "server") Then $sProxy = $mProxy["server"]
            If MapExists($mProxy, "bypass") Then $sBypass = $mProxy["bypass"]
            If MapExists($mProxy, "user") Then $sProxyUser = $mProxy["user"]
            If MapExists($mProxy, "password") Then $sProxyPassword = $mProxy["password"]
            If Not IsString($sProxy) Or Not IsString($sBypass) Or Not IsString($sProxyUser) Or Not IsString($sProxyPassword) Then _
                Return __AUI_HttpEasyFail($iRequestId, $AUI_ERR_INVALID_ARGUMENT)
            If Not _UI_HttpRequestSetProxy($iRequestId, $iProxyMode, $sProxy, $sBypass, $sProxyUser, $sProxyPassword) Then _
                Return __AUI_HttpEasyFail($iRequestId, @error, @extended)
        EndIf

        If MapExists($mOptions, "timeouts") Then
            Local $mTimeouts = $mOptions["timeouts"]
            If Not IsMap($mTimeouts) Then Return __AUI_HttpEasyFail($iRequestId, $AUI_ERR_INVALID_ARGUMENT)
            Local $iResolveTimeout = 30000, $iConnectTimeout = 30000, $iSendTimeout = 30000, $iReceiveTimeout = 30000
            Local $iTotalTimeout = ($iTimeout > 0) ? $iTimeout : 30000
            Local $aTimeoutKeys = MapKeys($mTimeouts)
            If @error Then Return __AUI_HttpEasyFail($iRequestId, $AUI_ERR_INVALID_ARGUMENT)
            For $vTimeoutKey In $aTimeoutKeys
                If VarGetType($vTimeoutKey) <> "String" Then Return __AUI_HttpEasyFail($iRequestId, $AUI_ERR_INVALID_ARGUMENT)
                Switch $vTimeoutKey
                    Case "resolve", "connect", "send", "receive", "total"
                    Case Else
                        Return __AUI_HttpEasyFail($iRequestId, $AUI_ERR_INVALID_ARGUMENT)
                EndSwitch
            Next
            If MapExists($mTimeouts, "resolve") Then $iResolveTimeout = $mTimeouts["resolve"]
            If MapExists($mTimeouts, "connect") Then $iConnectTimeout = $mTimeouts["connect"]
            If MapExists($mTimeouts, "send") Then $iSendTimeout = $mTimeouts["send"]
            If MapExists($mTimeouts, "receive") Then $iReceiveTimeout = $mTimeouts["receive"]
            If MapExists($mTimeouts, "total") Then $iTotalTimeout = $mTimeouts["total"]
            If Not _UI_HttpRequestSetTimeouts($iRequestId, $iResolveTimeout, $iConnectTimeout, $iSendTimeout, $iReceiveTimeout, $iTotalTimeout) Then _
                Return __AUI_HttpEasyFail($iRequestId, @error, @extended)
        EndIf

        If MapExists($mOptions, "retries") Then
            Local $mRetries = $mOptions["retries"]
            If Not IsMap($mRetries) Then Return __AUI_HttpEasyFail($iRequestId, $AUI_ERR_INVALID_ARGUMENT)
            Local $iMaxRetries = 0, $iBackoffMs = 250, $iMaxDelayMs = 5000, $bRetryNonIdempotent = False
            Local $aRetryKeys = MapKeys($mRetries)
            If @error Then Return __AUI_HttpEasyFail($iRequestId, $AUI_ERR_INVALID_ARGUMENT)
            For $vRetryKey In $aRetryKeys
                If VarGetType($vRetryKey) <> "String" Then Return __AUI_HttpEasyFail($iRequestId, $AUI_ERR_INVALID_ARGUMENT)
                Switch $vRetryKey
                    Case "max", "backoff", "maxDelay", "nonIdempotent"
                    Case Else
                        Return __AUI_HttpEasyFail($iRequestId, $AUI_ERR_INVALID_ARGUMENT)
                EndSwitch
            Next
            If MapExists($mRetries, "max") Then $iMaxRetries = $mRetries["max"]
            If MapExists($mRetries, "backoff") Then $iBackoffMs = $mRetries["backoff"]
            If MapExists($mRetries, "maxDelay") Then $iMaxDelayMs = $mRetries["maxDelay"]
            If MapExists($mRetries, "nonIdempotent") Then $bRetryNonIdempotent = $mRetries["nonIdempotent"]
            If Not IsBool($bRetryNonIdempotent) Then
                If Not __AUI_IsIntegerVariant($bRetryNonIdempotent) Or _
                        ($bRetryNonIdempotent <> 0 And $bRetryNonIdempotent <> 1) Then _
                    Return __AUI_HttpEasyFail($iRequestId, $AUI_ERR_INVALID_ARGUMENT)
                $bRetryNonIdempotent = ($bRetryNonIdempotent = 1)
            EndIf
            If Not _UI_HttpRequestSetRetryPolicy($iRequestId, $iMaxRetries, $iBackoffMs, $iMaxDelayMs, $bRetryNonIdempotent) Then _
                Return __AUI_HttpEasyFail($iRequestId, @error, @extended)
        EndIf

        Local $bHasBody = MapExists($mOptions, "body")
        Local $bHasBodyFile = MapExists($mOptions, "bodyFile")
        Local $bHasForm = MapExists($mOptions, "form")
        Local $bHasMultipart = MapExists($mOptions, "multipart") Or MapExists($mOptions, "files")
        Local $iBodyKinds = ($bHasBody ? 1 : 0) + ($bHasBodyFile ? 1 : 0) + ($bHasForm ? 1 : 0) + ($bHasMultipart ? 1 : 0)
        If $iBodyKinds > 1 Then Return __AUI_HttpEasyFail($iRequestId, $AUI_ERR_INVALID_ARGUMENT)
        If MapExists($mOptions, "contentType") And Not $bHasBody Then Return __AUI_HttpEasyFail($iRequestId, $AUI_ERR_INVALID_ARGUMENT)
        If $bHasBody Then
            Local $vBody = $mOptions["body"]
            If IsBinary($vBody) Then
                If MapExists($mOptions, "contentType") Then Return __AUI_HttpEasyFail($iRequestId, $AUI_ERR_INVALID_ARGUMENT)
                If Not _UI_HttpRequestSetBodyBytes($iRequestId, $vBody) Then Return __AUI_HttpEasyFail($iRequestId, @error, @extended)
            ElseIf IsString($vBody) Then
                Local $sContentType = ""
                If MapExists($mOptions, "contentType") Then
                    If Not IsString($mOptions["contentType"]) Then Return __AUI_HttpEasyFail($iRequestId, $AUI_ERR_INVALID_ARGUMENT)
                    $sContentType = $mOptions["contentType"]
                EndIf
                If Not _UI_HttpRequestSetBodyText($iRequestId, $vBody, $sContentType) Then Return __AUI_HttpEasyFail($iRequestId, @error, @extended)
            Else
                Return __AUI_HttpEasyFail($iRequestId, $AUI_ERR_INVALID_ARGUMENT)
            EndIf
        ElseIf $bHasBodyFile Then
            If Not IsString($mOptions["bodyFile"]) Or Not _UI_HttpRequestSetBodyFile($iRequestId, $mOptions["bodyFile"]) Then _
                Return __AUI_HttpEasyFail($iRequestId, @error ? @error : $AUI_ERR_INVALID_ARGUMENT, @extended)
        ElseIf $bHasForm Then
            Local $mForm = $mOptions["form"]
            If Not IsMap($mForm) Then Return __AUI_HttpEasyFail($iRequestId, $AUI_ERR_INVALID_ARGUMENT)
            Local $aFormNames = MapKeys($mForm)
            If @error Then Return __AUI_HttpEasyFail($iRequestId, $AUI_ERR_INVALID_ARGUMENT)
            For $vFormName In $aFormNames
                If VarGetType($vFormName) <> "String" Or Not IsString($mForm[$vFormName]) Then _
                    Return __AUI_HttpEasyFail($iRequestId, $AUI_ERR_INVALID_ARGUMENT)
                If Not _UI_HttpRequestAddFormField($iRequestId, $vFormName, $mForm[$vFormName]) Then _
                    Return __AUI_HttpEasyFail($iRequestId, @error, @extended)
            Next
        ElseIf $bHasMultipart Then
            If MapExists($mOptions, "multipart") Then
                Local $mMultipart = $mOptions["multipart"]
                If Not IsMap($mMultipart) Then Return __AUI_HttpEasyFail($iRequestId, $AUI_ERR_INVALID_ARGUMENT)
                Local $aMultipartNames = MapKeys($mMultipart)
                If @error Then Return __AUI_HttpEasyFail($iRequestId, $AUI_ERR_INVALID_ARGUMENT)
                For $vMultipartName In $aMultipartNames
                    If VarGetType($vMultipartName) <> "String" Or Not IsString($mMultipart[$vMultipartName]) Then _
                        Return __AUI_HttpEasyFail($iRequestId, $AUI_ERR_INVALID_ARGUMENT)
                    If Not _UI_HttpRequestAddMultipartField($iRequestId, $vMultipartName, $mMultipart[$vMultipartName]) Then _
                        Return __AUI_HttpEasyFail($iRequestId, @error, @extended)
                Next
            EndIf
            If MapExists($mOptions, "files") Then
                Local $mFiles = $mOptions["files"]
                If Not IsMap($mFiles) Then Return __AUI_HttpEasyFail($iRequestId, $AUI_ERR_INVALID_ARGUMENT)
                Local $aFileNames = MapKeys($mFiles)
                If @error Then Return __AUI_HttpEasyFail($iRequestId, $AUI_ERR_INVALID_ARGUMENT)
                For $vFileName In $aFileNames
                    If VarGetType($vFileName) <> "String" Then Return __AUI_HttpEasyFail($iRequestId, $AUI_ERR_INVALID_ARGUMENT)
                    Local $vFile = $mFiles[$vFileName]
                    Local $sFilePath = "", $sFileContentType = ""
                    If IsString($vFile) Then
                        $sFilePath = $vFile
                    ElseIf IsArray($vFile) And UBound($vFile) = 2 And IsString($vFile[0]) And IsString($vFile[1]) Then
                        $sFilePath = $vFile[0]
                        $sFileContentType = $vFile[1]
                    Else
                        Return __AUI_HttpEasyFail($iRequestId, $AUI_ERR_INVALID_ARGUMENT)
                    EndIf
                    If Not _UI_HttpRequestAddMultipartFile($iRequestId, $vFileName, $sFilePath, $sFileContentType) Then _
                        Return __AUI_HttpEasyFail($iRequestId, @error, @extended)
                Next
            EndIf
        EndIf

        If MapExists($mOptions, "auth") And MapExists($mOptions, "bearer") Then Return __AUI_HttpEasyFail($iRequestId, $AUI_ERR_INVALID_ARGUMENT)
        If MapExists($mOptions, "auth") Then
            Local $aAuth = $mOptions["auth"]
            If Not IsArray($aAuth) Or UBound($aAuth) <> 2 Or Not IsString($aAuth[0]) Or Not IsString($aAuth[1]) Then _
                Return __AUI_HttpEasyFail($iRequestId, $AUI_ERR_INVALID_ARGUMENT)
            If Not _UI_HttpRequestSetBasicAuth($iRequestId, $aAuth[0], $aAuth[1]) Then _
                Return __AUI_HttpEasyFail($iRequestId, @error, @extended)
        ElseIf MapExists($mOptions, "bearer") Then
            If Not IsString($mOptions["bearer"]) Or Not _UI_HttpRequestSetBearerAuth($iRequestId, $mOptions["bearer"]) Then _
                Return __AUI_HttpEasyFail($iRequestId, @error ? @error : $AUI_ERR_INVALID_ARGUMENT, @extended)
        EndIf

        Local $bHasOutputFile = MapExists($mOptions, "outputFile")
        If $bHasOutputFile And MapExists($mOptions, "responseMode") Then Return __AUI_HttpEasyFail($iRequestId, $AUI_ERR_INVALID_ARGUMENT)
        If $bHasOutputFile Then
            If Not IsString($mOptions["outputFile"]) Or Not _UI_HttpRequestSetOutputFile($iRequestId, $mOptions["outputFile"]) Then _
                Return __AUI_HttpEasyFail($iRequestId, @error ? @error : $AUI_ERR_INVALID_ARGUMENT, @extended)
        ElseIf Not _UI_HttpRequestSetResponseMode($iRequestId, $iMode) Then
            Return __AUI_HttpEasyFail($iRequestId, @error, @extended)
        EndIf

        If MapExists($mOptions, "responseBytes") Or MapExists($mOptions, "downloadBytes") Then
            Local $iResponseBytes = $AUI_NET_RESPONSE_LIMIT_DEFAULT
            Local $iDownloadBytes = $AUI_NET_DOWNLOAD_LIMIT_DEFAULT
            If MapExists($mOptions, "responseBytes") Then $iResponseBytes = $mOptions["responseBytes"]
            If MapExists($mOptions, "downloadBytes") Then $iDownloadBytes = $mOptions["downloadBytes"]
            If Not _UI_HttpRequestSetLimits($iRequestId, $iResponseBytes, $iDownloadBytes) Then _
                Return __AUI_HttpEasyFail($iRequestId, @error, @extended)
        EndIf
    ElseIf Not _UI_HttpRequestSetResponseMode($iRequestId, $iMode) Then
        Return __AUI_HttpEasyFail($iRequestId, @error, @extended)
    EndIf

    If Not __AUI_CbSet($__AUI_CB_HTTP_EASY_TIMER, $iRequestId, TimerInit(), 0, False) Then Return __AUI_HttpEasyFail($iRequestId, @error)
    If Not _UI_HttpRequestSend($iRequestId) Then Return __AUI_HttpEasyFail($iRequestId, @error, @extended)
    Return __AUI_HttpEasyResult($iRequestId)
EndFunc

; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_HttpRequestCreate
; 說明 ...: Creates a configurable asynchronous HTTP request.
; 語法 ........: _UI_HttpRequestCreate( $hWnd, $sMethod, $sUrl [, $iTimeout = 0 [, $iNetFlags = $AUI_NET_DEFAULT [, $sOnDone =
;                  "" [, $sOnProgress = ""]]]] )
; 參數 ....: $hWnd - Target window handle, the callback is executed on the UI thread of the window
;                  $sMethod - HTTP method, such as GET, POST, PUT, PATCH, DELETE, HEAD, or OPTIONS
;                  $sUrl - HTTP or HTTPS address
;                  $iTimeout - Total timeout in milliseconds; 0 uses the 30 second default
;                  $iNetFlags - Request level network security flags
;                  $sOnDone - Optional completion callback Func($iRequestId, $iState)
;                  $sOnProgress - Optional progress callback Func($iRequestId, $iDone, $iTotal)
; 傳回值 .: Success - Request ID; call _UI_HttpRequestSend after configuration is complete
;                  Failure - 0 and set @error
; 作者 ........: Fanxing
; 備註 .......: This function uses an isolated one-shot session. Use _UI_HttpSessionRequestCreate when requests must share
;                  connections, cookies, or a custom redirect policy. A process can retain at most 512 HTTP request objects. A
;                  completed request remains allocated until _UI_HttpRequestRelease is called. HTTP 4xx and 5xx mean that the
;                  server returned a response, so the state remains $AUI_HTTP_OK; inspect the HTTP status code separately for
;                  the application result. Prefer the one-step _UI_HttpRequest helper for ordinary requests to avoid manual
;                  configuration and release management.
; 範例 .......: Yes
; ===============================================================================================================================
Func _UI_HttpRequestCreate($hWnd, $sMethod, $sUrl, $iTimeout = 0, $iNetFlags = $AUI_NET_DEFAULT, $sOnDone = "", $sOnProgress = "")
    Local $vAuiHelperResult = __AUI_HttpRequestCreate(0, $hWnd, $sMethod, $sUrl, $iTimeout, $iNetFlags, $sOnDone, $sOnProgress)
    Return SetError(@error, @extended, $vAuiHelperResult)
EndFunc

; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_HttpSessionRequestCreate
; 說明 ...: Creates an asynchronous HTTP request from a reusable session.
; 語法 ........: _UI_HttpSessionRequestCreate( $iSessionId, $hWnd, $sMethod, $sUrl [, $iTimeout = 0 [, $iNetFlags =
;                  $AUI_NET_DEFAULT [, $sOnDone = "" [, $sOnProgress = ""]]]] )
; 參數 ....: $iSessionId - Session ID returned by _UI_HttpSessionCreate
;                  $hWnd - Target window handle, the callback is executed on the UI thread of the window
;                  $sMethod - HTTP method, such as GET, POST, PUT, PATCH, DELETE, HEAD, or OPTIONS
;                  $sUrl - HTTP or HTTPS address
;                  $iTimeout - Total timeout in milliseconds; 0 uses the 30-second default and includes all redirects
;                  $iNetFlags - Request level network security flags
;                  $sOnDone - Optional completion callback Func($iRequestId, $iState)
;                  $sOnProgress - Optional progress callback Func($iRequestId, $iDone, $iTotal)
; 傳回值 .: Success - Request ID; call _UI_HttpRequestSend after configuration is complete
;                  Failure - 0 and set @error
; 作者 ........: Fanxing
; 備註 .......: The request binds to the session when it is created. Releasing the public session ID later does not interrupt
;                  existing requests. Default headers and the redirect policy are snapshotted when sending starts, while cookies
;                  are selected again from the thread-safe jar before every hop.
; 相關函式 .......: _UI_HttpSessionCreate, _UI_HttpRequestCreate, _UI_HttpRequestSend
; 範例 .......: Yes
; ===============================================================================================================================
Func _UI_HttpSessionRequestCreate($iSessionId, $hWnd, $sMethod, $sUrl, $iTimeout = 0, $iNetFlags = $AUI_NET_DEFAULT, $sOnDone = "", $sOnProgress = "")
    Local $vAuiHelperResult = __AUI_HttpRequestCreate($iSessionId, $hWnd, $sMethod, $sUrl, $iTimeout, $iNetFlags, $sOnDone, $sOnProgress)
    Return SetError(@error, @extended, $vAuiHelperResult)
EndFunc

Func __AUI_HttpRequestCreate($iSessionId, $hWnd, $sMethod, $sUrl, $iTimeout, $iNetFlags, $sOnDone, $sOnProgress)
    Local $vAbortResult
    If __AUI_ValidateOptionalCallback($sOnDone) = 0 Or __AUI_ValidateOptionalCallback($sOnProgress) = 0 Then Return SetError(@error, 0, 0)
    Local $pDone = 0, $pProgress = 0
    If $sOnDone <> "" Then
        If $g_pAuiDispHttpDone = 0 Then $g_pAuiDispHttpDone = __AUI_RegisterCallback("__AUI_DispHttpDone", "int;int")
        If $g_pAuiDispHttpDone = 0 Then Return SetError(@error, 0, 0)
        $pDone = $g_pAuiDispHttpDone
    EndIf
    If $sOnProgress <> "" Then
        If $g_pAuiDispHttpProgress = 0 Then $g_pAuiDispHttpProgress = __AUI_RegisterCallback("__AUI_DispHttpProgress", "int;int64;int64")
        If $g_pAuiDispHttpProgress = 0 Then Return SetError(@error, 0, 0)
        $pProgress = $g_pAuiDispHttpProgress
    EndIf
    Local $aResult = __AUI_DllCall("int", "_UI_HttpRequestCreate", "int", $iSessionId, "hwnd", $hWnd, "wstr", $sMethod, "wstr", $sUrl, "int", $iTimeout, "uint", $iNetFlags, "ptr", $pDone, "ptr", $pProgress)
    Local $iDllError = @error, $iDllExtended = @extended
    If $iDllError Or Not IsArray($aResult) Then Return SetError($iDllError, $iDllExtended, 0)
    If $aResult[0] <= 0 Then
        Local $iNativeError = __AUI_ReadNativeLastError()
        Local $iNativeCallError = @error
        If $iNativeCallError Then Return SetError($iNativeCallError, 0, 0)
        If $iNativeError = $AUI_OK Then $iNativeError = $AUI_ERR_IO
        $g_iAuiUdfErrorCode = $iNativeError
        Return SetError($iNativeError, 0, 0)
    EndIf
    If $sOnDone <> "" And __AUI_CbSet($__AUI_CB_HTTP_DONE, $aResult[0], $sOnDone, 0, False) = 0 Then
        $vAbortResult = __AUI_HttpAbortRegistration($aResult[0], @error)
        Return SetError(@error, @extended, $vAbortResult)
    EndIf
    If $sOnProgress <> "" And __AUI_CbSet($__AUI_CB_HTTP_PROGRESS, $aResult[0], $sOnProgress, 0, False) = 0 Then
        $vAbortResult = __AUI_HttpAbortRegistration($aResult[0], @error)
        Return SetError(@error, @extended, $vAbortResult)
    EndIf
    If ($sOnDone <> "" Or $sOnProgress <> "") And __AUI_CbSet($__AUI_CB_HTTP_OWNER, $aResult[0], $hWnd, 0, False) = 0 Then
        $vAbortResult = __AUI_HttpAbortRegistration($aResult[0], @error)
        Return SetError(@error, @extended, $vAbortResult)
    EndIf
    Return SetError(0, 0, $aResult[0])
EndFunc

; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_HttpRequestSetHeader
; 說明 ...: Sets or replace a request header.
; 語法 ........: _UI_HttpRequestSetHeader( $iRequestId, $sName, $sValue )
; 參數 ....: $iRequestId - _UI_HttpRequestCreate Request ID returned
;                  $sName - Header name
;                  $sValue - Header value
; 傳回值 .: Success - 1
;                  Failure - 0
; 作者 ........: Fanxing
; 備註 .......: One request accepts at most 128 headers. A name is limited to 256 characters and a value to 8,192. CR/LF
;                  injection and the runtime-managed Content-Length, Transfer-Encoding, and Cookie headers are rejected.
; 範例 .......: No
; ===============================================================================================================================
Func _UI_HttpRequestSetHeader($iRequestId, $sName, $sValue)
    Local $vAuiForwardResult = __AUI_Call("int", "_UI_HttpRequestSetHeader", "int", $iRequestId, "wstr", $sName, "wstr", $sValue)
    Return SetError(@error, @extended, $vAuiForwardResult)
EndFunc

; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_HttpRequestAddQuery
; 說明 ...: Appends a UTF-8 percent-encoded query parameter to the request URL.
; 語法 ........: _UI_HttpRequestAddQuery( $iRequestId, $sName, $sValue )
; 參數 ....: $iRequestId - Request ID
;                  $sName - Parameter name
;                  $sValue - Parameter value
; 傳回值 .: Success - 1
;                  Failure - 0
; 作者 ........: Fanxing
; 備註 .......: The name and value are converted to UTF-8 and percent-encoded using URL query rules; spaces become %20. The
;                  complete encoded URL remains limited to 4,096 UTF-16 code units. Repeated names are preserved in call order.
; 範例 .......: No
; ===============================================================================================================================
Func _UI_HttpRequestAddQuery($iRequestId, $sName, $sValue)
    Local $vResult = __AUI_Call("int", "_UI_HttpRequestAddQuery", "int", $iRequestId, "wstr", $sName, "wstr", $sValue)
    Return SetError(@error, @extended, $vResult)
EndFunc
; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_HttpRequestSetBodyText
; 說明 ...: Sets UTF-8 text request body.
; 語法 ........: _UI_HttpRequestSetBodyText( $iRequestId, $sText [, $sContentType = ""] )
; 參數 ....: $iRequestId - Request ID
;                  $sText - AutoIt text, converted to UTF-8
;                  $sContentType - [Optional] Content-Type; use text/plain when empty; charset=utf-8
; 傳回值 .: Success - 1
;                  Failure - 0
; 作者 ........: Fanxing
; 備註 .......: Text is converted strictly to UTF-8. An in-memory request body is limited to 128 MiB. The call sets or
;                  replaces Content-Type.
; 範例 .......: No
; ===============================================================================================================================
Func _UI_HttpRequestSetBodyText($iRequestId, $sText, $sContentType = "")
    Local $vAuiForwardResult = __AUI_Call("int", "_UI_HttpRequestSetBodyText", "int", $iRequestId, "wstr", $sText, "wstr", $sContentType)
    Return SetError(@error, @extended, $vAuiForwardResult)
EndFunc
; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_HttpRequestSetBodyBytes
; 說明 ...: Sets binary request body.
; 語法 ........: _UI_HttpRequestSetBodyBytes( $iRequestId, $vBinary )
; 參數 ....: $iRequestId - Request ID
;                  $vBinary - AutoIt Binary value
; 傳回值 .: Success - 1
;                  Failure - 0
; 作者 ........: Fanxing
; 備註 .......: Accepts only an AutoIt Binary value. An in-memory request body is limited to 128 MiB, and an empty Binary
;                  value is a valid empty body.
; 範例 .......: No
; ===============================================================================================================================
Func _UI_HttpRequestSetBodyBytes($iRequestId, $vBinary)
    If Not IsBinary($vBinary) Then
        Local $vInvalidResult = __AUI_Fail($AUI_ERR_INVALID_ARGUMENT, 0, 0)
        Return SetError(@error, @extended, $vInvalidResult)
    EndIf
    Local $iSize = BinaryLen($vBinary), $iCapacity = $iSize
    If $iCapacity < 1 Then $iCapacity = 1
    Local $tBytes = DllStructCreate("byte[" & $iCapacity & "]")
    If $iSize > 0 Then DllStructSetData($tBytes, 1, $vBinary)
    Local $vAuiForwardResult = __AUI_Call("int", "_UI_HttpRequestSetBodyBytes", "int", $iRequestId, "ptr", DllStructGetPtr($tBytes), "int", $iSize)
    Return SetError(@error, @extended, $vAuiForwardResult)
EndFunc
; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_HttpRequestSetBodyFile
; 說明 ...: Streaming read request body from local file.
; 語法 ........: _UI_HttpRequestSetBodyFile( $iRequestId, $sPath )
; 參數 ....: $iRequestId - Request ID
;                  $sPath - Local file path
; 傳回值 .: Success - 1
;                  Failure - 0
; 作者 ........: Fanxing
; 備註 .......: The file is streamed on a background thread and is limited to 64 GiB. It is reopened when transmission
;                  starts, and the current file content is sent.
; 範例 .......: No
; ===============================================================================================================================
Func _UI_HttpRequestSetBodyFile($iRequestId, $sPath)
    Local $vAuiForwardResult = __AUI_Call("int", "_UI_HttpRequestSetBodyFile", "int", $iRequestId, "wstr", $sPath)
    Return SetError(@error, @extended, $vAuiForwardResult)
EndFunc

; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_HttpRequestAddFormField
; 說明 ...: Adds a field to an application/x-www-form-urlencoded request body.
; 語法 ........: _UI_HttpRequestAddFormField( $iRequestId, $sName, $sValue )
; 參數 ....: $iRequestId - Request ID
;                  $sName - Field name
;                  $sValue - Field value
; 傳回值 .: Success - 1
;                  Failure - 0
; 作者 ........: Fanxing
; 備註 .......: Names and values are encoded using UTF-8 form rules, with spaces represented by +. Repeated fields are
;                  preserved in call order. Form, multipart, text, Binary, and file bodies are mutually exclusive. A field name
;                  is limited to 1,024 characters, a field value to 16 Mi UTF-16 characters, and the encoded in-memory body to
;                  128 MiB.
; 範例 .......: No
; ===============================================================================================================================
Func _UI_HttpRequestAddFormField($iRequestId, $sName, $sValue)
    Local $vResult = __AUI_Call("int", "_UI_HttpRequestAddFormField", "int", $iRequestId, "wstr", $sName, "wstr", $sValue)
    Return SetError(@error, @extended, $vResult)
EndFunc

; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_HttpRequestAddMultipartField
; 說明 ...: Adds a UTF-8 text field to a multipart/form-data request body.
; 語法 ........: _UI_HttpRequestAddMultipartField( $iRequestId, $sName, $sValue )
; 參數 ....: $iRequestId - Request ID
;                  $sName - Field name
;                  $sValue - Field value
; 傳回值 .: Success - 1
;                  Failure - 0
; 作者 ........: Fanxing
; 備註 .......: One request accepts at most 128 multipart fields and files. A field name is limited to 1,024 characters and a
;                  field value to 16 Mi UTF-16 characters. The runtime generates a random boundary and rejects names that could
;                  break the header structure.
; 相關函式 .......: _UI_HttpRequestAddMultipartFile
; 範例 .......: No
; ===============================================================================================================================
Func _UI_HttpRequestAddMultipartField($iRequestId, $sName, $sValue)
    Local $vResult = __AUI_Call("int", "_UI_HttpRequestAddMultipartField", "int", $iRequestId, "wstr", $sName, "wstr", $sValue)
    Return SetError(@error, @extended, $vResult)
EndFunc

; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_HttpRequestAddMultipartFile
; 說明 ...: Adds a streamed file part to a multipart/form-data request body.
; 語法 ........: _UI_HttpRequestAddMultipartFile( $iRequestId, $sName, $sPath [, $sContentType = ""] )
; 參數 ....: $iRequestId - Request ID
;                  $sName - Field name
;                  $sPath - Local file path
;                  $sContentType - [Optional] File Content-Type; an empty string uses application/octet-stream
; 傳回值 .: Success - 1
;                  Failure - 0
; 作者 ........: Fanxing
; 備註 .......: The worker streams the file instead of loading it entirely into memory and reopens it before the initial send
;                  and every retry. One file and the complete multipart body are each limited to 64 GiB; one request accepts at
;                  most 128 parts.
; 相關函式 .......: _UI_HttpRequestAddMultipartField
; 範例 .......: No
; ===============================================================================================================================
Func _UI_HttpRequestAddMultipartFile($iRequestId, $sName, $sPath, $sContentType = "")
    Local $vResult = __AUI_Call("int", "_UI_HttpRequestAddMultipartFile", "int", $iRequestId, "wstr", $sName, "wstr", $sPath, "wstr", $sContentType)
    Return SetError(@error, @extended, $vResult)
EndFunc

; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_HttpRequestSetBasicAuth
; 說明 ...: Sets the HTTP Basic Authorization header.
; 語法 ........: _UI_HttpRequestSetBasicAuth( $iRequestId, $sUser, $sPassword )
; 參數 ....: $iRequestId - Request ID
;                  $sUser - User name; cannot be empty or contain a colon
;                  $sPassword - Password
; 傳回值 .: Success - 1
;                  Failure - 0
; 作者 ........: Fanxing
; 備註 .......: AUI encodes user:password as UTF-8 and then Base64. Basic authentication encodes credentials but does not
;                  encrypt them, so send it only over HTTPS. Cross-origin redirects remove Authorization.
; 相關函式 .......: _UI_HttpRequestSetBearerAuth
; 範例 .......: No
; ===============================================================================================================================
Func _UI_HttpRequestSetBasicAuth($iRequestId, $sUser, $sPassword)
    Local $vResult = __AUI_Call("int", "_UI_HttpRequestSetBasicAuth", "int", $iRequestId, "wstr", $sUser, "wstr", $sPassword)
    Return SetError(@error, @extended, $vResult)
EndFunc

; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_HttpRequestSetBearerAuth
; 說明 ...: Sets the Bearer Authorization header.
; 語法 ........: _UI_HttpRequestSetBearerAuth( $iRequestId, $sToken )
; 參數 ....: $iRequestId - Request ID
;                  $sToken - Non-empty Bearer token
; 傳回值 .: Success - 1
;                  Failure - 0
; 作者 ........: Fanxing
; 備註 .......: The token is limited to 8,192 characters and cannot contain CR or LF. Cross-origin redirects remove
;                  Authorization.
; 相關函式 .......: _UI_HttpRequestSetBasicAuth
; 範例 .......: No
; ===============================================================================================================================
Func _UI_HttpRequestSetBearerAuth($iRequestId, $sToken)
    Local $vResult = __AUI_Call("int", "_UI_HttpRequestSetBearerAuth", "int", $iRequestId, "wstr", $sToken)
    Return SetError(@error, @extended, $vResult)
EndFunc

; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_HttpRequestSetProxy
; 說明 ...: Overrides the proxy policy for the current request.
; 語法 ........: _UI_HttpRequestSetProxy( $iRequestId [, $iMode = $AUI_HTTP_PROXY_SYSTEM [, $sProxy = "" [, $sBypass = "" [,
;                  $sUser = "" [, $sPassword = ""]]]]] )
; 參數 ....: $iRequestId - Request ID
;                  $iMode - SYSTEM, DIRECT, or NAMED proxy mode
;                  $sProxy - [Optional] Proxy address for NAMED mode
;                  $sBypass - [Optional] WinHTTP bypass list for NAMED mode
;                  $sUser - [Optional] Proxy user name
;                  $sPassword - [Optional] Proxy password
; 傳回值 .: Success - 1
;                  Failure - 0
; 作者 ........: Fanxing
; 備註 .......: Request-level settings override the session defaults. A Session reuses a separate WinHTTP transport session
;                  for each proxy configuration. Proxy credentials are set through WinHTTP proxy options and are not written as
;                  ordinary request headers.
; 相關函式 .......: _UI_HttpSessionSetProxy
; 範例 .......: No
; ===============================================================================================================================
Func _UI_HttpRequestSetProxy($iRequestId, $iMode = $AUI_HTTP_PROXY_SYSTEM, $sProxy = "", $sBypass = "", $sUser = "", $sPassword = "")
    Local $vResult = __AUI_Call("int", "_UI_HttpRequestSetProxy", "int", $iRequestId, "int", $iMode, "wstr", $sProxy, "wstr", $sBypass, "wstr", $sUser, "wstr", $sPassword)
    Return SetError(@error, @extended, $vResult)
EndFunc

; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_HttpRequestSetTimeouts
; 說明 ...: Sets the resolve, connect, send, receive, and total timeouts.
; 語法 ........: _UI_HttpRequestSetTimeouts( $iRequestId, $iResolveMs, $iConnectMs, $iSendMs, $iReceiveMs, $iTotalMs )
; 參數 ....: $iRequestId - Request ID
;                  $iResolveMs - DNS resolution timeout in milliseconds
;                  $iConnectMs - Connect-phase timeout in milliseconds
;                  $iSendMs - Send-phase timeout in milliseconds
;                  $iReceiveMs - Receive-phase timeout in milliseconds
;                  $iTotalMs - Total time budget in milliseconds, starting when Send queues the request
; 傳回值 .: Success - 1
;                  Failure - 0
; 作者 ........: Fanxing
; 備註 .......: Each value ranges from 1 through 86,400,000. A phase cannot consume more than the remaining total budget;
;                  queueing, redirects, retry delays, uploads, and downloads all count toward the total timeout.
; 範例 .......: No
; ===============================================================================================================================
Func _UI_HttpRequestSetTimeouts($iRequestId, $iResolveMs, $iConnectMs, $iSendMs, $iReceiveMs, $iTotalMs)
    Local $vResult = __AUI_Call("int", "_UI_HttpRequestSetTimeouts", "int", $iRequestId, "int", $iResolveMs, "int", $iConnectMs, "int", $iSendMs, "int", $iReceiveMs, "int", $iTotalMs)
    Return SetError(@error, @extended, $vResult)
EndFunc

; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_HttpRequestSetRetryPolicy
; 說明 ...: Configures automatic retries for temporary transport errors and selected HTTP status codes.
; 語法 ........: _UI_HttpRequestSetRetryPolicy( $iRequestId [, $iMaxRetries = 0 [, $iBackoffMs = 250 [, $iMaxDelayMs = 5000 [,
;                  $bRetryNonIdempotent = False]]]] )
; 參數 ....: $iRequestId - Request ID
;                  $iMaxRetries - Number of additional retries, from 0 through 5
;                  $iBackoffMs - Initial exponential-backoff delay in milliseconds, from 1 through 60,000
;                  $iMaxDelayMs - Maximum delay for one retry in milliseconds, from backoff through 60,000
;                  $bRetryNonIdempotent - Whether retries are allowed for non-idempotent requests such as POST and PATCH
; 傳回值 .: Success - 1
;                  Failure - 0
; 作者 ........: Fanxing
; 備註 .......: Retries are disabled by default. When enabled, GET, HEAD, PUT, DELETE, OPTIONS, and TRACE may be retried.
;                  POST, PATCH, and other non-idempotent methods are replayed only when $bRetryNonIdempotent=True, and the
;                  caller must ensure that duplicate submission is safe. Status codes 408, 429, 500, 502, 503, and 504, plus
;                  temporary connection, resolution, and replay errors, are retryable. Retry-After accepts either seconds or an
;                  HTTP-date and remains bounded by the maximum delay and total timeout. File bodies and multipart files are
;                  reopened from the beginning for every retry.
; 相關函式 .......: _UI_HttpRequestGetAttemptCount
; 範例 .......: No
; ===============================================================================================================================
Func _UI_HttpRequestSetRetryPolicy($iRequestId, $iMaxRetries = 0, $iBackoffMs = 250, $iMaxDelayMs = 5000, $bRetryNonIdempotent = False)
    Local $vResult = __AUI_Call("int", "_UI_HttpRequestSetRetryPolicy", "int", $iRequestId, "int", $iMaxRetries, "int", $iBackoffMs, "int", $iMaxDelayMs, "int", $bRetryNonIdempotent ? 1 : 0)
    Return SetError(@error, @extended, $vResult)
EndFunc
; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_HttpRequestSetOutputFile
; 說明 ...: Stream success response to file and replace target atomically.
; 語法 ........: _UI_HttpRequestSetOutputFile( $iRequestId, $sPath )
; 參數 ....: $iRequestId - Request ID
;                  $sPath - Output file path
; 傳回值 .: Success - 1
;                  Failure - 0
; 作者 ........: Fanxing
; 備註 .......: The default file-response limit is 1 GiB and can be raised to 64 GiB with _UI_HttpRequestSetLimits. AUI
;                  writes a temporary file in the target directory and atomically replaces the target only after success;
;                  failure, cancellation, or timeout preserves the original target. Setting an output file selects file-response
;                  mode, so _UI_HttpRequestSetResponseMode is no longer accepted and no in-memory text or Binary body is
;                  available.
; 範例 .......: No
; ===============================================================================================================================
Func _UI_HttpRequestSetOutputFile($iRequestId, $sPath)
    Local $vAuiForwardResult = __AUI_Call("int", "_UI_HttpRequestSetOutputFile", "int", $iRequestId, "wstr", $sPath)
    Return SetError(@error, @extended, $vAuiForwardResult)
EndFunc

; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_HttpRequestSetResponseMode
; 說明 ...: Sets how an in-memory HTTP response is retained.
; 語法 ........: _UI_HttpRequestSetResponseMode( $iRequestId, $iMode )
; 參數 ....: $iRequestId - Request ID
;                  $iMode - $AUI_HTTP_RESPONSE_TEXT or $AUI_HTTP_RESPONSE_BINARY
; 傳回值 .: Success - 1
;                  Failure - 0
; 作者 ........: Fanxing
; 備註 .......: Text mode is the default. On completion, AUI decodes the response to UTF-16 according to its BOM or
;                  Content-Type charset, releases the original bytes, and exposes the content only through
;                  _UI_HttpRequestGetText. Decoded text is limited to 33,554,432 UTF-16 code units. Binary mode retains the
;                  original bytes without creating a UTF-16 copy and exposes them only through _UI_HttpRequestGetBody. File
;                  downloads use _UI_HttpRequestSetOutputFile and cannot also set this mode.
; 相關函式 .......: _UI_HttpRequestGetText, _UI_HttpRequestGetBody, _UI_HttpRequestSetOutputFile
; 範例 .......: No
; ===============================================================================================================================
Func _UI_HttpRequestSetResponseMode($iRequestId, $iMode)
    Local $vAuiForwardResult = __AUI_Call("int", "_UI_HttpRequestSetResponseMode", "int", $iRequestId, "int", $iMode)
    Return SetError(@error, @extended, $vAuiForwardResult)
EndFunc
; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_HttpRequestSend
; 說明 ...: Starts HTTP request in background thread.
; 語法 ........: _UI_HttpRequestSend( $iRequestId )
; 參數 ....: $iRequestId - Request ID
; 傳回值 .: Success - 1
;                  Failure - 0
; 作者 ........: Fanxing
; 備註 .......: Does not block the AutoIt UI thread. Configuration is frozen after a successful send. The completion callback
;                  is delivered exactly once and only after the request reaches the succeeded, failed, cancelled, or timed-out
;                  terminal state. A window notification received while the request is still running does not complete or
;                  release it.
; 範例 .......: No
; ===============================================================================================================================
Func _UI_HttpRequestSend($iRequestId)
    Local $vAuiForwardResult = __AUI_Call("int", "_UI_HttpRequestSend", "int", $iRequestId)
    Return SetError(@error, @extended, $vAuiForwardResult)
EndFunc
; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_HttpRequestCancel
; 說明 ...: Cancels an HTTP request.
; 語法 ........: _UI_HttpRequestCancel( $iRequestId )
; 參數 ....: $iRequestId - Request ID
; 傳回值 .: Success - 1
;                  Failure - 0
; 作者 ........: Fanxing
; 備註 .......: A configured or running request can be cancelled; a terminal request cannot be cancelled again. The
;                  completion callback still receives $AUI_HTTP_CANCELLED and is invoked exactly once.
; 範例 .......: No
; ===============================================================================================================================
Func _UI_HttpRequestCancel($iRequestId)
    Local $vAuiForwardResult = __AUI_Call("int", "_UI_HttpRequestCancel", "int", $iRequestId)
    Return SetError(@error, @extended, $vAuiForwardResult)
EndFunc
; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_HttpRequestRelease
; 說明 ...: Releases an HTTP request object and its response.
; 語法 ........: _UI_HttpRequestRelease( $iRequestId )
; 參數 ....: $iRequestId - Request ID
; 傳回值 .: Success - 1
;                  Failure - 0; a running request or a terminal request whose completion callback is still pending cannot be
;                  released
; 作者 ........: Fanxing
; 備註 .......: A configured request can be released immediately. If a terminal request has a completion callback, it cannot
;                  be released until that callback has been delivered, which prevents completion notification loss. The request
;                  ID becomes invalid immediately after release; do not release a running request from its progress callback.
; 範例 .......: No
; ===============================================================================================================================
Func _UI_HttpRequestRelease($iRequestId)
    Local $v = __AUI_Call("int", "_UI_HttpRequestRelease", "int", $iRequestId)
    Local $iError = @error, $iExtended = @extended
    If $v Then
        __AUI_CbDel($__AUI_CB_HTTP_DONE, $iRequestId)
        __AUI_CbDel($__AUI_CB_HTTP_PROGRESS, $iRequestId)
        __AUI_CbDel($__AUI_CB_HTTP_OWNER, $iRequestId)
        __AUI_HttpEasyCleanup($iRequestId)
    EndIf
    Return SetError($iError, $iExtended, $v)
EndFunc
; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_HttpRequestStatus
; 說明 ...: Queries HTTP request status.
; 語法 ........: _UI_HttpRequestStatus( $iRequestId )
; 參數 ....: $iRequestId - Request ID
; 傳回值 .: Success - $AUI_HTTP_* status value
;                  Failure - -1
; 作者 ........: Fanxing
; 備註 .......: The state progresses from CONFIGURED to RUNNING, then ends as OK, FAILED, CANCELLED, or TIMEOUT.
; 範例 .......: No
; ===============================================================================================================================
Func _UI_HttpRequestStatus($iRequestId)
    Local $vAuiForwardResult = __AUI_Call("int", "_UI_HttpRequestStatus", "int", $iRequestId)
    Return SetError(@error, @extended, $vAuiForwardResult)
EndFunc
