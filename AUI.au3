; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_FileHashAsync
; 說明 ...: Computes file digest on background thread.
; 語法 ........: _UI_FileHashAsync( $hWnd, $sPath, $iAlgo, $sOnDone )
; 參數 ....: $hWnd - Window handle
;                  $sPath - File path to be read
;                  $iAlgo - $AUI_HASH_MD5, $AUI_HASH_SHA1 or $AUI_HASH_SHA256
;                  $sOnDone - Completion callback name, signature Func($iTaskId, $iStatus)
; 傳回值 .: Success - Task ID (>=1); upon success, _UI_AsyncResult returns a lowercase hexadecimal summary
;                  Failure - 0
; 作者 ........: Fanxing
; 相關函式 .......: _UI_AsyncResult
; 範例 .......: Yes
; ===============================================================================================================================
Func _UI_FileHashAsync($hWnd, $sPath, $iAlgo, $sOnDone)
    Local $iError
    If __AUI_ValidateOptionalCallback($sOnDone) = 0 Then Return SetError(@error, 0, 0)
    If $g_pAuiDispAsyncDone = 0 Then $g_pAuiDispAsyncDone = __AUI_RegisterCallback("__AUI_DispAsyncDone", "int;int")
    If $g_pAuiDispAsyncDone = 0 Then Return SetError(@error, 0, 0)
    Local $iId = __AUI_Call("int", "_UI_FileHashAsync", "hwnd", $hWnd, "wstr", $sPath, "int", $iAlgo, "ptr", $g_pAuiDispAsyncDone)
    If @error Then Return SetError(@error, 0, 0)
    If $iId > 0 Then
        If __AUI_CbSet($__AUI_CB_ASYNC_DONE, $iId, $sOnDone) = 0 Then
            $iError = @error
            __AUI_AsyncAbortRegistration($iId)
            Return SetError($iError, 0, 0)
        EndIf
        If __AUI_CbSet($__AUI_CB_ASYNC_OWNER, $iId, $hWnd, 0, False) = 0 Then
            $iError = @error
            __AUI_AsyncAbortRegistration($iId)
            Return SetError($iError, 0, 0)
        EndIf
    EndIf
    Return $iId
EndFunc

; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_DirScanAsync
; 說明 ...: Scans a directory recursively on a worker thread and reports the file count and total byte count.
; 語法 ........: _UI_DirScanAsync( $hWnd, $sDir, $sOnDone [, $bRecursive = True] )
; 參數 ....: $hWnd - Window handle
;                  $sDir - Directory path to scan
;                  $sOnDone - Completion callback name, signature Func($iTaskId, $iStatus)
;                  $bRecursive - [Optional] Whether to scan recursively, default True
; 傳回值 .: Success - Task ID (>=1); the first line of the result is "Number of files <Tab> total bytes", followed by
;                  file details
;                  Failure - 0
; 作者 ........: Fanxing
; 相關函式 .......: _UI_AsyncResult
; 範例 .......: Yes
; ===============================================================================================================================
Func _UI_DirScanAsync($hWnd, $sDir, $sOnDone, $bRecursive = True)
    Local $iError
    If __AUI_ValidateOptionalCallback($sOnDone) = 0 Then Return SetError(@error, 0, 0)
    If $g_pAuiDispAsyncDone = 0 Then $g_pAuiDispAsyncDone = __AUI_RegisterCallback("__AUI_DispAsyncDone", "int;int")
    If $g_pAuiDispAsyncDone = 0 Then Return SetError(@error, 0, 0)
    Local $iId = __AUI_Call("int", "_UI_DirScanAsync", "hwnd", $hWnd, "wstr", $sDir, "int", $bRecursive ? 1 : 0, "ptr", $g_pAuiDispAsyncDone)
    If @error Then Return SetError(@error, 0, 0)
    If $iId > 0 Then
        If __AUI_CbSet($__AUI_CB_ASYNC_DONE, $iId, $sOnDone) = 0 Then
            $iError = @error
            __AUI_AsyncAbortRegistration($iId)
            Return SetError($iError, 0, 0)
        EndIf
        If __AUI_CbSet($__AUI_CB_ASYNC_OWNER, $iId, $hWnd, 0, False) = 0 Then
            $iError = @error
            __AUI_AsyncAbortRegistration($iId)
            Return SetError($iError, 0, 0)
        EndIf
    EndIf
    Return $iId
EndFunc

