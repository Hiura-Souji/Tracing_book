; ────────────────────────────────────────────────────────────────────────────
;  Menu
; ────────────────────────────────────────────────────────────────────────────
; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_Menu
; 說明 ...: Creates dropdown menu button (OnValue callback gives item index).
; 語法 ........: _UI_Menu( $hWnd, $iParent, $sLabel, $sItems [, $iX = 0 [, $iY = 0 [, $iW = 0 [, $iH = 0]]]] )
; 參數 ....: $hWnd - Window handle returned by _UI_WindowCreate
;                  $iParent - Parent element ID; use 0 for the window root
;                  $sLabel - Menu button text
;                  $sItems - Menu items, vertical bar | separated (OnValue callback gives item index)
;                  $iX - [Optional] Logical X coordinate (relative to parent container; ignored in flexible containers such as
;                  Row/Column), default 0
;                  $iY - [Optional] Logical Y coordinate (relative to parent container; ignored in flexible containers), default
;                  0
;                  $iW - [Optional] Logical width; 0 = automatic measurement by trigger text, default 0
;                  $iH - [Optional] Logical height; 0 = automatically determined/filled by layout, default 0
; 傳回值 .: Success - New element ID (integer, >= 1)
;                  Failure - 0
; 作者 ........: Fanxing
; 相關函式 .......: _UI_ContextMenu, _UI_OnValue
; 範例 .......: Yes
; ===============================================================================================================================
Func _UI_Menu($hWnd, $iParent, $sLabel, $sItems, _
              $iX = 0, $iY = 0, $iW = 0, $iH = 0)
    Local $vAuiForwardResult = __AUI_Call("int", "_UI_Menu", _
