;                  $iTree - Tree control ID (_UI_Tree returned)
; 傳回值 .: Success - 1
;                  Failure - 0; there is no matching BeginUpdate or the control is invalid
; 作者 ........: Fanxing
; 範例 .......: Yes
; ===============================================================================================================================
Func _UI_TreeEndUpdate($hWnd, $iTree)
    Local $vAuiForwardResult = __AUI_Call("int", "_UI_TreeEndUpdate", "hwnd", $hWnd, "int", $iTree)
    Return SetError(@error, @extended, $vAuiForwardResult)
EndFunc

