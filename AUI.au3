; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_EditSetMaxLength
; 說明 ...: Sets the maximum number of user-visible characters, counted in extended grapheme clusters; typing, pasting,
;                  and AutoComplete candidate commit are all limited by this value.
; 語法 ........: _UI_EditSetMaxLength( $hWnd, $iId, $iMaxLength )
; 參數 ....: $hWnd - Window handle
;                  $iId - Edit control element ID
;                  $iMaxLength - Maximum number of extended grapheme clusters; 0 means unlimited
; 傳回值 .: Success - 1
;                  Failure - 0; the setting is rejected with @error=$AUI_ERR_OUT_OF_RANGE when $iMaxLength is negative, the
;                  current text already exceeds the new limit, or the limit is below the required minimum (existing text is
;                  never truncated)
; 作者 ........: Fanxing
; 範例 .......: Yes
; ===============================================================================================================================
Func _UI_EditSetMaxLength($hWnd, $iId, $iMaxLength)
    Local $vAuiForwardResult = __AUI_Call("int", "_UI_EditSetMaxLength", "hwnd", $hWnd, "int", $iId, "int", $iMaxLength)
    Return SetError(@error, @extended, $vAuiForwardResult)
EndFunc

