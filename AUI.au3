; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_EditGetPadding
; 說明 ...: Retrieves the logical pixel padding of the edit content.
; 語法 ........: _UI_EditGetPadding( $hWnd, $iId )
; 參數 ....: $hWnd - Window handle
;                  $iId - Edit control element ID
; 傳回值 .: Success - Four-element array [left, top, right, bottom]
;                  Failure - 0
; 作者 ........: Fanxing
; 範例 .......: Yes
; ===============================================================================================================================
Func _UI_EditGetPadding($hWnd, $iId)
    If __AUI_EnsureDll() = 0 Then Return SetError($g_iAuiLoadError, 0, 0)
    Local $aCall = __AUI_DllCall("int", "_UI_EditGetPadding", "hwnd", $hWnd, "int", $iId, _
            "int*", 0, "int*", 0, "int*", 0, "int*", 0)
    Local $iDllError = @error
    If $iDllError Or Not IsArray($aCall) Then Return SetError($iDllError, 0, 0)
    If Not $aCall[0] Then Return SetError(__AUI_ReadNativeLastError(), 0, 0)
    Local $aPadding[4] = [$aCall[3], $aCall[4], $aCall[5], $aCall[6]]
    Return $aPadding
EndFunc

