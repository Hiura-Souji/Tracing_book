EndFunc

; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_JsonCount
; 說明 ...: Returns the number of entries at a path: key count for an object, element count for an array.
; 語法 ........: _UI_JsonCount( $iJson [, $sPath = ""] )
; 參數 ....: $iJson - Document handle
;                  $sPath - [Optional] Path; empty string or omitted = root
; 傳回值 .: Success - Entry count (0 for an empty container)
;                  Failure - -1; the value is not an object or array ($AUI_ERR_WRONG_ELEMENT_TYPE)
; 作者 ........: Fanxing
; 相關函式 .......: _UI_JsonType, _UI_JsonKeyName
; 範例 .......: No
; ===============================================================================================================================
Func _UI_JsonCount($iJson, $sPath = "")
    Local $vAuiForwardResult = __AUI_Call("int", "_UI_JsonCount", "int", $iJson, "wstr", $sPath)
