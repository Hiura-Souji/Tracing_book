; ────────────────────────────────────────────────────────────────────────────
;  Notify
; ────────────────────────────────────────────────────────────────────────────
; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_Notify
; 說明 ...: Displays an auto-dismissing notification card in the upper-right corner of a window.
; 語法 ........: _UI_Notify( $hWnd, $sTitle [, $sBody = "" [, $iVariant = $AUI_NOTIFY_INFO [, $iDuration = 3000]]] )
; 參數 ....: $hWnd - Window handle returned by _UI_WindowCreate
;                  $sTitle - Notification title; the short message can be passed in directly as the title
;                  $sBody - [Optional] Text content, default ""
;                  $iVariant - [Optional] Type $AUI_NOTIFY_*, default $AUI_NOTIFY_INFO
;                  $iDuration - [Optional] Dwell milliseconds, default 3000, maximum 60000
; 傳回值 .: Success - Stable notification ID (greater than 0), can be used to close in advance or query status
;                  Failure - 0 (the window is invalid, or both title and text are empty)
; 作者 ........: Fanxing
; 備註 .......: A window shows at most 8 notifications at once; beyond that the oldest one is evicted and its ID becomes
;                  invalid immediately, so further use returns $AUI_ERR_OUT_OF_RANGE. The display duration must be 1-60000 ms;
;                  out-of-range values are rejected.
; 相關函式 .......: _UI_MessageBox, _UI_Dialog
; 範例 .......: Yes
; ===============================================================================================================================
Func _UI_Notify($hWnd, $sTitle, $sBody = "", $iVariant = $AUI_NOTIFY_INFO, $iDuration = 3000)
    Local $vAuiForwardResult = __AUI_Call("int64", "_UI_Notify", _
                      "hwnd", $hWnd, "wstr", $sTitle, "wstr", $sBody, _
                      "int", $iVariant, "int", $iDuration)
    Return SetError(@error, @extended, $vAuiForwardResult)
EndFunc

; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_NotifyUpdate
; 說明 ...: Atomically updates an existing notification and restarts its timeout.
; 語法 ........: _UI_NotifyUpdate( $hWnd, $iNotification, $sTitle [, $sBody = "" [, $iVariant = $AUI_NOTIFY_INFO [, $iDuration
;                  = 3000]]] )
; 參數 ....: $hWnd - Window handle returned by _UI_WindowCreate
;                  $iNotification - Stable notification ID returned by _UI_Notify
;                  $sTitle - New title; title and body cannot be empty at the same time
;                  $sBody - [Optional] New text, default ""
;                  $iVariant - [Optional] New type $AUI_NOTIFY_*, default $AUI_NOTIFY_INFO
;                  $iDuration - [Optional] New display duration in the 1–60,000 ms range; default is 3,000 ms.
; 傳回值 .: Success - 1
;                  Failure - 0
; 作者 ........: Fanxing
; 相關函式 .......: _UI_Notify, _UI_NotifyGetTitle, _UI_NotifyGetBody
; 範例 .......: Yes
; ===============================================================================================================================
Func _UI_NotifyUpdate($hWnd, $iNotification, $sTitle, $sBody = "", $iVariant = $AUI_NOTIFY_INFO, $iDuration = 3000)
    Local $vAuiForwardResult = __AUI_Call("int", "_UI_NotifyUpdate", _
                      "hwnd", $hWnd, "int64", $iNotification, "wstr", $sTitle, "wstr", $sBody, _
                      "int", $iVariant, "int", $iDuration)
    Return SetError(@error, @extended, $vAuiForwardResult)
EndFunc

