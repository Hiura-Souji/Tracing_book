; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_HttpRequestGetText
; 說明 ...: Decodes the response body into AutoIt text.
; 語法 ........: _UI_HttpRequestGetText( $iRequestId )
; 參數 ....: $iRequestId - Request ID
; 傳回值 .: Success - UTF-16 AutoIt text
;                  Failure - Empty string
; 作者 ........: Fanxing
; 備註 .......: Recognizes UTF-8 and UTF-16 BOMs first, and supports UTF-8, UTF-16, ASCII, ISO-8859-1, Windows-1252, GB18030,
;                  GBK, Big5, and Shift_JIS declared by Content-Type. An unknown charset or invalid encoding sets @error; use
;                  _UI_HttpRequestGetBody for binary content.
; 範例 .......: No
; ===============================================================================================================================
Func _UI_HttpRequestGetText($iRequestId)
    Local $vAuiHelperResult = __AUI_HttpReadText("_UI_HttpRequestGetText", $iRequestId)
    Return SetError(@error, @extended, $vAuiHelperResult)
EndFunc
; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_HttpRequestGetBody
; 說明 ...: Retrieves binary response body.
; 語法 ........: _UI_HttpRequestGetBody( $iRequestId )
; 參數 ....: $iRequestId - Request ID
; 傳回值 .: Success - AutoIt Binary value
;                  Failure - Empty Binary value
; 作者 ........: Fanxing
; 備註 .......: A valid zero-byte response also returns an empty Binary value with @error = 0; use @error to distinguish
;                  failure.
; 範例 .......: No
; ===============================================================================================================================
Func _UI_HttpRequestGetBody($iRequestId)
    Local $aNeed = __AUI_DllCall("int", "_UI_HttpRequestGetBody", "int", $iRequestId, "ptr", 0, "int", 0)
    If @error Or Not IsArray($aNeed) Then Return SetError(@error, 0, StringToBinary(""))
    If $aNeed[0] < 0 Then Return SetError(__AUI_ReadNativeLastError(), 0, StringToBinary(""))
    If $aNeed[0] = 0 Then
        Local $iNativeError = __AUI_ReadNativeLastError()
        Local $iNativeDllError = @error
        If $iNativeDllError Then Return SetError($iNativeDllError, 0, StringToBinary(""))
        If $iNativeError <> $AUI_OK Then Return SetError($iNativeError, 0, StringToBinary(""))
        Return SetError(0, 0, StringToBinary(""))
    EndIf
    Local $tBytes = DllStructCreate("byte[" & $aNeed[0] & "]")
    Local $aRead = __AUI_DllCall("int", "_UI_HttpRequestGetBody", "int", $iRequestId, "ptr", DllStructGetPtr($tBytes), "int", $aNeed[0])
    If @error Or Not IsArray($aRead) Then Return SetError(@error, 0, StringToBinary(""))
    Return DllStructGetData($tBytes, 1)
EndFunc
