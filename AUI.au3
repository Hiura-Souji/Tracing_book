; 語法 ........: _UI_JsonHas( $iJson [, $sPath = ""] )
; 參數 ....: $iJson - Document handle
;                  $sPath - [Optional] Path; empty string or omitted = root
; 傳回值 .: Success - 1 if the path exists, 0 if it does not
;                  Failure - -1
; 作者 ........: Fanxing
; 相關函式 .......: _UI_JsonType
; 範例 .......: No
; ===============================================================================================================================
Func _UI_JsonHas($iJson, $sPath = "")
    Local $vAuiForwardResult = __AUI_Call("int", "_UI_JsonHas", "int", $iJson, "wstr", $sPath)
