; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_DataViewHitTest
; 說明 ...: Performs a hit test using logical coordinates relative to the DataView.
; 語法 ........: _UI_DataViewHitTest( $hWnd, $iDataView, $iX, $iY )
; 參數 ....: $hWnd - Window handle returned by _UI_WindowCreate
;                  $iDataView - DataView control ID
;                  $iX - Logical X coordinate within the control
;                  $iY - Logical Y coordinate within the control
; 傳回值 .: Success - Three-element array [hit area, row, column], meaningless rows and columns are -1
;                  Failure - 0 and set @error
; 作者 ........: Fanxing
; 範例 .......: Yes
; ===============================================================================================================================
Func _UI_DataViewHitTest($hWnd, $iDataView, $iX, $iY)
    If __AUI_EnsureDll() = 0 Then Return SetError($g_iAuiLoadError, 0, 0)
    Local $aCall = __AUI_DllCall("int", "_UI_DataViewHitTest", "hwnd", $hWnd, "int", $iDataView, _
        "int", $iX, "int", $iY, "int*", -1, "int*", -1)
    Local $iDllError = @error
    If $iDllError Or Not IsArray($aCall) Then Return SetError($iDllError, 0, 0)
    Local $iNativeError = __AUI_ReadNativeLastError()
    If $iNativeError <> $AUI_OK Then Return SetError($iNativeError, 0, 0)
    Local $aResult[3] = [$aCall[0], $aCall[5], $aCall[6]]
    Return SetError(0, 0, $aResult)
EndFunc

; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_DataViewGetCellRect
; 說明 ...: Retrieves the logical pixel rectangle of the cell relative to DataView.
; 語法 ........: _UI_DataViewGetCellRect( $hWnd, $iDataView, $iRow, $iColumn )
; 參數 ....: $hWnd - Window handle returned by _UI_WindowCreate
;                  $iDataView - DataView control ID
;                  $iRow - Zero-based row index
;                  $iColumn - Zero-based column index
; 傳回值 .: Success - Four-element array [x, y, width, height]
;                  Failure - 0 and set @error
; 作者 ........: Fanxing
; 範例 .......: Yes
; ===============================================================================================================================
Func _UI_DataViewGetCellRect($hWnd, $iDataView, $iRow, $iColumn)
    If __AUI_EnsureDll() = 0 Then Return SetError($g_iAuiLoadError, 0, 0)
    Local $aCall = __AUI_DllCall("int", "_UI_DataViewGetCellRect", "hwnd", $hWnd, "int", $iDataView, _
        "int", $iRow, "int", $iColumn, "int*", 0, "int*", 0, "int*", 0, "int*", 0)
    Local $iDllError = @error
    If $iDllError Or Not IsArray($aCall) Then Return SetError($iDllError, 0, 0)
    If $aCall[0] = 0 Then Return SetError(__AUI_ReadNativeLastError(), 0, 0)
    Local $aResult[4] = [$aCall[5], $aCall[6], $aCall[7], $aCall[8]]
    Return SetError(0, 0, $aResult)
EndFunc

; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_DataViewVirtual
; 說明 ...: Enables virtual DataView mode (very large data is valued based on range transactions, in conjunction with
;                  _UI_DataViewOnRangeRequest).
; 語法 ........: _UI_DataViewVirtual( $hWnd, $iDataView, $iRowCount, $iColCount )
; 參數 ....: $hWnd - Window handle returned by _UI_WindowCreate
;                  $iDataView - DataView element ID returned by _UI_DataView
;                  $iRowCount - Total number of rows in the virtual DataView, from 0 through 2,147,483,647
;                  $iColCount - Total number of columns in virtual DataView
; 傳回值 .: Success - 1
;                  Failure - 0 (the number of rows and columns exceeds the upper limit of the virtual DataView or the parameter
;                  is invalid)
; 作者 ........: Fanxing
; 備註 .......: Datasets above 10 million rows remain supported. Provide filtering, search, or direct navigation instead of
;                  relying only on the scrollbar. UI Automation Grid and Table can retrieve offscreen cells by row and column;
;                  changing the virtual revision invalidates existing row and cell providers.
; 相關函式 .......: _UI_DataViewOnRangeRequest, _UI_DataViewSupplyRow, _UI_DataViewSupplyCell, _UI_DataViewCommitRange
; 範例 .......: No
; ===============================================================================================================================
Func _UI_DataViewVirtual($hWnd, $iDataView, $iRowCount, $iColCount)
    Local $vAuiForwardResult = __AUI_Call("int", "_UI_DataViewVirtual", _
                      "hwnd", $hWnd, "int", $iDataView, "int", $iRowCount, "int", $iColCount)
    Return SetError(@error, @extended, $vAuiForwardResult)
EndFunc

; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_DataViewOnRangeRequest
; 說明 ...: Registers the visible-range batch-request callback for a virtual DataView.
; 語法 ........: _UI_DataViewOnRangeRequest( $hWnd, $iDataView, $sFuncName )
; 參數 ....: $hWnd - Window handle returned by _UI_WindowCreate
;                  $iDataView - DataView element ID
;                  $sFuncName - Func F($id, $token, $first, $count, $revision)
; 傳回值 .: Success - 1
;                  Failure - 0; the callback name is invalid, callback registration failed, or the native call failed
; 作者 ........: Fanxing
; 備註 .......: In the callback, SupplyRow is called row by row, SupplyCell is called cell by cell, and finally CommitRange
;                  is called.
; 範例 .......: Yes
; ===============================================================================================================================
Func _UI_DataViewOnRangeRequest($hWnd, $iDataView, $sFuncName)
    If __AUI_ValidateOptionalCallback($sFuncName) = 0 Then Return SetError(@error, 0, 0)
    If $sFuncName <> "" And $g_pAuiDispDataRange = 0 Then $g_pAuiDispDataRange = __AUI_RegisterCallback("__AUI_DataRangeProxy", "hwnd;int;uint64;int;int;uint64", "none")
    If $sFuncName <> "" And $g_pAuiDispDataRange = 0 Then Return SetError(@error, 0, 0)
    Local $sOldFunc = __AUI_CbGet($__AUI_CB_DATAVIEW_RANGE, $iDataView, $hWnd)
    If __AUI_CbSet($__AUI_CB_DATAVIEW_RANGE, $iDataView, $sFuncName, $hWnd) = 0 Then Return SetError(@error, 0, 0)
    Local $pCallback = $sFuncName = "" ? 0 : $g_pAuiDispDataRange
    Local $iResult = __AUI_Call("int", "_UI_DataViewOnRangeRequest", "hwnd", $hWnd, "int", $iDataView, "ptr", $pCallback)
    Local $iCallError = @error
    If $iCallError Or $iResult = 0 Then
        __AUI_CbSet($__AUI_CB_DATAVIEW_RANGE, $iDataView, $sOldFunc, $hWnd)
        Return SetError($iCallError, 0, 0)
    EndIf
    Return SetError(0, 0, 1)
EndFunc

; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_DataViewOnRowId
; 說明 ...: Registers the stable Row ID of the virtual DataView to provide a callback so that rows outside the screen can
;                  also be queried by stable identity.
; 語法 ........: _UI_DataViewOnRowId( $hWnd, $iDataView, $sFuncName )
; 參數 ....: $hWnd - Window handle returned by _UI_WindowCreate
;                  $iDataView - Virtual DataView control ID
;                  $sFuncName - Func F($iRow) -> Positive int64 Row ID; empty string means cancel
; 傳回值 .: Success - 1
;                  Failure - 0; the callback name is invalid, callback registration failed, or the native call failed
; 作者 ........: Fanxing
; 備註 .......: Only called by explicit queries such as GetRowId, SelectedRowId, CheckedRowId, etc., this callback will not
;                  be entered during the drawing phase.
; 相關函式 .......: _UI_DataViewVirtual, _UI_DataViewSupplyRow, _UI_DataViewGetRowId
; 範例 .......: Yes
; ===============================================================================================================================
Func _UI_DataViewOnRowId($hWnd, $iDataView, $sFuncName)
    If __AUI_ValidateOptionalCallback($sFuncName) = 0 Then Return SetError(@error, 0, 0)
    If $sFuncName <> "" And $g_pAuiDispDataRowId = 0 Then $g_pAuiDispDataRowId = __AUI_RegisterCallback("__AUI_DataRowIdProxy", "hwnd;int;int", "int64")
    If $sFuncName <> "" And $g_pAuiDispDataRowId = 0 Then Return SetError(@error, 0, 0)
    Local $sOldFunc = __AUI_CbGet($__AUI_CB_DATAVIEW_ROW_ID, $iDataView, $hWnd)
    If __AUI_CbSet($__AUI_CB_DATAVIEW_ROW_ID, $iDataView, $sFuncName, $hWnd) = 0 Then Return SetError(@error, 0, 0)
    Local $pCallback = $sFuncName = "" ? 0 : $g_pAuiDispDataRowId
    Local $iResult = __AUI_Call("int", "_UI_DataViewOnRowId", "hwnd", $hWnd, "int", $iDataView, "ptr", $pCallback)
    Local $iCallError = @error
    If $iCallError Or $iResult = 0 Then
        __AUI_CbSet($__AUI_CB_DATAVIEW_ROW_ID, $iDataView, $sOldFunc, $hWnd)
        Return SetError($iCallError, 0, 0)
    EndIf
    Return SetError(0, 0, 1)
EndFunc

; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_DataViewSetRevision
; 說明 ...: Sets dummy data versions and invalidate old snapshots and late commits.
; 語法 ........: _UI_DataViewSetRevision( $hWnd, $iDataView, $iRevision )
; 參數 ....: $hWnd - Window handle returned by _UI_WindowCreate
;                  $iDataView - DataView element ID
;                  $iRevision - Caller-maintained 64-bit monotonic data version
; 傳回值 .: Success - 1
;                  Failure - 0
; 作者 ........: Fanxing
; 範例 .......: Yes
; ===============================================================================================================================
Func _UI_DataViewSetRevision($hWnd, $iDataView, $iRevision)
    Local $vAuiForwardResult = __AUI_Call("int", "_UI_DataViewSetRevision", "hwnd", $hWnd, "int", $iDataView, "uint64", $iRevision)
    Return SetError(@error, @extended, $vAuiForwardResult)
EndFunc

; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_DataViewSupplyRow
; 說明 ...: Supplies a row's stable ID and background color to the current virtual-range transaction.
; 語法 ........: _UI_DataViewSupplyRow( $hWnd, $iDataView, $iToken, $iRow, $iRowId [, $iBackground = 0] )
; 參數 ....: $hWnd - Window handle returned by _UI_WindowCreate
;                  $iDataView - DataView element ID
;                  $iToken - Request token received by the range callback
;                  $iRow - Global zero base row position
;                  $iRowId - Positive int64 stable Row ID
;                  $iBackground - Optional ARGB row background color; 0 uses default color
; 傳回值 .: Success - 1
;                  Failure - 0
; 作者 ........: Fanxing
; 範例 .......: Yes
; ===============================================================================================================================
Func _UI_DataViewSupplyRow($hWnd, $iDataView, $iToken, $iRow, $iRowId, $iBackground = 0)
    If Not __AUI_IsIntegerVariant($iRowId) Or $iRowId <= 0 Then
        $g_iAuiUdfErrorCode = $AUI_ERR_INVALID_ARGUMENT
        Return SetError($g_iAuiUdfErrorCode, 0, 0)
    EndIf
    Local $vAuiForwardResult = __AUI_Call("int", "_UI_DataViewSupplyRow", "hwnd", $hWnd, "int", $iDataView, _
        "uint64", $iToken, "int", $iRow, "int64", $iRowId, "uint", $iBackground)
    Return SetError(@error, @extended, $vAuiForwardResult)
EndFunc

