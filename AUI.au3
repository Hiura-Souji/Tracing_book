    Local $f = __AUI_CbGet($__AUI_CB_DATAVIEW_ROW_DBLCLICK, $iId, $hWnd)
    If $f <> "" Then __AUI_SafeCall($f, $iRow, 0, 0, 1)
EndFunc

Func __AUI_ReorderProxy($hWnd, $iId, $iFrom, $iTo)
