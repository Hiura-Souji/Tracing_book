; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_SliderSetRange
; 說明 ...: Atomically sets the Slider range and clamps the current value.
; 語法 ........: _UI_SliderSetRange( $hWnd, $iId, $iMin, $iMax )
; 參數 ....: $hWnd - Window handle
;                  $iId - Slider element ID
;                  $iMin - Minimum value
;                  $iMax - Maximum value, must not be less than the minimum value
; 傳回值 .: Success - 1
;                  Failure - 0, and set the error code
; 作者 ........: Fanxing
; 範例 .......: Yes
; ===============================================================================================================================
Func _UI_SliderSetRange($hWnd, $iId, $iMin, $iMax)
    Local $vAuiForwardResult = __AUI_Call("int", "_UI_SliderSetRange", "hwnd", $hWnd, "int", $iId, _
            "int", $iMin, "int", $iMax)
    Return SetError(@error, @extended, $vAuiForwardResult)
EndFunc

; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_SliderGetRange
; 說明 ...: Retrieves slider integer range.
; 語法 ........: _UI_SliderGetRange( $hWnd, $iId )
; 參數 ....: $hWnd - Window handle
;                  $iId - Slider element ID
; 傳回值 .: Success - Two-element array [minimum value, maximum value]
;                  Failure - NULL value and set @error
; 作者 ........: Fanxing
; 範例 .......: Yes
; ===============================================================================================================================
Func _UI_SliderGetRange($hWnd, $iId)
    If __AUI_EnsureDll() = 0 Then Return SetError($g_iAuiLoadError, 0, Null)
    Local $aCall = __AUI_DllCall("int", "_UI_SliderGetRange", _
            "hwnd", $hWnd, "int", $iId, "int*", 0, "int*", 0)
    Local $iError = @error
    If $iError Or Not IsArray($aCall) Then Return SetError($iError, 0, Null)
    If $aCall[0] = 0 Then Return SetError(__AUI_ReadNativeLastError(), 0, Null)
    Local $aRange[2] = [$aCall[3], $aCall[4]]
    Return $aRange
EndFunc

