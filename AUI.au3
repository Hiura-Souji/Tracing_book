; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_MediaViewGetNaturalSize
; 說明 ...: Queries the natural pixel size of a video.
; 語法 ........: _UI_MediaViewGetNaturalSize($hWnd, $iMedia, ByRef $iWidth, ByRef $iHeight)
; 參數 ....: $hWnd - Window handle
;                  $iMedia - MediaView element ID
;                  $iWidth - [ByRef] Receive the natural pixel width of the video
;                  $iHeight - [ByRef] Receive the natural pixel height of the video
; 傳回值 .: 1 on success, 0 if audio or not yet ready
; 作者 ........: Fanxing
; 範例 .......: Yes
; ===============================================================================================================================
Func _UI_MediaViewGetNaturalSize($hWnd, $iMedia, ByRef $iWidth, ByRef $iHeight)
    If __AUI_EnsureDll() = 0 Then Return SetError($g_iAuiLoadError, 0, 0)
    Local $tSize = DllStructCreate("int width;int height")
    Local $a = __AUI_DllCall("int", "_UI_MediaViewGetNaturalSize", _
            "hwnd", $hWnd, "int", $iMedia, "ptr", DllStructGetPtr($tSize, "width"), _
            "ptr", DllStructGetPtr($tSize, "height"))
    Local $iDllError = @error
    If $iDllError Or Not IsArray($a) Then Return SetError($iDllError, 0, 0)
    If $a[0] = 0 Then
        Local $iNativeError = __AUI_ReadNativeLastError()
        If $iNativeError <> $AUI_OK Then Return SetError($iNativeError, 0, 0)
    EndIf
    $iWidth = DllStructGetData($tSize, "width")
    $iHeight = DllStructGetData($tSize, "height")
    Return SetError(0, 0, $a[0])
EndFunc

