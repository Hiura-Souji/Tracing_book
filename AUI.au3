; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_WebViewGetPick
; 說明 ...: Retrieves the latest picking result (JSON: selector/text/attribute, etc.).
; 語法 ........: _UI_WebViewGetPick( $hWnd, $iWebId )
; 參數 ....: $hWnd - Window handle returned by _UI_WindowCreate
;                  $iWebId - WebView control ID (_UI_WebView returned)
; 傳回值 .: Success - The element picking result this time is JSON; if there is no new result, it is an empty string.
;                  Failure - ""
; 作者 ........: Fanxing
; 相關函式 .......: _UI_WebViewGetPickField
; 範例 .......: Yes
; ===============================================================================================================================
Func _UI_WebViewGetPick($hWnd, $iWebId)
    Local $sResult = __AUI_ReadElementText("_UI_WebViewGetPick", $hWnd, $iWebId)
    Local $iReadError = @error
    If $iReadError Then Return SetError($iReadError, 0, "")
    If $sResult <> "" Then __AUI_CbSet($__AUI_CB_WEB_PICK_CACHE, $iWebId, $sResult, $hWnd, False)
    Return SetError(0, 0, $sResult)
EndFunc

; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_WebViewGetPickField
; 說明 ...: Retrieves a field from the pick result JSON.
; 語法 ........: _UI_WebViewGetPickField( $hWnd, $iWebId, $sField )
; 參數 ....: $hWnd - Window handle returned by _UI_WindowCreate
;                  $iWebId - WebView control ID (_UI_WebView returned)
;                  $sField - The field name to be taken
; 傳回值 .: Success - The string value of the specified field in the most recent picked result
;                  Failure - ""
; 作者 ........: Fanxing
; 相關函式 .......: _UI_WebViewGetPick
; 範例 .......: No
; ===============================================================================================================================
Func _UI_WebViewGetPickField($hWnd, $iWebId, $sField)
    _UI_WebViewGetPick($hWnd, $iWebId)
    Local $iReadError = @error
    If $iReadError Then Return SetError($iReadError, 0, "")
    Local $vAuiForwardResult = _UI_WebViewJsonField(__AUI_CbGet($__AUI_CB_WEB_PICK_CACHE, $iWebId, $hWnd), $sField)
    Return SetError(@error, @extended, $vAuiForwardResult)
EndFunc

; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_WebViewLocatorAsync
; 說明 ...: Submits asynchronous web element locator requests via unified opcodes.
; 語法 ........: _UI_WebViewLocatorAsync( $hWnd, $iWebId, $iOperation [, $sMode = "" [, $sSel = "" [, $iIndex = 0 [,
;                  $sArgument = "" [, $sOnDone = ""]]]]] )
; 參數 ....: $hWnd - Window handle returned by _UI_WindowCreate
;                  $iWebId - WebView control ID (_UI_WebView returned)
;                  $iOperation - An $AUI_WEB_LOC_* opcode
;                  $sMode - [Optional] "css" or "xpath"; no selector operation can be empty, default is ""
;                  $sSel - [Optional] Non-empty selector; no selector operation can be empty, default is ""
;                  $iIndex - [Optional] Match index (starting from 0), default 0
;                  $sArgument - [Optional] The new value of SetValue or the attribute name of GetAttribute, default ""
;                  $sOnDone - [Optional] Completion callback function name, signature Func F($iWebId, $iRequestId, $iStatus),
;                  default ""
; 傳回值 .: Success - Request ID (> 0)
;                  Failure - 0; a parameter is invalid or the maximum number of unreleased requests has been reached
; 作者 ........: Fanxing
; 相關函式 .......: _UI_WebViewResultGet, _UI_WebViewResultRelease
; 範例 .......: Yes
; ===============================================================================================================================
Func _UI_WebViewLocatorAsync($hWnd, $iWebId, $iOperation, $sMode = "", $sSel = "", $iIndex = 0, $sArgument = "", $sOnDone = "")
    If __AUI_ValidateOptionalCallback($sOnDone) = 0 Then Return SetError(@error, 0, 0)
    Local $pCallback = 0
    If $sOnDone <> "" Then
        If $g_pAuiDispWebResult = 0 Then $g_pAuiDispWebResult = __AUI_RegisterCallback("__AUI_DispWebResult", "hwnd;int;int;int")
        If $g_pAuiDispWebResult = 0 Then Return SetError(@error, 0, 0)
        $pCallback = $g_pAuiDispWebResult
    EndIf
    Local $iRequestId = __AUI_Call("int", "_UI_WebViewLocatorAsync", _
            "hwnd", $hWnd, "int", $iWebId, "int", $iOperation, _
            "wstr", $sMode, "wstr", $sSel, "int", $iIndex, _
            "wstr", $sArgument, "ptr", $pCallback)
    If @error Then Return SetError(@error, 0, 0)
    If __AUI_WebResultAttachCallback($hWnd, $iWebId, $iRequestId, $sOnDone) = 0 Then Return SetError(@error, 0, 0)
    Return $iRequestId
EndFunc

; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_WebViewCountAsync
; 說明 ...: Asynchronously counts the number of elements matching a selector.
; 語法 ........: _UI_WebViewCountAsync( $hWnd, $iWebId, $sMode, $sSel, $sOnDone = "" )
; 參數 ....: $hWnd - Window handle returned by _UI_WindowCreate
;                  $iWebId - WebView control ID (_UI_WebView returned)
;                  $sMode - Locator type; must be "css" or "xpath"
;                  $sSel - Non-empty CSS selector or XPath expression
;                  $sOnDone - [Optional] Completion callback function name, signature Func F($iWebId, $iRequestId, $iStatus),
;                  default ""
; 傳回值 .: Success - Request ID (> 0)
;                  Failure - 0; a parameter is invalid or the maximum number of unreleased requests has been reached
; 作者 ........: Fanxing
; 相關函式 .......: _UI_WebViewResultGetInt, _UI_WebViewResultRelease
; 範例 .......: Yes
; ===============================================================================================================================
Func _UI_WebViewCountAsync($hWnd, $iWebId, $sMode, $sSel, $sOnDone = "")
    Local $vAuiForwardResult = _UI_WebViewLocatorAsync($hWnd, $iWebId, $AUI_WEB_LOC_COUNT, $sMode, $sSel, 0, "", $sOnDone)
    Return SetError(@error, @extended, $vAuiForwardResult)
EndFunc

