; ────────────────────────────────────────────────────────────────────────────
;  NumberInput
; ────────────────────────────────────────────────────────────────────────────
; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_NumberInput
; 說明 ...: Creates a number input box (with up and down fine-tuning, range and step size can be set).
; 語法 ........: _UI_NumberInput( $hWnd, $iParent [, $nValue = 0 [, $nMin = 0 [, $nMax = 100 [, $nStep = 1 [, $iX = 0 [, $iY =
;                  0 [, $iW = 0 [, $iH = 0]]]]]]]] )
; 參數 ....: $hWnd - Window handle returned by _UI_WindowCreate
;                  $iParent - Parent element ID; use 0 for the window root
;                  $nValue - [Optional] Initial value, default 0
;                  $nMin - [optional] minimum value, default 0
;                  $nMax - [Optional] Maximum value, default 100
;                  $nStep - [Optional] Step size, default 1
;                  $iX - [Optional] Logical X coordinate (relative to parent container; ignored in flexible containers such as
;                  Row/Column), default 0
;                  $iY - [Optional] Logical Y coordinate (relative to parent container; ignored in flexible containers), default
;                  0
;                  $iW - [Optional] Logical width; 0 = automatically determined/filled by layout, default 0
;                  $iH - [Optional] Logical height; 0 = automatically determined/filled by layout, default 0
; 傳回值 .: Success - New element ID (integer, >= 1)
;                  Failure - 0
; 作者 ........: Fanxing
; 相關函式 .......: _UI_NumberInputGetValue, _UI_NumberInputSetValue, _UI_OnNumberChange
; 範例 .......: Yes
; ===============================================================================================================================
Func _UI_NumberInput($hWnd, $iParent, $nValue = 0, $nMin = 0, $nMax = 100, $nStep = 1, _
                     $iX = 0, $iY = 0, $iW = 0, $iH = 0)
    Local $vAuiForwardResult = __AUI_Call("int", "_UI_NumberInput", _
                       "hwnd", $hWnd, "int", $iParent, _
                       "double", $nValue, "double", $nMin, "double", $nMax, "double", $nStep, _
                       "int", $iX, "int", $iY, "int", $iW, "int", $iH)
    Return SetError(@error, @extended, $vAuiForwardResult)
EndFunc

