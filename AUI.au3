; ────────────────────────────────────────────────────────────────────────────
;  Text
; ────────────────────────────────────────────────────────────────────────────
; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_Text
; 說明 ...: Creates text labels.
; 語法 ........: _UI_Text( $hWnd, $iParent, $sText [, $iX = 0 [, $iY = 0 [, $iW = 0 [, $iH = 0]]]] )
; 參數 ....: $hWnd - Window handle returned by _UI_WindowCreate
;                  $iParent - Parent element ID; use 0 for the window root
;                  $sText - Text content
;                  $iX - [Optional] Logical X coordinate (relative to parent container; ignored in flexible containers such as
;                  Row/Column), default 0
;                  $iY - [Optional] Logical Y coordinate (relative to parent container; ignored in flexible containers), default
;                  0
;                  $iW - [Optional] Logical width; omit or pass 0 = adaptive to the container/content, default 0
;                  $iH - [Optional] Logical height; omit or pass 0 = adaptive to the content, default 0
; 傳回值 .: Success - New element ID (integer, >= 1)
;                  Failure - 0
; 作者 ........: Fanxing
; 相關函式 .......: _UI_Heading, _UI_SetText
; 範例 .......: Yes
; ===============================================================================================================================
Func _UI_Text($hWnd, $iParent, $sText, $iX = 0, $iY = 0, $iW = 0, $iH = 0)
    Local $vAuiForwardResult = __AUI_Call("int", "_UI_Text", _
                       "hwnd", $hWnd, "int", $iParent, "wstr", $sText, _
                       "int", $iX, "int", $iY, "int", $iW, "int", $iH)
    Return SetError(@error, @extended, $vAuiForwardResult)
EndFunc

; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_MeasureText
; 說明 ...: Measures text rendering size in logical pixels. When the maximum width is 0, the width of a single line is
;                  not limited; when it is greater than 0, the line is folded according to the width. A font size of 0 uses the
;                  theme value. Returns [width, height].
; 語法 ........: _UI_MeasureText( $hWnd, $sText [, $iFontSize = 0 [, $iMaxWidth = 0]] )
; 參數 ....: $hWnd - Window handle returned by _UI_WindowCreate
;                  $sText - Text content
;                  $iFontSize - [Optional] Logical font size in the 0–10,000 range; 0 uses the theme default.
;                  $iMaxWidth - [Optional] Maximum logical width in the 0–1,000,000 range; 0 removes the single-line width
;                  limit.
; 傳回值 .: Success - Two-element array [width, height] containing logical width and height
;                  Failure - [0, 0]
; 作者 ........: Fanxing
; 範例 .......: No
; ===============================================================================================================================
Func _UI_MeasureText($hWnd, $sText, $iFontSize = 0, $iMaxWidth = 0)
    Local $tW = DllStructCreate("int"), $tH = DllStructCreate("int")
    Local $iResult = __AUI_Call("int", "_UI_MeasureText", "hwnd", $hWnd, "wstr", $sText, "double", $iFontSize, "int", $iMaxWidth, _
                                "ptr", DllStructGetPtr($tW), "ptr", DllStructGetPtr($tH))
    If @error Or $iResult = 0 Then
        Local $aFail[2] = [0, 0]
        Return SetError(@error, 0, $aFail)
    EndIf
    Local $aRet[2] = [DllStructGetData($tW, 1), DllStructGetData($tH, 1)]
    Return SetError(0, 0, $aRet)
EndFunc

; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_SetAutoSize
; 說明 ...: Turns on or off adaptive sizing of elements based on content (measured internally by the library, no manual
;                  calculation required). Text element: The width changes with the text and then wraps to $iMaxWidth; Row/Column
;                  container: the height automatically wraps the child elements. $iMaxWidth=0 means no width limit (the
;                  container ignores this parameter).
; 語法 ........: _UI_SetAutoSize( $hWnd, $iId [, $iMaxWidth = 0 [, $bEnable = True]] )
; 參數 ....: $hWnd - Window handle returned by _UI_WindowCreate
;                  $iId - Target element ID
;                  $iMaxWidth - [Optional] The maximum logical width allowed during automatic line wrapping; 0 means no limit,
;                  default 0
;                  $bEnable - [Optional] True to turn on, False to turn off, default True
; 傳回值 .: Success - 1
;                  Failure - 0; the maximum width cannot be negative
; 作者 ........: Fanxing
; 範例 .......: No
; ===============================================================================================================================
Func _UI_SetAutoSize($hWnd, $iId, $iMaxWidth = 0, $bEnable = True)
    Local $vAuiForwardResult = __AUI_Call("int", "_UI_SetAutoSize", "hwnd", $hWnd, "int", $iId, "int", $iMaxWidth, "int", $bEnable ? 1 : 0)
    Return SetError(@error, @extended, $vAuiForwardResult)
EndFunc

; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_GetAutoSize
; 說明 ...: Retrieves the element's content-adaptive state and maximum width.
; 語法 ........: _UI_GetAutoSize( $hWnd, $iId )
; 參數 ....: $hWnd - Window handle
;                  $iId - Target element ID
; 傳回值 .: Success - Two-item array [whether enabled, maximum logical width]; maximum width 0 means unlimited
;                  Failure - 0, and set @error
; 作者 ........: Fanxing
; 相關函式 .......: _UI_SetAutoSize
; 範例 .......: No
; ===============================================================================================================================
Func _UI_GetAutoSize($hWnd, $iId)
    Local $tMaxWidth = DllStructCreate("int"), $tEnable = DllStructCreate("int")
    Local $iResult = __AUI_Call("int", "_UI_GetAutoSize", "hwnd", $hWnd, "int", $iId, _
            "ptr", DllStructGetPtr($tMaxWidth), "ptr", DllStructGetPtr($tEnable))
    Local $iDllError = @error
    If $iDllError Then Return SetError($iDllError, 0, 0)
    If $iResult = 0 Then
        Local $iNativeError = _UI_GetLastError()
        If @error Or $iNativeError = $AUI_OK Then $iNativeError = $AUI_ERR_INVALID_ARGUMENT
        Return SetError($iNativeError, 0, 0)
    EndIf
    Local $aState[2] = [DllStructGetData($tEnable, 1) <> 0, DllStructGetData($tMaxWidth, 1)]
    Return SetError(0, 0, $aState)
EndFunc
