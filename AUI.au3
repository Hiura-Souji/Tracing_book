EndFunc

; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_JsonGetString
; 說明 ...: Reads a string value at a path.
; 語法 ........: _UI_JsonGetString( $iJson [, $sPath = ""] )
; 參數 ....: $iJson - Document handle
;                  $sPath - [Optional] Path; empty string or omitted = root
; 傳回值 .: Success - The string value
;                  Failure - ""; the value is not a string ($AUI_ERR_WRONG_ELEMENT_TYPE) or the path is missing
; 作者 ........: Fanxing
; 備註 .......: A string containing U+0000 is rejected with $AUI_ERR_LIMIT_EXCEEDED to prevent silent truncation through the
;                  AutoIt string channel; read the serialized escaped form with _UI_JsonGetRaw instead.
; 相關函式 .......: _UI_JsonType, _UI_JsonGetInt64, _UI_JsonGetDouble, _UI_JsonGetBool, _UI_JsonIsNull
; 範例 .......: No
; ===============================================================================================================================
Func _UI_JsonGetString($iJson, $sPath = "")
    Local $vAuiHelperResult = __AUI_JsonReadText("_UI_JsonGetString", $iJson, $sPath, 0, False)
    Return SetError(@error, @extended, $vAuiHelperResult)
EndFunc

; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_JsonGetInt64
; 說明 ...: Reads an integer value at a path as a 64-bit integer (no silent truncation).
; 語法 ........: _UI_JsonGetInt64( $iJson [, $sPath = ""] )
; 參數 ....: $iJson - Document handle
;                  $sPath - [Optional] Path; empty string or omitted = root
; 傳回值 .: Success - The 64-bit integer value
;                  Failure - 0; the value is not an integer ($AUI_ERR_WRONG_ELEMENT_TYPE) or exceeds the int64 range
; 作者 ........: Fanxing
; 備註 .......: An unsigned value above 9,223,372,036,854,775,807 fails with $AUI_ERR_OUT_OF_RANGE. Use _UI_JsonGetNumberText
;                  to preserve its decimal representation; a Double is not an exact substitute.
; 相關函式 .......: _UI_JsonGetNumberText, _UI_JsonGetDouble
; 範例 .......: No
; ===============================================================================================================================
Func _UI_JsonGetInt64($iJson, $sPath = "")
    If __AUI_EnsureDll() = 0 Then Return SetError($g_iAuiLoadError, 0, 0)
    Local $tOut = DllStructCreate("int64")
    Local $aRet = __AUI_DllCall("int", "_UI_JsonGetInt64", "int", $iJson, "wstr", $sPath, _
                          "ptr", DllStructGetPtr($tOut))
    Local $iErr = @error
    If $iErr Or Not IsArray($aRet) Then Return SetError($iErr, 0, 0)
    If $aRet[0] = 0 Then
        Local $iNativeError = _UI_GetLastError()
        If @error Or $iNativeError = $AUI_OK Then $iNativeError = $AUI_ERR_OUT_OF_RANGE
        Return SetError($iNativeError, 0, 0)
    EndIf
    Return SetError(0, 0, DllStructGetData($tOut, 1))
EndFunc

; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_JsonGetDouble
; 說明 ...: Reads a numeric value at a path as a double.
; 語法 ........: _UI_JsonGetDouble( $iJson [, $sPath = ""] )
; 參數 ....: $iJson - Document handle
;                  $sPath - [Optional] Path; empty string or omitted = root
; 傳回值 .: Success - The finite double value
;                  Failure - 0; the value is not a number ($AUI_ERR_WRONG_ELEMENT_TYPE) or is outside the finite Double range
; 作者 ........: Fanxing
; 備註 .......: Integers beyond 2^53 lose precision when read as Double. Use _UI_JsonGetNumberText when the complete JSON
;                  number token must be retained. Valid JSON numbers such as 1e309 remain stored in the document but cannot be
;                  converted to Double.
; 相關函式 .......: _UI_JsonGetInt64, _UI_JsonGetNumberText
; 範例 .......: No
; ===============================================================================================================================
Func _UI_JsonGetDouble($iJson, $sPath = "")
    If __AUI_EnsureDll() = 0 Then Return SetError($g_iAuiLoadError, 0, 0)
    Local $tOut = DllStructCreate("double")
    Local $aRet = __AUI_DllCall("int", "_UI_JsonGetDouble", "int", $iJson, "wstr", $sPath, _
                          "ptr", DllStructGetPtr($tOut))
    Local $iErr = @error
    If $iErr Or Not IsArray($aRet) Then Return SetError($iErr, 0, 0)
    If $aRet[0] = 0 Then
        Local $iNativeError = _UI_GetLastError()
        If @error Or $iNativeError = $AUI_OK Then $iNativeError = $AUI_ERR_OUT_OF_RANGE
        Return SetError($iNativeError, 0, 0)
    EndIf
    Return SetError(0, 0, DllStructGetData($tOut, 1))
EndFunc

; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_JsonGetNumberText
; 說明 ...: Returns the complete JSON number token retained during parsing without converting it to an AutoIt Double.
; 語法 ........: _UI_JsonGetNumberText( $iJson [, $sPath = ""] )
; 參數 ....: $iJson - Document or borrowed child handle
;                  $sPath - [Optional] Path; empty string or omitted = root
; 傳回值 .: Success - JSON number text
;                  Failure - "" and set @error
; 作者 ........: Fanxing
; 備註 .......: The original spelling is retained, including trailing zeros and exponent notation. Use this for
;                  arbitrary-size integers, high-precision decimals, or any numeric token that must round-trip without lexical
;                  changes.
; 相關函式 .......: _UI_JsonGetInt64, _UI_JsonGetDouble, _UI_JsonSetRaw
; 範例 .......: No
; ===============================================================================================================================
Func _UI_JsonGetNumberText($iJson, $sPath = "")
    Local $vAuiHelperResult = __AUI_JsonReadText("_UI_JsonGetNumberText", $iJson, $sPath, 0, False)
    Return SetError(@error, @extended, $vAuiHelperResult)
EndFunc

; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_JsonGetBool
; 說明 ...: Reads a boolean value at a path.
; 語法 ........: _UI_JsonGetBool( $iJson [, $sPath = ""] )
; 參數 ....: $iJson - Document handle
;                  $sPath - [Optional] Path; empty string or omitted = root
; 傳回值 .: Success - True or False
;                  Failure - False; the value is not a boolean ($AUI_ERR_WRONG_ELEMENT_TYPE)
; 作者 ........: Fanxing
; 相關函式 .......: _UI_JsonType
; 範例 .......: No
; ===============================================================================================================================
Func _UI_JsonGetBool($iJson, $sPath = "")
    If __AUI_EnsureDll() = 0 Then Return SetError($g_iAuiLoadError, 0, False)
    Local $tOut = DllStructCreate("int")
    Local $aRet = __AUI_DllCall("int", "_UI_JsonGetBool", "int", $iJson, "wstr", $sPath, _
                          "ptr", DllStructGetPtr($tOut))
    Local $iErr = @error
    If $iErr Or Not IsArray($aRet) Then Return SetError($iErr, 0, False)
    If $aRet[0] = 0 Then
        Local $iNativeError = _UI_GetLastError()
        If @error Or $iNativeError = $AUI_OK Then $iNativeError = $AUI_ERR_OUT_OF_RANGE
        Return SetError($iNativeError, 0, False)
    EndIf
    Return SetError(0, 0, DllStructGetData($tOut, 1) <> 0)
EndFunc

; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_JsonIsNull
; 說明 ...: Checks whether the value at a path is JSON null.
; 語法 ........: _UI_JsonIsNull( $iJson [, $sPath = ""] )
; 參數 ....: $iJson - Document handle
;                  $sPath - [Optional] Path; empty string or omitted = root
; 傳回值 .: Success - 1 if the value is null, 0 if it is any other type
;                  Failure - -1
; 作者 ........: Fanxing
; 相關函式 .......: _UI_JsonType
; 範例 .......: No
; ===============================================================================================================================
Func _UI_JsonIsNull($iJson, $sPath = "")
    Local $vAuiForwardResult = __AUI_Call("int", "_UI_JsonIsNull", "int", $iJson, "wstr", $sPath)
    Return SetError(@error, @extended, $vAuiForwardResult)
EndFunc

; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_JsonGetRaw
; 說明 ...: Returns the compact serialized JSON text of a subtree (the value at the path).
; 語法 ........: _UI_JsonGetRaw( $iJson [, $sPath = ""] )
; 參數 ....: $iJson - Document handle
;                  $sPath - [Optional] Path; empty string or omitted = root
; 傳回值 .: Success - The compact JSON text of the subtree
;                  Failure - ""
; 作者 ........: Fanxing
; 備註 .......: Use _UI_JsonToAutoItAt to convert a subtree directly instead of copying it to text and parsing it again.
; 相關函式 .......: _UI_JsonSerialize, _UI_JsonToAutoItAt
; 範例 .......: No
; ===============================================================================================================================
Func _UI_JsonGetRaw($iJson, $sPath = "")
    Local $vAuiHelperResult = __AUI_JsonReadText("_UI_JsonGetRaw", $iJson, $sPath, 0, False)
    Return SetError(@error, @extended, $vAuiHelperResult)
EndFunc

; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_JsonKeyName
; 說明 ...: Returns the key name of an object entry by insertion-order index for enumeration and conversion.
; 語法 ........: _UI_JsonKeyName( $iJson, $sPath, $iIndex )
; 參數 ....: $iJson - Document handle
;                  $sPath - Path to the object; empty string = root
;                  $iIndex - Zero-based entry index
; 傳回值 .: Success - The key name
;                  Failure - ""; the value is not an object or the index is out of range
; 作者 ........: Fanxing
; 備註 .......: A key name containing U+0000 is rejected ($AUI_ERR_LIMIT_EXCEEDED).
; 相關函式 .......: _UI_JsonCount
; 範例 .......: No
; ===============================================================================================================================
Func _UI_JsonKeyName($iJson, $sPath, $iIndex)
    Local $vAuiHelperResult = __AUI_JsonReadText("_UI_JsonKeyName", $iJson, $sPath, $iIndex, True)
    Return SetError(@error, @extended, $vAuiHelperResult)
EndFunc

; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_JsonSerialize
; 說明 ...: Serializes the root selected by a document or borrowed child handle back to JSON text.
; 語法 ........: _UI_JsonSerialize( $iJson [, $iIndent = 0] )
; 參數 ....: $iJson - Document or borrowed child handle
;                  $iIndent - [Optional] 0 = compact (default), 2 = two-space indentation, 4 = four-space indentation
; 傳回值 .: Success - JSON text
;                  Failure - ""
; 作者 ........: Fanxing
; 相關函式 .......: _UI_JsonParse, _UI_JsonGetRaw
; 範例 .......: No
; ===============================================================================================================================
Func _UI_JsonSerialize($iJson, $iIndent = 0)
    If __AUI_EnsureDll() = 0 Then Return SetError($g_iAuiLoadError, 0, "")
    Local $aNeed = __AUI_DllCall("int", "_UI_JsonSerialize", "int", $iJson, "int", $iIndent, "ptr", 0, "int", 0)
    Local $iDllError = @error
    If $iDllError Or Not IsArray($aNeed) Then Return SetError($iDllError, 0, "")
    If $aNeed[0] < 0 Then Return SetError(__AUI_ReadNativeLastError(), 0, "")
    If $aNeed[0] = 0 Then
        Local $iNativeError = __AUI_ReadNativeLastError()
        Local $iNativeDllError = @error
        If $iNativeDllError Then Return SetError($iNativeDllError, 0, "")
        If $iNativeError <> $AUI_OK Then Return SetError($iNativeError, 0, "")
    EndIf
    Local $iCap = $aNeed[0] + 1
    If $iCap < 1 Then $iCap = 1
    If $iCap > $__AUI_READ_TEXT_MAX_CHARS Then
        $g_iAuiUdfErrorCode = $AUI_ERR_LIMIT_EXCEEDED
        Return SetError($g_iAuiUdfErrorCode, 0, "")
    EndIf
    Local $tBuf = DllStructCreate("wchar[" & $iCap & "]")
    If @error Or Not IsDllStruct($tBuf) Then
        $g_iAuiUdfErrorCode = $AUI_ERR_LIMIT_EXCEEDED
        Return SetError($g_iAuiUdfErrorCode, 0, "")
    EndIf
    Local $aRead = __AUI_DllCall("int", "_UI_JsonSerialize", "int", $iJson, "int", $iIndent, "ptr", DllStructGetPtr($tBuf), "int", $iCap)
    $iDllError = @error
    If $iDllError Or Not IsArray($aRead) Then Return SetError($iDllError, 0, "")
    If $aRead[0] < 0 Then Return SetError(__AUI_ReadNativeLastError(), 0, "")
    If $aRead[0] >= $iCap Then
        $g_iAuiUdfErrorCode = $AUI_ERR_BUFFER_TOO_SMALL
        Return SetError($g_iAuiUdfErrorCode, $aRead[0] + 1, "")
    EndIf
    If $aRead[0] = 0 Then
        Local $iReadError = __AUI_ReadNativeLastError()
        Local $iReadDllError = @error
        If $iReadDllError Then Return SetError($iReadDllError, 0, "")
        If $iReadError <> $AUI_OK Then Return SetError($iReadError, 0, "")
    EndIf
    Return SetError(0, 0, DllStructGetData($tBuf, 1))
EndFunc

; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_JsonSaveFile
; 說明 ...: Saves a JSON document by writing a sibling temporary file and then atomically replacing the target.
; 語法 ........: _UI_JsonSaveFile( $iJson, $sPath [, $iIndent = 0 [, $iEncoding = $AUI_JSON_FILE_UTF8]] )
; 參數 ....: $iJson - Document or borrowed child handle
;                  $sPath - Target file path
;                  $iIndent - [Optional] 0 = compact, 2 = two-space indentation, 4 = four-space indentation
;                  $iEncoding - [Optional] $AUI_JSON_FILE_UTF8/_UTF8_BOM/_UTF16_LE/_UTF16_BE
; 傳回值 .: Success - 1
;                  Failure - 0 and set @error
; 作者 ........: Fanxing
; 備註 .......: Output files are limited to 64 MiB. A temporary file must be creatable in the target directory; a replacement
;                  failure never overwrites the target with partially written content.
; 相關函式 .......: _UI_JsonLoadFile, _UI_JsonSerialize
; 範例 .......: No
; ===============================================================================================================================
Func _UI_JsonSaveFile($iJson, $sPath, $iIndent = 0, $iEncoding = $AUI_JSON_FILE_UTF8)
    Local $vAuiForwardResult = __AUI_Call("int", "_UI_JsonSaveFile", "int", $iJson, "wstr", $sPath, _
            "int", $iIndent, "int", $iEncoding)
    Return SetError(@error, @extended, $vAuiForwardResult)
EndFunc

; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_JsonChild
; 說明 ...: Returns a borrowed child handle for the entry at an index in a container (array or object); the child handle
;                  becomes invalid when the document is released, and paths on it are relative to the child itself.
; 語法 ........: _UI_JsonChild( $iJson, $sPath, $iIndex )
; 參數 ....: $iJson - Document handle (or a child handle)
;                  $sPath - Path to the container; empty string = root of the handle
;                  $iIndex - Zero-based entry index
; 傳回值 .: Success - Borrowed child handle; release it early with _UI_JsonFree when it is no longer needed, or release
;                  its owner document
;                  Failure - 0; the value is not a container or the index is out of range
; 作者 ........: Fanxing
; 備註 .......: At most 1,024 child handles may be live at once. During long-running enumeration, release each child after
;                  use to avoid exhausting the handle pool. Releasing the owner document invalidates all of its remaining child
;                  handles.
; 相關函式 .......: _UI_JsonCount, _UI_JsonKeyName, _UI_JsonFree
; 範例 .......: No
; ===============================================================================================================================
Func _UI_JsonChild($iJson, $sPath, $iIndex)
    Local $vAuiForwardResult = __AUI_Call("int", "_UI_JsonChild", "int", $iJson, "wstr", $sPath, "int", $iIndex)
    Return SetError(@error, @extended, $vAuiForwardResult)
EndFunc

; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_JsonPointer
; 說明 ...: Resolves a value by RFC 6901 JSON Pointer and returns a borrowed child handle.
; 語法 ........: _UI_JsonPointer( $iJson, $sPointer )
; 參數 ....: $iJson - Document or borrowed child handle
;                  $sPointer - RFC 6901 JSON Pointer; an empty string selects the current handle root
; 傳回值 .: Success - Borrowed child handle; release it early with _UI_JsonFree
;                  Failure - 0 and set @error
; 作者 ........: Fanxing
; 備註 .......: Escape "~" as "~0" and "/" as "~1" within a segment. A pointer is limited to 4,096 UTF-16 code units and 128
;                  segments. Array indices must not contain leading zeroes. A successful mutation immediately invalidates every
;                  existing borrowed handle for the document.
; 相關函式 .......: _UI_JsonChild, _UI_JsonToAutoItAt, _UI_JsonFree
; 範例 .......: No
; ===============================================================================================================================
Func _UI_JsonPointer($iJson, $sPointer)
    Local $vAuiForwardResult = __AUI_Call("int", "_UI_JsonPointer", "int", $iJson, "wstr", $sPointer)
    Return SetError(@error, @extended, $vAuiForwardResult)
EndFunc

; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_JsonCreateObject
; 說明 ...: Creates a JSON document whose root is an empty object.
; 語法 ........: _UI_JsonCreateObject()
; 參數 ....: None
; 傳回值 .: Success - Document handle; release it with _UI_JsonFree
;                  Failure - 0 and set @error
; 作者 ........: Fanxing
; 相關函式 .......: _UI_JsonCreateArray, _UI_JsonSet, _UI_JsonFree
; 範例 .......: No
; ===============================================================================================================================
Func _UI_JsonCreateObject()
    Local $iJson = _UI_JsonParse("{}")
    Return SetError(@error, @extended, $iJson)
EndFunc

