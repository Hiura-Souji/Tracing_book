; 參數 ....: $hWnd - Window handle
;                  $iId - Edit control element ID
;                  $iStart - Starting UTF-16 position (inclusive)
;                  $iEnd - Ending UTF-16 position (exclusive)
; 傳回值 .: Success - Range text
;                  Failure - Empty string and set @error
; 作者 ........: Fanxing
; 範例 .......: Yes
; ===============================================================================================================================
Func _UI_EditGetTextRange($hWnd, $iId, $iStart, $iEnd)
    Local $vAuiHelperResult = __AUI_ReadPairText("_UI_EditGetTextRange", $hWnd, $iId, $iStart, $iEnd)
    Return SetError(@error, @extended, $vAuiHelperResult)
EndFunc

; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_EditGetSelection
; 說明 ...: Retrieves the current selection; when there is no selection, both positions are the cursor positions.
; 語法 ........: _UI_EditGetSelection( $hWnd, $iId )
; 參數 ....: $hWnd - Window handle
;                  $iId - Edit control element ID
; 傳回值 .: Success - Two-element array [start position, end position]
;                  Failure - 0
; 作者 ........: Fanxing
; 範例 .......: Yes
; ===============================================================================================================================
Func _UI_EditGetSelection($hWnd, $iId)
    If __AUI_EnsureDll() = 0 Then Return SetError($g_iAuiLoadError, 0, 0)
    Local $aCall = __AUI_DllCall("int", "_UI_EditGetSelection", "hwnd", $hWnd, "int", $iId, "int*", 0, "int*", 0)
    Local $iDllError = @error
    If $iDllError Or Not IsArray($aCall) Then Return SetError($iDllError, 0, 0)
    If Not $aCall[0] Then Return SetError(__AUI_ReadNativeLastError(), 0, 0)
    Local $aSelection[2] = [$aCall[3], $aCall[4]]
    Return $aSelection
EndFunc

; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_EditSetSelection
; 說明 ...: Sets the edit control selection, and the position will be clamped to the fully extended grapheme boundary.
; 語法 ........: _UI_EditSetSelection( $hWnd, $iId, $iStart [, $iEnd = -1] )
; 參數 ....: $hWnd - Window handle
;                  $iId - Edit control element ID
;                  $iStart - Selection starting UTF-16 position
;                  $iEnd - [Optional] The end position of the selection; -1 indicates the end of the text
; 傳回值 .: Success - 1
;                  Failure - 0
; 作者 ........: Fanxing
; 備註 .......: A successful selection change also raises the UI Automation TextSelectionChanged event.
; 範例 .......: Yes
; ===============================================================================================================================
Func _UI_EditSetSelection($hWnd, $iId, $iStart, $iEnd = -1)
    Local $vAuiForwardResult = __AUI_Call("int", "_UI_EditSetSelection", "hwnd", $hWnd, "int", $iId, "int", $iStart, "int", $iEnd)
    Return SetError(@error, @extended, $vAuiForwardResult)
EndFunc

