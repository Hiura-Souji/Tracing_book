; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_DataView
; 說明 ...: Creates a unified DataView that can be displayed as a table with a header or a list without a header.
; 語法 ........: _UI_DataView( $hWnd, $iParent, $sColumns [, $sRows = "" [, $bHeaderVisible = True [, $iX = 0 [, $iY = 0 [,
;                  $iW = 0 [, $iH = 0]]]]]] )
; 參數 ....: $hWnd - Window handle returned by _UI_WindowCreate
;                  $iParent - Parent element ID; use 0 for the window root
;                  $sColumns - Column titles, separated by vertical bars | or TAB; pass an empty string for list mode
;                  $sRows - [Optional] Row data: Cells are separated into columns using @TAB, rows are separated using @CRLF,
;                  the default is ""
;                  $bHeaderVisible - [Optional] True to display the header (table mode); False to hide the header (list mode),
;                  default True
;                  $iX - [Optional] Logical X coordinate (relative to parent container; ignored in flexible containers such as
;                  Row/Column), default 0
;                  $iY - [Optional] Logical Y coordinate (relative to parent container; ignored in flexible containers), default
;                  0
;                  $iW - [Optional] Logical width; 0 = automatically determined/filled by layout, default 0
;                  $iH - [Optional] Logical height; 0 = automatically determined/filled by layout, default 0
; 傳回值 .: Success - New element ID (integer, >= 1)
;                  Failure - 0
; 作者 ........: Fanxing
; 相關函式 .......: _UI_DataViewSetRows, _UI_DataViewSetCell, _UI_DataViewOnRangeRequest
; 範例 .......: Yes
; ===============================================================================================================================
Func _UI_DataView($hWnd, $iParent, $sColumns, $sRows = "", $bHeaderVisible = True, $iX = 0, $iY = 0, $iW = 0, $iH = 0)
    Local $vAuiForwardResult = __AUI_Call("int", "_UI_DataView", _
                       "hwnd", $hWnd, "int", $iParent, _
                       "wstr", $sColumns, "wstr", $sRows, _
                       "int", $bHeaderVisible ? 1 : 0, _
                       "int", $iX, "int", $iY, "int", $iW, "int", $iH)
    Return SetError(@error, @extended, $vAuiForwardResult)
EndFunc

Func __AUI_DataActionProxy($hWnd, $iDataView, $iRow, $iRowId, $iCol, $iAction)
