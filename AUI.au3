;                  $sPointer - RFC 6901 JSON Pointer to an array; an empty string selects a root array
;                  $sValueJson - A complete, valid JSON value
; 傳回值 .: Success - 1
;                  Failure - 0 and set @error
; 作者 ........: Fanxing
; 相關函式 .......: _UI_JsonArrayAppend, _UI_JsonArrayInsertRaw
; 範例 .......: No
; ===============================================================================================================================
Func _UI_JsonArrayAppendRaw($iJson, $sPointer, $sValueJson)
    Local $vAuiForwardResult = __AUI_Call("int", "_UI_JsonArrayAppendRaw", "int", $iJson, "wstr", $sPointer, "wstr", $sValueJson)
    Return SetError(@error, @extended, $vAuiForwardResult)
EndFunc

