; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_HttpRequestSetLimits
; 說明 ...: Sets the in-memory response and file-download limits for the current request.
; 語法 ........: _UI_HttpRequestSetLimits( $iRequestId, $iResponseBytes, $iDownloadBytes )
; 參數 ....: $iRequestId - Request ID
;                  $iResponseBytes - Maximum number of bytes in memory response
;                  $iDownloadBytes - Maximum number of bytes in file response
; 傳回值 .: Success - 1
;                  Failure - 0
; 作者 ........: Fanxing
; 備註 .......: The default in-memory response limit is 32 MiB and the default file-response limit is 1 GiB. They can be
;                  configured from 1 byte through 128 MiB and from 1 byte through 64 GiB, respectively. AUI checks both
;                  Content-Length and the actual decompressed byte count received. Text mode is also limited to 33,554,432
;                  UTF-16 code units after decoding.
; 範例 .......: No
; ===============================================================================================================================
Func _UI_HttpRequestSetLimits($iRequestId, $iResponseBytes, $iDownloadBytes)
    Local $vAuiForwardResult = __AUI_Call("int", "_UI_HttpRequestSetLimits", "int", $iRequestId, "int64", $iResponseBytes, "int64", $iDownloadBytes)
    Return SetError(@error, @extended, $vAuiForwardResult)
EndFunc

