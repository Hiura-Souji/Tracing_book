; #FUNCTION# ===================================================================================================================
; 名稱 ..........: _UI_WebViewNewTab
; 說明 ...: Creates a WebView tab and returns its tab ID.
; 語法 ........: _UI_WebViewNewTab( $hWnd, $iWebId [, $sUrl = "about:blank"] )
; 參數 ....: $hWnd - Window handle returned by _UI_WindowCreate
;                  $iWebId - WebView control ID (_UI_WebView returned)
;                  $sUrl - [Optional] Initial URL, default "about:blank"
; 傳回值 .: Success - Stable tab ID for new tab page
;                  Failure - 0
; 作者 ........: Fanxing
; 備註 .......: Tab creation is asynchronous; the returned ID is reserved immediately. Until OnTabAdded is received, closing
;                  or switching to this ID fails with @error=CoreNotReady, and GetTabLoading returns 1. A single WebView
;                  supports at most 64 tabs, including those still being created.
; 相關函式 .......: _UI_WebViewCloseTab, _UI_WebViewSwitchTab
; 範例 .......: Yes
; ===============================================================================================================================
Func _UI_WebViewNewTab($hWnd, $iWebId, $sUrl = "about:blank")
    Local $vAuiForwardResult = __AUI_Call("int", "_UI_WebViewNewTab", _
                      "hwnd", $hWnd, "int", $iWebId, "wstr", $sUrl)
    Return SetError(@error, @extended, $vAuiForwardResult)
EndFunc

